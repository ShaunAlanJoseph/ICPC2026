  "source_code": "#include <bits/stdc++.h>\r\n#define mod 998244353\r\nusing namespace std;\r\n\r\nvector<long long> inv_,H;\r\nvoid solve(int n){\r\n    if (inv_.empty()){\r\n        inv_.assign(2,1);\r\n        H.assign(2,0);\r\n        H[1]=1;\r\n    }\r\n        int cur=inv_.size()-1;\r\n        if(n<=cur) return;\r\n        inv_.resize(n+1);\r\n        H.resize(n+1);\r\n        for(int i=cur+1; i<=n; i++){\r\n            inv_[i]=(mod-(mod/i)*inv_[mod%i]%mod)%mod;\r\n            H[i]=(H[i-1]+inv_[i])%mod;\r\n            \r\n        }\r\n\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        solve(n);\r\n        long long ans = 0;\r\n        long long temp;\r\n        for(int j=1;j<=n;j++){\r\n            long long a;\r\n            cin>>a;\r\n            a%=mod;\r\n            if(a<0) a+=mod;\r\n            long long w=(H[j-1]+H[n-j])%mod;\r\n            ans=(ans+a*w)%mod;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
