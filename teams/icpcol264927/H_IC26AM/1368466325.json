  "source_code": "#include <bits/stdc++.h>\r\n#define int long long int\r\nusing namespace std;\r\n\r\nconst int mod = 998244353;\r\nconst int mx = 300005;\r\n\r\nint inv[mx],h[mx];\r\n\r\nvoid init() {\r\n    \r\n    inv[1] = 1;\r\n    int i = 2;\r\n    while (i < mx) {\r\n        inv[i] = mod-(mod/i)*inv[mod%i]%mod;\r\n        i++;\r\n    }\r\n    \r\n    h[0] = 0;\r\n    for (int j = 1;j<mx;j++) {\r\n        h[j] = (h[j-1] + inv[j])%mod;\r\n    }\r\n}\r\nvoid solve() {\r\n    \r\n    int n;\r\n    cin >> n;\r\n    \r\n    vector<int> a(n);\r\n    for (int i =0;i<n;i++) {\r\n        cin >> a[i];\r\n    }\r\n    \r\n    if (n == 1) {\r\n        cout << 0 << endl;\r\n        return;\r\n    }\r\n    \r\n    int ans = 0;\r\n    for (int i = 0;i<n;i++) {\r\n        int x = (h[i] + h[n-1-i]) % mod;\r\n        int y = (a[i] % mod + mod) % mod;\r\n        \r\n        ans = (ans + y*x) % mod;\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\nint32_t main() {\r\n\t\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\tinit();\r\n\t\r\n\twhile (t--) {\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
