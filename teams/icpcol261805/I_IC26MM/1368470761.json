  "source_code": "# cook your dish here\r\nt=int(input())\r\nm=998244353\r\ndef msk(lo,hi,v):\r\n    lo=max(lo,0); hi=min(hi,v-1)\r\n    return ((1<<(hi+1))-(1<<lo)) if lo<=hi else 0\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    okl=[(1<<v)-1 for v in range(n+1)]\r\n    okr=[(1<<v)-1 for v in range(n+1)]\r\n    \r\n    for i,v in enumerate(a,1):\r\n        c=i-n+v-1\r\n        npre=(i-1)//2 \r\n        nsuf=(n-i)//2 \r\n        P=[(0,npre)] if c==npre else ([(npre,npre)] if c<npre else []) \r\n        S=[]\r\n        if v-i==nsuf: S.append((max(0,i-1),v-1))\r\n        q=v-1-nsuf\r\n        if 0<=q<=i-2: S.append((q,q))\r\n        lm=0\r\n        rm=0\r\n        for x,y in P:\r\n            lm|=msk(x,min(y,i-1),v)\r\n            rm|=msk(x,min(y,c),v)\r\n        for x,y in S:\r\n            lm|=msk(max(x,i-1),y,v)\r\n            rm|=msk(max(x,c),y,v)\r\n        okl[v]&=lm \r\n        okr[v]&=rm \r\n        \r\n    dp=[0]*n\r\n    dp[0]=1 \r\n    for v in range(1,n):\r\n        ndp= [0]*n\r\n        for l in range(v):\r\n            cur=dp[l]\r\n            if not cur: continue\r\n            if(okr[v] >>l)&1 : ndp[l]+=cur\r\n            if(okl[v] >>l)&1: ndp[l+1]+=cur\r\n        dp=ndp \r\n    ans=0\r\n    ml=okl[n]\r\n    mr=okr[n]\r\n    for l in range(n):\r\n        if(dp[l] and (((ml>>l) &1) or ((mr>>l) &1 ))): ans+=dp[l]\r\n    print(ans%m)\r\n    \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        ",
