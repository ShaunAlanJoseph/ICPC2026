  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    p=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        p[i+1] = p[i]+a[i]\r\n    ans=0\r\n    for i in range(n+1):\r\n        l=0\r\n        r=n-i\r\n        while(l<r):\r\n            m=l+(r-l)//2\r\n            q1=i+2*m\r\n            q2=3*n - 2*i-m\r\n            cur=6* p[i]+4 * (p[q1] - p[i]) + 3 * ( p[q2] - p[q1] )\r\n            m2=m+1\r\n            q1=i+2*m2\r\n            q2=3*n- 2*i -m2\r\n            \r\n            nxt= 6*p[i] + 4*(p[q1] - p[i]) + 3*(p[q2]-p[q1])\r\n            \r\n            if nxt>cur:\r\n                l=m+1 \r\n            else:\r\n                r=m \r\n        m=l \r\n        q1=i+2*m\r\n        q2=3*n-2*i -m \r\n        ans=max( ans ,   6*p[i] + 4*(p[q1] - p[i]) + 3*(p[q2]-p[q1]) ) \r\n        \r\n    print(ans)\r\n        ",
