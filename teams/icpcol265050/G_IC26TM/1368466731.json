  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nint n;\r\nvector<int> a, suffix;\r\n\r\nint f(int j, int i) {\r\n    if (j == -1) return 0;\r\n    return (suffix[2 * i + j] - suffix[3 * n - i]) * 3 + (suffix[3 * n - i - 2 * j] - suffix[3 * n - i]);\r\n    \r\n}\r\n\r\nsigned main() {\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\twhile (t--) {\r\n\t    cin >> n;\r\n\t    \r\n\t    a.resize(3 * n);\r\n\t    for (int i = 0; i < 3 * n; i++) {\r\n\t        cin >> a[i];\r\n\t    }\r\n\t    \r\n\t    sort(a.begin(), a.end());\r\n\t    \r\n\t    suffix.assign(3 * n + 1, 0);\r\n\t    for (int i = 3 * n - 1; i >= 0; i--) {\r\n\t        suffix[i] = suffix[i + 1] + a[i];\r\n\t    }\r\n\t    \r\n\t    int ans = 0;\r\n\t    \r\n\t    for (int i = 0; i <= n; i++) {\r\n\t        int local = 6 * suffix[3 * n - i];\r\n\t        \r\n\t        int l = 0, r = n - i + 1;\r\n\t        while (l + 1 < r) {\r\n\t            int m = (l + r) / 2;\r\n\t            \r\n\t            if (f(m, i) - f(m - 1, i) >= 0) {\r\n\t                l = m;\r\n\t            } else {\r\n\t                r = m;\r\n\t            }\r\n\t        }\r\n\t        \r\n\t        \r\n\t        ans = max(ans, local + f(l, i));\r\n\t    }\r\n\t    \r\n\t    \r\n\t    cout << ans << '\\n';\r\n\t}\r\n}\r\n",
