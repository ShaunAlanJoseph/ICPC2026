  "source_code": "import sys \r\n\r\nMOD = 998244353\r\n\r\ninput = sys.stdin.buffer.readline\r\n\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    \r\n    inv = [0] * (n + 1)\r\n    \r\n    if n >= 1:\r\n        inv[1] = 1\r\n    \r\n    for i in range(2, n + 1):\r\n        inv[i] = MOD - (MOD // i) * inv[MOD % i] % MOD\r\n        \r\n    H = [0] * n\r\n    \r\n    for i in range(1, n):\r\n        H[i] = (H[i - 1] + inv[i] % MOD)\r\n        \r\n    ans = 0\r\n    \r\n    for i in range(n):\r\n        coefficient = (H[i] + H[n - i -1]) % MOD\r\n        \r\n        ans = (ans + (a[i] % MOD) * coefficient) % MOD\r\n    print(ans)    ",
