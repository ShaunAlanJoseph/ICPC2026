  "source_code": "#include <bits/stdc++.h>\r\n#define ll long long \r\nusing namespace std;\r\n\r\nvoid Mani(){\r\n    ll n;cin>>n;\r\n    ll n3=3*n,ans=-1;\r\n    vector<ll>a(n3);\r\n    for(ll i=0;i<n3;i++)cin>>a[i];\r\n    sort(a.rbegin(),a.rend());\r\n    \r\n    vector<ll>sx(n3+1,0);\r\n    for(ll i=0;i<n3;i++){\r\n        sx[i+1]=sx[i]+a[i];\r\n    }\r\n    for(ll z=0;z<=2*n;z++){\r\n        ll l =max(0LL,z-n);\r\n        ll r=z/2;\r\n        auto solve=[&](ll i){\r\n            return 2LL*sx[i]+sx[2*z-3*i];\r\n        };\r\n        \r\n        while(r-l>2){\r\n            ll m1=l+(r-l)/3;\r\n            ll m2=r-(r-l)/3;\r\n            if(solve(m1)<solve(m2)){\r\n                l=m1;\r\n            }\r\n            else r=m2;\r\n        }\r\n        ll best=-1;\r\n        for(ll i=l;i<=r;i++){\r\n            best=max(best,solve(i));\r\n        }\r\n        ll cur=best+3LL*sx[3*n-z];\r\n        ans=max(ans,cur);\r\n    }\r\n    \r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tll tt;cin>>tt;\r\n\twhile(tt--){\r\n   Mani();\r\n\t}\r\n}\r\n",
