  "source_code": "#include <bits/stdc++.h>\r\n#define ll long long \r\nusing namespace std;\r\n\r\nconst ll M=998244353,MAXI=2e5+6;\r\nll inv[MAXI];\r\nll b[MAXI];\r\n\r\nvoid pre(){\r\n    inv[1]=1;\r\n    for(ll i=2;i<MAXI;i++){\r\n        inv[i]=(M-(M/i)*inv[M%i]%M)%M;\r\n    }\r\n    b[0]=0;\r\n    for(ll i=1;i<MAXI;i++){\r\n        b[i]=(b[i-1]+inv[i])%M;\r\n    }\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tll tt;cin>>tt;\r\n\tpre();\r\n\twhile(tt--){\r\n       ll n,ans=0;cin>>n;\r\n       vector<ll>a(n);\r\n       for(auto &i:a)cin>>i;\r\n       for(ll i=0;i<n;i++){\r\n           ll cf=(b[i]+b[n-1-i])%M;\r\n           ans=(ans+a[i]*cf)%M;\r\n       }\r\n       cout<<ans<<endl;\r\n\t}\r\n}\r\n",
