  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\t// your code goes here\r\n\tconst int mod=998244353;\r\n\tconst int maxi=200005;\r\n\tlong long v1[maxi],v2[maxi];\r\n\tvoid compute(){\r\n\t    v1[1]=1;\r\n\t    for(int i=2;i<maxi;i++){\r\n\t        v1[i]=(mod-mod/i)*v1[mod%i]%mod;\r\n\t    }\r\n\t    v2[0]=0;\r\n\t    for(int i=1;i<maxi;i++){\r\n\t        v2[i]=(v2[i-1]+v1[i])%mod;\r\n\t    }\r\n\t}\r\n    void solve(){\r\n        int n;\r\n        cin>>n;\r\n        long long sol=0;\r\n        for(int i=1;i<=n;i++){\r\n            long long a;\r\n            cin>>a;\r\n            long long coeff=(v2[i-1]+v2[n-i])%mod;\r\n            sol=(sol+a*coeff)%mod;\r\n        }\r\n        cout<<sol<<endl;\r\n    }\r\nint main(){\r\n    compute();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n\r\n",
