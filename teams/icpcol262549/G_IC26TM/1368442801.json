  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int nums=3*n;\r\n        vector<long long> arr(nums);\r\n        for(int i=0;i<nums;i++){\r\n            cin>>arr[i];\r\n        }\r\n        sort(arr.rbegin(),arr.rend());\r\n        vector<long long> pre(nums+1,0);\r\n        for(int i=0;i<nums;i++){\r\n            pre[i+1]=pre[i]+arr[i];\r\n        }\r\n        auto evaluate=[&](int a,int b){\r\n            return 2LL*pre[a]+pre[a+2*b]+3LL*pre[3*n-2*a-b];\r\n        };\r\n        long long maxi=0;\r\n        for(int i=0;i<=n;i++){\r\n            int low=0,high=n-i;\r\n            while(low<=high){\r\n                int mid=low+(high-low)/2;\r\n                if(mid<n-i && evaluate(i,mid+1)>evaluate(i,mid)){\r\n                    low=mid+1;\r\n                }\r\n                else{\r\n                   high=mid-1; \r\n                }\r\n            }\r\n            maxi=max(maxi,evaluate(i,low));\r\n        }\r\n        cout<<maxi<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
