  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    vector<int> a(3*n + 1);\r\n\t    for(int i = 1;i<=3*n;i++)\r\n\t    {\r\n\t        cin >> a[i];\r\n\t    }\r\n\t    sort(a.begin()+1,a.end(),greater<long long>());\r\n\t    vector<long long> dp(((3*n) + 1),0);\r\n\t    for(int i =1;i<=(3*n);i++)\r\n\t    {\r\n\t        dp[i] = dp[i-1]+a[i];\r\n\t    }\r\n\t    long long score = 0;\r\n\t    for(int i = 0;i<=(n);i++)\r\n\t    {\r\n\t        int low = 0;\r\n\t        int high = n-i-1;\r\n\t        int o = 0;\r\n\t        while(low <= high)\r\n\t        {\r\n\t            int mid = low + (high-low)/2;\r\n\t            long long diff = a[i+2 * mid + 1] + a[i+2 * mid + 2] - 3LL * a[3 * n - 2 * i - mid];\r\n\t            if(diff >= 0)\r\n\t            {\r\n\t                o = mid + 1;\r\n\t                low = mid + 1;\r\n\t            }\r\n\t            else\r\n\t            {\r\n\t                high = mid -1;\r\n\t            }\r\n\t        }\r\n\t        long long cs = 2LL * dp[i]+dp[i+2 * o] + 3LL * dp[3*n - 2 * i - o];\r\n\t        score = max(score,cs);\r\n\t    }\r\n\t    cout << score << endl;\r\n\t}\r\n}\r\n",
