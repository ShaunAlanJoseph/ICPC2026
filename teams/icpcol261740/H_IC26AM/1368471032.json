  "source_code": "import sys\r\n\r\ndef solve():\r\n    inpd = sys.stdin.read().split()\r\n    \r\n    MOD = 998244353\r\n    MAXN = 200005\r\n    \r\n    H = [0] * MAXN\r\n    \r\n    for i in range(1, MAXN):\r\n        H[i] = (H[i - 1] + pow(i, MOD - 2, MOD)) % MOD\r\n        \r\n    t = int(inpd[0])\r\n    idx = 1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(inpd[idx])\r\n        idx += 1\r\n        \r\n        es = 0\r\n        for i in range(n):\r\n            ai = int(inpd[idx])\r\n            idx += 1\r\n            \r\n            ei = (H[i] + H[n - 1 - i]) % MOD\r\n            es = (es + ai * ei) % MOD\r\n        \r\n        out.append(str(es))\r\n    print('\\n'.join(out))\r\n\r\nsys.set_int_max_str_digits(200000)\r\nsolve()",
