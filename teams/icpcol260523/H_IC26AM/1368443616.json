  "source_code": "# cook your dish here\r\nimport sys \r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    M = 998244353\r\n    L = 200001\r\n    inv = [0] * (L + 1)\r\n    inv[1] = 1 \r\n    for i in range(2, L + 1):\r\n        inv[i] = (M - (M // i) * inv[M % i]) % M \r\n    H = [0] * (L + 1)\r\n    for i in range(1, L + 1):\r\n        H[i] = (H[i-1] + inv[i]) % M \r\n    \r\n    p = 1 \r\n    out = []\r\n    for _ in range(int(data[0])):\r\n        n = int(data[p]); p+= 1\r\n        ans = 0;\r\n        for j in range(n):\r\n            ans += int(data[p + j]) * (H[j] + H[n -1 - j])\r\n        p += n\r\n        out.append(ans % M)\r\n    sys.stdout.write(\"\\n\".join(map(str,out)))\r\nmain()",
