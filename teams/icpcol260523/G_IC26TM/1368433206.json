  "source_code": "t = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    a.sort(reverse=True)\r\n    m = 3 * n\r\n    s = [0] * (m + 1)\r\n    for i in range(m):\r\n        s[i + 1] = s[i] + a[i]\r\n    r = 0\r\n    for p in range(n + 1):\r\n        l, h = 0, n-p\r\n        while l < h:\r\n            d = (l + h) // 2\r\n            c = m - 2 * p - d - 1\r\n            if a[p + 2 * d] + a[p + 2 * d + 1] > 3 * a[c]:\r\n                l = d + 1\r\n            else:\r\n                h = d\r\n        for q in (max(0, l - 1), l, min(n - p, l + 1)):\r\n            v = 2 * s[p] + s[p + 2 * q] + 3 * s[m - 2 * p - q]\r\n            if v > r:\r\n                r = v\r\n    print(r)",
