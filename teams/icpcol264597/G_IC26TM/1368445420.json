  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\n\r\nvoid tom(){\r\n    int n;\r\n    cin>>n;\r\n    vector<ll>a(3*n);\r\n    for(int i=0;i<3*n;i++) cin>>a[i];\r\n    sort(a.rbegin(),a.rend());\r\n    \r\n    vector<ll>pre(3*n+1,0);\r\n    for(int i=0;i<3*n;i++) pre[i+1]=pre[i]+a[i];\r\n    ll res=0;\r\n    for(int i=0;i<=n;i++){\r\n        int s=0,e=n-i-1,bst=0;\r\n        while(s<=e){\r\n            int mid=s+(e-s)/2;\r\n            ll diff=a[i+2*mid]+a[i+ 2*mid + 1] - 3*(a[3*n- 2*i-mid-1]);\r\n            if(diff>=0){\r\n                bst=mid+1;\r\n                s=mid+1;\r\n            }else e=mid-1;   \r\n        }\r\n    for(int j=max(0,bst-1);j<=min(n-i,bst+1);j++){\r\n        ll curr=2*pre[i]+pre[i+2*j]+3*pre[3*n - 2*i -j];\r\n        res=max(res,curr);\r\n    }\r\n    }\r\n    cout<<res<<'\\n';\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        tom();\r\n    }\r\n}\r\n",
