  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    scanf(\"%d\", &n);\r\n\t    int m = 3 * n;\r\n\t    vector<ll> a(m);\r\n\t    for(auto &x : a) scanf(\"%lld\", &x);\r\n\t    sort(a.rbegin(), a.rend());\r\n\t    vector<ll> p(m + 1, 0);\r\n\t    for(int i = 0; i < m; i++){\r\n\t        p[i + 1] = p[i] + a[i];\r\n\t    }\r\n\t    ll best = 0;\r\n\t    for(int i = 0; i <= n; i++){\r\n\t        auto h = [&](int k)-> ll{\r\n\t            int j = 6 * n - 3 * i - 2 * k;\r\n\t            return p[j] + 3 * p[k];\r\n\t        };\r\n\t        int lo = 2 * n - i, hi = 3 * n - 2 * i;\r\n\t        while(lo < hi){\r\n\t            int mid = (lo + hi) / 2;\r\n\t            if(h(mid) < h(mid + 1)) lo = mid + 1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        best = max(best, 2 * p[i] + h(lo));\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\r\n}\r\n",
