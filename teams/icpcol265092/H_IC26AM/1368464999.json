  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long int ll;\r\nll MOD = 998244353;\r\nll MAX = 200005;\r\nll inv[200005];\r\nll H[200005];\r\nvoid pre(){\r\n    inv[1] = 1;\r\n    for(int i = 2;i<MAX;i++){\r\n        inv[i] = (MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n        \r\n    }\r\n    H[0] = 0;\r\n    for(int i = 1;i<MAX;i++){\r\n        H[i] = (H[i-1] + inv[i])%MOD;\r\n        \r\n    }\r\n}\r\nvoid solve(){\r\n    int t;\r\n    cin>>t;\r\n    pre();\r\n  while(t--){\r\n      int n;\r\n      cin>>n;\r\n      ll ans = 0;\r\n      for(int i = 1;i<=n;i++){\r\n          ll a;\r\n          cin>>a;\r\n          ll coef = (H[i-1] + H[n-i])%MOD;\r\n          ans = (ans + a%MOD*coef%MOD)%MOD;\r\n          \r\n      }\r\n      cout<<ans<<\"\\n\";\r\n  }\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tsolve();\r\n\r\n}\r\n",
