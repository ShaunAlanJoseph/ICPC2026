  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ninput = sys.stdin.buffer.readline\r\nout = []\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    \r\n    a = list(map(int, input().split()))\r\n    a.sort(reverse = True)\r\n    pref = [0]*(3*n+1)\r\n    \r\n    \r\n    for i in range(3 * n):\r\n        pref[i+1] = pref[i] + a[i]\r\n        \r\n    ans = 0\r\n        \r\n    for A in range(n + 1):\r\n        lo = 0\r\n        hi = n-A\r\n        \r\n        while lo<hi:\r\n            B = (lo + hi)//2\r\n            \r\n            gain = a[A+ 2*B] + a[A+(2*B) + 1] - 3*a[3*n-2 *A-B-1]\r\n            \r\n            if(gain >= 0):\r\n                lo = B+1 \r\n            else:\r\n                hi = B \r\n        B = lo \r\n    \r\n        score = 2 * pref[A] + pref[A+2*B] + 3*pref[3*n-2*A-B]\r\n    \r\n        ans = max(ans, score)\r\n    \r\n    out.append(str(ans))\r\n    \r\nprint(\"\\n\".join(out))",
