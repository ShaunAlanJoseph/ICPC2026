  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n\r\n    while (t--) {\r\n        int n;\r\n        cin >> n;\r\n        \r\n        int m = 3 * n;\r\n        vector < long long > a(m), p(m + 1);\r\n        \r\n        for (auto &x : a) {\r\n            cin >> x;\r\n        }\r\n        \r\n        sort(a.rbegin(), a.rend());\r\n\r\n        for (int i = 0; i < m; i++) {\r\n            p[i + 1] = p[i] + a[i];\r\n        }\r\n\r\n        auto calc = [ & ](int x, int y) {\r\n            int l = x;\r\n            int r = x + 2 * y;\r\n            int z = m - 2 * x - y;\r\n\r\n            return 6LL * p[l] + 4LL * (p[r] - p[l]) + 3LL * (p[z] - p[r]);\r\n        };\r\n\r\n        long long ans = 0;\r\n\r\n        for (int x = 0; x <= n; x++) {\r\n            int l = 0, r = n - x;\r\n\r\n            while (l < r) {\r\n                int mid = (l + r) / 2;\r\n\r\n                if (calc(x, mid) < calc(x, mid + 1)) {\r\n                    l = mid + 1;\r\n                } else {\r\n                    r = mid;\r\n                }\r\n            }\r\n\r\n            ans = max(ans, calc(x, l));\r\n        }\r\n\r\n        cout << ans << \"\\n\";\r\n    }\r\n}",
