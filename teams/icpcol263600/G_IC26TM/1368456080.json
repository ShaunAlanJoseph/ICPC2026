  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    int T = 0;\r\n    cin >> T;\r\n    while(T--){\r\n        int n = 0;\r\n        cin >> n;\r\n        int m = 3 * n;\r\n        vector<long long> a(m);\r\n        for(int i = 0; i < m; i++){\r\n            cin >> a[i];\r\n        }\r\n        sort(a.begin(), a.end(), greater<long long>());\r\n        vector<long long> p(m + 1, 0);\r\n        for(int i = 0; i < m; i++){\r\n            p[i + 1] = p[i] + a[i];\r\n        }\r\n        auto f1 = [&](int ta, int tb) -> long long{\r\n            return 2 * p[ta] + p[ta + 2 * tb] + 3 * p[m - 2 * ta - tb];\r\n        };\r\n        \r\n        long long aaa =0;\r\n        for(int ta = 0; ta <= n; ta++){\r\n            int lo = 0, hi = n - ta;\r\n            while(lo < hi){\r\n                int mid = (lo + hi)/2;\r\n                if(f1(ta, mid + 1) - f1(ta, mid) > 0) lo = mid + 1;\r\n                else{\r\n                    hi = mid;\r\n                }\r\n                \r\n            }\r\n            aaa = max(aaa, f1(ta, lo));\r\n        }\r\n        cout << aaa << endl;\r\n    }\r\n\r\n}\r\n",
