  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\n\r\nconst int MAXN = 200005;\r\n\r\nlong long inv[MAXN], harmonic[MAXN];\r\n\r\nint main() {\r\n    inv[1] = 1;\r\n    for(int i = 2; i < MAXN; i++){\r\n        inv[i] = (MOD- MOD/i) * inv[MOD % i] % MOD;\r\n    }\r\n    harmonic[0] = 0;\r\n    for(int i = 1; i < MAXN; i++){\r\n        harmonic[i] = (harmonic[i - 1] + inv[i] ) % MOD;\r\n    }\r\n    \r\n\tint T = 0;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n = 0;\r\n\t    cin >> n;\r\n\t    \r\n\t    long long ans = 0;\r\n\t    for(int j = 1; j <= n; j++){\r\n\t        long long x;\r\n\t        cin >> x;\r\n\t        long long cnt = (harmonic[j - 1] + harmonic[n - j]) % MOD;\r\n\t        ans = (ans + x % MOD * cnt) % MOD;\r\n\t        \r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
