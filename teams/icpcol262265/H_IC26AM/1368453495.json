  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\nconst int MOD=998244353;\r\nconst int N=2e5+11;\r\n\r\nint inv[N],precomp[N];\r\n\r\nvoid precompute(){\r\n    inv[1]=1;\r\n    for(int i=2;i<N;i++){\r\n        int val=MOD-MOD/i;\r\n        inv[i]=val*inv[MOD%i]%MOD;\r\n    }\r\n    for(int i=1;i<N;i++){\r\n        precomp[i]=(precomp[i-1]+inv[i])%MOD;\r\n    }\r\n}\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int res=0;\r\n    for(int i=1;i<=n;i++){\r\n        int a;\r\n        cin>>a;\r\n        int coefficient=(precomp[i-1]+precomp[n-i])%MOD;\r\n        res=(res+coefficient*a)%MOD;\r\n    }\r\n    \r\n    cout<<res<<'\\n';\r\n}\r\nsigned main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tprecompute();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
