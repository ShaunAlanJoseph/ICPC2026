  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define alr(a) a.rbegin(),a.rend()\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int m=3*n;\r\n    vector<int> a(m);\r\n    for(auto &x:a) cin>>x;\r\n    sort(alr(a));\r\n    \r\n    vector<int> p(m+1);\r\n    for(int i=0;i<m;i++){\r\n        p[i+1]=p[i]+a[i];\r\n    }\r\n     int ans=-1;\r\n     \r\n     for(int c1=0;c1<=n;c1++){\r\n         int x=n-c1;\r\n         int l=0,r=x-1,k=0;\r\n         \r\n         while(l<=r){\r\n             int mid=(l+r)/2;\r\n             int curr=p[c1+2*mid]+3*p[m-2*c1-mid];\r\n             int next=p[c1+2*(mid+1)]+3*p[m-2*c1-(mid+1)];\r\n             if(next>=curr){\r\n                k=mid+1;\r\n                l=mid+1;\r\n             }\r\n             else{\r\n                 r=mid-1;\r\n             }\r\n         }\r\n         int ind1=c1+2*k;\r\n         int ind2=m-2*c1-k;\r\n         int value=p[ind1]+3*p[ind2];\r\n         ans=max(ans,2*p[c1]+value);\r\n     }\r\n     cout<<ans<<'\\n';\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n}\r\n",
