  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long> a(m);\r\n\t    for(auto &value : a)\r\n\t      cin>>value;\r\n\t    sort(a.begin(), a.end(), greater<long long>());\r\n\t    vector<long long> pref(m+1 ,0);\r\n\t    for(int i=0;i<m;++i)\r\n\t       pref[i+1]=pref[i]+a[i];\r\n\t       auto score=[&](int x, int y)->long long{\r\n\t           return 2LL * pref[x]+pref[x+2*y]+ 3LL* pref[m-2*x-y];\r\n\t       };\r\n\t       long long answer=0;\r\n\t       int y=n;\r\n\t       for(int x=0;x<=n;++x){\r\n\t           y=min(y,n-x);\r\n\t           while(y>0 && score(x,y-1) >= score(x,y))\r\n\t             --y;\r\n\t            answer=max(answer,score(x,y));\r\n\t       }\r\n\t       cout<<answer<<'\\n';\r\n\t}\r\n\treturn 0;\r\n}\r\n",
