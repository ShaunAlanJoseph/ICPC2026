  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconstexpr int MOD=998244353;\r\nconstexpr int MAX_N=200000;\r\nint inv[MAX_N+1];\r\nint harmonic[MAX_N+1];\r\nint main() {\r\n    inv[1]=1;\r\n    for(int i=2;i<=MAX_N;++i){\r\n        inv[i]=MOD-1LL*(MOD/i)* inv[MOD%i]%MOD;\r\n    }\r\n    for(int i=1;i<=MAX_N;++i){\r\n        harmonic[i]=(harmonic[i-1]+inv[i])%MOD;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        long long answer=0;\r\n        for(int i=1;i<=n;++i){\r\n            long long a;\r\n            cin>>a;\r\n            int coefficient=(harmonic[i-1]+ harmonic[n-i])% MOD;\r\n            answer=(answer+a*coefficient)%MOD;\r\n        }\r\n        cout<<answer<<'\\n';\r\n    }\r\n\treturn 0;\r\n\r\n}\r\n",
