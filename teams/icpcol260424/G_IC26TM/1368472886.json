  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    \r\n    int t; \r\n    cin >> t; \r\n    while(t--) {\r\n        \r\n        int n; \r\n        cin >> n; \r\n        vector<long long> R(3*n+1);\r\n        for(int i=1;i<=3*n;i++) cin >> R[i]; \r\n       \r\n       sort(R.begin()+1,R.end(),greater<>()); \r\n       \r\n       vector<long long> s(3*n+1,0);\r\n       for(int i=1;i<=3*n;i++) s[i] = s[i-1]+R[i];\r\n       \r\n       auto f = [&](int A,int B) { \r\n           return 2LL*s[A]+s[A+2*B] + 3LL*s[3*n-2*A- B];\r\n           };\r\n           \r\n           long long yxz = 0; \r\n           for(int A = 0;A<=n;A++) { \r\n               int l=0,r =n-A;\r\n               \r\n               while(l < r) { \r\n                   int m = l  + (r-l)/2;\r\n                   long long delta = R[A+2*m+1] + R[A+2*m+2] - 3LL*R[3*n-2*A-m];\r\n                   if(delta >= 0) l = m+1;\r\n                   else r = m;\r\n               }\r\n               yxz = max(yxz,f(A,l));\r\n           }\r\n           cout << yxz << endl;\r\n\r\n            }\r\n        \r\n        \r\n    \r\n    return 0;\r\n\r\n}\r\n",
