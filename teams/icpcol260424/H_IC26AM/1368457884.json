  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nconst ll mod = 998244353LL;\r\n\r\nll modpow(ll a, ll b){\r\n    ll ans = 1;\r\n    while(b > 0){\r\n        if(b&1) ans = (ans * a) %mod;\r\n        a = (a*a) %mod;\r\n        b>>=1;\r\n    }\r\n    return ans; \r\n}\r\n\r\nll inv(ll a){\r\n    return modpow(a, mod-2);\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    vector<ll> prob(200000 + 100, 0);\r\n    for(int i = 1; i<200000+100; i++){\r\n        prob[i] = (prob[i-1] + inv(i))%mod;\r\n    }\r\n    \r\n    int ti; cin >> ti;\r\n    while(ti--){\r\n        int n; cin>>n;\r\n        ll sum = 0LL;\r\n        for(int i = 1; i<=n; i++){\r\n            ll x; cin >> x;\r\n            ll count = (prob[i-1] + prob[n-i])%mod;\r\n            sum = (sum + (count*x)%mod)%mod;\r\n        }\r\n        \r\n        cout << sum << endl;\r\n    }\r\n}\r\n",
