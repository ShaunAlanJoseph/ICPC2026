  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nconst int N = 200005;\r\nlong long inv[N], H[N];\r\nint main() {\r\n\t// your code goes here\r\n\tinv[1] = 1;\r\n\tfor(int i = 2; i < N ; i++) inv[i] = (MOD - MOD / i * inv[MOD % i] % MOD ) % MOD;\r\n\tfor(int i = 1; i < N; i++) H[i] = (H[i - 1] + inv[i]) % MOD;\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    long long ans = 0;\r\n\t    for(int j = 1; j <= n; j++){\r\n\t        long long a;\r\n\t        cin >> a;\r\n\t        ans = (ans + a * ((H[j - 1]) + H[n - j]) % MOD) % MOD;\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
