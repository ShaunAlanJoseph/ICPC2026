  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    t= int(data[0]);pos=1\r\n    result=[]\r\n    for _ in range(t):\r\n        n=int(data[pos]);pos+=1\r\n        arr=sorted(map(int,data[pos:pos+3*n]),reverse=True)\r\n        pos+=3*n \r\n        pre =[0]*(3*n+1)\r\n        for i in range(3*n):\r\n            pre[i+1]=pre[i]+arr[i]\r\n        best=0\r\n        for a in range(n+1):\r\n            base=2*pre[a]\r\n            rem=n-a\r\n            low,high=0, rem\r\n            while low<high:\r\n                mid=(low+high)>>1\r\n                f1=pre[a+2*mid]+3*pre[3*n-2*a-mid]\r\n                f2=pre[a+2*mid+2]+3*pre[3*n-2*a-mid-1]\r\n                if f2>f1:\r\n                    low=mid+1\r\n                else:\r\n                    high=mid\r\n            value=base+pre[a+2*low]+3*pre[3*n-2*a-low]    \r\n            if value>best:\r\n                best=value\r\n        result.append(best)\r\n    print(\"\\n\".join(map(str, result)))\r\nmain()\r\n            ",
