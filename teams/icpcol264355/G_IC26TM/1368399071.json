  "source_code": "import sys\r\ninput = sys.stdin.readline\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()), reverse = True)\r\n    p=[0]\r\n    for x in a:\r\n        p.append(p[-1]+x)\r\n    ans=0\r\n    for A in range(n+1):\r\n        m=n-A\r\n        def f(b):\r\n            j=A+2*b\r\n            k=3*n-2*A-b\r\n            return a[j]+a[j+1]-3*a[k-1]\r\n        lo,hi=0,m\r\n        while lo<hi:\r\n            mid=(lo+hi)//2\r\n            if mid==m or f(mid) < 0:\r\n                hi = mid\r\n            else:\r\n                lo=mid+1\r\n        for b in (lo, max(0,lo-1)):\r\n            j=A+2*b\r\n            k=3*n-2*A-b\r\n            if j+1 <= 3*n and k>= 0:\r\n                ans = max(ans,2*p[A] + p[j] + 3*p[k])\r\n    print(ans)",
