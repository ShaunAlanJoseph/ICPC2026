  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0])\r\n    pos=1\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(data[pos]);\r\n        pos+=1\r\n        m=3*n\r\n        a=sorted(map(int,data[pos:pos+m]),reverse=True)\r\n        pos+=m\r\n        p=[0]*(m+1)\r\n        for i in range(m):\r\n            p[i+1]=p[i]+a[i]\r\n        best=0\r\n        for k1 in range(n+1):\r\n            base=m-2*k1\r\n            lo,hi=0,n-k1\r\n            while lo<hi:\r\n                mid=(lo+hi)//2\r\n                d=(p[k1+2*mid+2]+3*p[base-mid-1])-(p[k1+2*mid]+3*p[base-mid])\r\n                if d<=0:\r\n                    hi=mid\r\n                else:\r\n                    lo=mid+1\r\n            val=2*p[k1]+p[k1+2*lo]+3*p[base-lo]\r\n            if val>best:\r\n                best=val\r\n                \r\n        out.append(str(best))\r\n    print(\"\\n\".join(out))\r\nmain()",
