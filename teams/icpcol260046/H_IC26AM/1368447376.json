  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    MOD = 998244353\r\n    data=sys.stdin.buffer.read().split()\r\n    N=200005\r\n    inv=[0,1]+[0]*(N-2)\r\n    for i in range(2,N):\r\n        inv[i]=(MOD-MOD//i)*inv[MOD%i]%MOD\r\n    h=[0]*N\r\n    for i in range(1,N):\r\n        h[i]=(h[i-1]+inv[i])%MOD\r\n    t=int(data[0])\r\n    pos=1\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(data[pos]);\r\n        pos+=1\r\n        ans=0\r\n        for j in range(1,n+1):\r\n            a=int(data[pos+j-1])\r\n            ans+=a*(h[n-j]+h[j-1])\r\n        pos+=n\r\n        out.append(str(ans%MOD))\r\n    print(\"\\n\".join(out))\r\nmain()",
