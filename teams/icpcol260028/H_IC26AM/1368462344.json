  "source_code": "# cook your dish here\r\nimport sys\r\n\r\n\r\ndef solve(t):\r\n    mod=998244353\r\n    d=sys.stdin.read().split()\r\n    p=0\r\n    res=[]\r\n    mx=200005\r\n    iv=[0,1]+[0]*(mx-2)\r\n    for i in range(2,mx):\r\n        iv[i]=(mod-(mod//i)*iv[mod%i]%mod)%mod\r\n    h=[0]*mx\r\n    for i in range(1,mx):\r\n        h[i]=(h[i-1]+iv[i])%mod\r\n    for i in range(t):\r\n        n=int(d[p])\r\n        p+=1\r\n        ans=0\r\n        for j in range(1,n+1):\r\n            a=int(d[p+j-1])\r\n            ans=(ans+a*((h[j-1]+h[n-j])%mod))%mod\r\n        p+=n\r\n        res.append(ans)\r\n    for i in res:\r\n        print(i)\r\n    \r\ndef my():\r\n    n=int(sys.stdin.readline())\r\n    solve(n)\r\n\r\n\r\nmy()\r\n        ",
