  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\n#define f(i, m, n)  for(int i = m; i<=n; i++)\r\n#define rep(i, n)   for(int i = 0; i<n; i++)\r\n\r\n#define mod 998244353\r\n\r\nconst int MAXN = 200005;\r\nll invn[MAXN];\r\nll H[MAXN];\r\n\r\nvoid inv_codesniperman(){\r\n    invn[1] = 1;\r\n    f(i, 2, MAXN - 1)   invn[i] = mod - (mod/i)*invn[mod%i]%mod;\r\n    \r\n    H[0] = 0;\r\n    f(i, 1, MAXN-1) H[i] = (H[i-1]+invn[i])%mod;\r\n}\r\n\r\nvoid solve(){\r\n    int n; cin >> n;\r\n    \r\n    ll ans = 0;\r\n    f(i, 1, n){\r\n        ll v; cin >> v;\r\n        ll expected1 = (H[i-1] + H[n-i]) % mod;\r\n        \r\n        ans = (ans + v*expected1)%mod;\r\n    }\r\n    \r\n    cout << ans << \"\\n\";\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(0);\r\n    \r\n    inv_codesniperman();\r\n    \r\n    ll t; cin >> t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    \r\n    return 0;\r\n}\r\n",
