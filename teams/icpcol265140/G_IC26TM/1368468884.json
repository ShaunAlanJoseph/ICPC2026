  "source_code": "# cook your dish here\r\ndef max_teams_strenght(n,strenghts):\r\n    strenghts.sort(reverse=True)\r\n    S=[0]+strenghts\r\n    P=[0]*(3*n+1)\r\n    for i in range(1,3*n+1):\r\n        P[i]=P[i-1]+S[i]\r\n    max_total=0\r\n    for L in range(n+1):\r\n        low=0\r\n        high=L-1\r\n        best_k1=0\r\n        while low<=high:\r\n            mid=(high+low)//2\r\n                \r\n            val= 2* S[mid+1]- S[2*L-mid] -3* S[3*n-L-mid]\r\n            if val>0:\r\n                best_k1=mid+1\r\n                low=mid+1;\r\n            else:\r\n                high=mid-1\r\n                    \r\n        score= 2* P[best_k1]+P[2*L-best_k1]+ 3* P[3*n-L-best_k1]\r\n        if score>max_total:\r\n            max_total=score\r\n    return max_total\r\n        \r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    print(max_teams_strenght(n,a))",
