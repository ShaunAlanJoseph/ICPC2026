  "source_code": "import sys\r\nMOD = 998244353\r\nMAXN = 200005\r\n\r\ninv = [0]*MAXN\r\ninv[1]=1\r\nfor i in range(2,MAXN):\r\n    inv[i] = MOD-(MOD//i)*inv[MOD%i]%MOD\r\n    \r\nH = [0]*MAXN\r\nfor i in range(1, MAXN):\r\n        H[i] = (H[i-1]+inv[i])%MOD\r\ndef solve():\r\n    input_data = sys.stdin.read().split()\r\n    if not input_data:\r\n        return\r\n    t = int(input_data[0])\r\n    idx = 1 \r\n    out = []\r\n    \r\n    for _ in range(t):\r\n        n = int(input_data[idx])\r\n        idx += 1 \r\n        a = list(map(int,input_data[idx:idx+n]))\r\n        idx += n \r\n        ans = 0 \r\n        \r\n        for i in range(n):\r\n            ans = (ans + a [i] * (H[i]+H[n-1-i]))%MOD\r\n        out.append(str(ans))\r\n            \r\n    sys.stdout.write(\"\\n\".join(out)+\"\\n\")\r\nif __name__=='__main__':\r\n    solve()\r\n                \r\n                ",
