  "source_code": "from itertools import accumulate as A \r\nfor _ in range(int(input())):\r\n    n  = int(input()); s=sorted(map(int, input().split()), reverse= True);P=[0]+list(A(s));j=n;r=0\r\n    for i in range(n+1):\r\n        j = min(j, n-i)\r\n        while j and s[i+2*j-2]+s[i+2*j-1] <= 3*s[3*n-2*i-j]:j-=1\r\n        r=max(r, 2*P[i]+P[i+2*j]+3*P[3*n-2*i-j])\r\n    print(r)",
