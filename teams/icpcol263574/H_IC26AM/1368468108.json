  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\n\t// your code goes here\r\n    const int MD = 998244353;\r\n    const int N = 200005;\r\n    int h[N];\r\n    \r\n    int inv(int i){\r\n        return i <= 1 ? 1 :(MD-MD/i)* inv(MD % i) % MD;\r\n        \r\n    \r\n    \r\n}\r\n\r\nint32_t main(){\r\n    for(int i=1;i<N;i++){\r\n        h[i]=(h[i-1]+ inv(i))% MD;\r\n        \r\n    }\r\n    int t;\r\n    if(cin>>t){\r\n        while(t--){\r\n            int n;\r\n            cin>>n;\r\n            \r\n            int ans=0;\r\n            for(int i=0;i<n;i++){\r\n                int v;\r\n                cin>>v;\r\n                ans = (ans + v *(h[i]+h[n-1-i])) % MD;\r\n                \r\n            }\r\n            cout<<ans<<\"\\n\";\r\n        }\r\n    }\r\n    return 0;\r\n}\r\n",
