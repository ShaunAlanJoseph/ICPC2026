  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n#define loop_forward(i,a,b) for(int i =a;i<b;i++)\r\n#define vi vector<int>\r\n#define pb push_back\r\nconst long long MD=998244353;\r\nios::sync_with_stdio(0),cin.tie(0);\r\nconst int LIM=200001;\r\nvi iv, hh;\r\niv.pb(0),iv.pb(1),hh.pb(0),hh.pb(1);\r\nloop_forward(k,2,LIM+1){\r\n    iv.pb((int) ((MD-(MD/k)*iv[MD%k]%MD)%MD));\r\n    hh.pb((int) (((long long)hh[k-1]+iv[k])%MD));\r\n}\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    long long acc=0;\r\n    loop_forward(j,1,n+1){\r\n    long long x;\r\n    cin>>x;\r\n    acc=(acc+x%MD*(((long long)hh[j-1]+hh[n-j])%MD))%MD;\r\n}\r\n    cout<<acc<<\"\\n\";\r\n}\r\n\r\nreturn 0;\r\n\r\n}\r\n\r\n\r\n\r\n\r\n",
