  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nlong long mod=998244353;\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\tvector<vector<long long>>cases(t);\r\n\tint maxi=0;\r\n\tfor(int i=0;i<t;i++){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    maxi=max(maxi,n);\r\n\t    cases[i].resize(n);\r\n\t    for(int j=0;j<n;j++){\r\n\t        cin>>cases[i][j];\r\n\t    }\r\n\t}\r\n\tint m=maxi+1;\r\n    vector<long long>temp(m,1),arr(m,0);\r\n    for(int i=2;i<m;i++){\r\n        temp[i]=(mod-(mod/i)*temp[mod%i]%mod)%mod;\r\n    }\r\n    for(int i=1;i<m;i++){\r\n        arr[i]=(arr[i-1]+temp[i])%mod;\r\n    }\r\n\tfor(auto &a:cases){\r\n\t    int n=a.size();\r\n\t    long long res=0;\r\n\t    for(int j=1;j<=n;j++){\r\n\t        res=(res+a[j-1]%mod*(arr[j-1]+arr[n-j])%mod)%mod;\r\n\t    }\r\n\t    cout<<res<<endl;\r\n\t}\r\n}\r\n",
