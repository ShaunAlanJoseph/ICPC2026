  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nlong long func(int p,int q,int m,vector<long long>&s){\r\n    int u=p+2*q;\r\n    int joy=m-2*p-q;\r\n    return 2*s[p]+s[u]+3*s[joy];\r\n}\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long>a(m);\r\n\t    for(auto &it:a) cin>>it;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long>s(m+1,0);\r\n\t    for(int i=0;i<m;i++){\r\n\t        s[i+1]=s[i]+a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int p=0;p<=n;p++){\r\n\t        int low=0,high=n-p;\r\n\t        while(low<high){\r\n\t            int mid=(low+high)/2;\r\n\t            if(func(p,mid+1,m,s)>func(p,mid,m,s)){\r\n\t                low=mid+1;\r\n\t            }\r\n\t            else{\r\n\t               high=mid;\r\n\t            }\r\n\t        }\r\n\t        ans=max(ans,func(p,low,m,s));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
