  "source_code": "import sys\r\n\r\nMOD = 998244353\r\nMAXN = 200000\r\n\r\ninv = [0] * (MAXN +1)\r\ninv[1] = 1\r\n\r\nfor i in range(2, MAXN + 1):\r\n    inv[i] = MOD - (MOD // i) * inv[MOD % i] %MOD\r\n    \r\nH = [0] * (MAXN + 1)\r\n    \r\nfor i in range(1, MAXN + 1):\r\n  H[i] = (H[i - 1] + inv[i]) % MOD\r\n \r\ndef solve():\r\n  data = list(map(int,\r\nsys.stdin.buffer.read().split()))\r\n  it = iter(data)\r\n  \r\n  t = next(it)\r\n  ans = []\r\n  \r\n  for _ in range(t):\r\n    n = next(it)\r\n    \r\n    a = [next(it) for _ in range(n)]\r\n    \r\n    total = 0\r\n    \r\n    for i in range(n):\r\n        \r\n      coeff = (H[i] + H[n - i - 1]) % MOD\r\n      total = (total + a[i] * coeff) % MOD\r\n      \r\n    ans.append(str(total))\r\n    \r\n  print(\"\\n\".join(ans))\r\n\r\nsolve()",
