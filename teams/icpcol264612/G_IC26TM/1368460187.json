  "source_code": "import sys\r\n\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\n\r\nfor _ in range (t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    \r\n    a.sort(reverse=True)\r\n    \r\n    m= 3 * n\r\n    \r\n    pref = [0] * (m + 1)\r\n    for i in range(m):\r\n        pref[i + 1] = pref[i] + a[i]\r\n        \r\n    def value(A, B):\r\n        j = A + 2 * B\r\n        k = 3 * n - 2 * A - B\r\n        return 2 * pref[A] + pref[j] + 3 * pref[k]\r\n        \r\n    ans = 0\r\n    \r\n    for A in range(n + 1):\r\n        lo, hi = 0, n - A \r\n        \r\n        while lo < hi: \r\n            mid = (lo + hi) // 2\r\n            \r\n            if value (A, mid) <= value(A, mid + 1):\r\n                lo = mid + 1\r\n            else:\r\n                hi = mid\r\n        ans = max(ans, value(A, lo))\r\n    print(ans)\r\n    ",
