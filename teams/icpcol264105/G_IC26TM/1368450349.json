  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        int m=n*3;\r\n        vector<long long>a(m);\r\n        for(auto &X:a)\r\n        {\r\n            cin>>X;\r\n        }\r\n        sort(a.rbegin(),a.rend());\r\n        vector<long long>p(m+1,0);\r\n        for(int i=0;i<m;i++)\r\n        {\r\n            p[i+1]=p[i]+a[i];\r\n        }\r\n        long long ans=0;\r\n        for(int i=0;i<=n;i++)\r\n        {\r\n            auto f=[&](int b)-> long long{\r\n                return 2*p[i]+p[i+2*b]+3*p[m-2*i-b];\r\n            };\r\n            int l=0,h=n-i;\r\n            while(l<h)\r\n            {\r\n                int mid=(l+h)/2;\r\n                if(f(mid+1)-f(mid)>0)\r\n                {\r\n                    l=mid+1;\r\n                }\r\n                else\r\n                {\r\n                    h=mid;\r\n                }\r\n            }\r\n            ans=max(ans,f(l));\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
