  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tconst int N=200005;\r\n\tvector<long long> inv(N+1),H(N+1,0);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=N;i++)\r\n\t{\r\n\t    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tfor(int i=1;i<=N;i++)\r\n\t{\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t}\r\n    int t;\r\n    cin>>t;\r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        long long ans=0;\r\n        for(int j=1;j<=n;j++)\r\n        {\r\n            long long a;\r\n            cin>>a;\r\n            long long w=(H[j-1]+H[n-j])%MOD;\r\n            ans=(ans+a%MOD*w)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
