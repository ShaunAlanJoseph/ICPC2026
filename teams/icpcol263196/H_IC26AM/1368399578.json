  "source_code": "mod=998244353\r\nt=int(input())\r\ntest=[]\r\nmaxn=0\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    test.append((n,a))\r\n    maxn=max(maxn,n)\r\ninv=[0]*(maxn+1)\r\nif maxn>=1:\r\n    inv[1]=1\r\nfor i in range(2,maxn+1):\r\n    inv[i]=mod-(mod//i)*inv[mod%i]%mod\r\nH=[0]*(maxn+1)\r\nfor i in range(1,maxn+1):\r\n    H[i]=(H[i-1]+inv[i])%mod\r\nfor n,a in test:\r\n    ans=0\r\n    for i in range(n):\r\n        cof=(H[i]+H[n-i-1])%mod\r\n        ans=(ans+a[i]*cof)%mod\r\n    print(ans)\r\n",
