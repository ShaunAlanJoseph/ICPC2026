  "source_code": "import sys\r\ninput=sys.stdin.readline\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    pre=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        pre[i+1]=pre[i]+a[i]\r\n    ans=0\r\n    for p in range(n+1):\r\n        l=0\r\n        h=n-p\r\n        while l<h:\r\n            m=(l+h+1)//2\r\n            q=m-1\r\n            j=p+2*q\r\n            k=3*n-2*p-q\r\n            delta=(a[j]+a[j+1]-3*a[k-1])\r\n            if delta>=0:\r\n                l=m\r\n            else:\r\n                h=m-1\r\n        q=l\r\n        j=p+2*q \r\n        k=3*n-2*p-q\r\n        current=(2*pre[p]+pre[j]+3*pre[k])\r\n        ans=max(ans,current)\r\n    print(ans)\r\n        ",
