  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long LL;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m=3*n;\r\n\t    vector<LL> v(m);\r\n\t    \r\n\t    for(auto& x : v){\r\n\t        cin>>x;\r\n\t    }\r\n\t    sort(v.begin(), v.end(), greater<LL>());\r\n\t    vector<LL> P(m+1, 0);\r\n\t    \r\n\t    for(int i=0; i<m; i++){\r\n\t        P[i+1] = P[i] + v[i];\r\n\t    }\r\n\t    LL best = 0;\r\n\t    for(int a =0; a<=n; a++){\r\n\t        auto g = [&](int b) -> LL{\r\n\t            return 2* P[a] + P[a+2*b] + 3* P[m-2*a-b];\r\n\t        };\r\n\t        \r\n\t        int lo = 0, hi = n-a;\r\n\t        \r\n\t        while(lo<hi){\r\n\t            int mid = (lo+hi)/2;\r\n\t            if(g(mid+1) > g(mid)) lo = mid+1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        best = max(best, g(lo));\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n}\r\n",
