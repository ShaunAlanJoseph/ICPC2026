  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    t = int(data[0])\r\n    pos = 1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[pos])\r\n        pos+=1\r\n        s = sorted(map(int,data[pos:pos+3*n]),reverse=True)\r\n        pos+=3*n \r\n        P=[0]*(3*n+1)\r\n        for i in range(3*n):\r\n            P[i+1]=P[i]+s[i]\r\n        best = 0\r\n        for A in range(n+1):\r\n            lo,hi=0,n-A\r\n            while lo<hi:\r\n                mid=(lo+hi)>>1\r\n                d=s[A+2*mid]+s[A+2*mid+1]-3*s[3*n-2*A-mid-1]\r\n                if d>0:\r\n                    lo = mid+1;\r\n                else:\r\n                    hi = mid\r\n            B = lo  \r\n            val = (6*P[A]+4*(P[A+2*B]-P[A])+3*(P[3*n-2*A-B]-P[A+2*B]))\r\n            if val>best:\r\n                best = val\r\n        out.append(best)        \r\n    sys.stdout.write(\"\\n\".join(map(str,out))+\"\\n\")\r\nmain()    \r\n                    \r\n                    \r\n        ",
