  "source_code": "# cook your dish here\r\n\r\nimport sys\r\n\r\nMOD = 998244353\r\n\r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    t = int(data[0])\r\n    idx = 1\r\n    N = 200005\r\n    \r\n    inv = [0, 1] + [0] * (N-2)\r\n    \r\n    for i in range(2, N):\r\n        inv[i] = (MOD - (MOD//i) * inv[MOD%i]%MOD)%MOD\r\n    \r\n    H = [0]*N\r\n    \r\n    for i in range(1, N):\r\n        H[i] = (H[i-1] + inv[i])%MOD\r\n    \r\n    out = []\r\n    \r\n    for _ in range(t):\r\n        n = int(data[idx])\r\n        idx+=1\r\n        \r\n        ans = 0\r\n        \r\n        for j in range(1, n+1):\r\n            ans+= int(data[idx+j-1])*(H[j-1]+ H[n-j])\r\n        \r\n        idx+=n\r\n        \r\n        out.append(ans%MOD)\r\n    \r\n    sys.stdout.write(\"\\n\".join(map(str, out))+\"\\n\")\r\n\r\nmain()\r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        \r\n        ",
