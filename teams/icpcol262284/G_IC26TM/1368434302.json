  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m = 3*n;\r\n\t    vector<long long>a(m);\r\n\t    for(int i=0; i<m; i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    sort(a.rbegin(), a.rend());\r\n\t    vector<long long>pref(m+1,0);\r\n\t    for(int i=0; i<m; i++){\r\n\t        pref[i+1]=pref[i]+a[i];\r\n\t    }\r\n\t    long long ans = LLONG_MIN;\r\n\t    for(int x=0; x<=n; x++){\r\n\t        int rem = n-x;\r\n\t        int io=0,hi=rem;\r\n\t        while(io<hi){\r\n\t            int mid=io+(hi-io)/2;\r\n\t            int p = x+2*mid;\r\n\t            int l=3*n-2*x-mid-1;\r\n\t            long long c=a[p]+a[p+1]-3LL * a[l];\r\n\t            if(c<0){\r\n\t                hi = mid;\r\n\t            }\r\n\t            else{\r\n\t                io=mid+1;\r\n\t            }\r\n\t        }\r\n\t        int y=io;\r\n\t        long long curr = 2LL*pref[x]+pref[x+2*y]+3LL*pref[3*n-2*x-y];\r\n\t        ans = max(ans,curr);\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t    \r\n\t}\r\n\r\n}\r\n",
