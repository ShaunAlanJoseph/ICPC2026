  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tconst long long mod=998244353;\r\n\tconst int mnp=200000;\r\n\tvector<long long> ult(mnp+1),xs(mnp+1);\r\n\t\r\n\tult[1]=1;\r\n\t\r\n\tfor(int i=1;i<=mnp;i++){\r\n\t    if(i>1) ult[i]=mod-(mod/i) * ult[mod%i] % mod ;\r\n\t    xs[i]=(xs[i-1]+ult[i]) % mod;\r\n\t}\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    long long res=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long sde;\r\n\t        cin>>sde;\r\n\t        res=(res+sde*((xs[i-1]+xs[n-i])%mod)) % mod;\r\n\t    }\r\n\t    cout<<res<<endl;\r\n\t}\r\n\t\r\n\t\r\n\r\n}\r\n",
