  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int sz=3*n;\r\n\t    vector<long long>kri(sz+1),dev(sz+1);\r\n\t    \r\n\t    for(int i=1;i<=sz;i++){\r\n\t        cin>>kri[i];\r\n\t    }\r\n\t    \r\n\t    sort(kri.begin()+1,kri.end(),greater<long long>());\r\n\t    \r\n\t    for(int i=1;i<=sz;i++){\r\n\t        dev[i]=dev[i-1]+kri[i];\r\n\t    }\r\n\t    \r\n\t    long long res=0;\r\n\t    \r\n\t    for(int i=0;i<=n;i++){\r\n\t        int l=0,r=n-i;\r\n\t        while(l<r){\r\n\t            int mnp=(l+r)/2;\r\n\t            long long dp=kri[i+2*mnp + 1] + kri[i+2 * mnp + 2] - 3*kri[sz-2 * i - mnp];\r\n\t            if(dp>0){\r\n\t                l=mnp+1;\r\n\t            } else{\r\n\t                r=mnp;\r\n\t            }\r\n\t        }\r\n\t        long long adv=2*dev[i]+ dev[i+2*l] + 3*dev[sz-2*i-l];\r\n\t        res=max(res,adv);\r\n\t    }\r\n\t    cout<<res<<endl;\r\n\t}\r\n\t\r\n\t\r\n}\r\n",
