  "source_code": "import sys\r\nMOD = 998244353\r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    LIM = 200001\r\n    inv = [0, 1] + [0] * (LIM - 1)\r\n    for i in range(2, LIM + 1):\r\n        inv[i] = (MOD - (MOD // i) * inv[MOD % i] % MOD) % MOD\r\n    H = [0] * (LIM + 1)\r\n    for i in range(1, LIM + 1):\r\n        H[i] = (H[i - 1] + inv[i]) % MOD\r\n    p = 0 \r\n    t = int(data[p]); p += 1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[p]); p += 1\r\n        total = 0 \r\n        for j in range(1, n + 1):\r\n            v = int(data[p + j -1])\r\n            total += v * (H[j - 1] + H[n - j])\r\n        p += n \r\n        out.append(str(total % MOD))\r\n    print(\"\\n\".join(out))\r\nmain()\r\n        ",
