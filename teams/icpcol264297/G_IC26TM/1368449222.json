  "source_code": "import sys \r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    p = 0\r\n    t = int(data[p]); p += 1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[p]); p += 1\r\n        s = sorted(map(int, data[p:p + 3 * n]), reverse = True)\r\n        p += 3 * n \r\n        pref = [0] * (3 * n + 1)\r\n        for i in range(3 * n):\r\n            pref[i + 1] = pref[i] + s[i]\r\n        best = 0\r\n        b = n \r\n        for a in range(n + 1):\r\n            if b > n - a:\r\n                b = n - a\r\n            while b > 0 and s[a + 2 * b - 2] + s[a + 2 * b - 1] - 3 * s[3 * n - 2 * a - b] <= 0:\r\n                b -= 1\r\n            val = 2 * pref[a] + pref[a + 2 * b] + 3 * pref[3 * n - 2 * a - b]\r\n            if val > best:\r\n                best = val \r\n        out.append(str(best))\r\n    print(\"\\n\".join(out))\r\nmain()",
