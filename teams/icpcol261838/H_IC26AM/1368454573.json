  "source_code": "import sys\r\nMOD = 998244353\r\ninput = sys.stdin.buffer.readline\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    inv = [0] * (n + 1)\r\n    if n:\r\n        inv [1] = 1\r\n        for i in range(2, n + 1):\r\n            inv[i] = MOD - (MOD // i) * inv[MOD % i] % MOD\r\n    h = [0] * (n + 1)\r\n    for i in range(1, n + 1):\r\n        h[i] = (h[i - 1] + inv[i]) % MOD\r\n    ans = 0\r\n    for i, x in enumerate(a):\r\n        ans = (ans + x * (h[i] + h[n - i -1])) % MOD\r\n    print(ans)",
