  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<long long>a(3*n);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++)\r\n\t    {\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    vector<long long> p(3*n+1,0);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++)\r\n\t    {\r\n\t        p[i+1] = p[i] + a[i];\r\n\t    }\r\n\t    \r\n\t    long long ans = 0;\r\n\t    \r\n\t   for(int d=0;d<=n;d++)\r\n\t   {\r\n\t       int left = 0;\r\n\t       int right = d;\r\n\t       \r\n\t       while(left<right)\r\n\t       {\r\n\t           int mid = (left + right)/2;\r\n\t           \r\n\t           long long v1 = 2*p[mid] + p[2*d-mid] + 3*p[3*n-mid-d];\r\n\t           long long v2 = 2*p[mid + 1] + p[2*d-mid-1] + 3*p[3*n-mid-1-d];\r\n\t           \r\n\t           if(v1<=v2)left = mid +1;\r\n\t           else right = mid;\r\n\t       }\r\n\t       \r\n\t       long long cur = 2*p[left] + p[2*d-left] + 3*p[3*n-left-d];\r\n\t       \r\n\t       ans = max(ans,cur);\r\n\t   }\r\n\t   cout<<ans<<endl;\r\n\t    \r\n\t}\r\nreturn 0;\r\n}\r\n",
