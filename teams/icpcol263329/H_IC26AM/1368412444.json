  "source_code": "# cook your dish here\r\nimport sys\r\nMOD = 998244353\r\nMAXN = 200001\r\n\r\na= [0,1] + [0] * (MAXN - 1)\r\nfor i in range(2,MAXN +1):\r\n    a[i] = (MOD - (MOD // i )*a[MOD%i] %MOD)%MOD\r\nh = [0] * (MAXN + 1)\r\nfor i in range(1,MAXN +1):\r\n    h[i] = (h[i-1] + a[i]) % MOD\r\ndef main():\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0]); ix = 1\r\n    o = []\r\n    for _ in range(t):\r\n        n = int(d[ix]); ix += 1\r\n        res = 0\r\n        for j in range(n):\r\n            res += int(d[ix+j]) * (h[j] + h[n-1-j])\r\n        ix += n\r\n        o.append(res % MOD)\r\n    print(\"\\n\".join(map(str,o)))\r\nmain()",
