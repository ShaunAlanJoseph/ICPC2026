  "source_code": "# cook your dish here\r\nimport sys \r\ndef main():\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0]); ix =1\r\n    o =[]\r\n    for _ in range(t):\r\n        n = int(d[ix]); ix +=1\r\n        s= sorted(map(int,d[ix:ix+3*n]),reverse = True)\r\n        ix += 3*n\r\n        p =[0]*(3*n+1)\r\n        for i in range(3*n):\r\n            p[i+1] = p[i] + s[i]\r\n        be =0\r\n        m=n\r\n        for a in range(n+1):\r\n            m = min(m, n-a)\r\n            while m>0 and not (s[a + 2*(m-1)] +s[a+2*(m-1)+1] > 3 * s[3*n-2*a - (m-1)-1]):\r\n                m -= 1\r\n            value = 2* p[a]+p[a+2*m]+3 * p[3*n -2*a-m]\r\n            if value> be:\r\n                be = value\r\n        o.append(be)\r\n    print(\"\\n\".join(map(str,o)))\r\nmain()\r\n                \r\n",
