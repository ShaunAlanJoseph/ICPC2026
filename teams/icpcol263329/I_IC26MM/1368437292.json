  "source_code": "# cook your dish here\r\nimport sys\r\nMOD = 998244353\r\ndef s1(n,a):\r\n    ru = [[]for _ in range(n)]\r\n    for i in range(1,n + 1):\r\n        v = a[i -1]\r\n        q,t = (i + 1) // 2, (n-i+2) // 2\r\n        cp,c = q + n - i , i - 1 + t\r\n        if v > cp and v > c:\r\n            return 0\r\n        ru[v - 1].append((v,q,cp,t,c))\r\n    def ok(T,l,step):\r\n        r = T - l\r\n        for v,q,cp,t,c in ru[T]:\r\n            if not (( v < cp and step == 'L' and l == q - 1) or (v == cp and l <= q - 1) or (v < c and step == 'R'and r == t - 1)or (v == c and r <= t - 1)):\r\n                return False\r\n        return True\r\n        \r\n    dp = [1] + [0] * n\r\n    for T in range(n - 1):\r\n        new = [0] * (n + 1)\r\n        for l in range(T+1):\r\n            if dp[l]:\r\n                if ok(T,l,'L'):new[l+1] = (new[l + 1]+dp[l])% MOD\r\n                if ok(T,l,'R'):new[l] = (new[l]+dp[l])% MOD\r\n        dp = new\r\n    return sum(dp[l] for l in range(n) if ok(n-1,l,None)) % MOD\r\nd = sys.stdin.buffer.read().split()\r\nt,p,o = int(d[0]),1,[]\r\nfor _ in range(t):\r\n    n = int(d[p]); a = list(map(int,d[p+1:p+1+n])); p += n + 1\r\n    o.append(s1(n,a))\r\nprint(\"\\n\".join(map(str,o)))",
