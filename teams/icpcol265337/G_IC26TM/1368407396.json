  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        int n;\r\n        cin >> n;\r\n        int m = 3 * n;\r\n        vector < long long > a(m + 1), s(m + 1, 0);\r\n        for (int i = 1; i <= m; i++) cin >> a[i];\r\n        sort(a.begin() + 1, a.end(), greater < long long > ());\r\n        for (int i = 1; i <= m; i++) s[i] = s[i - 1] + a[i];\r\n        long long ans = 0;\r\n        for (int i = 0; i <= n; i++) {\r\n            int lef = 0, right = n - i;\r\n            while (lef < right) {\r\n                int mid = lef + (right - lef) / 2;\r\n                long long temp = a[i + 2 * mid + 1] + a[i + 2 * mid + 2] - 3 * a[m - 2 * i - mid];\r\n                if (temp > 0) lef = mid + 1;\r\n                else right = mid;\r\n            }\r\n            long long curr = 2 * s[i] + s[i + 2 * lef] + 3 * s[m - 2 * i - lef];\r\n            ans = max(ans, curr);\r\n        }\r\n        \r\n        cout << ans << endl;\r\n    }\r\n}",
