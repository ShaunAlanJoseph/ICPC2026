  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nconst ll MOD = 998244353;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    \r\n    vector<ll> inverse(200001);\r\n    inverse[1] = 1;\r\n    for(int i = 2; i <= 200000; i++){\r\n        inverse[i] = MOD - (MOD / i) * inverse[MOD % i] % MOD;\r\n    }\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        \r\n        vector<ll> p(n+1, 0);\r\n        for(int i = 1; i <= n; i++){\r\n            ll temp;\r\n            cin >> temp;\r\n            \r\n            p[i] = (p[i-1] + temp) % MOD;\r\n        }\r\n        \r\n        ll ans = 0;\r\n        for(int x = 1; x < n; x++){\r\n            ll sum = (p[n - x] + p[n] - p[x] + MOD) % MOD;\r\n            ans = (ans + sum * inverse[x]) % MOD;\r\n        }\r\n        \r\n        cout << ans << \"\\n\";\r\n    }\r\n}\r\n",
