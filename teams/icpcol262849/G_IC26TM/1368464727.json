  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long \r\n\r\n\r\n\r\nvoid solve (){ \r\n    int n;cin>>n ; \r\n    vector<int> v(3*n,0);\r\n    for(int i =0;i<3*n;i++)cin>>v[i];\r\n    sort(v.rbegin(),v.rend());\r\n    vector<int> p(3*n+1,0);\r\n    for(int i = 0;i<3*n;i++){\r\n        p[i+1]=p[i]+v[i];\r\n    }\r\n    vector<int> ans(3*n+1,0);\r\n    int ans_max = 0 ;\r\n    for(int i = 0;i<=n;i++){\r\n        int lo = 0 ; int hi = i-1;\r\n        int  b = i+1;\r\n        while(lo<=hi){\r\n            int mid = lo+(hi-lo)/2;\r\n            int diff = 2LL*v[mid]-v[2LL*i-mid-1]-3LL*v[3LL*n-i-mid-1LL];\r\n            if(diff<=0){\r\n                b = mid ;\r\n                hi = mid-1;\r\n            }\r\n            else{\r\n                lo = mid+1;\r\n            }\r\n        }\r\n        for(int j = max(0LL,(b-2));j<=min(b+2,i);j++){\r\n            int mt = 2LL*p[j]+p[2LL*i-j]+3*p[3LL*n-i-j];\r\n            ans_max=max(mt,ans_max);\r\n        }\r\n    }\r\n    cout<<ans_max<<endl;\r\n}    \r\nsigned main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;cin>>t; \r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n}\r\n",
