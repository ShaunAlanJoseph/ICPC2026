  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\n/*richyrik*/\r\nvoid solve(){\r\n    ll n;\r\n    cin>>n;\r\n    vector<ll> a(3*n);\r\n    for(ll i=0;i<3*n;i++)cin>>a[i];\r\n    sort(a.begin(),a.end());\r\n    reverse(a.begin(),a.end());\r\n    vector<ll> permute(3*n+1);\r\n    for(int i=0;i<3*n;i++)permute[i+1]=permute[i]+a[i];\r\n    long long z=0;\r\n    for(int i=0;i<=2*n;i++){\r\n        int j=max(0ll,i-n);\r\n        int r=i/2;\r\n        auto f=[&](int x){\r\n            int y=2*i-3*x;\r\n            int k=3*n-i;\r\n            \r\n            return 2*permute[x]+permute[y]+3*permute[k];\r\n        };\r\n        while(j<r){\r\n            int mid=(j+r)/2;\r\n            if(f(mid)<=f(mid+1))j=mid+1;\r\n            else r=mid;\r\n        }\r\n        z=max(z,f(j));\r\n    }\r\n    \r\n    cout<<z<<'\\n';\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    ll t=0;\r\n    cin>>t;\r\n    while(t--)solve();\r\n}\r\n",
