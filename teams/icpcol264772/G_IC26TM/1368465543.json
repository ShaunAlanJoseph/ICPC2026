  "source_code": "# cook your dish here\r\ndef icpc():\r\n    l=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    preference=[0]*(3*l+1)\r\n    for i in range(3*l):\r\n        preference[i+1]=preference[i]+a[i]\r\n    def task(C,D):\r\n        p1=C\r\n        p2=C+2*D\r\n        p3=3*l-2*C-D\r\n        return (6*preference[p1]+4*(preference[p2]-preference[p1])+3*(preference[p3]-preference[p2]))\r\n    answer=0\r\n    for C in range(l+1):\r\n        le=0\r\n        rt=l-C\r\n        while le<rt:\r\n            mid=(le+rt)//2\r\n            if task(C,mid)<=task(C,mid+1):\r\n                le=mid+1\r\n            else:\r\n                rt=mid\r\n        answer=max(answer,task(C,le))\r\n    print(answer)\r\nt=int(input())\r\nfor _ in range(t):\r\n    icpc()",
