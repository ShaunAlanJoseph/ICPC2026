  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tint t;\r\n\tcin>>t;\r\n\tconst int maxn=200000;\r\n\tvector<long long>inv(maxn+1);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=maxn;i++){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t    \r\n\t}\r\n\tvector<long long>h(maxn+1,0);\r\n\tfor(int i=1;i<=maxn;i++){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t}\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long> a(n+1);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long coff=(h[i-1]+h[n-i])%MOD;\r\n\t        ans=(ans+a[i]*coff)%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
