  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\n\t// your code goes here\r\n\tconst long long MOD = 998244353;\r\n\tlong long in[200005];\r\n\tlong long sum[200005];\r\n\t\r\n\tint main(){\r\n\t \r\n\t    int t ;\r\n\t    cin>>t;\r\n\t    in[1] = 1;\r\n\t    sum[0] =0;\r\n\t    for(int i =1;i<=200000;i++){\r\n\t        if(i>1){\r\n\t            in[i]=MOD-(MOD/i)*in[MOD%i]%MOD;\r\n\t            \r\n\t        }\r\n\t        sum[i]=(sum[i-1]+in[i])%MOD;\r\n\t    }\r\n\t    while(t--){\r\n\t       int n;\r\n\t       cin>>n;\r\n\t       long long ans =0;\r\n\t       \r\n\t       for(int i = 0;i<n;i++){\r\n\t           long long x ;\r\n\t           cin>>x;\r\n\t           long long count = (sum[i]+sum[n-i-1])%MOD;\r\n\t           ans = (ans+x*count)%MOD;\r\n\t           \r\n\t       }\r\n\t       \r\n\t       cout<<ans<<\"\\n\";\r\n\t       \r\n\t       \r\n\t    }\r\n\t    return 0;\r\n\t}\r\n\r\n",
