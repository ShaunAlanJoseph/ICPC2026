  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\nint t;\r\ncin>>t;\r\nwhile(t--)   {\r\n    int n;\r\n    cin>>n;\r\n    int m=3*n;\r\n    vector<long long> a(m);\r\n    for(int i=0;i<m;i++)   {\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector<long long> p(m+1,0);\r\n    for(int i=0;i<m;i++) \r\n    {\r\n        p[i+1]=p[i]+a[i];\r\n        \r\n    }\r\n    auto get=[&](int x,int y)  {\r\n        return 2*p[x]+p[x+2*y]+3*p[3*n-2*x-y];\r\n        \r\n    };\r\n    long long ans=0;\r\n    int y=n;\r\n    for(int x=0;x<=n;x++)   {\r\n        y=min(y,n-x);\r\n        while(y>0 && get(x,y-1)>=get(x,y))   {\r\n            y--;\r\n        }\r\n        ans=max(ans,get(x,y));\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nreturn 0;\r\n}\r\n",
