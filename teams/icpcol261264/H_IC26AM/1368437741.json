  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long mod=998244353;\r\nconst int maxn=200005;\r\nlong long inv[maxn],h[maxn];\r\nint main() {\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<maxn;i++)\r\n\t    inv[i]=(mod-(mod/i)*inv[mod%i]%mod)%mod;\r\n\th[0]=0;\r\n\t    for(int i=1;i<maxn;i++)\r\n\t        h[i]=(h[i-1]+inv[i])%mod;\r\n\t    \r\n\tint t;cin>>t;\r\n\twhile(t--){\r\n\t    int n;cin>>n;\r\n\t    long long ans=0;\r\n\t    for(int j=1;j<=n;j++){\r\n\t        long long a;cin>>a;\r\n\t        long long w=(h[j-1]+h[n-j])%mod;\r\n\t    ans=(ans+a%mod*w)%mod;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\nreturn 0;\r\n}\r\n",
