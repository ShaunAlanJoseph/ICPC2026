  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long>v(m);\r\n\t    for(auto &x:v){cin>>x;}\r\n\t    sort(v.begin(),v.end(),greater<long long>());\r\n\t    vector<long long>p(m+1,0);\r\n\t    for(int i=0;i<m;i++){\r\n\t        p[i+1]=p[i]+v[i];\r\n\t    }\r\n\t    long long best=0;\r\n\t    for(int a=0;a<=n;a++){\r\n\t        auto f=[&](int b)->long long{\r\n\t            int T=m-2*a-b;\r\n\t            return 2*p[a]+p[a+2*b]+3*p[T];\r\n\t        };\r\n\t        int low=0,h1=n-a;\r\n\t        while(low<h1){\r\n\t            int mid=(low+h1+1)/2;\r\n\t            if(f(mid)>f(mid-1)){low=mid;}\r\n\t            else{h1=mid-1;}\r\n\t        }\r\n\t        best=max(best,f(low));\r\n\t    }\r\n\t    cout<<best<<\"\\n\";\r\n\t}\r\nreturn 0;\r\n}\r\n",
