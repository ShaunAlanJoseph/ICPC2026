  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\n\r\nconst int mod = 998244353;\r\nconst int MAXN = 2e5 + 5;\r\nint n; \r\nvector<int> a; \r\nint inv[MAXN], H[MAXN];\r\n\r\nvoid precompute(){\r\n    inv[1] = 1;\r\n    for(int i = 2; i < MAXN; i++){\r\n        inv[i] = (mod - mod / i) * inv[mod%i]%mod; \r\n    }\r\n\r\n    H[0] = 0;\r\n    for(int i = 1; i < MAXN; i++){\r\n        H[i] = (H[i-1] + inv[i]%mod);\r\n    }\r\n}\r\n\r\n\r\nvoid solve(){\r\n    cin >> n; \r\n    a.resize(n);\r\n    for(int i = 0; i < n ; i++){\r\n        cin >> a[i];\r\n    }\r\n    \r\n    int ans = 0; \r\n    for(int i = 0; i < n; i++){\r\n        int coeff = (H[i]+H[n-1-i]) % mod;\r\n        ans = (ans + a[i] * coeff) % mod;\r\n    }\r\n    cout << ans << \"\\n\"; \r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    \r\n    int t; \r\n    t = 1;\r\n    cin >> t;\r\n    precompute();\r\n    \r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n",
