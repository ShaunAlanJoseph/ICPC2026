  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long m=998244353;\r\nconst int n=200001;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tvector<long long>inv(n+1),H(n+1,0) ;\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=n;i++){\r\n\t    inv[i]=(m-(m/i)*inv[m%i]%m)%m;\r\n\t   \r\n\t}\r\n\t\r\n\tfor(int i=1;i<=n;i++){\r\n\t    H[i]=(H[i-1]+inv[i])%m;\r\n\t    \r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--)\r\n\t{\r\n\t    int N;\r\n\t    cin>>N;\r\n\t    \r\n\t    long long ans=0;\r\n\t    for(int j=1;j<=N;j++){\r\n\t        long long a;cin>>a;\r\n\t        ans=(ans+a%m*((H[j-1]+H[N-j]) %m))%m;;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\t\r\n\r\n}\r\n",
