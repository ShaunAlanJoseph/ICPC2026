  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    \r\n\t    std::vector<long long > a(m) ;\r\n\t    \r\n\t    for(int i=0;i<m;i++){\r\n\t        cin>>a[i];\r\n\t        \r\n\t    }\r\n\t    sort(a.begin(),a.end(), greater<long long>());\r\n\t    vector<long long> pref(m+1,0);\r\n\t    \r\n\t    for(int i=0;i<m;i++){\r\n\t        pref[i+1]=pref[i]+a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    \r\n\t    for(int b=0;b<=n;b++){\r\n\t        int maxb=n-b;\r\n\t        \r\n\t        int lo=0;\r\n\t        int hi=maxb;\r\n\t        while(lo<hi){\r\n\t            int mid=(lo+ hi+1)/2;\r\n\t            int B=mid-1;\r\n\t            int q=b+2*B;\r\n\t            int r=3*n-2*b-B;\r\n\t            long long delta=a[q]+a[q+1]-3LL*a[r-1];\r\n\t            \r\n\t            if(delta>=0){\r\n\t                lo=mid;\r\n\t            }else{\r\n\t                hi=mid-1;\r\n\t            }\r\n\t        }\r\n\t        int B=lo;\r\n\t        int q=b+2*B;\r\n\t        int r=3*n-2*b-B;\r\n\t        long long value=2LL*pref[b]+pref[q]+3LL*pref[r];\r\n\t        ans=max(ans,value);\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
