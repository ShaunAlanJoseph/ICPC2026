  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=[]\r\n    while(len(a)<3*n):\r\n        a.extend(map(int,input().split()))\r\n    a.sort(reverse = True)\r\n    pre=[0]\r\n    for i in a:\r\n        pre.append(pre[-1]+i)\r\n    def score(x,y):\r\n        return 2*pre[x]+pre[x+2*y]+3*pre[3*n-2*x-y]\r\n    best=0\r\n    for x in range(n+1):\r\n        low=0\r\n        high=n-x\r\n        while(low<high):\r\n            mid=(low+high)//2\r\n            if(score(x,mid)<score(x,mid+1)):\r\n                low=mid+1\r\n            else:\r\n                high=mid\r\n        best=max(best,score(x,low))\r\n    print(best)\r\n    \r\n    ",
