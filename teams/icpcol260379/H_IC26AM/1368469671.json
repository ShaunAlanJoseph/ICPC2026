  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int mod =  998244353;\r\nconst int maxn = 200005;\r\n\r\nint invt[maxn];\r\nint h[maxn];\r\n\r\nvoid pre()\r\n{\r\n    invt[1] = 1;\r\n    \r\n    for(int i=2;i<maxn;i++)\r\n    invt[i] = (mod-mod/i)* invt[mod%i]%mod;\r\n    \r\n    h[0] = 0;\r\n    \r\n    for(int i=1;i<maxn;i++)\r\n    h[i] = (h[i-1]+invt[i])%mod;\r\n}\r\n\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n\tpre();\r\n\tint t;cin>>t;\r\n\t\r\n\twhile(t--)\r\n\t{\r\n\t    int n;cin>>n;\r\n\t    \r\n\t    int exs = 0;\r\n\t    \r\n\t    for(int i=1;i<=n;i++)\r\n\t    {\r\n\t        int a;\r\n\t        cin>>a;\r\n\t        \r\n\t        int coef = (h[i-1]+h[n-i])%mod;\r\n\t        exs = (exs+a*coef%mod)%mod;\r\n\t    }\r\n\t    cout<<exs<<endl;\r\n\t}\r\n\r\n}\r\n",
