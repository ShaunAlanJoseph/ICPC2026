  "source_code": "# cook your dish here\r\nimport sys\r\nMOD= 998244353\r\n\r\ndef sol():\r\n    input= sys.stdin.readline\r\n    \r\n    t6=int(input())\r\n    tes=[]\r\n    maxi=0\r\n    \r\n    for _ in range(t6):\r\n        n6= int( input())\r\n        a6= list(map(int, input().split()))\r\n        tes.append((n6, a6))\r\n        maxi=max(maxi, n6)\r\n    \r\n    env=[0]*(maxi+1)\r\n    if maxi >=1:\r\n        env[1]=1\r\n    \r\n    for i in range(2, maxi + 1):\r\n        env[i]=MOD - (MOD // i) * env[MOD % i] % MOD\r\n        \r\n    Hi=[0]* maxi\r\n    for i in range(1, maxi):\r\n        Hi[i]= (Hi[i-1] + env[i]) % MOD\r\n        \r\n    for n6, a6 in tes:\r\n        ans6=0\r\n    \r\n        for i in range(n6):\r\n            coff=(Hi[i]+Hi[n6-1-i]) % MOD\r\n            ans6=(ans6 + a6[i]* coff) % MOD\r\n        print(ans6)\r\n        \r\nif __name__==\"__main__\":\r\n    sol()\r\n    \r\n    \r\n    \r\n    \r\n        ",
