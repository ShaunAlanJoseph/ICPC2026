  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD=998244353;\r\nconst int N=200005;\r\nll inv[N],H[N];\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<N;i++)\r\n\t{\r\n\t    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tH[0]=0;\r\n\tfor(int i=1;i<N;i++)\r\n\t{\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll a;\r\n\t        cin>>a;\r\n\t        ll c=(H[n-i]+H[i-1])%MOD;\r\n\t        ans=(ans+a%MOD*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
