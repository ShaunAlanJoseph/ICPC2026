  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll mod = 998244353;\r\nconst int N = 200000;\r\n\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    vector<ll>inv(N+1) , pre(N+1,0);\r\n    inv[1] = 1;\r\n    for(int i=2;i<=N;i++){\r\n        inv[i] = mod - (mod/i)*inv[mod%i] % mod;\r\n    }\r\n    for(int i=1;i<=N;i++){\r\n        pre[i] = (pre[i-1] + inv[i] ) % mod;\r\n    }\r\n    \r\n    while (t--) {\r\n        int n;\r\n        cin>>n;\r\n        ll ans = 0;\r\n        for(int i=1;i<=n;i++){\r\n            ll x;\r\n            cin>>x;\r\n            ll curr = (pre[i-1] + pre[n-i]) % mod;\r\n            ans = (ans + x*curr) % mod;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}",
