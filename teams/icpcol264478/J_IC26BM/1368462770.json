  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() {\r\n    // your code goes here\r\n    int t;\r\n    cin >> t;\r\n    string types[4] = {\"00\",\"01\",\"10\",\"11\"};\r\n    while (t--) {\r\n        ll cnt[4];\r\n        for (int i = 0; i < 4; i++) cin >> cnt[i];\r\n        string ans;\r\n        bool pos = false;\r\n        for(int i=0;i<4;i++){\r\n            if(!cnt[i]) continue;\r\n            ll a = cnt[0] , b = cnt[1] , c = cnt[2] , d = cnt[3];\r\n            if(i==0) a--;\r\n            else if(i==1) b--;\r\n            else if(i==2) c--;\r\n            else d--;\r\n            ll x = min(a,b+d);\r\n            ll u = min(x,d);\r\n            d-=u;\r\n            b-=(x-u);\r\n            ll y = min(b,(b+d)/2);\r\n            ll z = b+d-2*y;\r\n            string s(a+c+x , '0');\r\n            for(int j=0;j<y;j++){\r\n                s+=\"01\";\r\n            }\r\n            s+=string(z,'1');\r\n            s+=types[i];\r\n            if(!pos || s<ans){\r\n                ans = s;\r\n                pos = true;\r\n            }\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}",
