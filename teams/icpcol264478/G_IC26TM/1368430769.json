  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nll find(int i,int j,int n,vector<ll>&pre){\r\n    int k = n - i - j;\r\n    ll f_seg = 6LL*pre[i];\r\n    ll s_seg = 4LL* (pre[i+2*j] - pre[i]);\r\n    ll t_seg = 3LL* (pre[i+2*j+3*k] - pre[i+2*j]);\r\n    return f_seg + s_seg + t_seg;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    ll n;\r\n\t    cin>>n;\r\n\t    ll m = 3*n;\r\n\t    vector<ll>a(m);\r\n\t    for(int i=0;i<m;i++) cin>>a[i];\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    ll ans = 0;\r\n\t    vector<ll>pre(m+1,0);\r\n\t    for(int i=0;i<m;i++){\r\n\t        pre[i+1] = pre[i]+a[i];\r\n\t    }\r\n\t    for(int i=0;i<=n;i++){\r\n\t        int l = 0 , h = n - i;\r\n\t        while(l<h){\r\n\t            int mid = l + (h-l)/2;\r\n\t            if(find(i,mid+1,n,pre) > find(i,mid,n,pre)){\r\n\t                l = mid + 1;\r\n\t            }\r\n\t            else h = mid;\r\n\t        }\r\n\t        ans = max(ans , find(i,l,n,pre));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
