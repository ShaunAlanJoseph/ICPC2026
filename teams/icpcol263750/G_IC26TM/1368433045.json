  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int total = 3*n;\r\n\t    vector<ll> a(total);\r\n\t    for(int i =0;i<total;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    vector<ll> pref(total+1,0);\r\n\t    for(int i =0;i<total;i++){\r\n\t        pref[i+1] = pref[i] + a[i];\r\n\t    }\r\n\t    ll answer = 0;\r\n\t    for(int x =0;x<= n;x++){\r\n\t        int left =0;\r\n\t        int right = n-x;\r\n\t        while(left<right){\r\n\t            int y= (left+right+1)/2;\r\n\t            int start = x +2*(y-1);\r\n\t            int last = total - 2*x -y;\r\n\t            \r\n\t            ll gain = a[start] + a[start +1] - 3LL*a[last];\r\n\t            if(gain >= 0) left =y;\r\n\t            else right = y-1;\r\n\t        }\r\n\t        int y = left;\r\n\t        \r\n\t        ll current = 6LL* pref[x];\r\n\t        \r\n\t        current += 4LL * (pref[x+2*y] - pref[x]);\r\n\t        current += 3LL * (pref[total - 2*x-y] - pref[x+2*y]);\r\n\t        \r\n\t        answer = max(answer,current);\r\n\t        \r\n\t    }\r\n\t    cout<<answer<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
