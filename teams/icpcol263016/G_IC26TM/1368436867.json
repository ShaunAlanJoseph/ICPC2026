  "source_code": "# cook your dish here\r\nimport sys\r\ninp=sys.stdin.readline\r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    p=[0]\r\n    for x in a:p.append(p[-1]+x)\r\n    ans=0\r\n    for A in range(n+1):\r\n        l,r=0,n-A\r\n        while l<r:\r\n            B=(l+r)//2\r\n            f=lambda b:2*p[A]+p[A+2*b]+3*p[3*n-2*A-b]\r\n            if f(B)<=f(B+1):l=B+1 \r\n            else:\r\n                r=B \r\n        ans=max(ans,2*p[A]+p[A+2*l]+3*p[3*n-2*A-l])\r\n    print(ans)",
