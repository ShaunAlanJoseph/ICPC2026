  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nll M=998244353;\r\nll pow(ll a, ll b){\r\n    ll r=1;\r\n    while(b){\r\n        if(b&1==1) r=r*a%M;\r\n        a=a*a%M;\r\n        b>>=1;\r\n    }\r\n    return r;\r\n}\r\nll inv(ll x){\r\n    return pow(x,M-2);\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<ll>a(n);\r\n        for(int i=0; i<n; i++) cin>>a[i];\r\n        vector<ll>h(n+1,0);\r\n        for(int i=1; i<n; i++){\r\n            h[i]=h[i-1]+inv(i);\r\n            h[i]%=M;\r\n        }\r\n        int ans=0;\r\n        for(int i=0; i<n; i++){\r\n            int temp=h[i]+h[n-i-1];\r\n            temp%=M;\r\n            ans+=a[i]*temp%M;\r\n            ans%=M;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
