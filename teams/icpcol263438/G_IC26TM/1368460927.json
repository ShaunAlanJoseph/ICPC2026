  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint n; vector<ll>p ;\r\nll calc(int a , int b){\r\n    return 2*p[a]+p[a+2*b]+3*p[3*n-2*a-b];\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    vector<ll> v(3*n);\r\n\t    for(auto & x:v){\r\n\t        cin>>x;\r\n\t    }\r\n\t    \r\n\t    sort(v.rbegin(),v.rend());\r\n\t    p.assign(3*n+1,0);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++){\r\n\t        p[i+1] = p[i]+v[i];\r\n\t    }\r\n\t    \r\n\t    ll ans =0;\r\n\t    for(int a =0;a<=n;a++){\r\n\t        int lo = 0, hi =n-a;\r\n\t        while(lo<hi){\r\n\t            int mid = lo+(hi-lo)/2;\r\n\t            if(calc(a,mid+1)>calc(a,mid))lo =mid+1;\r\n\t            else hi =mid;\r\n\t        }\r\n\t        \r\n\t        ans = max(ans,calc(a,lo));\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<\"\\n\";\r\n\t    \r\n\t    \r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
