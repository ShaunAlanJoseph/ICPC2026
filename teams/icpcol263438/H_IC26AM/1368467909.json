  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nconst int N =200005;\r\nll inv[N],h[N];\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\tinv[1] = 1;\r\n\tfor(int i=2;i<N;i++) inv[i] = (MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\th[0] =0;\r\n\tfor(int i=1;i<N;i++)h[i] = (h[i-1]+inv[i])%MOD;\r\n\t\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans =0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll x ; cin>>x;\r\n\t        ll c =(h[i-1] +h[n-i])%MOD;\r\n\t        ans =(ans + x%MOD*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t    \r\n\t    \r\n\t}\r\n\t\r\n\treturn 0;\r\n\r\n}\r\n",
