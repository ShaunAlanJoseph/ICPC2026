  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD= 998244353;\r\n\r\n\r\n\r\nint main() {\r\n    const int n= 200005;\r\n    vector<long long>inv(n), H(n);\r\n    inv[1]= 1;\r\n    for(int i= 2; i<n; i++) inv[i]= (MOD - (MOD/i) * inv[MOD%i]%MOD)%MOD;\r\n    \r\n    H[0]= 0;\r\n    for(int i= 1; i<n; i++) H[i]= (H[i-1] + inv[i])%MOD;\r\n    int t;\r\n    scanf(\"%d\", &t);\r\n    while(t--) {\r\n        int n;\r\n        scanf(\"%d\", &n);\r\n        long long ans= 0;\r\n        for(int j= 1; j<=n; j++) {\r\n            long long a;\r\n            scanf(\"%lld\", &a);\r\n            ans= (ans + a%MOD  * ((H[j-1] + H[n-j]) % MOD ) ) % MOD;\r\n        }\r\n        printf(\"%lld\\n\", ans);\r\n    }   \r\n    return 0;\r\n}\r\n",
