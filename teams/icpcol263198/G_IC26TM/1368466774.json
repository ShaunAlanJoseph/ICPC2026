  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n\t// your code goes here f**k it.\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(3*n),p(3*n+1);\r\n\t    for(long long &x :a){\r\n\t        cin>>x;\r\n\t        \r\n\t    }\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    \r\n\t    for (int x=0;x<=n;x++){\r\n\t        int l=0,r=n-x;\r\n\t        auto f=[&](int y){\r\n\t            int u=x+2*y;\r\n\t            int w=3*n-2*x-y;\r\n\t            return 2*p[x]+p[u]+3*p[w];\r\n\t        };\r\n\t        while(l<r){\r\n\t            int m=(l+r)/2;\r\n\t            int u=x+2*m;\r\n\t            int w=3*n-2*x-m;\r\n\t            if(a[u]+a[u+1]>=3*a[w-1]){\r\n\t                l=m+1;\r\n\t            }\r\n\t            else{\r\n\t                r=m;\r\n\t            }\r\n\t        }\r\n\t        ans=max({ans,f(l),l?f(l-1):0LL});\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\t\r\n\treturn 0;\r\n}\r\n",
