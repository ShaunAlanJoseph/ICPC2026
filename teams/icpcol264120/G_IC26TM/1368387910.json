  "source_code": "import sys\r\nfrom itertools import accumulate\r\n\r\ndef main():\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0])\r\n    pos = 1\r\n    out = []\r\n\r\n    for _ in range(t):\r\n        n = int(d[pos])\r\n        m = 3 * n\r\n        a = sorted(map(int, d[pos + 1:pos + 1+ m]), reverse=True)\r\n        pos += 1 + m\r\n        \r\n        S = [0] + list(accumulate(a))\r\n        best = 0\r\n        q = n\r\n        for p in range(n + 1):\r\n            q = min(q, n - p)\r\n            while q > 0 and a[p+2*q-2] + a[p+2*q-1] <= 3 * a[m-2*p-q]:\r\n                q -= 1\r\n            val = 2*S[p] + S[p+2*q] + 3*S[m-2*p-q]\r\n            if val > best: \r\n                best = val\r\n        out.append(best)\r\n            \r\n    print(\"\\n\".join(map(str, out)))\r\n    \r\nmain()",
