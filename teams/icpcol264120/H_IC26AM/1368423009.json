  "source_code": "import sys\r\ndef main():\r\n    M = 998244353\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0]); k = 1\r\n    N = 200001\r\n    inv = [0, 1] + [0] * (N - 1)\r\n    for i in range(2, N + 1):\r\n        inv[i] = (M - (M // i) * inv[M % i] % M) % M \r\n    H = [0] * (N + 1)\r\n    for i in range(1, N + 1):\r\n        H[i] = (H[i - 1] + inv[i]) % M\r\n    o = []\r\n    for _ in range(t):\r\n        n = int(d[k]); k += 1 \r\n        s = 0\r\n        for j in range(1, n + 1):\r\n            s += int(d[k + j - 1]) * (H[n - j] +  H[j - 1])\r\n        k += n \r\n        o.append(s % M)\r\n    print(\"\\n\".join(map(str, o)))\r\n    \r\nmain()",
