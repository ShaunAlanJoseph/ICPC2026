  "source_code": "#include <stdio.h>\r\n#include <stdlib.h>\r\nlong long P[600005];\r\nint arr[600005];\r\nint n;\r\nint cmp(const void*x, const void *y){\r\n    int u = *(const int*)x, v= *(const int *)y;\r\n    return(u<v)-(u>v);\r\n}\r\nlong long V(int a, int b){\r\n    return 2 * P[a]+P[a+2*b] + 3*P[3*n-2*a-b];\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\nint t;\r\nscanf(\"%d\",&t);\r\nwhile(t--){\r\n    scanf(\"%d\",&n );\r\n    int m = 3 * n;\r\n    for(int i=0; i<m; i++)\r\n    scanf(\"%d\", &arr[i]);\r\n    qsort(arr,m, sizeof(int), cmp);\r\n    P[0]=0;\r\n    for(int i=0; i<m; i++)\r\n    P[i+1]=P[i]+arr[i];\r\n    long long ans =0;\r\n     for( int a=0; a<=n; a++) {\r\n         int lo= 0, hi=n-a;\r\n         while(lo<hi){\r\n             int mid=(lo+hi)/2;\r\n             if(V(a, mid +1) > V(a,mid)) lo = mid +1;\r\n             else hi = mid;\r\n         }\r\n         long long v  = V(a,lo);\r\n         if(v>ans) ans = v;\r\n     }\r\n     printf(\"%lld\\n\", ans);\r\n}\r\nreturn 0;\r\n}\r\n\r\n",
