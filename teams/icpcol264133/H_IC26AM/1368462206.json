  "source_code": "#include <stdio.h>\r\n\r\n#define MOD 998244353LL\r\n#define MAXN 200005\r\nlong long inv [MAXN], H[MAXN];\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\ninv[1]=1;\r\nfor(int i = 2; i<MAXN; i++)\r\ninv[i]= (MOD - (MOD/i)*inv[MOD %i]%MOD) %MOD;\r\nH[0] =0;\r\nfor(int i= 1; i<MAXN; i++)\r\nH[i]= (H[i-1]+inv[i])%MOD;\r\nint t;\r\nscanf(\"%d\", &t);\r\nwhile(t--){\r\n    int n;\r\n    scanf(\"%d\",&n);\r\n    long long ans = 0;\r\n    for(int j= 1; j<=n;j++){\r\n        long long a;\r\n        scanf(\"%lld\",&a);\r\n        long long c = (H[j-1]+H[n-j]) %MOD;\r\n        ans = (ans + a %MOD*c)%MOD;\r\n        \r\n    }\r\n    \r\n    printf(\"%lld\\n\",ans);\r\n}\r\nreturn 0;\r\n}\r\n\r\n",
