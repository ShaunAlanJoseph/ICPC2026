  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nlong long int f(int a,int b,vector<long long> &p,int m){\r\n    return 2*p[a] + p[a+2*b] + 3*p[m-2*a-b];\r\n}\r\n\r\nint main() {\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\t\r\n\twhile (t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m = 3*n;\r\n\t    vector<long long> v(m);\r\n\t    for (auto &x:v){\r\n\t        cin>>x;\r\n\t    }\r\n\t    \r\n\t    sort(v.begin(),v.end(),greater<int>());\r\n\t    \r\n\t    vector<long long> p(m+1,0);\r\n\t    for (int i=0;i<m;i++){\r\n\t        p[i+1] = p[i] + v[i];\r\n\t    }\r\n\t    \r\n\t    \r\n\t    long long ans = 0;\r\n\t    \r\n\t    for (int i=0;i<=n;i++){\r\n\t        int l = 0;\r\n\t        int r = n-i;\r\n\t        \r\n\t        while (l<r){\r\n\t            int mid = l + (r-l)/2;\r\n\t            \r\n\t            if (f(i,mid+1,p,m) > f(i,mid,p,m)){\r\n\t                l = mid+1;\r\n\t            }\r\n\t            else{\r\n\t                r=mid;\r\n\t            }\r\n\t        }\r\n\t        \r\n\t        ans = max(ans,f(i,l,p,m));\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n}\r\n",
