  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int md = 998244353;\r\nconst int mx = 200000;\r\n\r\nvector<int64_t> inv, h;\r\n\r\nvoid precompute() {\r\n    inv.assign(mx + 1, 0);\r\n    h.assign(mx + 1, 0);\r\n    inv[1] = 1;\r\n    for (int i = 2; i <= mx; i++) {\r\n        inv[i] = (md - (md / i) * inv[md % i] % md) % md;\r\n    }\r\n    for (int i = 1; i <= mx; i++) {\r\n        h[i] = (h[i - 1] + inv[i]) % md;\r\n    }\r\n}\r\n\r\nint64_t weight(int j, int n) {\r\n    return (h[j - 1] + h[n - j]) % md;\r\n}\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    auto addmod = [](int64_t a, int64_t b) {\r\n        return (a + b) % md;\r\n    };\r\n    int64_t ans = 0;\r\n    for (int j = 1; j <= n; j++) {\r\n        int64_t x;\r\n        cin >> x;\r\n        ans = addmod(ans, x % md * weight(j, n) % md);\r\n    }\r\n    cout << ans << '\\n';\r\n}\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tprecompute();\r\n\tint t;\r\n\tcin >> t;\r\n\twhile (t--) {\r\n\t    solve();\r\n\t}\r\n    return 0;\r\n}\r\n",
