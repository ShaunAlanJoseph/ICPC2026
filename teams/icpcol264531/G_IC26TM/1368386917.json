  "source_code": "# cook your dish here\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    a.sort(reverse = True)\r\n    pre = [0] * (3 * n + 1)\r\n    for i in range(3 * n):\r\n        pre[i + 1] = pre[i] + a[i]\r\n    ans = 0\r\n    for i in range(n + 1):\r\n        lf = 0\r\n        rg = n - 1\r\n        while lf < rg:\r\n            j = (lf + rg) // 2\r\n            pos1 = i + 2 * j    \r\n            pos2 = pos1 + 1 \r\n            ls = 3 * n - 2 * i - j - 1 \r\n            gain = a[pos1] + a[pos2] - 3 * a[ls]\r\n            if gain > 0:\r\n                lf = j + 1 \r\n            else:\r\n                rg = j \r\n        for j in (lf - 1, lf, lf + 1):\r\n            if 0 <= j <= n - i:\r\n                k = n - i - j \r\n                fend = i \r\n                send = i + 2 * j \r\n                tend = send + 3 * k \r\n                sc = 6 * pre[fend] \r\n                sc += 4 * (pre[send] - pre[fend])\r\n                sc += 3 * (pre[tend] - pre[send])\r\n                ans = max(ans, sc)\r\n    print(ans)",
