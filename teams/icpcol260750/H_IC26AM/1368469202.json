  "source_code": "#include <stdio.h>\r\n\r\n#define MOD  998244353\r\nlong long h[200005], inv[200005], a[200005];\r\n\r\nint main() {\r\n    int t,n,i;\r\n    long long ans,coef;\r\n    \r\n    inv[1]=1;\r\n    for(i=2;i<=200000;i++)\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    \r\n    for(i=1;i<=200000;i++)\r\n        h[i]=(h[i-1]+inv[i])%MOD;\r\n        \r\n    scanf(\"%d\",&t);\r\n    \r\n    while(t--) {\r\n        scanf(\"%d\",&n);\r\n        \r\n        for(i=0;i<n;i++)\r\n            scanf(\"%d\",&a[i]);\r\n            \r\n        ans=0;\r\n        \r\n        for(i=0;i<n;i++){\r\n            coef=(h[i]+h[n-i-1])%MOD;\r\n            ans=(ans+a[i]*coef)%MOD;\r\n        }    \r\n        printf(\"%d\\n\",ans);\r\n    }\r\n    return 0;\r\n}\r\n\r\n\r\n",
