  "source_code": "#include <stdio.h>\r\n#include <stdlib.h>\r\n\r\nlong long a[600005],p[600005];\r\n\r\nint cmp(const void*x,const void*y){\r\n    long long A=*(long long*)x,B=*(long long*)y;\r\n    return (A<B)-(A>B);\r\n}\r\n\r\nlong long f(int n,int A,int B){\r\n    int  x=A+2*B,y=3*n-2*A-B;\r\n    return 6*p[A]+4*(p[x]-p[A])+3*(p[y]-p[x]);\r\n}\r\n\r\nint main(){\r\n    int t,n,A,B;\r\n    scanf(\"%d\",&t);\r\n    \r\n    while(t--){\r\n        scanf(\"%d\",&n);\r\n    \r\n    for(int i=0;i<3*n;i++)\r\n       scanf(\"%lld\",&a[i]);\r\n     \r\n     qsort(a,3*n,sizeof(long long),cmp);\r\n     \r\n     p[0]=0;\r\n     for(int i=0;i<3*n;i++)\r\n        p[i+1]=p[i]+a[i];\r\n        \r\n    long long ans=0;\r\n    B=n;\r\n        \r\n    for(A=0;A<=n;A++){\r\n        if(B>n-A) B=n-A;\r\n        \r\n        while(B && f(n,A,B-1)>f(n,A,B))\r\n            B--;\r\n    \r\n    long long v=f(n,A,B);\r\n    if(v>ans) ans=v;\r\n    }\r\n    printf(\"%lld\\n\",ans);\r\n    }\r\n}",
