  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n\tpublic static void main (String[] args) throws java.lang.Exception\r\n\t{\r\n\tScanner sc=new Scanner(System.in);\r\n\tint T=sc.nextInt();\r\n\twhile(T-->0){\r\n\t    int n=sc.nextInt(),m=3*n;\r\n\t    long[]a=new long[m],p=new long[m+1];\r\n\t    for(int i = 0;i<m;i++)a[i]=sc.nextLong();\r\n\t    Arrays.sort(a);\r\n\t    for(int i = 0;i<m;i++)p[i+1]=p[i]+a[m-1-i];\r\n\t    long ans = 0;\r\n\t    for(int A = 0;A<=n;A++){\r\n\t        int lo = 0,hi=n-A;\r\n\t        while(lo<hi){\r\n\t            int B = (lo+hi)/2;\r\n\t            int K = 3*n-2*A-B,J=A+2*B;\r\n\t            long d=-3*a[m-K]+a[m-1-J]+a[m-2-J];\r\n\t            if(d>=0)lo=B+1;else hi = B;\r\n\t            \r\n\t        }\r\n\t    for(int B = Math.max(0,lo-1);B<=Math.min(n-A,lo);B++){\r\n\t        int K = 3*n-2*A-B,J=A+2*B;\r\n\t        ans = Math.max(ans,3*p[K]+p[J]+2*p[A]);\r\n\t    }\r\n\t    }\r\n\t    System.out.println(ans);\r\n\t}\r\n\r\n\t}\r\n}\r\n",
