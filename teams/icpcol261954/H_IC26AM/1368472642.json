  "source_code": "for _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    dp=[0]*(n+1)\r\n    m=998244353\r\n    h=[0]*n\r\n    an=0\r\n    for i in range(1,n):\r\n        h[i]=(h[i-1]+pow(i,m-2,m))%m\r\n    an=0\r\n    for i,x in enumerate (a):\r\n         an+=x*(h[i]+h[n-1-i])\r\n    print(an%m)\r\n",
