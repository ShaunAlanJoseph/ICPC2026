  "source_code": "# cook your dish here\r\nm=998244353\r\ndef f(n,a):\r\n    p=[[]for _ in range(n+1)]\r\n    for i,x in enumerate(a,1):\r\n        if x<1 or x>n:return 0\r\n        p[x]+=[i];\r\n    def v(i,x,t,s):\r\n        l=t+1;r=t+n-x+1\r\n        return x==n-i//2 and r<=i or s==1 and l==(i+1)//2 and i<=r or x==(n+i)//2 and i<=l or s==0 and r==(n+i+1)//2 and l<=i \r\n    d=[1]+[0]*n \r\n    for x in range(1,n):\r\n        q=[0]*(n+1)\r\n        for t in range(x):\r\n            if d[t]:\r\n                if all(v(i,x,t,0)for i in p[x]):q[t]=(q[t]+d[t])%m\r\n                if all(v(i,x,t,1) for i in p[x]):q[t+1]=(q[t+1]+d[t])%m\r\n        d=q\r\n    return sum(d[t]for t in range(n)if all(v(i,n,t,2)for i in p[n]))%m\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    print(f(n,a))\r\n    ",
