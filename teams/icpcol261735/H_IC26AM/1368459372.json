  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\n\r\nll mod = 998244353, mx = 2e5 + 69;\r\nvector<ll> inv(mx), h(mx);\r\n\r\nstruct _{\r\n    _() {\r\n        inv[1] = 1;\r\n        for(ll i = 2; i < mx; i ++) {\r\n            inv[i] = (mod - (mod / i) * inv[mod % i] % mod) % mod;\r\n        }\r\n        h[0] = 0;\r\n        for(ll i = 1; i < mx; i++) {\r\n            h[i] = (h[i - 1] + inv[i]) % mod;\r\n        }\r\n    }\r\n}__;\r\n\r\n\r\nint main() {\r\n    ll t, n, ans;\r\n    cin >> t;\r\n    while(t --) {\r\n        cin >> n;\r\n        ans = 0;\r\n        for(ll i = 1; i <= n; i++) {\r\n            ll x;\r\n            cin >> x;\r\n            ans = (ans + x * ((h[i-1] + h[n - i]) % mod)) % mod;\r\n        }\r\n        cout << ans<<\"\\n\";\r\n    }\r\n}\r\n",
