  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define  ll long long\r\nll v(ll p,ll q,vector<ll>&s,ll n){\r\n    ll x1=p+2*q;\r\n    ll x2=3*n-2*p-q;\r\n    return 6*s[p]+4*(s[x1]-s[p])+3*(s[x2]-s[x1]);\r\n}\r\nvoid solve(){\r\n   ll n;\r\n   cin>>n;\r\n   ll m=3*n;\r\n   vector<ll>a(m);\r\n   for(ll i=0;i<m;i++){\r\n       cin>>a[i];\r\n   }\r\n   sort(a.begin(),a.end());\r\n   reverse(a.begin(),a.end());\r\n   vector<ll>suf(m+1,0);\r\n   for(ll i=0;i<m;i++){\r\n       suf[i+1]=suf[i]+a[i];\r\n   }\r\n   ll ans=0;\r\n   for(ll p=0;p<=n;p++){\r\n       ll l=0;\r\n       ll h=n-p;\r\n       \r\n       while(l<h){\r\n           ll mid=l+(h-l)/2;\r\n           if(v(p,mid+1,suf,n)>v(p,mid,suf,n)){\r\n               l=mid+1;\r\n           }\r\n           else{\r\n               h=mid;\r\n           }\r\n       }\r\n       ans=max(ans,v(p,l,suf,n));\r\n   }\r\n   cout<<ans<<endl;\r\n}\r\nint main() {\r\nll t;\r\ncin>>t;\r\nwhile(t--){\r\n    solve();\r\n}\r\n\r\n}\r\n",
