  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long \r\n\r\nconst int mod = 998244353;\r\nconst int MAXN = 200005;\r\n\r\nll in[MAXN] ;\r\nll h[MAXN];\r\n\r\nvoid precompute() {\r\n    in[1] = 1 ;\r\n    for(int i = 2 ; i < MAXN ; i++){\r\n        in[i] = ((mod - mod / i) * in[mod % i]) % mod ;\r\n    }\r\n    h[0] = 0 ;\r\n    \r\n    for(int i = 1 ; i < MAXN ; i++){\r\n        h[i] = (h[i - 1 ] + in[i]) % mod ;\r\n    }\r\n}\r\n\r\n\r\nvoid solve() {\r\n    int n ;\r\n    cin>> n ;\r\n    \r\n    ll sum = 0 ;\r\n    for(int i = 1 ; i <= n ; i++){\r\n        ll a ;\r\n        cin>> a ;\r\n        \r\n        ll occ = (h[i - 1] + h[n - i]) % mod; \r\n        ll t = (a % mod * occ) % mod ;\r\n        sum = (sum + t) % mod ;\r\n        \r\n    }\r\n    \r\n    cout<< sum <<endl ;\r\n    \r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tprecompute() ;\r\n\t\r\n\tint t ;\r\n\tcin>> t ;\r\n\t\r\n\twhile(t--){\r\n\t    solve() ;\r\n\t}\r\n\t\r\n\t\r\n\r\n}\r\n",
