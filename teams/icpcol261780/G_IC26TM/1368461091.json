  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint n;\r\nvector<long long> prefix;\r\nlong long sol(long long a,long long b){\r\n    long long c1 = 2*prefix[a];\r\n    long long c2 = prefix[a+2*b];\r\n    long long c3 = 3*prefix[3*n-2*a-b];\r\n    return c1+c2+c3;\r\n}\r\n\r\nvoid solve(){\r\n    cin>>n;\r\n    vector<long long> arr(3*n);\r\n    prefix.assign(3*n+1,0);\r\n    for(int i=0;i<3*n;i++)cin>>arr[i];\r\n    sort(arr.rbegin(),arr.rend());\r\n    for(int i=1;i<3*n+1;i++){\r\n        prefix[i]=prefix[i-1]+arr[i-1];\r\n    }\r\n    long long ans = 0;\r\n    for(int i=0;i<=n;i++){\r\n        long long low = 0 , high = n-i;\r\n        while(low<high){\r\n            long long mid = low + (high-low)/2;\r\n            if(sol(i,mid)<=sol(i,mid+1))low=mid+1;\r\n            else high = mid;\r\n        }\r\n        if(ans<sol(i,low))ans=sol(i,low);\r\n    \r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n",
