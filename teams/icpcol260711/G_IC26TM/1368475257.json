  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nll helper(vector<ll>& pre, int n,int k1,int k2){\r\n    int k3=n-k1-k2;\r\n    int p1=k1;\r\n    int p2=k1+ 2*k2;\r\n    int p3=k1+ 2*k2+ 3*k3;\r\n    return 6*pre[p1] +  4*(pre[p2]-pre[p1]) +3*(pre[p3]-pre[p2]);\r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    vector<ll> a(3*n);\r\n\t    for(auto& i:a) cin >> i;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<ll> pre(3*n +1,0);\r\n\t    for(int i=0;i< 3*n;i++) pre[i+1]=pre[i]+a[i];\r\n\t    ll ans=0;\r\n\t    int k2=n;\r\n\t    for(int k1=0;k1<=n;k1++){\r\n\t        if(k2>n-k1)k2=n-k1;\r\n\t        while(k2>0 && helper(pre,n,k1,k2)<=helper(pre,n,k1,k2-1)) k2--;\r\n\t        ans=max(ans,helper(pre,n,k1,k2));\r\n\t        \r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
