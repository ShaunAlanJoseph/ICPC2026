  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n     long long a = 998244353;\r\n     int b= 200005;\r\n     vector<long long> inv (b,0);\r\n     vector<long long>h(b,0);\r\n     inv[1]=1;\r\n     for(int i=2;i<b;i++){\r\n         inv[i]=a-(a/i)*inv[a%i]%a;\r\n     }\r\n      for(int i=1;i<b;i++){\r\n          h[i]=(h[i-1]+inv[i])%a;\r\n      }\r\n      int t;\r\n      cin>>t;\r\n      while(t--){\r\n          int n;\r\n          cin>>n;\r\n          vector<long long>arr(n);\r\n          for(int i=0;i<n;i++){\r\n              cin>>arr[i];\r\n          }\r\n           if(n==1){\r\n               cout<<0<<endl;\r\n               continue;\r\n           }\r\n            long long ans =0 ;\r\n            for(int i=0;i<n;i++){\r\n                long long cef=(h[i]+h[n-1-i])%a;\r\n                long long val = (arr[i]%a+a)%a;\r\n                ans=(ans+val*cef)%a;\r\n            }\r\n             cout<<ans<<endl;\r\n      }\r\n       return 0;\r\n}\r\n",
