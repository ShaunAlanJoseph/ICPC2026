  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n     int t;\r\n     cin>>t;\r\n     while(t--){\r\n          int n;\r\n          cin>>n;\r\n          vector<int>a(3*n);\r\n          for(int i=0;i<3*n;i++)\r\n              cin>>a[i];\r\n     sort(a.rbegin(), a.rend());\r\n     vector<long long> p(3*n+1, 0);\r\n     for(int i=0; i<3*n; i++){\r\n         p[i+1] = p[i] + a[i];\r\n     }\r\n     auto calc = [&](int i, int m){\r\n         return 2*p[i] + p[i+2*m] + 3*p[3*n-2*i-m];\r\n     };\r\n     long long anss = 0;\r\n     for(int i=0; i<=n; i++){\r\n         int l =0, r=n-i;\r\n         while(r-l>2){\r\n             int m1 = l+(r-l)/3;\r\n             int m2 = r-(r-l)/3;\r\n             if(calc(i,m1) < calc(i, m2)){\r\n                 l = m1;\r\n             }else{\r\n                 r = m2;\r\n             }\r\n         }\r\n         for(int m=l; m<=r; m++){\r\n             anss = max(anss, calc(i, m));\r\n         }\r\n     }\r\n         cout<< anss<< endl;\r\n     }\r\n      return 0;\r\n}\r\n",
