  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tconst int MOD=998244353;\r\n\tvector<long long>Hor(200006,0);\r\n\tvector<long long>pro(200006,0);\r\n\tpro[1]=1;\r\n\tfor(int i=2;i<=200005;i++){\r\n\t    pro[i]=((MOD-MOD/i)*pro[MOD%i])%MOD;\r\n\t}\r\n\tfor(int i=1;i<=200005;i++){\r\n\t    Hor[i]=(Hor[i-1]+pro[i])%MOD;\r\n\t    \r\n\t}\r\n\t\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<long long>a(n);\r\n        for(int i=0;i<n;i++){\r\n            cin>>a[i];\r\n        }\r\n        long long ans=0;\r\n        for(int k=1;k<=n;k++){\r\n            long long coeff=(Hor[k-1]+Hor[n-k])%MOD;\r\n            long long cont=(a[k-1]%MOD*coeff)%MOD;\r\n            ans=(ans+cont)%MOD;\r\n            \r\n        }\r\n        cout<<(ans+MOD)%MOD<<\"\\n\";\r\n    }\r\n}\r\n",
