  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    vector<ll> s(3*n);\r\n\t    for(int i =0;i<s.size();i++){\r\n\t        cin >> s[i];\r\n\t    }\r\n\t    sort(s.rbegin(),s.rend());\r\n\t    vector<ll> p(3*n+1,0);\r\n\t    for(int i =0;i < 3*n;i++){\r\n\t        p[i+1] = p[i] + s[i];\r\n\t    }\r\n\t    auto f =[&](ll a,ll b){\r\n\t        return 6*p[a] +4*(p[a+2*b] - p[a]) + 3*(p[3*n-2*a-b]- p[a+2*b]);\r\n\t    };\r\n\t    ll best = 0;\r\n\t    for(int a =0;a <= n;a++){\r\n\t        int lo =0,hi =n-a;\r\n\t        while(lo < hi){\r\n\t            int m = (lo +hi)/2;\r\n\t            if(f(a,m+1) > f(a,m)){\r\n\t                lo = m+1;\r\n\t            }else{\r\n\t                hi = m;\r\n\t            }\r\n\t        }\r\n\t        best = max(best,f(a,lo));\r\n\t    }\r\n\t    cout << best <<'\\n';\r\n\t}\r\n\r\n}\r\n",
