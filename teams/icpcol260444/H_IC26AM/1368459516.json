  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nconst int MOD= 998244353;\r\nconst int MAXM=200005;\r\nlong long inv[MAXM];\r\nlong long ar[MAXM];\r\n\r\n\r\n\r\nvoid compute(){\r\n    inv[1]=1;\r\n    for(int i=2;i<MAXM;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD % i]% MOD;\r\n    }\r\n        ar[0]=0;\r\n        for(int i=1;i<MAXM;i++){\r\n            ar[i]=(ar[i-1]+inv[i])%MOD;\r\n        }\r\n}\r\nvoid solve(){\r\n      int n;\r\n      cin>>n;\r\n      long long ans=0;\r\n      for(int i=1;i<=n;i++){\r\n          long long x;\r\n          cin>>x;\r\n          long long coef=(ar[i-1]+ar[n-i])%MOD;\r\n          ans=(ans+x*coef)%MOD;\r\n      }\r\n      cout<<ans<<endl;\r\n    }\r\nint main() {\r\n\t// your code goes here\r\n\t//courtesy of yash,ritik\r\n\tcompute();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
