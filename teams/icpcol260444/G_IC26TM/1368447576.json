  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll=long long;\r\nll getval(const vector<ll>&vec,int n,int m,int x){\r\n    return 2ll*vec[x]+vec[2*m-x]+3ll *vec[3*n-m-x];\r\n}\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int tot=3*n;\r\n    vector<ll>a(tot);\r\n    for(int i=0;i<tot;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector<ll>vec(tot+1,0);\r\n    for(int i=0;i<tot;i++){\r\n        vec[i+1]=vec[i]+a[i];\r\n    }\r\n    ll ans=0;\r\n    for(int m=0;m<=n;m++){\r\n        int low=0,high=m;\r\n        while(high-low>2){\r\n            int m1=low+(high-low)/3;\r\n            int m2=high-(high-low)/3;\r\n            if(getval(vec,n,m,m1)<getval(vec,n,m,m2)){\r\n                low=m1;\r\n            }else{\r\n                high=m2;\r\n            }\r\n        }\r\n        for(int x=low;x<=high;x++){\r\n            ans=max(ans,getval(vec,n,m,x));\r\n        }\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
