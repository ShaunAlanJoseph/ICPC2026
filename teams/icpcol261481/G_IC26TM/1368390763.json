  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long>a(3*n);\r\n    for(auto &x:a)cin>>x;\r\n    sort(a.rbegin(),a.rend());\r\n    vector<long long>pref(3*n+1,0);\r\n    for(int i=0;i<3*n;++i)\r\n    pref[i+1]=pref[i]+a[i];\r\n    long long ans=0;\r\n    for(int A=0;A<=n;++A){\r\n        int lo=0,hi=n-A;\r\n        while(lo<hi){\r\n            int B=(lo+hi)/2;\r\n            int u=A+2*B;\r\n            int v=3*n-2*A-B;\r\n            long long diff=a[u]+a[u+1]-3LL*a[v-1];\r\n            if(diff>=0)\r\n            lo=B+1;\r\n            else hi=B;\r\n        }\r\n        for(int B:{lo,max(0,lo-1),n-A}){\r\n            long long cur=2LL*pref[A]+pref[A+2*B]+3LL*pref[3*n-2*A-B];\r\n            ans=max(ans,cur);\r\n        }\r\n    }cout<<ans<<'\\n';\r\n}return 0;\r\n}\r\n",
