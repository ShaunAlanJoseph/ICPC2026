  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing int64=long long;\r\nconst int64 MOD=998244353;\r\nint64 modPow(int64 a,int64 e){\r\n    int64 res=1;\r\n    while(e>0){\r\n        if(e&1)\r\n        res=res*a%MOD;\r\n    a=a*a%MOD;\r\n    e>>=1;\r\n    \r\n    }return res;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\nint t;\r\ncin>>t;\r\nvector<pair<int,vector<int64>>>\r\ntests(t);\r\nint maxN=0;\r\nfor(auto &[n,a]:tests){\r\n    cin>>n;\r\n    a.resize(n);\r\n    for(auto &x:a)\r\n    cin>>x;\r\n    maxN=max(maxN,n);\r\n}\r\nvector<int64>H(maxN+1,0);\r\nfor(int i=1;i<=maxN;i++){\r\n    H[i]=(H[i-1]+modPow(i,MOD-2))%MOD;\r\n}\r\nfor(auto &[n,a]:tests){\r\n    int64 ans=0;\r\n    for(int i=0;i<n;i++){\r\n        int64 coefficient =(H[i]+H[n-1-i])%MOD;\r\n        ans=(ans+(a[i]%MOD)*coefficient)%MOD;\r\n    }\r\n    cout<<ans<<'\\n';\r\n}\r\nreturn 0;\r\n}\r\n",
