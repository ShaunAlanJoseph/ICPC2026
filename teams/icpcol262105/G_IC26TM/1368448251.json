  "source_code": "# cook your dish here\r\nimport sys\r\ndef solve():\r\n    d = sys.stdin.read().split()\r\n    if not d:\r\n        return \r\n    out = []\r\n    idx =1\r\n    for _ in range(int(d[0])):\r\n        n = int(d[idx])\r\n        idx+=1\r\n        sz = 3*n\r\n        a = sorted((int(x) for x in d[idx:idx+sz]),reverse = True)\r\n        idx+=sz\r\n        p = [0]\r\n        for x in a:\r\n            p.append(p[-1]+x)\r\n        ans = -1\r\n        for y in range(2*n+1):\r\n            l,r = max(0,y-n),y//2\r\n            while r-l>5:\r\n                m1,m2 = l+(r-l)//3,r-(r-l)//3\r\n                if p[2*y-3*m1]+2*p[m1]<p[2*y-3*m2]+2*p[m2]:\r\n                    l = m1\r\n                else:\r\n                    r = m2\r\n            ans = max(ans,3*p[sz-y]+max(p[2*y-3*x]+2*p[x] for x in range(l,r+1)))\r\n        out.append(str(ans))\r\n    sys.stdout.write('\\n'.join(out)+'\\n')\r\nif __name__=='__main__':\r\n    solve()",
