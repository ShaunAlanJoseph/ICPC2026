  "source_code": "# cook your dish here\r\nimport sys\r\ndef solve():\r\n    input_data = sys.stdin.read().split()\r\n    if not input_data:\r\n        return \r\n    mod = 998244353\r\n    maxi = 200005\r\n    inv = [1]*maxi\r\n    h = [0]*maxi\r\n    for i in range(2,maxi):\r\n        inv[i] = mod-(mod//i)*inv[mod%i]%mod\r\n    for i in range(1,maxi):\r\n        h[i] = (h[i-1]+inv[i])%mod\r\n    out=  []\r\n    idx = 1\r\n    t = int(input_data[0])\r\n    for _ in range(t):\r\n        n = int(input_data[idx])\r\n        idx+=1\r\n        ans = 0\r\n        for i in range(n):\r\n            val = int(input_data[idx+i])\r\n            coeff = (h[i]+h[n-1-i])%mod\r\n            ans = (ans+val*coeff)%mod\r\n        idx+=n\r\n        out.append(str(ans))\r\n    sys.stdout.write('\\n'.join(out)+'\\n')\r\nif __name__=='__main__':\r\n    solve()\r\n            ",
