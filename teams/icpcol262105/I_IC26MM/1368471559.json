  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tcin.tie(0)->sync_with_stdio(0);\r\n\tint t,n;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    std::vector<vector<int>> P(n+1);\r\n\t    for(int i{1},x;i<=n;++i){\r\n\t        cin>>x;\r\n\t        P[x].push_back(i);\r\n\t    }\r\n\t    vector<int> D(n+1,0);\r\n\t    D[0]=1;\r\n\t    for(int v=1;v<n;++v){\r\n\t        vector<int> L(v,1),R(v,1),N(v+1,0);\r\n\t        for(int i:P[v]){\r\n\t            int a=v-1-n+i,c=i-1;\r\n\t            int b=(i-1)/2,d=v-1-(n-i)/2;\r\n\t            int s=max(0,(v==n-i/2)?a+1:0);\r\n\t            int e=min(v-1,(v==n-(n-i+1)/2)?c-1:v);\r\n\t            for(int  j=s;j<=e;++j){\r\n\t                if (j!=b || j<=a) L[j]=0;\r\n\t                if(j!=d || j>=c) R[j]=0;\r\n\t            }\r\n\t        }\r\n\t        for(int j=0 ;j<v;++j){\r\n\t            if(D[j]){\r\n\t                if (L[j]) N[j+1]=(N[j+1]+D[j])%998244353;\r\n\t                if (R[j]) N[j]=(N[j]+D[j])%998244353;\r\n\t            }\r\n\t        }\r\n\t        D=N;\r\n\t    }\r\n\t    \r\n\t    int ans=0;\r\n\t    for(int j=0;j<n;++j){\r\n\t        bool ok=1;\r\n\t        for(int i:P[n]) ok&=((i==1 && j==0) || (i==n && j==n-1));\r\n\t        if(ok) ans=(ans+D[j])%998244353;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
