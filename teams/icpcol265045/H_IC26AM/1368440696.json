  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nconst int N=200005;\r\n\t\r\nlong long inv[N],h[N];\r\n\t\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<N;i++){\r\n\t    inv[i]=MOD-MOD/i*inv[MOD%i]%MOD;\r\n\t}\r\n\tfor(int i=1;i<N;i++){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t}\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    long long ans=0;\r\n\t    long long x;\r\n\t    for(int i=0;i<n;i++){\r\n\t        cin>>x;\r\n\t        long long c=(h[i]+h[n-1-i])%MOD;\r\n\t        ans=(ans+x*c)%MOD;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
