  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        \r\n        vector<long long> a(3*n);\r\n        for(auto &x:a)cin>>x;\r\n        \r\n        sort(a.rbegin(),a.rend());\r\n        vector<long long> p(3*n+1);\r\n        for(int i=0;i<3*n;i++){\r\n            p[i+1]=p[i]+a[i];\r\n        }\r\n        \r\n        long long ans=0;\r\n        \r\n        for(int i=0;i<=n;i++){\r\n            int l=0,r=n-i-1;\r\n            \r\n            while(l<=r){\r\n                int j=(l+r)/2;\r\n                int q=i+2*j;\r\n                int e=3*n-2*i-j;\r\n                \r\n                if(a[q]+a[q+1]>3*a[e-1]){\r\n                    l=j+1;\r\n                }\r\n                else{\r\n                    r=j-1;\r\n                }\r\n            }\r\n            int j=l;\r\n            long long curr=2*p[i]+p[i+2*j]+3*p[3*n-2*i-j];\r\n            ans=max(ans,curr);\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
