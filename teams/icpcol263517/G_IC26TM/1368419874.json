  "source_code": "# cook your dish here\r\nimport sys\r\nfrom itertools import accumulate\r\n\r\ndef main():\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0]); p = 1; out = []\r\n    for _ in range(t):\r\n        n = int(d[p]); p += 1\r\n        m = 3 * n \r\n        s = sorted(map(int, d[p:p + m]), reverse=True); p += m \r\n        P = [0] + list(accumulate(s))\r\n        best = 0\r\n        b = n \r\n        for a in range(n + 1):\r\n            if b > n - a: b = n - a \r\n            while b > 0 and s[a + 2*b - 2] + s[a + 2*b - 1] <= 3 * s[m - 2*a - b]:\r\n                b -= 1\r\n            v = 2 * P[a] + P[a + 2*b] + 3*P[m - 2*a -b]\r\n            if v > best: best  = v \r\n        out.append(best)\r\n    print(\"\\n\".join(map(str, out)))\r\nmain()",
