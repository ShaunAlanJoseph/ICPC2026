  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    M=998244353\r\n    N=200001\r\n    inv=[0,1] + [0]*(N-1)\r\n    for i in range(2,N + 1):\r\n        inv[i] = (M-( M//i)*inv[M%i]%M) % M\r\n    H=[0]*(N+1)\r\n    for i in range(1, N+1):\r\n        H[i]= (H[i-1]+ inv[i])%M\r\n    d=sys.stdin.buffer.read().split()\r\n    t=int(d[0]); p=1; out = []\r\n    for _ in range(t):\r\n        n= int(d[p]); p+=1 \r\n        a=d[p:p+n]; p+=n\r\n        Hr = H[n- 1::-1]\r\n        s=sum(int(x)*(u+v) for x,u,v in zip(a,H,Hr))\r\n        out.append(s%M)\r\n    print(\"\\n\".join(map(str,out)))\r\nmain()\r\n\r\n\r\n        \r\n\r\n\r\n    ",
