  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll=long long;\r\n\r\nconst ll MOD=998244353;\r\n\r\nll modpow(ll a, ll b){\r\n    ll res=1;\r\n    while(b>0){\r\n        if(b&1){\r\n            res=res*a%MOD;\r\n            \r\n        }a=a*a%MOD;\r\n        b>>=1;\r\n    } return res;\r\n}\r\n\r\nint main() {\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<ll> a(n+1);\r\n    \r\n    for(int i=1;i<=n;i++){\r\n        cin>>a[i];\r\n        a[i]%=MOD;\r\n        \r\n    }\r\n    if(n==1){\r\n        cout<<0<<endl;\r\n        continue;\r\n        \r\n    }\r\n    vector<ll> in(n+1);\r\n    in[1]=1;\r\n    for(int i=2;i<=n;i++){\r\n        in[i]=MOD-(MOD/i)*in[MOD% i]% MOD;\r\n    }\r\n    \r\n    vector<ll> h(n+1, 0);\r\n    for(int i=1;i<=n;i++){\r\n        h[i]=(h[i-1]+in[i])% MOD;\r\n    }\r\n    ll ans=0;\r\n    for(int i=1;i<=n;i++){\r\n        ll c=(h[i-1] + h[n-i])% MOD;\r\n        ans=(ans+a[i]*c)%MOD;\r\n    }cout<<ans<<endl;\r\n} return 0;\r\n\r\n}\r\n",
