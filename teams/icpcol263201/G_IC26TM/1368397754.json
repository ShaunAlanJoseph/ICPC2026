  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long>a(m);\r\n\t    for(auto &x: a) cin>>x;\r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long> p(m+1, 0);\r\n\t    for(int i=0;i<m;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t        \r\n\t        \r\n\t    }long long ans=0;\r\n\t    for(int z=0;z<=2*n;z++){\r\n\t        int lo=max(0,z-n);\r\n\t        int hi=z/2;\r\n\t        int l=lo, r=hi;\r\n\t        while(l<r){\r\n\t            int mid=(l+r)/2;\r\n\t            int q=2*z-3*mid;\r\n\t            \r\n\t            long long diff=2*a[mid]-(a[q-3]+a[q-2]+a[q-1]);\r\n\t            if(diff>=0){\r\n\t                l=mid+1;\r\n\t            }else r=mid;\r\n\t        } for(int A=max(lo, l-1); A<= min(hi, l+1);A++){\r\n\t            int q=2*z-3*A;\r\n\t            int k=3*n-z;\r\n\t            \r\n\t            long long cur=3LL* p[k]+p[q]+2LL* p[A];\r\n\t            ans=max(ans, cur);\r\n\t        }\r\n\t         \r\n\t    }cout<<ans<<endl;\r\n\t} return 0;\r\n\r\n}\r\n",
