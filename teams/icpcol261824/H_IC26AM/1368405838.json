  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing int64 = long long;\r\nconst int64 MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    vector<int>inv(200001);\r\n    inv[1] = 1;\r\n    for(int i=2; i<=200000; i++){\r\n        inv[i] = MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<int64>a(n);\r\n        for(auto &x :a) cin>>x;\r\n        vector<int64> h(n+1, 0);\r\n        for(int i=1; i<=n; i++){\r\n            h[i] = (h[i-1] + inv[i]) %MOD;\r\n        }\r\n        int64 ans= 0;\r\n        for(int i=0; i<n; i++){\r\n            int64 coef = (h[i] + h[n-i-1]) %MOD;\r\n            ans = (ans+a[i] *coef) %MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
