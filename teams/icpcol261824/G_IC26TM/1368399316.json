  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    \r\n    a.sort(reverse = True)\r\n    \r\n    m = 3 * n\r\n    \r\n    pref = [0] * (m+1)\r\n    for i in range(m):\r\n        pref[i+1] = pref[i] + a[i]\r\n        \r\n    ans = 0\r\n    \r\n    for c1 in range(n+1):\r\n        max_c2 = n - c1\r\n        \r\n        def value(c2):\r\n            p = c1\r\n            q = c1 + 2 * c2\r\n            r = 3*n - 2*c1 - c2 \r\n            \r\n            return 2 * pref[p] + pref[q] + 3*pref[r]\r\n            \r\n        lo,hi = 0,max_c2\r\n        \r\n        while lo < hi:\r\n            mid = (lo + hi) // 2 \r\n            \r\n            p = c1 + 2*mid \r\n            \r\n            r = 3*n-2*c1-mid \r\n            \r\n            gain = a[p] + a[p+1] - 3 * a[r-1]\r\n            if gain >= 0:\r\n                lo = mid+1 \r\n            else:\r\n                hi = mid \r\n                \r\n        ans = max(ans,value(lo))\r\n        \r\n        if lo > 0:\r\n            ans = max(ans,value(lo - 1))\r\n            \r\n    print(ans)",
