  "source_code": "t=int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    teams = n\r\n    n=n*3\r\n    \r\n    arr=list(map(int,input().split()))\r\n    arr.sort(reverse=True)\r\n    \r\n    prefix=[0]*(n+1)\r\n    \r\n    for i in range(n):\r\n        prefix[i+1]=prefix[i]+arr[i]\r\n        \r\n    ans=0\r\n    \r\n    for x in range(teams+1):\r\n        low=0\r\n        high=teams-x\r\n        \r\n        while low<high:\r\n            y=(low+high+1)//2\r\n            \r\n            pos=x+2*(y-1)\r\n            end=n-2*x-(y-1)\r\n            \r\n            if arr[pos]+arr[pos+1]<3*arr[end-1]:\r\n                high=y-1\r\n            else:\r\n                low=y\r\n        y=low\r\n        \r\n        pos=x+2*y\r\n        end=n-2*x-y\r\n        \r\n        curr=2*prefix[x]+prefix[pos]+3*prefix[end]\r\n        \r\n        ans=max(ans,curr)\r\n        \r\n    print(ans)",
