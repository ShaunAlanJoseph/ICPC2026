  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--)\r\n\t{\r\n\t    int n;cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<ll>a(m);\r\n\t    for(auto&x:a)\r\n\t    cin>>x;\r\n\t    sort(a.begin(),a.end(),greater<ll>());\r\n\t    vector<ll>pref(m+1,0);\r\n\t    for(int i=0;i<m;i++)\r\n\t    pref[i+1]=pref[i]+a[i];\r\n\t    ll bestbonus=0;\r\n\t    for(int A=0;A<=n;A++)\r\n\t    {\r\n\t        int maxB=n-A;\r\n\t        auto getbonus=[&](int B)->ll{\r\n\t            ll bonus=3ll*pref[A];\r\n\t            bonus+=pref[A+2*B]-pref[A];\r\n\t            int start=m-(2*A+B);\r\n\t            bonus-=3ll*(pref[m]-pref[start]);\r\n\t            return bonus;\r\n\t        };\r\n\t        int lo=0,hi=maxB;\r\n\t        while(lo<hi){\r\n\t            int mid=(lo+hi)/2;\r\n\t            if(getbonus(mid)<=getbonus(mid+1))\r\n\t            lo=mid+1;\r\n\t            else\r\n\t            hi=mid;\r\n\t        }\r\n\t        bestbonus=max(bestbonus,getbonus(lo));\r\n\t        }\r\n\t        ll answer=3ll*pref[m]+bestbonus;\r\n\t        cout<<answer<<'\\n';\r\n\t    }\r\n\t    return 0;\r\n\t}\r\n\r\n\r\n",
