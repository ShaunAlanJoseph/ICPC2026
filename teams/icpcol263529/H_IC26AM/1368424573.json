  "source_code": "#include <stdio.h>\r\n#include <stdlib.h>\r\n\r\n#define M 998244353LL\r\n#define LIMIT 200005\r\n\r\nlong long inv[LIMIT],h[LIMIT];\r\n\r\nvoid precompute(){\r\n    inv[1]=1;\r\n    for (int i=2;i<LIMIT;i++){\r\n        inv[i]=(M-M/i)*inv[M%i]%M;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<LIMIT;i++){\r\n        h[i]=(h[i-1]+inv[i])%M;\r\n    }\r\n}\r\n\r\nvoid solve(void){\r\n    int n;\r\n    if(scanf(\"%d\",&n)!=1) \r\n    return ;\r\n    long long ans =0;\r\n    for (int k=1;k<=n;k++){\r\n        long long x;\r\n        scanf(\"%lld\",&x);\r\n        long long coeff=(h[k-1]+h[n-k])%M;\r\n        ans = (ans+(x%M)*coeff)%M;\r\n    }\r\n    printf(\"%lld\\n\",ans);\r\n}\r\n\r\nint main() {\r\n\tprecompute();\r\n\tint t;\r\n\tif(scanf(\"%d\",&t)==1) while (t--) solve();\r\n\treturn 0;\r\n}\r\n\r\n",
