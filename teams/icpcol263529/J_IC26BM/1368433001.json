  "source_code": "t=int(input())\r\nfor _ in range(t):\r\n    c=list(map(int,input().split()))\r\n    n=sum(c)\r\n    tp=['00','01','10','11']\r\n    ans=None\r\n    for l in range(4):\r\n        if c[l]==0:\r\n            continue\r\n        a=c.copy()\r\n        a[l]-=1\r\n        c00,c01,c10,c11=a\r\n        extra=min(c00,c01+c11)\r\n        z=c00+c10+extra\r\n        ones01=min(c01,(c01+c11-extra)//2)\r\n        ones10=min(c10,c00-extra,(c01+c11-extra-2*ones01)//2)\r\n        ones=n-1-z-2*ones01-2*ones10\r\n        cur=(\"0\"*z+\"01\"*ones01+\"10\"*ones10+\"1\"*ones+tp[l])\r\n        \r\n        if ans is None or cur<ans:\r\n            ans=cur\r\n    print(ans)\r\n        \r\n        \r\n        \r\n        \r\n   ",
