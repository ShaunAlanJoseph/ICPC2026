  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n\tpublic static void main (String[] args) throws java.lang.Exception\r\n\t{\r\n\t\t// your code goes here\r\n\t\tScanner hi=new Scanner(System.in);\r\n\t\tlong M=998244353;\r\n\t\tint N=200000;\r\n\t\tlong[] h=new long[N+1],inv=new long[N+1];\r\n\t\tinv[1]=1;\r\n\t\tfor(int i=2;i<=N;i++){\r\n\t\t    inv[i]=M-(M/i)*inv[(int)(M%i)]%M;\r\n\t\t    \r\n\t\t}\r\n\t\tfor(int i=1;i<=N;i++){\r\n\t\t    h[i]=(h[i-1]+inv[i])%M;\r\n\t\t}\r\n\t\tint t=hi.nextInt();\r\n\t\twhile(t-->0){\r\n\t\t    int n=hi.nextInt();\r\n\t\t    long ans=0;\r\n\t\t    for(int i=1;i<=n;i++){\r\n\t\t        long a=hi.nextLong();\r\n\t\t    \r\n\t\t    ans=(ans+a*(h[i-1]+h[n-i]))%M;\r\n\t\t}\r\nSystem.out.println(ans);\r\n\t}\r\n}\r\n}",
