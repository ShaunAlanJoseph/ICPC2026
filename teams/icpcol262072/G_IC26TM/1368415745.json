  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n\tpublic static void main (String[] args) throws java.lang.Exception\r\n\t{\r\n\t\t// your code goes here\r\n\t\tScanner a=new Scanner(System.in);\r\n\t\tint t=a.nextInt();\r\n\t\twhile(t-->0)\r\n\t\t{\r\n\t\t    int n=a.nextInt(),m=3*n;\r\n\t\t    long[] b=new long[m];\r\n\t\t for(int i=0;i<m;i++)   {\r\n\t\t     b[i]=a.nextLong();\r\n\t\t }\r\n\t\t Arrays.sort(b);\r\n\t\t long[] p= new long[m+1];\r\n\t\t for(int i=0;i<m;i++){\r\n\t\t     p[i+1]= p[i]+b[m-1-i];\r\n\t\t }\r\n\t\t long ans=0;\r\n\t\t for(int A=0;A<=n;A++){\r\n\t\t     int l=0,r=n-A;\r\n\t\t \r\n\t\t while(l<r){\r\n\t\t     int B=(l+r)/2;\r\n\t\t     int x=A+2*B;\r\n\t\t     int y=3*n-2*A-B;\r\n\t\t     if(b[m-1-x]+b[m-2-x]>=3*b[m-y])  l=B+1;\r\n\t\t     else r=B;\r\n\t\t }\r\n\t\t for(int B=Math.max(0,l-1);B<=l&&B<=n-A;B++){\r\n\t\t     int x=A+2*B;\r\n\t\t     int y=3*n-2*A-B;\r\n\t\t     long cur=6*p[A]+4*(p[x]-p[A])+3*(p[y]-p[x]);\r\n\t\t     ans=Math.max(ans,cur);\r\n\t\t }\r\n\t\t}\r\n\r\nSystem.out.println(ans);\r\n\t}\r\n}\r\n}",
