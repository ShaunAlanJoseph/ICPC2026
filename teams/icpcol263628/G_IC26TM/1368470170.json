  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(NULL);\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        int N = 3 * n;\r\n        vector<ll> a(N + 1), P(N + 1, 0);\r\n        for(int i = 1; i<= N; i++) cin >> a[i];\r\n        sort(a.begin() + 1, a.end(), greater<ll>());\r\n        for(int i = 1; i<= N ; i++) P[i] = P[i -1] + a[i];\r\n        \r\n        ll best = 0;\r\n        for(int p = 0; p <= n; p++){\r\n            int lo = 0, hi = n-p;\r\n            while(lo < hi){\r\n                int q = (lo + hi) /2;\r\n                if(a[p +2*q+1] + a[p+2*q+2] > 3 * a[N-2*p-q]) lo = q + 1;\r\n                else hi = q;\r\n                \r\n            }\r\n            best = max(best,2*P[p] + P[p +2 *lo] + 3 * P[N -2 * p - lo]);\r\n        }\r\n        cout << best << \"\\n\";\r\n    }\r\n    \r\n}\r\n",
