  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD = 998244353;\r\nconst int MAXN = 200005;\r\nlong long inv_[MAXN],H[MAXN];\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(NULL);\r\n    \r\n    inv_[1] = H[1] = 1;\r\n    \r\n    for(int i = 2; i < MAXN; i++){\r\n        inv_[i] = (MOD- MOD / i) * inv_[MOD % i] % MOD;\r\n        H[i] = (H[i-1] + inv_[i]) % MOD;\r\n    }\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n ;\r\n        cin >> n;\r\n        long long ans = 0, x;\r\n        for(int i = 1; i <= n; i++){\r\n            cin >> x;\r\n            ans = (ans + (H[i - 1] + H[n -i] ) % MOD * x) % MOD;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n}\r\n",
