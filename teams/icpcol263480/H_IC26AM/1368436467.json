  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tconst long long mod=998244353;\r\n\tconst int l =200000;\r\n\tvector<long long> inv(l+1,0);\r\n\tvector<long long>h(l+1,0);\r\n\tinv[1]=1;\r\n\tfor(int i=1;i<=l;i++){\r\n\t    if(i>1){\r\n\t        inv[i]=mod-(mod/i)*inv[mod%i]%mod;\r\n\t    }\r\n\t    h[i]=(h[i-1]+inv[i])%mod;\r\n\t}\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<long long >a(n);\r\n        for(int i=0;i<n;i++){\r\n            cin>>a[i];\r\n        }\r\n        long long ans=0;\r\n        for( int i=0;i<n;i++){\r\n            long long cnt =(h[i]+h[n-i-1])%mod;\r\n            ans=(ans+a[i]*cnt)%mod;\r\n        }\r\n        cout<<ans<<\"\\n\";\r\n    }\r\n    return 0;\r\n}\r\n",
