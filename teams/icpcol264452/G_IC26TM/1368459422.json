  "source_code": "import sys\r\ninput=sys.stdin.readline\r\ndef solve():\r\n    t=int(input())\r\n    for _ in range(t):\r\n        n=int(input())\r\n        a=list(map(int,input().split()))\r\n        a.sort(reverse=True)\r\n        m=3*n\r\n        pref=[0]*(m+1)\r\n        for i in range(m):\r\n            pref[i+1]=pref[i]+a[i]\r\n        ans=0\r\n        \r\n        for p in range(n+1):\r\n            low=0\r\n            high=n-p\r\n            while low<high:\r\n                q=(low+high)//2\r\n                j=p+2*q\r\n                k=3*n-2*p-q\r\n                diff=a[j]+a[j+1]-3*a[k-1]\r\n                if diff>=0:\r\n                    low=q+1\r\n                else:\r\n                    high=q\r\n            q=low\r\n            r=n-p-q\r\n            end4=p + 2*q\r\n            end3=end4+3*r\r\n            current=(\r\n                6*pref[p]\r\n                +4*(pref[end4]-pref[p])\r\n                +3*(pref[end3]-pref[end4])\r\n            )\r\n            ans=max(ans,current)\r\n        print(ans)\r\nsolve()    ",
