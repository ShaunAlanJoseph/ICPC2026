  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    int m = 3 * n;\r\n    vector<ll> a(m), S(m+1,0);\r\n    \r\n    for(auto &x:a){\r\n        cin >> x;\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    for(int i=0;i<m;i++){\r\n        S[i+1] = S[i] + a[i]; \r\n    }\r\n    ll ans = 0;\r\n    for(int p=0;p<=n;p++){\r\n        auto g = [&](int q){\r\n            return S[p+2*q] + 3 * S[m-2 * p-q];\r\n        };\r\n        \r\n        int lo = 0,hi = n-p;\r\n        while(lo<hi){\r\n            int mid = lo + (hi-lo)/2;\r\n            if(g(mid+1)>g(mid)){\r\n                lo = mid+1;\r\n            }\r\n            else hi = mid;\r\n        }\r\n        ans = max(ans, 2* S[p] + g(lo));\r\n    }\r\n    cout << ans <<'\\n';\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(0),cin.tie(0);\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
