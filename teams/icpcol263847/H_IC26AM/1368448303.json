  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll M = 998244353;\r\nconst int N = 200005;\r\n\r\nll inv[N], H[N];\r\n\r\nvoid precompute(){\r\n    inv[1] = 1; H[1] = 1;\r\n    for(int i=2;i<N;i++){\r\n        inv[i] = (M - M/i) * inv[M % i] % M;\r\n        H[i] = (H[i-1] + inv[i]) % M;\r\n    }\r\n}\r\n\r\nvoid solve(){\r\n    \r\n    int n;\r\n    cin >> n;\r\n    ll ans = 0;\r\n    for(int j=1;j<=n;j++){\r\n        ll x;\r\n        cin >> x;\r\n        ans = (ans+ x % M * ((H[n-j] + H[j-1]) % M)) % M;\r\n    }\r\n    cout << ans << '\\n';\r\n}\r\n\r\nint main() {\r\n\tios::sync_with_stdio(0),cin.tie(0);\r\n\tprecompute();\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
