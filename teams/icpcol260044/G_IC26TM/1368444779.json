  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>v(3*n);\r\n\t    for(long long &x:v){\r\n\t        cin>>x;\r\n\t    }\r\n\t    sort(v.rbegin(),v.rend());\r\n\t    vector<long long>pref(3*n+1,0);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        pref[i+1]=pref[i]+v[i];\r\n\t    }\r\n\t    auto answer=[&](int k,int l){\r\n\t        int p=k+2*l;\r\n\t        int q=3*n-2*k-l;\r\n\t        return 6LL*pref[k]+4LL*(pref[p]-pref[k])+3LL*(pref[q]-pref[p]);\r\n\t    };\r\n\t    long long ans=0;\r\n\t    int l=n;\r\n\t    for(int k=0;k<=n;k++){\r\n\t        l=min(l,n-k);\r\n\t        while(l>0){\r\n\t            int p=k+2*(l-1);\r\n\t            int q=3*n-2*k-l;\r\n\t            long long temp=v[p]+v[p+1]-3LL*v[q];\r\n\t            if(temp>=0) break;\r\n\t            --l;\r\n\t        }\r\n\t        ans=max(ans,answer(k,l));\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t    \r\n\t}\r\n\treturn 0;\r\n}\r\n",
