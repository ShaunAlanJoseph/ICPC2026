  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD=998244353;\r\n\r\nint power(long long a, long long ex){\r\n    long long r=1;\r\n    while(ex){\r\n        if(ex&1) r=r*a%MOD;\r\n        a=a*a%MOD;\r\n        ex>>=1;\r\n    }\r\n    return r;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>v(n);\r\n\t    for(auto &x:v) cin>>x;\r\n\t    vector<long long>b(n+1,0);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        b[i]=(b[i-1]+power(i,MOD-2))%MOD;\r\n\t    }\r\n\t    long long answer=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        long long w=(b[i]+b[n-i-1])%MOD;\r\n\t        answer=(answer+(v[i]%MOD)*w)%MOD;\r\n\t    }\r\n\t    cout<<answer<<'\\n';\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
