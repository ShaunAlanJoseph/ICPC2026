  "source_code": "# cook your dish here\r\nMD = 998244353\r\nMX = 200000\r\n\r\ninv = [0] * (MX + 1)\r\nj = [0] * (MX + 1)\r\n\r\ninv[1] = 1\r\nfor i in range(2, MX + 1):\r\n    inv[i] = MD - (MD // i) * inv[MD % i] % MD\r\n\r\nfor k in range(1, MX+1):\r\n    j[k] = (j[k-1] + inv[k]) % MD\r\n    \r\ndef solve():\r\n    y = int(input())\r\n    ot = []\r\n    \r\n    for _ in range(y):\r\n        n = int(input())\r\n        b = list(map(int, input().split()))\r\n        \r\n        an = 0\r\n        for i in range(n):\r\n            an += b[i] * (j[i] + j[n - 1 - i])\r\n            an %= MD\r\n        ot.append(str(an))\r\n    print(\"\\n\".join(ot))\r\nsolve()",
