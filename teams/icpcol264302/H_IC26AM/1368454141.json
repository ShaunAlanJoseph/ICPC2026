  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    \r\n    long long mod = 998244353;\r\n    \r\n    int maxn = 200005;\r\n    long long inv[maxn], h[maxn];\r\n    \r\n    \r\n        inv[1] = 1;\r\n        for(int i=2;i<=maxn;i++){\r\n            inv[i]=(mod-(mod/i)* inv[mod%i] % mod) % mod;\r\n        }\r\n        h[0]= 0;\r\n        for(int i=1;i<maxn;i++){\r\n            h[i]= (h[i-1]+inv[i])%mod;\r\n        }\r\n        int t;\r\n        cin>>t;\r\n        while(t--){\r\n            int n;\r\n            cin>>n;\r\n            long long ans =0;\r\n            for(int j=1;j<=n;j++){\r\n                long long a;\r\n                cin>>a;\r\n                long long w = (h[j-1]+h[n-j])%mod;\r\n                ans = (ans+a%mod*w)%mod;\r\n            }\r\n            cout<<ans<<endl;\r\n        }\r\n    }\r\n\r\n",
