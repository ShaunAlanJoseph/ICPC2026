  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long M = 998244353;\r\nint main() {\r\n\r\n\r\nios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    int t;\r\n    cin >> t;\r\n    while (t--){\r\n        int n;\r\n        cin >> n;\r\n        vector<long long> a(n),inv(n + 1), h(n + 1);\r\n        for (auto &x : a)\r\n            cin >> x;\r\n        inv[1] = 1;\r\n        for (int i = 2; i <= n; i++){\r\n            inv[i] =    M - (M/i)*inv[M%i]%M;\r\n            \r\n        }\r\n        for (int i = 1; i <= n; i++){\r\n            h[i]= (h[i-1]+ inv[i]) % M;\r\n            \r\n        }\r\n        long long ans = 0;\r\n        for (int i =0; i < n; i++){\r\n           ans = (ans + a[i]*(h[i]+h[n-i-1]))% M;\r\n           \r\n        }\r\n        cout << ans << '\\n';\r\n    }\r\nreturn 0;\r\n}\r\n",
