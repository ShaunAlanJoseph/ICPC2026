  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<ll>a(m);\r\n\t    for(int i=0;i<m;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<ll>pre(m+1,0);\r\n\t    int i=0;\r\n\t    while(i<m){\r\n\t        pre[i+1]=pre[i]+a[i];\r\n\t        i++;\r\n\t    }\r\n\t    ll res=0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        int left=0, right=n-i;\r\n\t        while(left<right){\r\n\t            int mid=left+(right-left)/2;\r\n\t            ll add=a[i+2*mid]+a[i+2*mid+1];\r\n\t            ll diff=3*a[m-2*i-mid-1];\r\n\t            if(add>diff) left=mid+1;\r\n\t            else right=mid;\r\n\t        }\r\n\t        int y=left;\r\n\t        int k=i+2*y, r=m-2*i-y;\r\n\t        ll curr=2*pre[i]+pre[k]+3*pre[r];\r\n\t        if(curr>res)res=curr;\r\n\t    }\r\n\t    cout<<res<<\"\\n\";\r\n\t}\r\n}\r\n",
