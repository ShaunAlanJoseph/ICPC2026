  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\nconst ll MOD=998244353;\r\nconst int N=200001;\r\nll h[N];\r\n\r\nint main() {\r\n\t// your code goes here\r\n\th[0]=0;\r\n\tint i=1;\r\n\twhile(i<N){\r\n\t    ll res=1;\r\n\t    ll a=i;\r\n\t    ll b=MOD-2;\r\n\t    while(b>0){\r\n\t        if(b%2==1)res=(res*a)%MOD;\r\n\t        a=(a*a)%MOD;\r\n\t        b=b/2;\r\n\t    }\r\n\t    h[i]=(h[i-1]+res)%MOD;\r\n\t    i++;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll jap=0;\r\n\t    for(int j=1;j<=n;j++){\r\n\t        ll x;\r\n\t        cin>>x;\r\n\t        ll left=h[j-1];\r\n\t        ll right=h[n-j];\r\n\t        ll sum=(left+right)%MOD;\r\n\t        jap=(jap+x*sum)%MOD;\r\n\t    }\r\n\t    cout<<jap<<\"\\n\";\r\n\t}\r\n}\r\n",
