  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD=998244353;\r\n\r\ntypedef long long ll;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin >>t;\r\n\twhile(t--){\r\n    \tint n;\r\n    \tcin >> n;\r\n    \tvector<int> a(n+1);\r\n    \tfor(int i=1;i<=n;i++)\r\n    \t    cin >> a[i];\r\n        vector<int> inv(n+1);\r\n        inv[1]=1;\r\n        for(int i=2;i<=n;i++)\r\n            inv[i]=MOD -(ll)(MOD/i)*inv[MOD%i]%MOD;\r\n        vector<int> x(n+1,0);\r\n        for(int i=1;i<=n;i++){\r\n            x[i]=(x[i-1] +inv[i])%MOD;\r\n        }\r\n        int ans=0;\r\n        for(int i=1;i<=n;i++){\r\n            int coef=(x[i-1]+x[n-i])%MOD;\r\n            ans=(ans+(ll)a[i]*coef)%MOD;\r\n        }\r\n        cout << ans << '\\n';\r\n\t}\r\n    return 0;\r\n}\r\n",
