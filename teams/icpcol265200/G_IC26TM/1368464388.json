  "source_code": "\r\ndef solve():\r\n    n = int(input())\r\n    nums = list(map(int, input().split()))\r\n    nums.sort(reverse = True)\r\n    \r\n    p = [0] * (3 * n + 1)\r\n    \r\n    for i in range(3 * n):\r\n        p[i + 1] = p[i] + nums[i]\r\n    \r\n    res = 0 \r\n    \r\n    for a in range(n + 1):\r\n        \r\n        l, r = 0, n - a \r\n        \r\n        while l < r:\r\n            mid = (l + r) // 2 \r\n            k2 = a + 2 * mid\r\n            k3 = 3* n - 2 * a - mid \r\n            gain = nums[k2] + nums[k2 + 1] - 3 * nums[k3 - 1]\r\n            if gain > 0:\r\n                l = mid + 1 \r\n            else: r = mid \r\n        b = l \r\n        val = 2 * p[a] + p[a + 2 * b] + 3 * p[3 * n - 2 * a - b]\r\n        res = max(res, val)\r\n    print(res)\r\n    \r\n\r\nfor _ in range(int(input())):\r\n    solve()",
