  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nvoid solve(ll n , vector<ll> &v){\r\n    sort(v.rbegin(),v.rend());\r\n    vector<ll> p(3*n+1,0LL);\r\n    \r\n    for(ll i=0;i<3*n;i++) p[i+1] = p[i] + v[i];\r\n    \r\n    auto f = [&](ll a, ll b) -> ll{\r\n        return 2*p[a] + p[a+2*b]+ 3*p[3*n-2*a-b];\r\n    };\r\n    \r\n    ll ans = LLONG_MIN;\r\n    for(ll a=0;a<=n;a++){\r\n        ll lo = 0, hi = n - a;\r\n        while(lo < hi){\r\n            ll mid = lo + (hi - lo) / 2;\r\n            if((f(a,mid+1) - f(a,mid)) > 0) lo = mid+1;\r\n            else hi = mid;\r\n        }\r\n        ans = max(ans, f(a,lo));\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tll tt;\r\n\tcin>>tt;\r\n\twhile(tt--){\r\n\t    ll n;\r\n\t    cin>>n;\r\n\t    vector<ll> v(3*n);\r\n\t    for(ll i=0;i<3*n;i++) cin>>v[i];\r\n\t    solve(n,v);\r\n\t}\r\n\r\n}\r\n",
