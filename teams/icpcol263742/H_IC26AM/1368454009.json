  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD = 998244353;\r\n\r\nint main() {\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<ll>a(n+1),inv(n+1),h(n+1);\r\n    \r\n    for(int i =1;i<=n;i++){\r\n        cin>>a[i];\r\n    }\r\n    inv[1]=1;\r\n    for(int i =2;i<=n;i++)\r\n    inv[i]= MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    \r\n    for(int i=1;i<=n;i++){\r\n        h[i]=(h[i-1]+inv[i])%MOD;\r\n    }\r\n    ll ans=0;\r\n    for(int i=1;i<=n;i++){\r\n        ll coef=(h[i-1]+h[n-i])%MOD;\r\n        ans=(ans+a[i]%MOD*coef)%MOD;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\n}\r\n",
