  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long>a(3*n);\r\n    for(auto &x:a){\r\n        cin>>x;\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector<long long>p(3*n+1);\r\n    for(int i=0;i<3*n;i++){\r\n        p[i+1]=p[i] +a[i];\r\n    }\r\n    long long ans=0;\r\n    for(int k =0;k<=n;k++){\r\n        int l =0,r=n-k;\r\n        auto f = [&](int j ){\r\n            int x = k+2*j;\r\n            int y = 3*n - 2*k - j;\r\n            return 2 * p[k] + p[x] + 3*p[y];\r\n        };\r\n        while(l<r){\r\n            int mid = (l+r)/2;\r\n            if(f(mid)<=f(mid+1)){\r\n                l=mid+1;\r\n            }\r\n            else{\r\n                r=mid;\r\n                \r\n            }\r\n        }\r\n        ans=max(ans,f(l));\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n}\r\n",
