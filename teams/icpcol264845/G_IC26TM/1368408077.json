  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int N = 3 * n;\r\n\t    vector<ll> a(N);\r\n\t    for(auto &v : a) cin>>v;\r\n\t    sort(a.rbegin(), a.rend());\r\n\t    vector<ll> S(N+1, 0);\r\n\t    for(int i = 0; i < N; i++) S[i+1] = S[i] + a[i];\r\n\t    ll best = 0;\r\n\t    for(int i = 0; i <= n; i++){\r\n\t        auto h = [&](int m) -> ll{\r\n\t            int j = i + 2 * m;\r\n\t            int k = N - (3 * i + j) / 2;\r\n\t            ll yxz = 2 * S[i] + S[j] + 3 * S[k];\r\n\t            return yxz;\r\n\t        };\r\n\t        int lo = 0, hi = n-i;\r\n\t        while(lo < hi){\r\n\t            int mid = (lo + hi)/2;\r\n\t            if(h(mid + 1) > h(mid)) lo = mid + 1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        best = max(best, h(lo));\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
