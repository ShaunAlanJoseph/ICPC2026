  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nint main() {\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<vector<int>> byVal(n+1);\r\n\t    for(int i = 1; i <= n; i++){\r\n\t        int a;\r\n\t        cin>>a;\r\n\t        byVal[a].push_back(i);\r\n\t    }\r\n\t    auto valid = [&](int L, int R, int pos) -> bool{\r\n\t        for(int i : byVal[L+R+1]){\r\n\t            int pc = min(L, i) + max(0, i - (n - R));\r\n\t            bool ok1 = (pc == (i+1)/2 - 1) && pos <= i;\r\n\t            int m = n-i+1;\r\n\t            int sc = max(0, L-i+1) + min(R,m);\r\n\t            bool ok2 = (sc == (m+1)/2 - 1) && pos >= i;\r\n\t            if(!ok1 && !ok2) return false;\r\n\t        }\r\n\t        return true;\r\n\t    };\r\n\t    vector<ll> dp(n+1, 0), ndp (n+1, 0);\r\n\t    dp[0] = 1;\r\n\t    ll ans = 0;\r\n\t    for(int v = 0; v < n; v++){\r\n\t        if(v == n -1){\r\n\t            for(int L = 0; L <= v; L++){\r\n\t                if(dp[L] && valid(L, v - L, L+1)) ans = (ans + dp[L]) % MOD;\r\n\t            }\r\n\t            break;\r\n\t        }\r\n\t        fill(ndp.begin(), ndp.begin() + v + 2, 0);\r\n\t        for(int L = 0; L <= v; L++){\r\n\t            if(!dp[L]) continue;\r\n\t            int R = v - L;\r\n\t            if(valid(L,R,L+1)) ndp[L+1] = (ndp[L+1] + dp[L]) % MOD;\r\n\t            if(valid(L,R, n-R)) ndp[L] = (ndp[L] + dp[L]) % MOD;\r\n\t        }\r\n\t        swap(dp, ndp);\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
