  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200005;\r\nint main() {\r\n\tvector<ll> inv(MAXN), H(MAXN, 0);\r\n\tinv[1] = 1;\r\n\tfor(int i = 2; i < MAXN; i++) inv[i] = (MOD - (MOD/i) * inv[MOD % i]%MOD) % MOD;\r\n\tfor(int i = 1; i < MAXN; i++) H[i] = (H[i-1] + inv[i]) % MOD;\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans = 0;\r\n\t    for(int j = 1; j <= n; j++){\r\n\t        ll a;\r\n\t        cin>>a;\r\n\t        ll coef = (H[j-1] + H[n-j]) % MOD;\r\n\t        ans = (ans + a % MOD * coef) % MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
