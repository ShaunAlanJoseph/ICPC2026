  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--) {\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(3*n);\r\n\t    for(auto &x:a)cin>>x;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long>P(3*n+1, 0);\r\n\t    for(int i=0;i<3*n;i++)P[i+1] = P[i]+ a[i];\r\n\t    auto val = [&](int x, int b) -> long long {\r\n\t        return 2*P[x] + P[x+2*b] + 3*P[3*n - 2*x-b];\r\n\t    };\r\n\t    long long ans = 0;\r\n\t    for(int x = 0; x <= n; x++) {\r\n\t        int lo = 0, hi = n- x;\r\n\t        while(lo < hi) {\r\n\t            int mid = (lo+hi)/2;\r\n\t            if(val(x, mid+1)> val(x,mid)) lo = mid + 1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        ans = max(ans, val(x,lo));\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n\r\n}\r\n",
