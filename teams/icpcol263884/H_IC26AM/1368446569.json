  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nint main() {\r\n\t// your code goes here  \r\n\tint t;\r\n\tcin>>t;\r\n\tvector<vector<long long>>tests(t);\r\n\tint mx = 1;\r\n\tfor(int i=0;i<t;i++) {\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    tests[i].resize(n);\r\n\t    for(int j=0;j<n;j++) {\r\n\t        long long x;\r\n\t        cin>>x;\r\n\t        x%=MOD;\r\n\t        if(x<0)x+=MOD;\r\n\t        tests[i][j] = x;\r\n\t    }\r\n\t    mx = max(mx,n);\r\n\t}\r\n\tvector<long long>inv(mx+2), H(mx+2);\r\n\tinv[1] = 1;\r\n\tfor(int i=2;i<mx+1;i++) {\r\n\t    inv[i] = (MOD - (MOD/i) * inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tH[0] = 0;\r\n\tfor(int i=1;i<=mx+1;i++) {\r\n\t    H[i] = (H[i-1]+inv[i])%MOD;\r\n\t}\r\n\tfor(int i = 0;i<t;i++) {\r\n\t    int n = tests[i].size();\r\n\t    long long ans = 0;\r\n\t    for(int j = 1;j<=n;j++) {\r\n\t        long long c = (H[j-1] + H[n-j])%MOD;\r\n\t        ans = (ans + tests[i][j-1]*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n}\r\n",
