  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nll F(int x, int y, const vector<ll> & p, int n){\r\n    return 2LL * p[x] + p[x+2 *y] + 3LL * p[3*n - 2 * x - y];\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        vector<ll> a(3*n), p(3*n + 1, 0);\r\n        for(int i = 0; i < 3*n; i++){\r\n            cin >> a[i];\r\n        }\r\n        sort(a.rbegin(), a.rend());\r\n        for(int i = 0; i < 3*n; i++){\r\n            p[i+1] = p[i] + a[i];\r\n        }\r\n        \r\n        ll ans = 0;\r\n        int y = n;\r\n        for(int x = 0; x <= n; x++){\r\n            y = min(y, n-x);\r\n            \r\n            while(y > 0 && F(x, y-1, p, n) > F(x,y,p,n)) y--;\r\n            // while(y < n - x && F(x, y+1, p, n) >= F(x,y,p,n)) y++;\r\n            \r\n            ans = max(ans, F(x, y, p, n));\r\n        }\r\n        cout << ans << '\\n';\r\n    }\r\n    return 0;\r\n}\r\n",
