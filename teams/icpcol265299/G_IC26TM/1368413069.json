  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nconst int MAX=600005;\r\nll p[MAX],v[MAX];\r\n\r\ninline ll calc(int a, int b, int n){\r\n    return 2LL*p[a]+p[a+2*b]+3LL*p[3*n-2*a-b];\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int k=3*n;\r\n\t    for(int i=1;i<=k;i++)cin>>v[i];\r\n\t    sort(v+1,v+k+1,greater<ll>());\r\n\t    for(int i=1;i<=k;i++)p[i]=p[i-1]+v[i];\r\n\t    ll mx=-1;\r\n\t    for(int b=0;b<=n;b++){\r\n\t        int l=0,r=n-b;\r\n\t        while(r-l>=3){\r\n\t            int m1=l+(r-l)/3;\r\n\t            int m2=r-(r-l)/3;\r\n\t            if(calc(m1,b,n)<calc(m2,b,n))l=m1;\r\n\t            else r=m2;\r\n\t        }\r\n\t        for(int a=l;a<=r;a++){\r\n\t            long long mkl=calc(a,b,n);\r\n\t            mx=max(mx,mkl);\r\n\t        }\r\n\t    }\r\n\t    cout<<mx<<\"\\n\";\r\n\t}\r\n\r\n}\r\n",
