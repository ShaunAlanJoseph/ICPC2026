  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nstatic const int MAXN=200005;\r\nstatic const int MOD=998244353;\r\n\r\nlong long inv_arr[MAXN];\r\nlong long H[MAXN];\r\n\r\nvoid precompute(){\r\n    inv_arr[1]=1;\r\n    for(int i=2;i<MAXN;i++){\r\n        inv_arr[i]=(MOD-MOD/i)*inv_arr[MOD%i]%MOD;\r\n    }\r\n    H[0]=0;\r\n    for(int i=1;i<MAXN;i++){\r\n        H[i]=(H[i-1]+inv_arr[i])%MOD;\r\n    }\r\n}\r\nvoid solve() {\r\n\t// your code goes here\r\n\t\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(n+1);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    if(n==1){\r\n\t        cout<<0<<\"\\n\";\r\n\t        return;\r\n\t    }\r\n\t    long long tx=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long coef=(H[i-1]+H[n-i])%MOD;\r\n\t        long long contb=(coef*(a[i]%MOD))%MOD;\r\n\t        tx=(tx+contb)%MOD;\r\n\t        }\r\n\t        cout<<tx<<\"\\n\";\r\n\t}\r\n\r\nint main(){\r\n    precompute();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
