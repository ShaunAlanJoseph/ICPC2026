  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile (t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long> v(m);\r\n\t    for (auto i=0; i<m; i++) {\r\n\t        cin>>v[i];\r\n\t    }\r\n\t    sort(v.rbegin(), v.rend());\r\n\t    vector<long long> p(m+1, 0);\r\n\t    for (int i=0; i<m; i++){\r\n\t        p[i+1]=p[i]+v[i];\r\n\t       \r\n\t    }\r\n\t    auto f=[&](int a,int b){\r\n\t        return 2*p[a]+p[a+2*b]+3*p[m-2*a-b];\r\n\t        \r\n\t    };\r\n\t    long long b=0;\r\n\t    for (int a=0; a<=n; a++){\r\n\t        int l=0, h=n-a;\r\n\t        while (l<h){\r\n\t            int mid=l+(h-l)/2;\r\n\t            if (f(a, mid+1) > f(a, mid)){\r\n\t                l=mid+1;\r\n\t            }else{\r\n\t                h=mid;\r\n\t            }\r\n\t        }\r\n\t        b=max(b, f(a, l));\r\n\t    }\r\n\t    cout<<b<<endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
