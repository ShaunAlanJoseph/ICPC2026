  "source_code": "# cook your dish here\r\nimport sys\r\ndef expmod():\r\n    input_data=sys.stdin.read().split()\r\n    if not input_data:\r\n        return\r\n    MOD=998244353\r\n    MAXN=200000\r\n    inv=[0]*(MAXN+1)\r\n    inv[1]=1\r\n    for i in range(2,MAXN+1):\r\n        inv[i]=(MOD-MOD//i)*inv[MOD%i]%MOD\r\n    h=[0]*(MAXN+1)\r\n    for i in range(1,MAXN+1):\r\n        h[i]=(h[i-1]+inv[i])%MOD\r\n    t=int(input_data[0])\r\n    ptr=1\r\n    op=[]\r\n    for i in range(t):\r\n        n=int(input_data[ptr])\r\n        ptr+=1\r\n        a=[int(j) for j in input_data[ptr:ptr+n]]\r\n        ptr+=n\r\n        ans=0\r\n        for i in range(n):\r\n            expdepth=(h[i]+h[n-1-i]%MOD)\r\n            ans=(ans+a[i]*expdepth)%MOD\r\n        op.append(str(ans))\r\n    sys.stdout.write(\"\\n\".join(op)+\"\\n\")\r\nif __name__==\"__main__\":\r\n    expmod()",
