  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint n;\r\nvector<ll>P;\r\nll f(int a, int b){\r\n    return 2*P[a]+P[a+2*b]+3*P[3*n-2*a-b];\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    vector<ll>v(3*n);\r\n\t    for(auto&x:v) cin>>x;\r\n\t    sort(v.rbegin(), v.rend());\r\n\t    P.assign(3*n+1,0);\r\n\t    for(int i=0; i<3*n; i++) P[i+1]=P[i]+v[i];\r\n\t    \r\n\t    ll best = 0;\r\n\t    for(int a=0; a<=n; a++){\r\n\t        int lo=0, hi=n-a;\r\n\t        while(lo<hi){\r\n\t            int mid = (lo+hi)/2;\r\n\t            if(f(a,mid+1)>f(a,mid)) lo=mid+1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        best = max(best, f(a,lo));\r\n\t    }\r\n\t    cout<<best<<\"\\n\";\r\n\t}\r\n\treturn 0;\r\n}\r\n",
