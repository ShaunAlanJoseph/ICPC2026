  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\nconst ll MOD= 998244353;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tconst int N=200005;\r\n\tvector<ll>inv(N+1),H(N+1,0);\r\n\tinv[1]=1;\r\n\tfor(int i=2; i<=N; i++)\r\n\t  inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\tfor(int i=1; i<=N; i++)\r\n\t  H[i]=(H[i-1]+inv[i])%MOD;\r\n\t  \r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans =0;\r\n\t    for(int j=1; j<=n; j++){\r\n\t        ll a;\r\n\t        cin>>a;\r\n\t        ll c=(H[j-1]+H[n-j])%MOD;\r\n\t        ans = (ans+a%MOD*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\treturn 0;\r\n}\r\n",
