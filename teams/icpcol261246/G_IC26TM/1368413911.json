  "source_code": "for _ in range(int(input())):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    \r\n    a.sort(reverse = True)\r\n    \r\n    p = [0] * (3 * n + 1)\r\n    for i in range(3 * n):\r\n        p[i + 1] = p[i] + a[i]\r\n    \r\n    ans = 0\r\n    for i in range(n + 1):\r\n        l = 2 * n - i\r\n        h = 3 * n - 2 * i \r\n        \r\n        while(h - l > 2):\r\n            m1 = l + (h - l) // 3\r\n            m2 = h - (h - l) // 3\r\n        \r\n            f1 = 2 * p[i] + p[6 * n - 3 * i - 2 * m1] + 3 * p[m1] \r\n            f2 = 2 * p[i] + p[6 * n - 3 * i - 2 * m2] + 3 * p[m2] \r\n            \r\n            if(f1 < f2):\r\n                l = m1\r\n            else:\r\n                h = m2\r\n            \r\n        for k in range(l, h + 1):\r\n            v = 2 * p[i] + p[6 * n - 3 * i - 2 * k] + 3 * p[k]\r\n            ans = max(ans, v)\r\n    print(ans)",
