  "source_code": "# cook your dish here\r\nimport sys\r\ninput = sys.stdin.readline\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    a.sort(reverse = True)\r\n    m = 3*n\r\n    preff = [0]*(m+1)\r\n    for i in range(m):\r\n        preff[i+1] = preff[i] + a[i]\r\n    \r\n    ans = 0\r\n    for k in range(n+1):\r\n       low = 0\r\n       high = n-k\r\n       while low<high:\r\n           mid = (low+high+1)//2\r\n           y = mid -1\r\n           j = k +2 *y\r\n           z = 3*n-2*k-y\r\n           if a[j]+a[j+1]>= 3*a[z-1]:\r\n               low = mid\r\n           else:\r\n               high = mid-1\r\n       y = low\r\n       j = k+2*y\r\n       z = 3*n-2*k-y\r\n       \r\n            \r\n       pap = 6*preff[k]\r\n       pap2 = 4*(\r\n            preff[j]-preff[k])\r\n       pap3 = 3*(preff[z]-preff[j])\r\n   \r\n       val = pap + pap2 + pap3\r\n       \r\n       ans = max(ans,val)\r\n    print(ans)\r\n        \r\n            ",
