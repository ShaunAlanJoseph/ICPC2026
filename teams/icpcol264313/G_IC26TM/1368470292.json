  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n#define ull unsigned long long\r\n\r\n\r\n\r\nconst ll MOD =1e9;\r\n\r\n\r\nll func(int x,int y, int n, vector<ll>& p ) {\r\n    return 2*p[x]+p[x+2*y] + 3*p[3*n-2*x-y];\r\n}\r\n\r\nll ok(int val) {\r\n    if(val%2==0) return true;\r\n    else return false;\r\n}\r\n\r\n\r\nll func2(ll a, ll b, ll mod=MOD) {\r\n    ll r=1;\r\n    while(b) {\r\n        if(b&1) r= (r*a)%mod;\r\n        a= (a*a)%mod;\r\n        b>>=1;\r\n    }\r\n    return r;\r\n}\r\n\r\nll bs(int target ,int l , int r) {\r\n    while(l<r) {\r\n        int mid = l+ (r-l)/2;\r\n        if(ok(mid)) r=mid;\r\n        else l= mid+1;\r\n    }\r\n}\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<ll> a(3*n);\r\n\t    for(int i=0;i<3*n;i++)cin>>a[i];\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    vector<ll>p(3*n+1);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    ll ans=0;\r\n\t    int y=n;\r\n\t    for(int x=0;x<=n;x++){\r\n\t       // y=min(y,n-x);\r\n\t        while(y>0 && func(x,y-1,n,p)>= func(x, y,n,p)) y--;\r\n\t        ans= max(ans ,func(x,y,n, p));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
