  "source_code": "#include <iostream>\r\n#include<vector>\r\nusing namespace std;\r\n  const int MOD = 998244353;\r\n  const int MAXN =200005;\r\n  \r\n  long long inv[MAXN];\r\n  long long H[MAXN];\r\n  void precompute(){\r\n      inv[1]=1;\r\n      for(int i = 2;i<MAXN;++i){\r\n          inv[i] = (MOD -(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n      }\r\n      H[0] = 0;\r\n      for(int i = 1;i<MAXN;++i){\r\n          H[i]=(H[i-1]+inv[i]%MOD);\r\n      }\r\n  }\r\n  void solve(){\r\n      int n;\r\n      if(!(cin>>n))return;\r\n      vector<long long>a(n+1);\r\n      for(int i=1;i<=n;++i){\r\n          cin>>a[i];}\r\n          long long ans = 0;\r\n          for(int i =1;i<=n;++i){\r\n          long long coef=(H[i-1]+H[n-i])%MOD;\r\n          ans = (ans + coef*a[i])% MOD;\r\n          \r\n      }\r\n      cout<<ans<<\"\\n\";\r\n  }\r\n  \r\nint main() \r\n{\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    precompute();\r\n    \r\n    int t ;\r\n    if(cin>>t){\r\n        while(t--){\r\n            solve();\r\n        }\r\n    }\r\n    return 0;\r\n}",
