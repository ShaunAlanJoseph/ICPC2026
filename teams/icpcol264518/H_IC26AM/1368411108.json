  "source_code": "#include <stdio.h>\r\n\r\nint main(void) {\r\n\t// your code goes here\r\n\tprecompute();\r\n\tint t;\r\n\tif(scanf(\"%d\",&t)==1) while (t--) solve();\r\n\treturn 0;\r\n}\r\n\r\n#define MOD 998244353LL\r\n#define MAXN 200005\r\n\r\nlong long inv[MAXN], H[MAXN];\r\nvoid precompute(void){\r\n    inv[1]=1;\r\n    for(int i=2;i<MAXN;i++) inv[i]=(MOD-MOD/i)*inv[MOD%i]%MOD;\r\n    H[0]=0;\r\n    \r\n    for(int i=1;i<MAXN;i++) H[i]=(H[i-1]+inv[i])%MOD;\r\n    \r\n}\r\nvoid solve(void){\r\n    int n;\r\n    if(scanf(\"%d\",&n)!=1) return;\r\n    long long ans=0;\r\n    for(int k=1;k<=n;k++){\r\n        long long val;\r\n        scanf(\"%lld\",&val);\r\n        long long coeff=(H[k-1]+H[n-k])%MOD;\r\n        ans=(ans+(val%MOD)*coeff)%MOD;\r\n    }\r\n    printf(\"%lld\\n\",ans);\r\n}\r\n",
