  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nvoid ranj(){\r\n    int n;\r\n    cin>>n;\r\n    \r\n    vector<ll> a(3*n);\r\n    \r\n    for(int k=0;k<3*n;++k){\r\n        cin>>a[k];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector <ll> p(3*n+1,0);\r\n    for(int k=0;k<3*n;++k){\r\n        p[k+1]=p[k]+a[k];\r\n    }\r\n    auto eval=[&](ll i,ll j){\r\n        return 2*p[i]+p[i+2*j]+3*p[3*n-2*i-j];\r\n    };\r\n    ll ans=0;\r\n    for(ll i=0;i<=n;++i){\r\n        ll l=0,r=n-i;\r\n        while(l<r){\r\n            ll m=l+(r-l)/2;\r\n            if(eval(i,m+1)>=eval(i,m)){\r\n                l=m+1;\r\n            }\r\n            else{\r\n                r=m;\r\n            }\r\n        }\r\n        ans=max(ans,eval(i,l));\r\n    }\r\n    cout<<ans<<\"\\n\";\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    ranj();\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
