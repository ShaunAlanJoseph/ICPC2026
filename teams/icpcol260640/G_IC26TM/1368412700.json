  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n int t;\r\n scanf(\"%d\",&t);\r\n while(t--){\r\n     int n;\r\n     scanf(\"%d\",&n);\r\n     int m=3*n;\r\n     vector<ll> s(m);\r\n     for(auto &x : s) \r\n     scanf(\"%lld\",&x);\r\n     sort(s.begin(),s.end(),greater<ll>());\r\n     vector<ll> P(m+1,0);\r\n     for(int i=0;i<m;i++) P[i+1] = P[i] + s[i];\r\n     auto f =[&](int a, int b) -> ll {\r\n         return 2* P[a] + P[a + 2 * b]+3*P[m-2 *a-b];\r\n     };\r\n     ll best =0;\r\n     for(int a=0;a<=n;a++){\r\n         int lo =0,hi=n-a;\r\n         while(lo<hi){\r\n             int mid=(lo +hi) / 2;\r\n             if(f(a,mid+1) - f(a,mid)> 0) lo = mid+1;\r\n             else hi=mid;\r\n         }\r\n         best = max(best,f(a,lo));\r\n     }\r\n     printf(\"%lld\\n\",best);\r\n    }\r\n    return 0;\r\n}\r\n",
