  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    \r\n\t    int m = 3 * n;\r\n\t    \r\n\t    vector<ll> nums(m);\r\n\t    \r\n\t    for(auto &x : nums){\r\n\t        cin >> x;\r\n\t    }\r\n\t    \r\n\t    sort(nums.rbegin(), nums.rend());\r\n\t    \r\n\t    vector<ll> nums2(m + 1, 0);\r\n\t    \r\n\t    for(int i = 0; i < m; i++){\r\n\t        nums2[i + 1] = nums2[i] + nums[i];\r\n\t    }\r\n\t    \r\n\t    auto comp = [&](int x, int y) -> ll{\r\n\t        return 2 * nums2[x] + nums2[x + 2 * y] + 3 * nums2[m - 2 * x - y];\r\n\t    };\r\n\t    \r\n\t    ll b = 0;\r\n\t    \r\n\t    for(int j = 0; j <= n; j++){\r\n\t        int low = 0;\r\n\t        int high = n - j;\r\n\t        \r\n\t        while(low < high){\r\n\t            int mid = low  + (high - low) / 2;\r\n\t            if(comp(j, mid + 1) > comp(j, mid)){\r\n\t                low = mid + 1;\r\n\t            }\r\n\t            else{\r\n\t                high = mid;\r\n\t            }\r\n\t        }\r\n\t        b = max(b, comp(j, low));\r\n\t    }\r\n\t    cout << b << '\\n';\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
