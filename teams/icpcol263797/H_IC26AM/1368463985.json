  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nconst long long MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tconst int N = 200005;\r\n\tvector<ll> inv(N, 0), H(N, 0);\r\n\tinv[1] = 1;\r\n\t\r\n\tfor(int i = 2; i < N; i++){\r\n\t    inv[i] = (MOD - (MOD / i) * inv[MOD % i] % MOD) % MOD;\r\n\t}\r\n\tfor(int i = 1; i < N; i++){\r\n\t    H[i] = (H[i - 1] + inv[i]) % MOD;\r\n\t}\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\twhile(t--) {\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    \r\n\t    ll ans = 0;\r\n\t    \r\n\t    for(int i = 1; i <= n; i++){\r\n\t        ll a;\r\n\t        cin >> a;\r\n\t        ans = (ans + a % MOD * ((H[i - 1] + H[n - i]) % MOD)) % MOD; \r\n\t    }\r\n\t    \r\n\t    cout << ans << '\\n';\r\n\t    \r\n\t    \r\n\t}\r\n\r\n}\r\n",
