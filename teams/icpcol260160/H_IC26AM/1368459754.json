  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200005;\r\n\r\nll inv[MAXN], H[MAXN];\r\n\r\nvoid solve(){\r\n\tint n;\r\n\tcin>> n;\r\n\t\r\n\tll ans = 0;\r\n\tfor(int i=1;i<=n;i++){\r\n\t    ll a;\r\n\t    cin>> a;\r\n\t    ll mult = (H[i-1] + H[n-i]) % MOD;\r\n\t    ans = (ans + a % MOD * mult) % MOD;\r\n\t}\r\n\tcout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n    inv[1] = 1;\r\n    for(int i = 2; i<MAXN;i++) inv[i] = (MOD - (MOD/i) * inv[MOD % i] % MOD) % MOD;\r\n    \r\n    H[0] = 0;\r\n    for(int i = 1; i<MAXN;i++) H[i] = (H[i-1] + inv[i]) % MOD;\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    \r\n}\r\n",
