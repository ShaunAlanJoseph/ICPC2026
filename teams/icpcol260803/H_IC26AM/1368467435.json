  "source_code": "#include <bits/stdc++.h>\r\n#include<vector>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll MOD= 998244353;\r\nconst ll MAX_N = 200000;\r\n\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    vector<ll> inverse(MAX_N + 1 );\r\n    inverse[1]=1;\r\n    for(int i = 2;i<=MAX_N;i++){\r\n        inverse[i]=MOD-(MOD/i)*inverse[MOD %i]% MOD;\r\n    }\r\n    vector<ll> harmonic(MAX_N + 1, 0);\r\n    for(int i=1;i<MAX_N;i++){\r\n        harmonic[i]=(harmonic[i-1]+inverse[i]%MOD);\r\n    }\r\n    \r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        ll ttl=0;\r\n        for(int i=1;i<=n;i++){\r\n            ll value;\r\n            cin>> value;\r\n            \r\n            ll weight= (harmonic[i-1]+harmonic[n-i])%MOD;\r\n            ttl =(ttl+value*weight)%MOD;\r\n        }\r\n        cout<<ttl<<endl;\r\n    }\r\n    return 0;\r\n    \r\n}\r\n",
