  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nconst int maxx = 200005;\r\nconst int mod = 998244353;\r\n\r\nvector<int> harmonicNum(maxx);\r\n\r\nint pw(int a, int b){\r\n    int r = 1;\r\n    while(b > 0){\r\n        if(b&1) r = (r*a)%mod;\r\n        a = (a*a)%mod;\r\n        b >>= 1;\r\n    }\r\n    return r;\r\n}\r\n\r\nvoid preCompute(){\r\n    harmonicNum[0] = 0;\r\n    \r\n    for(int i=1; i<maxx; ++i){\r\n        int inv = pw(i, mod-2);\r\n        harmonicNum[i] = (harmonicNum[i-1] + inv)%mod;\r\n    }\r\n}\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    int total = 0;\r\n    \r\n    for(int i=1; i<=n; ++i){\r\n        int curr;\r\n        cin >> curr;\r\n        \r\n        int mult = (harmonicNum[i-1] + harmonicNum[n-i])%mod;\r\n        total = (total + curr*mult)%mod;\r\n    }\r\n    \r\n    cout << total << endl;\r\n}\r\n\r\nsigned main() {\r\n    preCompute();\r\n    \r\n    int t;\r\n    cin >> t;\r\n    \r\n    while(t--) solve();\r\n    \r\n    return 0;\r\n}\r\n",
