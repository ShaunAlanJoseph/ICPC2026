  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define all(x) x.begin(), x.end()\r\n\r\nint calc(int x, int k, vector<int> &pre){\r\n    return 2*pre[x] + pre[2*k-x] + 3*pre[pre.size()-1-x-k];\r\n}\r\n\r\nsigned main() {\r\n    int t;\r\n    cin >> t;\r\n    \r\n    while(t--){\r\n    \tint n;\r\n    \tcin >> n;\r\n    \t\r\n    \tint cnt = 3*n;\r\n    \t\r\n    \tvector<int> a(cnt);\r\n    \tfor(int &i:a) cin >> i;\r\n    \t\r\n    \tsort(a.rbegin(), a.rend());\r\n    \t\r\n    \tvector<int> pre(cnt+1, 0);\r\n    \tfor(int i=0; i<cnt; ++i){\r\n    \t    pre[i+1] = pre[i] + a[i];\r\n    \t}\r\n    \t\r\n    \tint res = 0;\r\n    \t\r\n    \tfor(int k=0; k<=n; ++k){\r\n    \t    int l = 0, r = k;\r\n    \t    \r\n    \t    while(l < r){\r\n    \t        int m = l + (r-l)/2;\r\n    \t        \r\n    \t        if(calc(m, k, pre) < calc(m+1, k, pre)){\r\n    \t            l = m+1;\r\n    \t        }\r\n    \t        else{\r\n    \t            r = m;\r\n    \t        }\r\n    \t    }\r\n    \t    \r\n    \t    res = max(res, calc(l, k, pre));\r\n    \t}\r\n    \t\r\n    \tcout << res << endl;\r\n    }\r\n}\r\n",
