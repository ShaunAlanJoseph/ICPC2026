  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n; \r\n\t    cin>>n;\r\n\t    vector<ll>a(n);\r\n\t    for(int i=0; i<n; i++) cin>>a[i];\r\n\t    vector<ll>inv(n+1);\r\n\t    inv[1]=1;\r\n\t    for(int i=2; i<=n; i++){\r\n\t        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t    }\r\n\t    vector<ll>H(n+1, 0);\r\n\t    for(int i=1; i<=n; i++){\r\n\t        H[i]=(H[i-1]+inv[i])%MOD;\r\n\t    }\r\n\t    ll ans=0;\r\n\t    for(int i=0; i<n; i++){\r\n\t        ll coef=(H[i]+H[n-i-1])%MOD;\r\n\t        ans=(ans+a[i]*coef)%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
