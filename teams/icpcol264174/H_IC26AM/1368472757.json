  "source_code": "import sys\r\n\r\ndef solution():\r\n    i_data = sys.stdin.read().split()\r\n    if not i_data:\r\n        return\r\n    \r\n    MOD = 998244353\r\n    maxi = 200005\r\n    \r\n    inv = [0]*maxi\r\n    \r\n    if maxi > 1:\r\n        inv[1] = 1\r\n    for i in range(2, maxi):\r\n        inv[i] = (MOD-MOD//i)*inv[MOD%i]%MOD\r\n        \r\n    h = [0]*maxi\r\n    for i in range(1, maxi):\r\n        h[i] = (h[i-1]+inv[i])%MOD\r\n    \r\n    t = int(i_data[0])\r\n    index = 1 \r\n    \r\n    out = []\r\n    \r\n    for _ in range(t):\r\n        n = int(i_data[index])\r\n        index += 1 \r\n        \r\n        a = i_data[index : index+n]\r\n        index += n\r\n        \r\n        e_sum = 0\r\n        \r\n        for i in range(1, n+1):\r\n            count = int(a[i-1])\r\n            cf = (h[i-1]+h[n-i])%MOD\r\n            \r\n            e_sum = (e_sum + count *cf)%MOD \r\n        out.append(str(e_sum))\r\n        \r\n    sys.stdout.write('\\n'.join(out)+'\\n')\r\n    \r\n    \r\nif __name__ == '__main__':\r\n    solution()\r\n",
