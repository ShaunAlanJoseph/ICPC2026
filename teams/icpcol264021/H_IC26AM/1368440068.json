  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst int mod= 998244353;\r\nconst int maxn  = 2000005;\r\nll inv[maxn];\r\nll h[maxn];\r\nvoid solve(){\r\n    inv[1]= 1;\r\n    h[0]= 0;\r\n    h[1] = 1;\r\n    for(int i=2;i <maxn; i++){\r\n        inv[i] = (mod - mod/i)*inv[mod%i]%mod;\r\n        h[i] = (h[i-1]+ inv[i])%mod;\r\n    }\r\n}\r\nvoid solving(){\r\n    int n; cin >>n;\r\n    vector<ll> a(n+1);\r\n    for(int i=1; i<=n; i++) cin >> a[i];\r\n    if(n==1){\r\n        cout << 0 << '\\n';\r\n        return;\r\n    }\r\n    ll expected_total =0;\r\n    for(int i=1; i<=n; i++){\r\n        ll expected_occurence = (h[i-1] + h[n-i])%mod;\r\n        ll contribution = (a[i]*expected_occurence)%mod;\r\n        expected_total = (expected_total + contribution)%mod;\r\n        \r\n    }\r\n    cout << expected_total << '\\n';\r\n}\r\nint main() {\r\n\tsolve();\r\n    int t; cin >>t;\r\n    while(t--){\r\n    solving();\r\n    }\r\n}\r\n",
