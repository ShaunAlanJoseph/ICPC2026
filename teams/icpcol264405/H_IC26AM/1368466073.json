  "source_code": "#include<stdio.h>\r\n#include<stdlib.h>\r\n\r\n#define MOD 998244353LL\r\n\r\nint main(){\r\n    int t;\r\n    scanf(\"%d\", &t);\r\n    \r\n    while(t--){\r\n        int n;\r\n        scanf(\"%d\", &n);\r\n        long long *a = malloc(n * sizeof(long long));\r\n        long long *h = calloc(n, sizeof(long long));\r\n        long long *inv = calloc(n, sizeof(long long));\r\n        \r\n        for(int i=0;i<n;i++)\r\n            scanf(\"%lld\", &a[i]);\r\n        if(n>1){\r\n            inv[1]=1;\r\n            for (int i = 2;i<n;i++)\r\n                inv[i] = MOD-(MOD/i) * inv[MOD % i] % MOD;\r\n            for (int i = 1;i<n;i++)\r\n                h[i] = (h[i-1]+inv[i]) % MOD;\r\n        }\r\n        long long ans = 0;\r\n        \r\n        for( int i=0;i<n;i++){\r\n            long long coef = (h[i]+h[n-i-1]) % MOD;\r\n            ans = (ans + a[i] * coef) % MOD;\r\n        }\r\n        \r\n        printf(\"%lld\\n\", ans);\r\n        free(a);\r\n        free(h);\r\n        free(inv);\r\n    }\r\n    return 0;\r\n}",
