  "source_code": "#include <stdio.h>\r\n#define MOD 998244353\r\n#define MAX 200005\r\n\r\nlong long inv[MAX],h[MAX];\r\n\r\nvoid precompute()\r\n{\r\n    inv[1]=1;\r\n    for(int i = 2;i<MAX;i++)\r\n    inv[i] = MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    \r\n    h[0] = 0;\r\n    for(int i=1;i<MAX;i++)\r\n    h[i] = (h[i-1]+inv[i])%MOD;\r\n}\r\n\r\nint main() {\r\n\tint t,n;\r\n\tscanf(\"%d\",&t);\r\n\t\r\n\tprecompute();\r\n\t\r\n\twhile(t--)\r\n\t{\r\n\t    scanf(\"%d\",&n);\r\n\t    long long ans = 0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long x;\r\n\t        scanf(\"%lld\",&x);\r\n\t        long long weight = (h[i-1]+h[n-i])%MOD;\r\n\t        ans = (ans+(x%MOD)*weight)%MOD;\r\n\t    }\r\n\t    printf(\"%lld\\n\",ans);\r\n\t}\r\n\treturn 0;\r\n\t\r\n\r\n}\r\n\r\n",
