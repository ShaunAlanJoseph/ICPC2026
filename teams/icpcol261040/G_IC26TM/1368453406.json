  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    vector<long long> vec(3*n) ;\r\n    for(int i=0;i<3*n;i++) cin >> vec[i] ;\r\n    sort(vec.rbegin(),vec.rend()) ;\r\n    vector<long long> pref(3*n+1) ;\r\n    for(int i=0;i<3*n;i++){\r\n        pref[i+1]=pref[i]+vec[i] ;\r\n    }\r\n    long long ans=0 ;\r\n    for(int i=0;i<=n;i++){\r\n        int l=0 ;\r\n        int r=n-i ;\r\n        while(l<r){\r\n            int mid=(l+r)/2 ;\r\n            int imp=i+2*mid ;\r\n            int last=3*n-2*i-mid-1 ;\r\n            if(vec[imp]+vec[imp+1]>3*vec[last]){\r\n                l=mid+1 ;\r\n            }else{\r\n                r=mid ;\r\n            }\r\n        }\r\n        int a=l ;\r\n        int three_end=3*n-2*i-a ;\r\n        long long one=6*pref[i] ;\r\n        long long two=4*(pref[i+2*a]-pref[i]) ;\r\n        long long three=3*(pref[three_end]-pref[i+2*a]) ;\r\n        ans=max(ans,one+two+three) ;\r\n    }\r\n    cout << ans << endl ;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t ;\r\n    while(t--){\r\n        solve() ;\r\n    }\r\n}\r\n",
