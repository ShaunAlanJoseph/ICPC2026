  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long int\r\nlong long int mod=998244353;\r\nint maxn=200005;\r\nint main() {\r\n\t// your code goes here\r\n    \r\n    vector<ll>inv(maxn),temp(maxn,0);\r\n    \r\n    inv[1]=1;\r\n    for(int j=2;j<maxn;j++)\r\n        inv[j]=(mod-(mod/j)*inv[mod%j]%mod)%mod;\r\n        \r\n    for(int i=1;i<maxn;i++)\r\n    temp[i]=(temp[i-1]+inv[i])%mod;\r\n    \r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        vector<ll>v(n);\r\n        for(auto &i:v)cin>>i;\r\n        for(int i=0;i<n;i++)\r\n        v[i]=v[i]%mod;\r\n        \r\n        ll ans=0;\r\n        for(int i=1;i<=n;i++)\r\n        {\r\n            ll w=(temp[i-1]+temp[n-i])%mod;\r\n            ans=(ans + (v[i-1]%mod)*w)%mod;\r\n            // ans%=mod;\r\n        }\r\n        \r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
