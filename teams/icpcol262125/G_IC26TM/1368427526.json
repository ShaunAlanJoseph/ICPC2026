  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll= long long;\r\n\r\nvoid solve(){\r\n    ll n;\r\n    cin>>n;\r\n    ll totalelements=3*n;\r\n    vector<ll> s(totalelements);\r\n    for(int i=0;i<totalelements;i++) cin>>s[i];\r\n    sort(s.rbegin(),s.rend());\r\n    vector<ll> p(totalelements+1,0);\r\n    for(int i=0;i<totalelements;i++){\r\n        p[i+1]=p[i]+s[i];\r\n    }\r\n    auto eval=[&](int u, int v)->ll{\r\n        return 2*p[u]+p[u+2*v]+3*p[3*n-2*u-v];\r\n    };\r\n    \r\n    ll maxstrength=0;\r\n    \r\n    for(int u=0;u<=n;u++){\r\n        ll lo=0, hi=n-u;\r\n        while(hi-lo>4){\r\n            ll m1=lo+(hi-lo)/3;\r\n            ll m2=hi-(hi-lo)/3;\r\n            if(eval(u,m1)<eval(u,m2)){\r\n                lo=m1;\r\n            }else{\r\n                hi=m2;\r\n            }\r\n        }\r\n        for(int v=lo;v<=hi;v++){\r\n            maxstrength=max(maxstrength,eval(u,v));\r\n        }\r\n    }\r\n    cout<<maxstrength<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ll t; cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
