  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll= long long;\r\nconst int mod=998244353;\r\nconst int maxn=2e5+5;\r\nint inv[maxn];\r\nint h[maxn];\r\nvoid precomp(){\r\n    inv[1]=1;\r\n    for(int i=2;i<maxn;i++){\r\n        inv[i]=(ll)(mod-mod/i)*inv[mod%i]%mod;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<maxn;i++){\r\n        h[i]=(h[i-1]+inv[i])%mod;\r\n    }\r\n}\r\nvoid solve(){\r\n    int n; cin>>n;\r\n    vector<ll> a(n+1);\r\n    for(int i=1;i<=n;i++) cin>>a[i];\r\n    if(n==1){\r\n        cout<<0<<endl;\r\n        return;\r\n    }\r\n    ll ans=0;\r\n    for(int k=1;k<=n;k++){\r\n        ll coeff=(h[k-1]+h[n-k])%mod;\r\n        ans=(ans+(a[k]%mod)*coeff)%mod;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tprecomp();\r\n    ll t; cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
