  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD = 998244353;\r\nconst int MN = 200002;\r\nlong long inv[MN],t1[MN];\r\nvoid precompute(){\r\n    inv[1] = 1;\r\n    for(int i =2;i<MN;i++)\r\n    {\r\n        inv[i] = (MOD - MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    for(int i = 1;i<MN;i++)\r\n    {\r\n        t1[i] = (t1[i-1]+ inv[i]%MOD);\r\n    }\r\n}\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    precompute();\r\n    while(t--){\r\n        long long n;\r\n        cin >> n;\r\n        long long ans = 0,x;\r\n        for(int i =0;i<n;i++)\r\n        {\r\n            cin >> x;\r\n            long long req = (t1[i]+t1[n-1-i])%MOD;\r\n            ans = (ans+(x%MOD)*req)%MOD;\r\n        }\r\n        cout <<  ans << \"\\n\";\r\n    }\r\n}\r\n",
