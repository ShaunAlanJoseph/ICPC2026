  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nint main() {\r\n\tconst ll  mod = 998244353;\r\n\tconst int max_n = 200005;\r\n\tlong long h[max_n];\r\n\t\r\n\tvector<ll> inverse(max_n);\r\n\tinverse[1]=1;\r\n\tfor(int i=2;i<max_n;i++){\r\n\t    inverse[i] = (mod -(mod/i)*inverse[mod%i]%mod)%mod;\r\n\t}\r\n\th[0]=0;\r\n\tfor(int i=1;i<max_n;i++){\r\n\t    h[i] = (h[i-1] +inverse[i])%mod;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans = 0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll a;\r\n\t        cin>>a;\r\n\t        ll times = (h[i-1] + h[n-i])%mod;\r\n\t        ans = (ans+a%mod*times)%mod;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n}\r\n",
