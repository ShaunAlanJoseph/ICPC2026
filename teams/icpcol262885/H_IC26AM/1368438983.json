  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll M = 998244353;\r\n\r\n\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n    \r\n    \r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    \r\n    int T;\r\n    cin >> T;\r\n    vector<ll> h(200001), iv(200001);\r\n    iv[1]=1;\r\n    for(int i=2;i<=200000; i++) iv[i]=M-M/i*iv[M%i]%M;\r\n    for(int i=1;i<=200000;i++) h[i] = (h[i-1]+iv[i])%M;\r\n    \r\n    while(T--){\r\n        int n;cin >>n;\r\n        ll ans = 0, x;\r\n        for(int i=0;i<n;i++){\r\n            cin >> x;\r\n            ans = (ans+x%M*(h[i] + h[n-1-i]))%M;\r\n        }\r\n        cout<< ans << \"\\n\";\r\n    }\r\n}\r\n",
