  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n// void solve(){\r\n//     int n;\r\n//     cin>>n;\r\n//     vector<long\r\n// }\r\n\r\nint main() {\r\n\t// your code goes here\r\n\r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    \r\n    \r\n    int T; cin >> T;\r\n    \r\n   while(T--){\r\n       \r\n    int n;\r\n    cin >> n;\r\n    \r\n    vector<long long> a(3*n),p(3*n+1);\r\n    for(auto &x : a) cin >> x;\r\n    sort(a.rbegin(), a.rend());\r\n    for(int i =0;i<3*n;i++)p[i+1]=p[i]+a[i];\r\n    long long ans = 0;\r\n    \r\n    for(int A =0;A<=n;A++){\r\n        int lo = 0,hi=n-A,K=3*n-2*A;\r\n        while(lo<hi){\r\n            int B =(lo+hi)/2;\r\n            if(a[A+2*B]+a[A+2*B+1]>3*a[K-B-1])lo = B+1;\r\n            else hi = B;\r\n             \r\n        }\r\n        for(int B = max(0,lo-1);B<=lo;B++)\r\n        ans = max(ans,2*p[A]+p[A+2*B]+3*p[K-B]);\r\n    }\r\n    \r\n    \r\n  \r\n    cout << ans<< \"\\n\";\r\n   }\r\n\r\n}",
