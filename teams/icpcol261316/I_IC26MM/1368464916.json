  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll mod=998244353;\r\nint n;\r\nvector<vector<int>>I;\r\nstatic inline int cnt(int lg,int rg,int a,int b){\r\n    int lo=max(lg,a),hi=min(rg,b);\r\n    return hi>=lo ? hi-lo+1 : 0;\r\n}\r\nstatic bool check(int x,int y,int lg,int rg){\r\n    for(int i:I[x]){\r\n        bool pre=(y<=i)&&cnt(lg,rg,1,i)==i/2;\r\n        bool suf=(y>=i)&&cnt(lg,rg,i,n)==(n-i+1)/2;\r\n        if(!pre&&!suf)return false;\r\n    }\r\n    return true;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    I.assign(n+2,{});\r\n\t    for(int i=1;i<=n;i++){\r\n\t        int a;\r\n\t        cin>>a;\r\n\t        I[a].push_back(i);\r\n\t    }\r\n\t    vector<ll>dp(n+2,0),nd(n+2,0);\r\n\t    dp[0]=1;\r\n\t    for(int x=1;x<=n-1;x++){\r\n\t        fill(nd.begin(),nd.end(),0);\r\n\t        for(int u=0;u<=x-1;u++){\r\n\t            if(!dp[u])continue;\r\n\t            int w=x-1-u;\r\n\t            {\r\n\t                int y=u+1;\r\n\t                if(check(x,y,y+1,n-w))nd[u+1]=(nd[u+1]+dp[u])%mod;\r\n\t            }\r\n\t            {\r\n\t                int y=n-w;\r\n\t                if(check(x,y,u+1,y-1))nd[u]=(nd[u]+dp[u])%mod;\r\n\t            }\r\n\t        }\r\n\t        swap(dp,nd);\r\n\t    }\r\n\t    ll ans=0;\r\n\t    for(int u=0;u<=n-1;u++){\r\n\t        if(!dp[u])continue;\r\n\t        if(check(n,u+1,1,0))ans=(ans+dp[u])%mod;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\r\n}\r\n",
