  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<ll>a(3*n);\r\n    for(auto&x:a)cin>>x;\r\n    sort(a.rbegin(),a.rend());\r\n    vector<ll>p(3*n+1,0);\r\n    for(int i=0;i<3*n;i++)p[i+1]=a[i]+p[i];\r\n    ll best=0;\r\n    for(int x=0;x<=n;x++){\r\n        auto h=[&](int m)->ll{\r\n            ll yxz=p[x+2*m];\r\n            return 2*p[x]+yxz+3*p[3*n-2*x-m];\r\n        };\r\n        int lo=0;int hi=n-x;\r\n        while(lo<hi){\r\n            int mid=lo+(hi-lo)/2;\r\n            if(h(mid+1)>h(mid))lo=mid+1;\r\n            else hi=mid;\r\n        }\r\n        best=max(best,h(lo));\r\n    }\r\n    cout<<best<<\"\\n\";\r\n    \r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
