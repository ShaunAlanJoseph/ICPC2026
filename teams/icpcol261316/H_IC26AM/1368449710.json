  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll mod=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    const int N=200005;\r\n    vector<ll>inv(N+1,1),H(N+1,0);\r\n    for(int i=2;i<=N;i++)inv[i]=(mod-(mod/i)*inv[mod%i]%mod)%mod;\r\n    for(int i=1;i<=N;i++)H[i]=(H[i-1]+inv[i])%mod;\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;cin>>n;\r\n        ll ans=0;\r\n        for(int j=1;j<=n;j++){\r\n            ll a;\r\n            cin>>a;\r\n            ans=(ans+a%mod*(H[n-j]+H[j-1])%mod)%mod;\r\n        }\r\n        cout<<ans<<\"\\n\";\r\n    }\r\n}\r\n",
