  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long M = 998244353;\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\tvector<int> vec(t);\r\n\tvector<vector<long long>> temp(t);\r\n\tint maxEle = 0;\r\n\tfor(int i=0;i<t;i++){\r\n\t    cin>>vec[i];\r\n\t    maxEle = max(maxEle,vec[i]);\r\n\t    temp[i].resize(vec[i]);\r\n\t    for(auto &x:temp[i]){\r\n\t        cin>>x;\r\n\t    }\r\n\t}vector<long long> vec2(maxEle+1);\r\n\tif(maxEle>=1){\r\n\t    vec2[1]=1;\r\n\t}for(int i =2;i<=maxEle;i++){\r\n\t    vec2[i]=M-(M/i)*vec2[M%i]%M;\r\n\t}vector<long long> ham(maxEle+1,0);\r\n\tfor(int i = 1;i<=maxEle;i++){\r\n\t    ham[i]=(ham[i-1]+vec2[i])%M;\r\n\t}for(int j=0;j<t;j++){\r\n\t    long long ans =0;\r\n\t    for(int i=0;i<vec[j];i++){\r\n\t        long long c=(ham[i]+ham[vec[j]-1-i])%M;\r\n\t        ans = (ans+temp[j][i]*c)%M;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}return 0;\r\n\r\n}\r\n",
