  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        \r\n        vector<int>v1(3*n+1,0);\r\n        for(int i=1;i<=3*n;i++)cin>>v1[i];\r\n        \r\n        sort(v1.begin()+1,v1.end(),greater<int>());\r\n        \r\n        vector<int>pre = v1;\r\n        \r\n        for(int i=1;i<=3*n;i++)pre[i]+=pre[i-1];\r\n        \r\n        int ans = 0;\r\n        \r\n        for(int i=0;i<=n;i++){\r\n            int lo = 0,hi = n-i;\r\n            \r\n            while(lo<hi){\r\n                int mid = (lo+hi)/2;\r\n                int d = v1[i+2*mid+1] + v1[i+2*mid+2]-3*v1[3*n-2*i-mid];\r\n                \r\n                if(d>0)lo = mid+1;\r\n                else hi = mid;\r\n            }\r\n            \r\n            int x = lo;\r\n            int ans1 = 2*pre[i] + pre[i+2*x]+3*pre[3*n-2*i-x];\r\n            \r\n            ans = max(ans,ans1);\r\n        }\r\n        \r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
