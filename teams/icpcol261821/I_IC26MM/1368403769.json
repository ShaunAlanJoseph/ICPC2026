  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int mod = 998244353;\r\n\r\nbool ok(int v,int l,int r,int pos,int n,vector<vector<int>>&v1){\r\n    for(auto i:v1[v]){\r\n        bool a = pos<=i && (l+max(0ll,i-n+r)==(i+1)/2-1);\r\n        bool b = pos>=i && (r + max(0ll, l-i+1)==(n-i+2)/2-1);\r\n        \r\n        if(!a && !b)return false;\r\n    }\r\n    return true;\r\n}\r\n\r\nint32_t main() {\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<vector<int>>v1(n+1);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        int x;\r\n\t        cin>>x;\r\n\t        v1[x].push_back(i);\r\n\t    }\r\n\t    \r\n\t    \r\n\t    vector<int>cur(1,1),nxt;\r\n\t    \r\n\t    for(int v=1;v<=n;v++){\r\n\t        nxt.assign(v+1,0);\r\n\t        for(int l=0;l<v;l++){\r\n\t            if(!cur[l])continue;\r\n\t            int r = v-1-l;\r\n\t            \r\n\t            if(ok(v,l,r,l+1,n,v1))nxt[l+1] = (nxt[l+1]+cur[l])%mod;\r\n\t            if(v<n && ok(v,l,r,n-r,n,v1))nxt[l] = (nxt[l]+cur[l])%mod;\r\n\t        }\r\n\t        cur.swap(nxt);\r\n\t       // for(auto x:cur)cout<<x<<\" \";\r\n\t    }\r\n\t    int ans = 0;\r\n\t    for(auto x:cur)ans = (ans+x)%mod;\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
