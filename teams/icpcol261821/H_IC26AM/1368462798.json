  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int mod = 998244353;\r\n\r\nint power(int a,int b){\r\n    int res = 1;\r\n    while(b>0){\r\n        if(b&1ll)res = (res*a)%mod;\r\n        b = b/2;\r\n        a = (a*a)%mod;\r\n    }\r\n    return res;\r\n}\r\n\r\nint inv_mod(int a){\r\n    return power(a,mod-2);\r\n}\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    \r\n    int mx = 2*1e5+1;\r\n    \r\n    vector<int>h(mx+1);\r\n    \r\n    h[0] = 0;\r\n    \r\n    for(int i=1;i<=mx;i++){\r\n        h[i] = (h[i-1]+ inv_mod(i))%mod;\r\n    }\r\n    \r\n    \r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        \r\n        vector<int>v1(n+1);\r\n        for(int i=1;i<=n;i++)cin>>v1[i];\r\n        \r\n        int ans = 0;\r\n        \r\n        for(int i=1;i<=n;i++){\r\n            ans = (ans + ((v1[i]%mod)*((h[i-1]+h[n-i])%mod))%mod)%mod;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
