  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    int t;\r\n    cin >> t;\r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        int m = 3*n;\r\n        vector<long long> s(m);\r\n        for(auto &x : s)\r\n        cin >> x;\r\n        sort(s.rbegin(),s.rend());\r\n        vector<long long> P(m+1,0);\r\n        for(int i = 0;i<m;i++)\r\n        P[i+1] = P[i] + s[i];\r\n        long long best = 0;\r\n        for(int a = 0;a<=n;a++)\r\n        {\r\n            auto g =[&](int b) -> long long{\r\n                return 2*P[a]+P[a+2*b] + 3*P[3*n - 2*a-b];\r\n                \r\n            };\r\n            int lo = 0,hi = n-a;\r\n            while(lo<hi)\r\n            {\r\n                int mid = (lo+hi)/2;\r\n                if(g(mid+1)>g(mid))\r\n                lo = mid+1;\r\n                else\r\n                hi = mid;\r\n                \r\n            }\r\n            best = max(best,g(lo));\r\n        }\r\n        cout << best <<'\\n';\r\n        \r\n    }\r\n    return 0;\r\n\t// your code goes here\r\n\r\n}\r\n",
