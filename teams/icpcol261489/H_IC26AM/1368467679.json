  "source_code": "import sys# cook your dish here\r\nMOD = 998244353\r\nMAXN = 200000\r\nH = [0]*(MAXN + 1)\r\ninv = [0] *(MAXN + 1)\r\ninv[1] = 1\r\nfor i in range (2,MAXN+1):\r\n    inv[i] = MOD-(MOD // i) * inv[MOD % i ]% MOD\r\nfor i in range(1,MAXN+1):\r\n    H[i] = (H[i-1] + inv[i]) % MOD\r\ndata = list(map(int,sys.stdin.buffer.read().split()))\r\nt = data[0]\r\npos = 1 \r\nout = []\r\nfor _ in range(t):\r\n    n = data[pos]\r\n    pos += 1 \r\n    a = data[pos:pos+n]\r\n    pos += n\r\n    ans = 0 \r\n    for i in range(n):\r\n        coff = H[i] + H[n-1-i]\r\n        ans = (ans + a[i]*coff)%MOD\r\n    out.append(str(ans))\r\nsys.stdout.write(\"\\n\".join(out))",
