  "source_code": "# cook your dish here\r\nt = int(input())\r\nwhile t:\r\n    t -= 1\r\n    n = int(input())\r\n    a = sorted(map(int,input().split()),reverse = True)\r\n    p=[0]\r\n    for x in a:p.append(p[-1]+x)\r\n    \r\n    b=n\r\n    ans =0\r\n    \r\n    for x in range(n+1):\r\n        if b>n-x: b=n-x\r\n        \r\n        while b:\r\n            f = 3*p[3*n-2*x-b]+2*p[x]+p[x+2*b]\r\n            g = 3*p[3*n-2*x-b+1]+2*p[x]+p[x+2*b-2]\r\n            if g>= f: b-=1\r\n            else: break\r\n        ans = max(ans,3*p[3*n-2*x-b]+2*p[x]+p[x+2*b])\r\n        \r\n    print(ans)\r\n            \r\n    \r\n    ",
