  "source_code": "import sys\r\ninput = sys.stdin.readline\r\n\r\nMOD = 998244353\r\nn= 200000\r\n\r\nh = [0]*(n+1)\r\nfor i in range(1,n+1):\r\n    h[i]= (h[i-1]+pow(i,MOD-2,MOD))\r\n\r\nt = int(input())\r\nout =[]\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    ans =0\r\n    for i in range(n):\r\n        ans = (ans+a[i]*(h[i]+h[n-1-i]))%MOD\r\n    out.append(ans)\r\n    \r\nprint(\"\\n\".join(map(str,out)))\r\n",
