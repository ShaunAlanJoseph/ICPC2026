  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n\r\nconst int MOD = 998244353;\r\nconst int MAXN = 200010;\r\n\r\nll inv[MAXN];\r\nll H[MAXN];\r\n\r\nvoid precompute(){\r\n    inv[1] = 1;\r\n    for(int i = 2;i<MAXN;i++){\r\n        inv[i] = (MOD - (MOD/i)* inv[MOD%i] % MOD) % MOD;\r\n    }\r\n    H[0] = 0;\r\n    for(int i =1;i<MAXN;i++){\r\n        H[i] = (H[i-1] + inv[i]) % MOD;\r\n    }\r\n}\r\nvoid solve(){\r\n    int n ;cin>>n;\r\n    ll ans = 0;\r\n    for(int i =1;i<= n;i++){\r\n        ll a;\r\n        cin>>a;\r\n        ll coeff = (H[i-1] + H[n-i]) % MOD;\r\n        ans = (ans + (a % MOD)* coeff % MOD) % MOD;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nint main() {\r\n    precompute();\r\n\tint test_case;cin>>test_case;\r\n\twhile(test_case--){\r\n\t    solve();\r\n\t}\r\n    return 0;\r\n}\r\n",
