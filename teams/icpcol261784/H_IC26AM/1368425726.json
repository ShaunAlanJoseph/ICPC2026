  "source_code": "#include <stdio.h>\r\n#define MOD 998244353\r\n#define MAX 200005\r\nlong long inv[MAX], h[MAX];\r\n\r\nint main() {\r\n    int t,n;\r\n    scanf(\"%d\",&t);\r\n    \r\n    inv[1]=1;\r\n    for(int i=2;i<MAX;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<MAX;i++){\r\n        h[i]=(h[i-1]+inv[i])%MOD;\r\n    }\r\n    while(t--){\r\n        scanf(\"%d\",&n);\r\n        long long a[MAX>200005?1:n];\r\n        for(int i=0;i<n;i++){\r\n            scanf(\"%lld\",&a[i]);\r\n        }\r\n        long long ans=0;\r\n        for(int i=0;i<n;i++){\r\n            long long c=(h[i]+h[n-1-i])%MOD;\r\n            ans=(ans+(a[i]%MOD)*c)%MOD;\r\n        }\r\n        printf(\"%lld\\n\",ans);\r\n    }\r\n    return 0;\r\n    \r\n\t\r\n\r\n}\r\n\r\n",
