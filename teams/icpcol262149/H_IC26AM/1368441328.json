  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\nconst long long M = 998244353;\r\n\r\nint main() {\r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n\r\n    int T, n;\r\n    cin >> T;\r\n    vector < long long > h(200001);\r\n    for (int i = 1; i <= 200000; i++)\r\n        h[i] = (h[i - 1] + [](long long a, long long b) {\r\n            long long r = 1;\r\n            for (; b; b >>= 1, a = a * a % M)\r\n                if (b & 1) r = r * a % M;\r\n            return r;\r\n        }(i, M - 2)) % M;\r\n\r\n    while (T--) {\r\n        cin >> n;\r\n        long long x, ans = 0;\r\n        for (int i = 1; i <= n; i++)\r\n            cin >> x, ans = (ans + x * (h[i - 1] + h[n - i])) % M;\r\n        cout << ans % M << \"\\n\";\r\n    }\r\n\r\n}",
