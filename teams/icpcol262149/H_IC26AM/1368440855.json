  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long M=998244353;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\t\r\n\tint T,n;\r\n\tcin>>T;\r\n\tvector<long long> h(200001);\r\n\tfor (int i = 1;i<=200000;i++)\r\n\th[i]=(h[i-1]+[](long long a, long long b) {\r\n\t    long long r=1;\r\n\t     for (;b;b>>=1,a=a*a%M)\r\n\t     if (b&1) r=r*a%M;\r\n\t     return r;\r\n\t}(i,M-2))%M;\r\n\t\r\n\twhile (T--){\r\n\t    cin>>n;\r\n\t    long long x, ans=0;\r\n\t    for (int i =1;i<=n;i++)\r\n\t    cin >>x, ans=(ans+x*(h[i-1]+h[n-i]))% M;\r\n\t    cout << ans % M<< \"\\n\";\r\n\t}\r\n\r\n}",
