  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        int m = n * 3;\r\n        vector<ll> a(m);\r\n        for(int i = 0 ; i < m ; i++) cin >> a[i];\r\n        \r\n        sort(a.begin(), a.end(), greater<ll>());\r\n        \r\n        vector<ll> v(m + 1, 0);\r\n        for(int i = 0 ; i < m; i++){\r\n            v[i + 1] = v[i] + a[i];\r\n        }\r\n        auto f = [&](int a, int b)-> ll{\r\n            return 2 * v[a] + v[a + 2 * b] + 3 * v[3 * n - 2 * a - b];\r\n        };\r\n        \r\n        ll ans = 0;\r\n        for(int i = 0 ;i <= n ; i++){\r\n            int l = 0;\r\n            int h = n - i;\r\n            \r\n            while(l < h){\r\n                int mid = (l + h) / 2;\r\n                if(f(i, mid + 1) > f(i, mid)) l = mid + 1;\r\n                else h = mid;\r\n            }\r\n            ans = max(ans, f(i, l));\r\n        }\r\n        cout << ans << endl;\r\n    }\r\n}\r\n",
