  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int m=3*n;\r\n        vector<ll>s(m);\r\n        for(auto &v :s) cin>>v;\r\n        sort(s.begin(),s.end(),greater<ll>());\r\n        \r\n        vector<ll> P(m+1,0);\r\n        for (int i = 0; i < m ; i++) P[i + 1] = P[i] + s[i];\r\n        \r\n        ll best = 0;\r\n        for (int a = 0; a <= n; a++) {\r\n            auto h = [&] (int b) -> ll {\r\n                return P[a + 2 * b]  + 3 * P[m - 2 * a - b];\r\n            };\r\n            \r\n            int lo =0, hi = n - a;\r\n            while (lo < hi) {\r\n                int mid = (lo + hi) /2;\r\n                if (h(mid + 1) > h(mid)) lo = mid + 1;\r\n                else hi = mid;\r\n            }\r\n            \r\n            ll yxz = 2 * P[a] + h(lo);\r\n            best = max(best, yxz);\r\n        }\r\n        cout << best << \"\\n\";\r\n    }\r\n\treturn 0;\r\n\r\n}\r\n",
