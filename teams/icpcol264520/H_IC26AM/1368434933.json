  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200005;\r\nll inv_[MAXN], H[MAXN];\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tinv_[1]=1;\r\n\tfor(int i=2;i<MAXN;i++)\r\n\tinv_[i] = (MOD - (MOD/i) * inv_[MOD%i]%MOD) % MOD;\r\n\tH[0]=0;\r\n\tfor(int i=1;i<MAXN;i++)\r\n\tH[i]=(H[i-1]+inv_[i])%MOD;\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll a;\r\n\t        cin>>a;\r\n\t        ll e=(H[n-i]+H[i-1])%MOD;\r\n\t        ans = (ans + a % MOD * e)%MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\treturn 0;\r\n\t\r\n\r\n}\r\n",
