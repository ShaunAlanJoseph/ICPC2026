  "source_code": "#include <bits/stdc++.h>\r\n#define int long long int\r\nusing namespace std;\r\n\r\nint MAXN = 2e5 + 5;\r\nint MOD = 998244353;\r\nvector<int> h(MAXN);\r\nint binexpo(int base, int ex){\r\n    int res = 1;\r\n    base %=MOD;\r\n    while(ex > 0){\r\n        if(ex & 1) res = (res * base) % MOD;\r\n        base =(base * base) % MOD;\r\n        ex >>= 1;\r\n    }\r\n    return res;\r\n}\r\nint inv(int val){\r\n    return binexpo(val, MOD - 2);\r\n}\r\nvoid pre(){\r\n    h[0] = 0;\r\n    for(int i = 1; i < MAXN; i++){\r\n        h[i] = (h[i - 1] + inv(i)) % MOD;\r\n    }\r\n}\r\nsigned main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    pre();\r\n\tint t;\r\n\tcin>> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >>n;\r\n\t    vector<int> a(n);\r\n\t    int ex = 0;\r\n\t    for(int i = 0; i < n; i++){\r\n\t        cin >> a[i];\r\n\t        int t1 = (h[i] + h[n - i - 1]) % MOD;\r\n\t        int t2 = ((a[i] % MOD) * t1) % MOD;\r\n\t        ex = (ex + t2) % MOD;\r\n\t   }\r\n\t   cout <<ex << endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
