  "source_code": "#include <bits/stdc++.h>\r\n#define int long long int\r\n\r\nusing namespace std;\r\n\r\nint myfunc(int x, int y, int n, vector<int>&pref){\r\n    int z = n - x - y;\r\n    return 2LL*pref[x] + pref[x + 2 * y] + 3 * pref[x + 2 * y + 3 * z];\r\n}\r\nsigned main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    int m = 3 * n;\r\n\t    vector<int>a(m);\r\n\t    for(int i = 0; i<m; i++){\r\n\t        cin >> a[i];\r\n\t    }\r\n\t    sort(a.rbegin(), a.rend());\r\n\t    vector<int> pref(m + 1, 0);\r\n\t    for(int i = 0; i < m; i++){\r\n\t        pref[i + 1] = pref[i] + a[i];\r\n\t        \r\n\t    }\r\n\t    \r\n\t    int ans = 0;\r\n\t    int y = n;\r\n\t    for(int x = 0; x <= n; x++){\r\n\t        if(y > n - x){\r\n\t            y = n - x;\r\n\t        }\r\n\t        while(y > 0 && myfunc(x, y - 1, n, pref) >= myfunc(x, y, n, pref)) y--;\r\n\t        \r\n\t        int xyz = myfunc(x, y, n, pref);\r\n\t        if(xyz > ans){\r\n\t            ans = xyz;\r\n\t        }\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t    \r\n\t    \r\n\t}\r\n\r\n}\r\n",
