  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    \r\n    int m = 3*n;\r\n    \r\n    vector<ll> a(3*n);\r\n    for(auto& x : a) cin >> x;\r\n    sort(a.begin(), a.end(), greater<ll>());\r\n    \r\n    vector<ll> p(m+1, 0);\r\n    \r\n    for(int i=0; i<m; i++) p[i+1] = p[i] + a[i];\r\n    \r\n    ll best = 0;\r\n    for(int x=0; x<=n; x++){\r\n        auto f = [&](int b) -> ll {\r\n            return 2 * p[x] + p[x+2*b] + 3 * p[m - 2 * x - b];\r\n        };\r\n        \r\n        int lo=0, hi=n-x;\r\n        \r\n        while(lo<hi){\r\n            int mid = lo + (hi-lo)/2;\r\n            if(f(mid+1) > f(mid)) lo = mid+1;\r\n            else hi = mid;\r\n        }\r\n        \r\n        best = max(best, f(lo));\r\n    }\r\n    \r\n    cout << best << endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n",
