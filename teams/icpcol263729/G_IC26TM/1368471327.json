  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    n *= 3;\r\n    vector<int> a(n);\r\n    for (int i = 0; i < n; i++) cin >> a[i];\r\n    sort(a.rbegin(), a.rend());\r\n\r\n    vector<int> pref(n+1,0);\r\n    for(int i=1; i<=n; i++) pref[i] = pref[i-1] + a[i-1];\r\n    \r\n    int ans=0;\r\n    for(int i=0; i<=n/3; i++) {\r\n        int lo=0, hi=n/3-i, best=0;\r\n        while(lo<=hi) {\r\n            int m1 = lo + (hi-lo)/3;\r\n            int m2 = hi - (hi-lo)/3;\r\n            \r\n            int sum1 = 6*pref[i] + 4*pref[i+2*m1] - 4*pref[i] + 3*pref[n-m1-2*i] - 3*pref[i+2*m1]; \r\n            int sum2 = 6*pref[i] + 4*pref[i+2*m2] - 4*pref[i] + 3*pref[n-m2-2*i] - 3*pref[i+2*m2];\r\n            \r\n            if(sum1<sum2) lo=m1+1;\r\n            else hi=m2-1;\r\n            \r\n            best = max({best,sum1,sum2});\r\n        }\r\n        \r\n        ans = max(ans, best);\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n\r\nint32_t main() {\r\n    int t = 1;\r\n    cin >> t;\r\n    while (t--) solve();\r\n}",
