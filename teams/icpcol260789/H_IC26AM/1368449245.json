  "source_code": "# cook your dish here\r\nMOD=998244353\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    h=[0]*n\r\n    \r\n    for i in range(1,n):\r\n        h[i]=(h[i-1]+pow(i,MOD-2,MOD))%MOD\r\n    print(sum(a[i]*(h[i]+h[n-1-i]) for i in range(n))%MOD)\r\n    \r\n            \r\n        ",
