  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nint main() {\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;cin>>n;\r\n    vector<ll>a(3*n),P(3*n+1,0);\r\n    for(auto &x:a)\r\n    {\r\n        cin>>x;\r\n        \r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    for(int i=0;i<3*n;i++)\r\n    P[i+1]=P[i]+a[i];\r\n    auto F=[&](int x,int b)\r\n    {\r\n        return 2*P[x]+P[x+2*b]+3*P[3*n-2*x-b];\r\n    };\r\n    ll r=0;\r\n    for(int x=0;x<=n;x++){\r\n        int l=0,h=n-x;\r\n        while(l<h)\r\n        {\r\n            int m=(l+h)/2;\r\n            if(F(x,m+1)>F(x,m))\r\n            l=m+1;\r\n            else\r\n            h=m;\r\n        }\r\n        r=max(r,F(x,l));\r\n    }\r\n    cout<<r<<endl;\r\n    }\r\n\r\n}\r\n",
