  "source_code": "#include <bits/stdc++.h>\r\nusing ll= long long;\r\nusing namespace std;\r\n\r\nint main() {\r\n    // your code goes here\r\n    int t, n, a;\r\n    cin >> t;\r\n    while (t--) {\r\n        cin >> n;\r\n        vector < vector < int >> g(n + 1);\r\n        vector < int > d(n + 2), e;\r\n        d[0] = 1;\r\n        for (int i = 1; i <= n; i++) {\r\n            /* code */\r\n            cin >> a;\r\n            g[a].push_back(i);\r\n            \r\n        }\r\n        for (int x=1; x <= n; x++) {\r\n            /* code */\r\n            e.assign(n+2,0);\r\n            for (int l = 0; l < x; l++) {\r\n                /* code */\r\n                for(int c =0;c<(x < n ? 2 : 1)&& d[l];c++){\r\n                    int r = x - l-1,L=l+!c,R=r+c,o=1;\r\n                    for (int i : g[x]) {\r\n                        /* code */\r\n                        int k = (i+1)/2,j=n-i+1,K=(j+1)/2;\r\n                        o &= (min(i,l)+max(0,i-n+r)<k&&k<=min(i,L)+max(0,i-n+R))||(min(j,r)+max(0,l-i+1)<K&&K<=min(j,R)+ max(0,L-i+1));\r\n                        \r\n                    }\r\n                    if(o)e[L] = (e[L] + d[l])% 998244353;\r\n                    \r\n                }\r\n            }\r\n            d = e;\r\n            \r\n        }\r\n        ll s = 0;\r\n        for(int v : d){\r\n            s += v;\r\n            \r\n            \r\n        }\r\n        cout<<s%998244353<<endl;\r\n        \r\n\r\n    }\r\n}",
