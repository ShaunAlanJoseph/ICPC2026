  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing int64 = long long;\r\nint main() {\r\n\tint T;\r\n\tcin>>T;\r\n\twhile(T){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<int64> a(3 * n);\r\n\t    \r\n\t    for(auto &x : a){\r\n\t        cin>>x;\r\n\t    }\r\n\t    \r\n\t    sort(a.rbegin(), a.rend()); \r\n\t    vector <int64> pref(3*n + 1, 0);\r\n\t    \r\n\t    for(int i = 0; i < (3 * n); i++){\r\n\t        pref[i + 1] = pref[i] + a[i];\r\n\t    }\r\n\t   \r\n\t    auto value = [&](int m, int k) -> int64{\r\n\t        return 2LL * pref[m] + pref[m + 2*k] + 3LL * pref[3 * n-2* m - k];\r\n\t    };\r\n\t    int k=n;\r\n\t    int64 answer = 0;\r\n\t    \r\n\t    for(int m = 0; m <= n; m++){\r\n\t        k = min(k, n - m);\r\n\t        \r\n\t        while(k > 0 && value(m, k - 1) >= value(m , k)){\r\n\t            k--;\r\n\t        }\r\n\t        \r\n\t        answer = max(answer, value(m, k));\r\n\t    }\r\n\t    \r\n\t    cout<<answer<<endl;\r\n\t    T--;\r\n\t}\r\n    return 0;\r\n}\r\n",
