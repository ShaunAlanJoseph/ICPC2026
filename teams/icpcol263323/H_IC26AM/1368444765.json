  "source_code": "# cook your dish here\r\nimport sys\r\ninput=sys.stdin.readline\r\n\r\nMOD=998244353\r\nN=200000\r\n\r\ninv=[0]*(N+1)\r\nh=[0]*(N+1)\r\ninv[1]=1\r\n\r\nfor i in range(2,N+1):\r\n    inv[i]=MOD-(MOD//i)*inv[MOD%i]%MOD\r\n    \r\nfor i in range(1,N+1):\r\n    h[i]=(h[i-1]+inv[i])%MOD\r\n    \r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    ans=0\r\n    \r\n    for i,x in enumerate(a):\r\n        ans+=x*(h[i]+h[n-1-i])\r\n        \r\n    print(ans%MOD)\r\n    ",
