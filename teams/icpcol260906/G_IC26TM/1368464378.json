  "source_code": "# cook your dish here\r\n\r\nT = int(input())\r\n\r\nfor t in range(T):\r\n    n = int(input())\r\n    r = sorted(map(int, input().split()), reverse=True)\r\n    \r\n    pre = [0]\r\n    for x in r:\r\n        pre.append(pre[-1] + x)\r\n        \r\n    ans = 0\r\n    \r\n    for x in range(n+1):\r\n        low, high = 0, n-x\r\n        \r\n        def f(b):\r\n            q = x + 2*b\r\n            a = 3*n - 2*x - b\r\n            return pre[q] + 3*pre[a]\r\n            \r\n        while low < high:\r\n            m = (low+high)//2\r\n            if f(m) <= f(m+1):\r\n                low = m + 1 \r\n            else:\r\n                high = m\r\n        \r\n        b = low\r\n        ans = max(ans, 2*pre[x] + f(b))\r\n            \r\n            \r\n    print(ans)",
