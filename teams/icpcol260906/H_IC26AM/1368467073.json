  "source_code": "# cook your dish here\r\n\r\nT = int(input())\r\n\r\nMOD = 998244353\r\n\r\nfor t in range(T):\r\n    \r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    \r\n    h = [0]*(n+1)\r\n    \r\n    for i in range(1, n+1):\r\n        h[i]=(h[i-1] + pow(i, MOD-2, MOD)) % MOD\r\n        \r\n    ans = 0\r\n        \r\n    for i in range(n):\r\n        w = (h[i] + h[n-i-1]) % MOD\r\n        ans = (ans + a[i]*w) % MOD\r\n        \r\n    print(ans)\r\n        ",
