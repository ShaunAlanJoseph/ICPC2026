  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    int t;\r\n    cin >> t;\r\n    \r\n    while(t--)\r\n    {\r\n        long long n;\r\n        cin >> n;\r\n        \r\n        vector <long long> a(3*n), b(3 *n + 1, 0);\r\n        \r\n        for(auto &x : a)    cin >> x;\r\n        \r\n        sort(a.rbegin(), a.rend());\r\n        \r\n        for(long long i = 0; i < 3*n; i++) b[i+1] =b[i] + a[i];\r\n        \r\n        \r\n        auto f = [&](long long i,long long m){\r\n            return 2LL*b[i] + b[i +2*m] + 3* b[3*n - 2*i - m];\r\n        };\r\n        \r\n        long long ans = 0;\r\n        \r\n        for(long long i=0; i<=n; i++){\r\n            long long lo = 0;\r\n            long long hi = n-i;\r\n            \r\n            while(lo < hi){\r\n                long long mid = lo + (hi-lo)/2;\r\n                if(f(i,mid+1) > f(i,mid)) lo = mid+1;\r\n                else hi = mid;\r\n            \r\n}\r\n            ans = max(ans, f(i,lo));\r\n        }\r\n        \r\n        \r\n        cout << ans << '\\n';\r\n    }\r\n}\r\n",
