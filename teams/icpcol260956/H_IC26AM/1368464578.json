  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\n\r\nconst ll MOD =  998244353;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--) {\r\n        int n;\r\n        cin >> n;\r\n        \r\n        vector<ll> a(n), inv(n+1), h(n+1);\r\n        \r\n        for(auto& x : a) {\r\n            cin >> x;\r\n        }\r\n        \r\n        if(n >= 1) inv[1]=1;\r\n        \r\n        for(int i = 2; i <= n; i++) {\r\n            inv[i] = MOD - (MOD / i) * inv[MOD % i] % MOD;\r\n        }\r\n        \r\n        for(int i = 1; i <= n; i++) {\r\n            h[i] = (h[i-1] + inv[i]) % MOD;\r\n        }\r\n        \r\n        ll ans = 0;\r\n        \r\n        for(int i = 0; i < n; i++) {\r\n            ans = (ans + a[i] * (h[i] + h[n - 1 - i])) % MOD;\r\n        }\r\n        \r\n        cout << ans << '\\n';\r\n    }\r\n}\r\n",
