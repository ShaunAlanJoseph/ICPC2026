  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long mod = 998244353;\r\n\r\nint l = 200000;\r\n\r\nvector<long long>r(l+1);\r\nvector<long long>f(l+1);\r\n\r\nvoid fun(){\r\n    r[1]=1;\r\n    for(int i=2;i<=l;i++){\r\n        r[i] = (mod-(mod/i)*r[mod%i]%mod)%mod;\r\n    }\r\n    \r\n    for(int i=1;i<=l;i++){\r\n        f[i] = (f[i-1]+r[i])%mod;\r\n        if(f[i]>=mod)\r\n            f[i]-=mod;\r\n        \r\n    }\r\n}\r\n\r\n\r\nint main() {\r\n    fun();\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<int>a(n);\r\n\t    \r\n\t    for(int i=0;i<n;i++)\r\n\t        cin>>a[i];\r\n\t        \r\n\t    long long ans = 0;\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        long long temp = (f[i]+f[n-i-1])%mod;\r\n\t        if(temp>=mod){\r\n\t            temp -=mod;\r\n\t        }\r\n\t        \r\n\t        ans = (ans + (a[i]%mod)*temp)%mod;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\t\r\n\r\n}\r\n",
