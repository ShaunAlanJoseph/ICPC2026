  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nusing ll = long long;\r\nconst ll M = 998244353;\r\nconst int N = 200005;\r\n\r\nll h[N] , inv[N]; \r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    inv[1]=1;\r\n    for(int i=2;i<N;i++){\r\n        inv[i]=M-(M/i)*inv[M%i]%M;\r\n    }\r\n        \r\n    for(int i=1;i<N;i++){\r\n        h[i]=(h[i-1]+inv[i])%M;\r\n    }\r\n    \r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        ll ans =0;\r\n        for(int i=1;i<=n;i++){\r\n            ll a;\r\n            cin>>a;\r\n            ll coef = (h[i-1]+h[n-i])%M;\r\n            \r\n            ans =(ans+a*coef)%M;\r\n        }\r\n        cout<<ans<<\"\\n\";\r\n    }\r\n        \r\n        \r\n\r\n}\r\n",
