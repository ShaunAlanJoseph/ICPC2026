  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin>>t;\r\n\tconst int N=200000;\r\n\tvector<ll>inv(N+1),h(N+1);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=N;i++){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\tfor(int i=1;i<=N;i++){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t}\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        ll x;\r\n\t        cin>>x;\r\n\t        ll c=(h[i]+h[n-1-i])%MOD;\r\n\t        ans=(ans+x*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n}\r\n",
