  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing  ll=long long;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int N=3*n;\r\n    vector<ll>a(N);\r\n    for(int i=0;i<N;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.begin(),a.end(),greater<ll>());\r\n    vector<ll>pref(N+1,0);\r\n    for(int i=0;i<N;i++){\r\n        pref[i+1]=pref[i]+a[i];\r\n    }\r\n    auto calc=[&](int c6,int c4)->ll{\r\n        int c3=n-c6-c4;\r\n        int p1=c6;\r\n        int p2=c6+2*c4;\r\n        int p3=p2+3*c3;\r\n        return 6LL*pref[p1]+4LL*(pref[p2]-pref[p1])+3LL*(pref[p3]-pref[p2]);\r\n    };\r\n    ll ans=0;\r\n    for(int c6=0;c6<=n;c6++){\r\n        int lo=0;\r\n        int hi=n-c6;\r\n        while(lo<hi){\r\n            int mid=lo+(hi-lo)/2;\r\n            if(calc(c6,mid)<=calc(c6,mid+1)){\r\n                lo=mid+1;\r\n            }\r\n            else{\r\n                hi=mid;\r\n            }\r\n        }\r\n        ans=max(ans,calc(c6,lo));\r\n    }\r\n    cout<<ans<<'\\n';\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
