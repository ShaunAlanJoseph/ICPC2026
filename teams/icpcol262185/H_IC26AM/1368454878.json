  "source_code": "# cook your dish here\r\nMOD = 998244353\r\n\r\ndef solve():\r\n    ip = int(input())\r\n    tests = []\r\n    big_n = 0\r\n    for i in range(ip):\r\n        n = int(input())\r\n        arr = list(map(int , input().split()))\r\n        tests.append((n,arr))\r\n        big_n = max(big_n , n)\r\n    \r\n    harmonic = [0]*(big_n+1)\r\n    inverse = [0]*(big_n +1)\r\n    \r\n    if big_n >= 1:\r\n        inverse[1] = 1\r\n    for i in range(2,big_n+1):\r\n        inverse[i] = MOD - (MOD//i)*inverse[MOD%i]%MOD\r\n    for i in range(1,big_n+1):\r\n        harmonic[i] = (harmonic[i-1]+inverse[i])%MOD\r\n    for n,arr in tests:\r\n        expected = 0\r\n        for i,value in enumerate(arr):\r\n            left = harmonic[i]\r\n            right = harmonic[n-1-i]\r\n            \r\n            contribution = value*(left+right)\r\n            expected = (expected+contribution)%MOD\r\n        print(expected)\r\nsolve()",
