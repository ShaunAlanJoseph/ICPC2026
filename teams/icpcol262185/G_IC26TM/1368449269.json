  "source_code": "# cook your dish here\r\ndef solve_case(n , ratings):\r\n    ratings.sort(reverse = True)\r\n    prefix = [0]\r\n    for value in ratings:\r\n        prefix.append(prefix[-1] + value)\r\n        \r\n    def team_score(solo,pair):\r\n        used_by_pairs = solo +2*pair\r\n        used_by_full = 3*n-2*solo-pair\r\n        return(\r\n            2*prefix[solo]\r\n            + prefix[used_by_pairs]+\r\n            3*prefix[used_by_full]\r\n            )\r\n    best = 0\r\n    pair = n\r\n    for solo in range(n+1):\r\n        pair = min(pair,n - solo)\r\n        while pair>0:\r\n            current = team_score(solo,pair)\r\n            previous = team_score(solo,pair-1)\r\n            if previous >= current:\r\n                pair -= 1\r\n            else:\r\n                break\r\n        best = max(best , team_score(solo,pair))\r\n    return best\r\n    \r\nip = int(input())\r\nfor i in range(ip):\r\n    n = int(input())\r\n    ratings = list(map(int , input().split()))\r\n    print(solve_case(n,ratings))\r\n    \r\n    \r\n    \r\n    ",
