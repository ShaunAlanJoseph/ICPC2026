  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int N = 3*n;\r\n    vector <long long> p(N+1,0);\r\n    for(int i = 1; i<= N; i++){\r\n        cin>> p[i];\r\n    }\r\n    sort(p.begin()+1 , p.end() , greater<long long>());\r\n    \r\n    for(int i = 1 ; i<=N ; i++) p[i] += p[i-1];\r\n    \r\n    auto e = [&](int k1, int k2){\r\n        return 2LL * p[k1] + p[k1+2*k2] + 3LL * p[N -2 *k1 -k2];\r\n    };\r\n    long long maxs = 0;\r\n    int k1 = 0;\r\n    while (k1 <= n){\r\n        \r\n        int l = 0, r = n- k1;\r\n        \r\n        while(r-l >= 3){\r\n            int m1 = l + (r-l) /3;\r\n            int m2 = r - (r-l) /3;\r\n            if(e(k1,m1) < e(k1,m2)) l = m1;\r\n            else r = m2;\r\n        }\r\n        for( int k2 = l; k2<= r; k2++){\r\n            maxs = max(maxs, e(k1, k2)); \r\n        }\r\n        \r\n        k1++;\r\n    }\r\n    cout<< maxs<<\"\\n\";\r\n}\r\nint main() {\r\n    ios_base::sync_with_stdio (false);\r\n    cin.tie(NULL);\r\n\tint t=1;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n}",
