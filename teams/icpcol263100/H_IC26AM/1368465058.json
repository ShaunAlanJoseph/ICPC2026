  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int mod = 998244353;\r\nconst int maxn = 200005;\r\n\r\nlong long inv[maxn];\r\nlong long H[maxn];\r\n\r\nvoid precom(){\r\n    inv[1] = 1;\r\n    for(int i = 2 ; i< maxn ; i++){\r\n        inv[i] = (mod - mod / i) * inv[mod % i] % mod;\r\n    }\r\n    H[0] = 0;\r\n    for(int i = 1; i< maxn ; i++){\r\n        H[i] = (H[i-1] + inv[i]) % mod;\r\n    }\r\n}\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    long long es = 0;\r\n    for(int i = 0 ; i< n; i++){\r\n        long long a;\r\n        cin>>a;\r\n        \r\n        long long cf = (H[i] + H[n-1-i])% mod;\r\n        es = (es + a*cf) % mod;\r\n    }\r\n    cout << es<<\"\\n\";\r\n}\r\nint main() {\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tprecom();\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n    return 0;\r\n}\r\n",
