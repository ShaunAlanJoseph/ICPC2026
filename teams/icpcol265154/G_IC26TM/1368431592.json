  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint T;\r\n\tcin >> T;\r\n\twhile (T--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    int N = 3*n;\r\n\t    vector<long long>s(N), p(N+1, 0);\r\n\t    for (auto &v: s) cin >> v;\r\n\t    sort(s.rbegin(), s.rend());\r\n\t    for (int i = 0; i<N; i++) p[i+1] = p[i] + s[i];\r\n\t    long long best = 0;\r\n\t    for (int a = 0; a<= n; a++){\r\n\t        auto g = [&](int b){return p[a+2*b] + 3*p[N-2*a-b];};\r\n\t        int lo = 0, hi = n-a;\r\n\t        while(lo < hi){\r\n\t            int m = (lo + hi) / 2;\r\n\t            if (g (m+1) > g(m)) lo = m + 1;\r\n\t            else hi = m;\r\n\t        }\r\n\t        best = max(best, 2 * p[a] + g(lo));\r\n\t    }\r\n\t    cout << best << endl;\r\n\t}\r\n\treturn 0;\r\n\t\r\n}\r\n",
