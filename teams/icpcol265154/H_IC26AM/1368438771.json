  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nconst ll MOD = 998244353;\r\nconst int N = 200005;\r\n\r\nll inv[N], H[N];\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tinv[1]= H[1] = 1;\r\n\tfor (int i = 2; i<N; i++){\r\n\t    inv[i] = (MOD - (MOD/i)* inv [MOD % i] % MOD) % MOD;\r\n\t    H[i] = (H[i -1] + inv[i]) % MOD;\r\n\t}\r\n\tint T;\r\n\tcin >> T;\r\n\twhile (T--){\r\n\t    int n; \r\n\t    cin >> n;\r\n\t    ll ans = 0;\r\n\t    for (int j = 1; j <= n; j++){\r\n\t        ll a;\r\n\t        cin >> a;\r\n\t        ans = (ans + a%MOD * ((H[j-1]+H[n-j])%MOD))%MOD;\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
