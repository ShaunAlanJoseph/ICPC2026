  "source_code": "import sys \r\ninput=sys.stdin.readline\r\n\r\nfor _ in range(int(input())):\r\n    n=int(input()); a=sorted(map(int,input().split()),reverse=True)\r\n    p=[0]\r\n    for x in a:p.append(p[-1]+x)\r\n    ans=0\r\n    for A in range(n+1):\r\n        l,r=0,n-A \r\n        while l<r:\r\n            c=(l+r)//2\r\n            x=2*n-A+c; y=2*n-A-2*c \r\n            if 3*a[x]>=a[y-2]+a[y-1]: l=c+1 \r\n            else:r=c \r\n        for c in (l-1,l):\r\n            if 0<=c<=n-A:\r\n                ans=max(ans,3*p[2*n-A+c]+p[2*n-A-2*c]+2*p[A])\r\n    print(ans)\r\n        \r\n    \r\n",
