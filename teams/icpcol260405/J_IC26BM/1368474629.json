  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n\tstatic String solve(int[] c){\r\n\t    String best=null;\r\n\t    String s[]={\"00\",\"01\",\"10\",\"11\"};\r\n\t    for(int i=0;i<4;i++){\r\n\t        if(c[i]==0)continue;\r\n\t        \r\n\t        int a=c[0];\r\n\t        int b=c[1];\r\n\t        int cc=c[2];\r\n\t        int d=c[3];\r\n\t        a-=(i==0?1:0);\r\n\t        b-=(i==1?1:0);\r\n\t        cc-=(i==2?1:0);\r\n\t        d-=(i==3?1:0);\r\n\t        int x=Math.min(a,b+d);\r\n\t        int y=Math.min(b,(b+d-x)/2);\r\n\t        String res=\"0\".repeat(a+cc+x)+\"01\".repeat(y)+\"1\".repeat(b+d-x-2*y)+s[i];\r\n\t        if(best==null || res.compareTo(best)<0)best=res;\r\n\t        \r\n\t    }\r\n\t    return best;\r\n\t    \r\n\t}\r\n\tpublic static void main(String args[]){\r\n\t    Scanner sc=new Scanner(System.in);\r\n\t    int t=sc.nextInt();\r\n\t    while(t-->0){\r\n\t        int c[]=new int[4];\r\n\t        for(int i=0;i<4;i++){\r\n\t            c[i]=sc.nextInt();\r\n\t            \r\n\t        }\r\n\t        System.out.println(solve(c));\r\n\t    }\r\n\t}\r\n\r\n}",
