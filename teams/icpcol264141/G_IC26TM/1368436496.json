  "source_code": "import sys\r\ndef solve():\r\n    input = sys.stdin.readline\r\n    t = int(input())\r\n    \r\n    for _ in range(t):\r\n        n = int(input())\r\n        a = list(map(int, input().split()))\r\n        a.sort(reverse = True)\r\n        \r\n        m = 3 * n\r\n        pref = [0] * (m + 1)\r\n        for i in range(m):\r\n            pref[i + 1] = pref[i] + a[i]\r\n        def value(x, y):\r\n            p = x + 2 * y\r\n            q = m - 2 * x - y\r\n            return(\r\n                2 * pref[x] + pref[p] + 3 * pref[q]\r\n                )\r\n        ans = 0\r\n            \r\n        y = n\r\n            \r\n        for x in range(n + 1):\r\n            y = min(y, n - x)\r\n            while y > 0 and value(x, y - 1) >= value(x, y):\r\n                y -= 1\r\n            ans = max(ans, value(x, y))\r\n        print(ans)\r\n\r\nif __name__ == \"__main__\":\r\n    solve()\r\n        ",
