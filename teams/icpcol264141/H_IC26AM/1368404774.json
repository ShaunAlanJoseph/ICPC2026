  "source_code": "# cook your dish here\r\nimport sys\r\nMOD = 998244353\r\n\r\ndata = list(map(int, sys.stdin.buffer.read().split()))\r\np = 0\r\nt = data[p]\r\np += 1\r\ntests = []\r\nmx = 0\r\n\r\nfor _ in range(t):\r\n    n = data[p]\r\n    p += 1\r\n    arr = data[p:p + n]\r\n    p += n\r\n    \r\n    tests.append((n, arr))\r\n    if n > mx:\r\n        mx = n\r\nH = [0] * (mx + 1)\r\ninv = [0] * (mx + 1)\r\n\r\nif mx >= 1:\r\n    inv[1] = 1\r\nfor i in range(2, mx + 1):\r\n    inv[i] = MOD - (MOD // i) * inv[MOD % i] % MOD\r\n\r\nfor i in range(1, mx + 1):\r\n    H[i] = H[i - 1] + inv[i]\r\n    if H[i] >= MOD:\r\n        H[i] -= MOD\r\nout = []\r\nfor n, arr in tests:\r\n    ans = 0\r\n    for i, x in enumerate(arr):\r\n        w = H[i] + H[n - 1 - i]\r\n        if w >= MOD:\r\n            w -= MOD\r\n        ans = (ans + x * w) % MOD\r\n    out.append(str(ans))\r\nsys.stdout.write(\"\\n\".join(out))",
