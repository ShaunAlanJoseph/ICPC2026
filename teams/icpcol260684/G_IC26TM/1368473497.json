  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        int n;\r\n        cin >> n;\r\n        int m = 3 * n;\r\n        vector < long long > a(m);\r\n        for (auto & i: a) {\r\n            cin >> i;\r\n        }\r\n        sort(a.begin(), a.end(), greater < long long > ());\r\n        vector < long long > pref(m + 1, 0);\r\n        for (int j = 0; j < m; j++) {\r\n            pref[j + 1] = pref[j] + a[j];\r\n        }\r\n        long long ans = 0;\r\n        for (int p = 0; p <= n; p++) {\r\n            int l = 0, h = n - p;\r\n            auto val = [ & ](int q) -> long long {\r\n                int k = p + 2 * q;\r\n                int M = 3 * n - 2 * p - q;\r\n                return 2LL * pref[p] + pref[k] + 3LL * pref[M];\r\n            };\r\n            while (l < h) {\r\n                int mid = (l + h) / 2;\r\n                if (val(mid) <= val(mid + 1)) l = mid + 1;\r\n                else h = mid;\r\n            }\r\n            ans = max(ans, val(l));\r\n        }\r\n        cout << ans << endl;\r\n\r\n    }\r\n\r\n}",
