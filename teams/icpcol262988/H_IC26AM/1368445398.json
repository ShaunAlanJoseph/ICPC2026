  "source_code": "import sys\r\ndef solve():\r\n    input_data=sys.stdin.read().split()\r\n    if not input_data:\r\n        return\r\n    mod=998244353\r\n    t=int(input_data[0])\r\n    p=1\r\n    out=[]\r\n    N=200000\r\n    inv=[0]*(N+1)\r\n    H=[0]*(N+1)\r\n    if(N>=1):\r\n        inv[1]=1\r\n    for i in range(2,N+1):\r\n        inv[i]=mod-(mod//i)*inv[mod%i]%mod\r\n    for i in range(1,N+1):\r\n        H[i]=(H[i-1]+inv[i])%mod\r\n    for _ in range(t):\r\n        n=int(input_data[p])\r\n        a=[int(x) for x in input_data[p+1:p+1+n]]\r\n        p+=n+1\r\n        ans=sum(x*(H[i]+H[n-i-1])% mod for i,x in enumerate(a)) % mod\r\n        out.append(str(ans))\r\n    print('\\n'.join(out))\r\nif __name__ == '__main__':\r\n    solve()",
