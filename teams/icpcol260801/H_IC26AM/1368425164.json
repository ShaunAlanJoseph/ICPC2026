  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD = 998244353;\r\nconst int MAX_N = 200005;\r\n\r\nlong long inv[MAX_N];\r\nlong long H[MAX_N];\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(NULL);\r\n    \r\n    inv[1] = 1;\r\n    H[0] = 0;\r\n    H[1] = 1;\r\n    \r\n    for(int i = 2; i < MAX_N; i++) {\r\n        inv[i] = (MOD - MOD / i) * inv[MOD % i] % MOD;\r\n        H[i] = (H[i - 1] + inv[i]) % MOD;\r\n    }\r\n    int t;\r\n    cin >> t;\r\n     while(t--) {\r\n         int n;\r\n         cin >> n;\r\n         long long ans = 0;\r\n         for(int i = 1; i <= n; i++) {\r\n             long long a;\r\n             cin >> a;\r\n             long long exp = (H[i - 1] + H[n - i]) % MOD;\r\n             ans = (ans + a * exp) % MOD;\r\n         }\r\n         cout << ans << \"\\n\";\r\n     }\r\n     return 0;\r\n}\r\n",
