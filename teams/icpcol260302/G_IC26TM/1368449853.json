  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\nint calc(int p, int q, int &n, vector<int> &pref){\r\n    int x = p;\r\n    int y = p + (2*q);\r\n    int z = (3*n)-(2*p)-q;\r\n    return ((2LL * pref[x])+(pref[y])+(3LL*pref[z]));\r\n}\r\n\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    vector<int> arr(n * 3);\r\n    for (int i = 0; i < n * 3; i++) {\r\n        cin >> arr[i];\r\n    }\r\n    sort(arr.rbegin(), arr.rend());\r\n    int m = n*3;\r\n    \r\n    vector<int>pref(m+1, 0);\r\n    for(int i=0; i<m; ++i){\r\n        pref[i+1] = pref[i] + arr[i];\r\n    }\r\n    int ans = 0;\r\n    for(int p=0; p<=n; ++p){\r\n        int l = 0, r=n-p;\r\n        while(l<r){\r\n            int  m = (l+r)/2;\r\n            if(calc(p, m, n, pref)<calc(p, m+1, n, pref))l=m+1;\r\n            else r = m;\r\n        }\r\n        ans = max(ans, calc(p, l, n, pref));\r\n    }\r\n    cout<<ans<<endl;\r\n    \r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    int tt;\r\n    cin >> tt;\r\n    while (tt--) {\r\n        solve();\r\n    }\r\n}\r\n",
