  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\n\r\nint main() {\r\n    const int N = 200005;\r\n    vector < long long > inversion(N), height(N);\r\n    inversion[1] = 1;\r\n    for (int i = 2; i < N; i++) inversion[i] = (MOD - (MOD / i) * inversion[MOD % i] % MOD) % MOD;\r\n    height[0] = 0;\r\n    for (int i = 1; i < N; i++) height[i] = (height[i - 1] + inversion[i]) % MOD;\r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        int n;\r\n        cin >> n;\r\n        long long ans = 0;\r\n        for (int j = 1; j <= n; j++) {\r\n            long long h;\r\n            cin >> h;\r\n            ans = (ans + h % MOD * ((height[j - 1] + height[n - j]) % MOD)) % MOD;\r\n        }\r\n        cout << ans << endl;\r\n    }\r\n    return 0;\r\n}",
