  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        int n;\r\n        cin >> n;\r\n        vector < ll > vec(3 * n), arr(3 * n + 1, 0);\r\n        for (auto & x: vec) cin >> x;\r\n        sort(vec.rbegin(), vec.rend());\r\n        for (int i = 0; i < 3 * n; i++) arr[i + 1] = arr[i] + vec[i];\r\n        ll good = 0;\r\n        for (int j = 0; j <= n; j++) {\r\n            auto func = [ & ](int b) {\r\n                return 2 * arr[j] + arr[j + 2 * b] + 3 * arr[3 * n - 2 * j - b];\r\n            };\r\n            int low = 0, high = n - j;\r\n            while (low < high) {\r\n                int mid=(low+high)/2;\r\n                if(func(mid+1)-func(mid)>0)low=mid+1;\r\n                else high=mid;\r\n            }\r\n            good=max(good,func(low));\r\n        }\r\n        cout<<good<<endl;\r\n    }\r\n}",
