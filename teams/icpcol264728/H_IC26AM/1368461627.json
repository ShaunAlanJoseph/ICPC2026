  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200005;\r\nll inv [MAXN], H[MAXN];\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(0);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<MAXN;i++){\r\n\t    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tH[0]=0;\r\n\tfor(int i =1;i<MAXN;i++){\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<ll>a(n+1);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    ll answer = 0;\r\n\t    for(int k=1;k<=n;k++){\r\n\t        ll depth=(H[k-1]+H[n-k])%MOD;\r\n\t        answer=(answer+a[k]%MOD*depth)%MOD;\r\n\t    }\r\n\t    cout<<answer<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
