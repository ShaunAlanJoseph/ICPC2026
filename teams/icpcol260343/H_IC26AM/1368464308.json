  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD=998244353;\r\nconst int N=200005;\r\nlong long inv[N],H[N];\r\n\r\nint main() {\r\n    inv[1]=1;\r\n    for(int i=2;i<N;i++){\r\n        inv[i]=(MOD -(MOD/i) * inv[MOD % i] % MOD) % MOD;\r\n    }\r\n    for(int i = 1; i < N; i++)\r\n        H[i] = (H[i - 1] + inv[i]) % MOD;\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        long long ans = 0;\r\n        for(int j = 1; j <= n; j++){\r\n            long long a ;\r\n            cin >> a;\r\n            ans = (ans + a % MOD *((H[j - 1] + H[n - j]) % MOD)) % MOD;\r\n        }\r\n        cout << ans << endl;\r\n    }\r\n    return 0;\r\n}\r\n",
