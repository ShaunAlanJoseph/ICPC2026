  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint n;\r\nvector<ll> P;\r\n\r\nll f(int p, int k2) {\r\n    return P[p + 2 * k2] + 3 * P[3 * n - 2 * p - k2];\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        cin >> n;\r\n        vector<ll> a(3*n);\r\n        for(auto &v : a){\r\n            cin >> v;\r\n        }\r\n        sort(a.begin(), a.end(), greater<ll>());\r\n        P.assign(3 * n + 1, 0);\r\n        for(int i = 0; i < 3 * n; i++) P[i + 1] = P[i] + a[i];\r\n        \r\n        ll best = 0;\r\n        for(int p = 0; p <= n; p++){\r\n            int lo = 0 , hi = n - p;\r\n            while(lo < hi){\r\n                int mid = (lo + hi) / 2;\r\n                if(f(p,mid + 1) - f(p,mid) > 0) lo = mid + 1;\r\n                else hi = mid;\r\n            }\r\n            best = max(best, 2 * P[p] + f(p,lo));\r\n        }\r\n        cout << best << endl;\r\n    }\r\n    return 0;\r\n}\r\n",
