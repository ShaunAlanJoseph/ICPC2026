  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long mod=998244353;\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n    int t;\r\n    cin>>t;\r\n    const int maxn=200000;\r\n    vector<long long>inv(maxn+1);\r\n    inv[1]=1;\r\n    for(int i=2;i<=maxn;i++){\r\n        inv[i]=mod-(mod/i)*inv[mod%i]%mod;\r\n    }\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<long long>a(n);\r\n        for(int i=0;i<n;i++){\r\n            cin>>a[i];\r\n        }\r\n        if(n==1){\r\n            cout<<0<<endl;\r\n            continue;\r\n        }\r\n        vector<long long>h(n+1,0);\r\n        for(int i=1;i<=n;i++){\r\n            h[i]=(h[i-1]+inv[i])%mod;\r\n        }\r\n        long long ans=0;\r\n        for(int i=0;i<n;i++){\r\n            long long coef=(h[i]+h[n-i-1])%mod;\r\n            ans=(ans+a[i]*coef)%mod;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
