  "source_code": "# cook your dish here\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    arr =sorted(map(int, input().split()), reverse = True)\r\n    m = 3 * n\r\n    p = [0] * (m + 1)\r\n    s = 0\r\n    for k in range(m):\r\n        s += arr[k]\r\n        p[k + 1] = s\r\n    maxi = 0\r\n    b = n\r\n    for i in range(n + 1):\r\n        if b > n - i:\r\n            b = n - i\r\n        q = m - 2 * i\r\n        while b > 0 and p[i + 2 * b - 2] + 3 * p[q - b + 1] >= p[i + 2*b] + 3 * p[q - b]:\r\n            b -= 1\r\n        temp = 2 * p[i] + p[i + 2*b] + 3 * p[q - b]\r\n        if temp > maxi:\r\n            maxi = temp\r\n    print(maxi)\r\n    \r\n    ",
