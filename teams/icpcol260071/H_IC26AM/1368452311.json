  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\nconst int MAXN=200000;\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    vector<ll> inv(MAXN+1);\r\n    vector<ll> H(MAXN+1,0);\r\n    inv[1]=1;\r\n    for(int i=2;i<=MAXN;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    for(int i=1;i<=MAXN;i++){\r\n        H[i]=(H[i-1]+inv[i])%MOD;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        ll ans=0;\r\n        for(int i=1;i<=n;i++){\r\n            ll a;\r\n            cin>>a;\r\n            ll coefficient=(H[i-1]+H[n-i])%MOD;\r\n            ans=(ans+ a*coefficient)%MOD;\r\n        }\r\n        cout<<ans<<'\\n';\r\n    }\r\n    return 0;\r\n\r\n}\r\n",
