  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n    ios::sync_with_stdio(0);cin.tie(0);\r\n    int t;cin>>t;\r\n    while(t--){\r\n        int n;cin>>n;int m=3*n;\r\n        vector<ll>a(m),S(m+1,0);\r\n        for(auto & x:a)cin>>x;\r\n        sort(a.rbegin(),a.rend());\r\n        for(int i=0;i<m;i++)S[i+1]=S[i]+a[i];\r\n        ll r=0;\r\n        for(int p=0;p<=n;p++){\r\n            auto F=[&](int q){\r\n                int e=m-2*p-q,k=p+2*q;\r\n                return 6*S[p]+4*(S[k]-S[p])+3*(S[e]-S[k]);\r\n            };\r\n            int lo=0,hi=n-p;\r\n            while(lo<hi){\r\n                int md=(lo+hi)/2;\r\n                if(F(md+1)>F(md)) lo=md+1; else hi=md;\r\n            }\r\n            r=max(r,F(lo));\r\n        }\r\n        cout<<r<<\"\\n\";\r\n    }\r\n\t\r\n\r\n}\r\n",
