  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD=998244353LL;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tconst int MAX=200001;\r\n\tvector<long long> inv(MAX+1,0),H(MAX+1,0);\r\n\tinv[1]=1;\r\n\t\r\n\tfor (int i=2;i<=MAX;i++){\r\n\t    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tfor(int i=1;i<=MAX;i++){\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t}\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    long long ans=0;\r\n\t    for(int j=1;j<=n;j++){\r\n\t        long long a;\r\n\t        cin >> a;\r\n\t        long long coef=(H[j-1]+H[n-j])%MOD;\r\n\t        ans=(ans+a%MOD*coef)%MOD;\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
