  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nconst ll helll=998244353;\r\nconst int maxN=2e5+10;\r\nint main() {\r\n\t// your code goes here\r\n    ll t;\r\n    cin>>t;\r\n    vector<ll> inv(maxN+1),pref(maxN+1,0);\r\n    inv[1]=1;\r\n    for(int i=1;i<=maxN;i++){\r\n        if(i>1){\r\n            inv[i]=helll-(helll/i)*inv[helll%i]%helll;\r\n        }\r\n        pref[i]=(pref[i-1]+inv[i])%helll;\r\n    }\r\n    while(t--){\r\n        ll n;\r\n        cin>>n;\r\n        vector<ll> v(n);\r\n        for(int i=0;i<n;i++){\r\n            cin>>v[i];\r\n        }\r\n        ll ans=0;\r\n        for(int i=0;i<n;i++){\r\n            ll curr=v[i];\r\n            ll add=(pref[n-1-i]+pref[i])%helll;\r\n            ans=(ans+(add*curr)%helll)%helll;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
