  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n#define all(v) v.begin(),v.end()\r\nint main() {\r\n\tll t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    ll n;\r\n\t    cin>>n;\r\n\t    vector<ll> v(3*n);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        cin>>v[i];\r\n\t    }\r\n\t    sort(v.rbegin(),v.rend());\r\n\t    vector<ll> pref(3*n+5,0);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        pref[i+1]=pref[i]+v[i];\r\n\t    }\r\n\t    ll ans=0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        ll a=i;\r\n\t        ll lo=0,hi=n-i;\r\n\t        while(lo<hi){\r\n\t            ll mid=lo+(hi-lo)/2;\r\n\t            ll b=a+2*mid;\r\n\t            ll c=b+3*(n-a-mid);\r\n\t            \r\n\t            ll ans1=6*pref[a]+4*(pref[b]-pref[a])+3*(pref[c]-pref[b]);\r\n\t            ll ans2=6*pref[a]+4*(pref[b+2]-pref[a])+3*(pref[c-1]-pref[b+2]);\r\n\t            \r\n\t            if(ans2>ans1){\r\n\t                lo=mid+1;\r\n\t            } else {\r\n\t                hi=mid;\r\n\t            }\r\n\t        }\r\n\t        ll b=a+2*lo;\r\n\t        ll c=b+3*(n-a-lo);\r\n\t        ans=max(ans,6*(pref[a])+4*(pref[b]-pref[a])+3*(pref[c]-pref[b]));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
