  "source_code": "# cook your dish her\r\nt= int(input())\r\nans = []\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n        \r\n    a.sort(reverse = True)\r\n    N = 3*n\r\n        \r\n    pref = [0]* (N +1)\r\n    for i in range(N):\r\n        pref[ i+1] = pref[i] + a [i]\r\n    best = 0\r\n            \r\n        \r\n    for A in range (n + 1):\r\n        max_B = n - A\r\n        lo = 0\r\n        hi = max_B\r\n        while lo < hi:\r\n            B = (lo + hi)//2\r\n            x = A+ 2* B\r\n            y=  N -2 * A - B\r\n            delta = a[x] + a[x + 1]- 3 * a[y - 1]\r\n                \r\n            if delta >= 0:\r\n                lo= B + 1\r\n            else:\r\n                hi = B \r\n        B = lo\r\n            \r\n        current =(\r\n            2* pref[A]\r\n            + pref [A+2*B]\r\n            + 3 * pref [N-2* A - B]\r\n        )\r\n            \r\n        best = max(best,current)\r\n            \r\n    ans.append (str(best))\r\n        \r\n    \r\nprint(\"\\n\".join(ans))\r\n     ",
