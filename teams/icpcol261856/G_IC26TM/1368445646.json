  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m=3*n;\r\n\t    vector<long long>a(m);\r\n\t    for(auto &x:a) cin>>x;\r\n\t    sort(a.begin(),a.end(),greater<long long>());\r\n\t    \r\n\t    vector<long long>pre(m+1,0);\r\n\t    for(int i=0;i<m;i++){\r\n\t        pre[i+1]=pre[i]+a[i];\r\n\t        \r\n\t    }\r\n\t    auto d=[&](int x,int y)->long long{\r\n\t        int z=n-x-y;\r\n\t        int a=x;\r\n\t        int b=x+2*y;\r\n\t        int c=x+2*y+3*z;\r\n\t        \r\n\t        return 6LL*pre[a]+4LL*(pre[b]-pre[a])+3LL*(pre[c]-pre[b]);\r\n\t    };\r\n\t    \r\n\t    long long ans=0;\r\n\t    for(int x=0;x<=n;x++){\r\n\t        int lo=0;\r\n\t        int hi=n-x;\r\n\t        \r\n\t        while(lo<hi){\r\n\t            int mid=(lo+hi)/2;\r\n\t            if(d(x,mid)<=d(x,mid+1)) lo=mid+1;\r\n\t            else hi=mid;\r\n\t        }\r\n\t        ans=max(ans,d(x,lo));\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
