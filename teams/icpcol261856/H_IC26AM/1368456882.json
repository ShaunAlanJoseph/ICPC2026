  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nconst int MAXN=200005;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tvector<long long>inv(MAXN),h(MAXN);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<MAXN;i++){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\tfor(int i=1;i<MAXN;i++){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(n);\r\n\t    for(int i=0;i<n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        long long c=(h[i]+h[n-1-i])%MOD;\r\n\t        ans=(ans+a[i]*c)%MOD;\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n\treturn 0;\r\n}\r\n",
