  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    MOD = 998244353\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0])\r\n    pos=1\r\n    N=200001\r\n    inv=[0,1]+[0]*(N-1)\r\n    for i in range(2,N+1):\r\n        inv[i]=(MOD-(MOD//i)*inv[MOD%i]%MOD)%MOD\r\n    H=[0]*(N+1)\r\n    for i in range(1,N+1):\r\n        H[i]=(H[i-1]+inv[i])%MOD\r\n    out=[]\r\n    for _ in range(t):\r\n        n= int(data[pos]); pos+=1\r\n        total=0\r\n        for j in range(1,n+1):\r\n            a=int(data[pos+j-1])\r\n            total += a*(H[n-j]+H[j-1])\r\n        pos+=n\r\n        out.append(total%MOD)\r\n    print(\"\\n\".join(map(str,out)))\r\nmain()",
