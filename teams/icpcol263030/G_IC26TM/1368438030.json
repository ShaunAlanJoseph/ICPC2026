  "source_code": "# cook your dish here\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    \r\n    a = list(map(int, input().split()))\r\n    \r\n    a.sort(reverse = True)\r\n    \r\n    S = [0] * (3 * n + 1)\r\n    for x in range(3 * n):\r\n        S[x + 1] = S[x] + a[x]\r\n        \r\n    best = 0\r\n    \r\n    for i in range(n + 1):\r\n        L = max(0, 2 * n - i)\r\n        R = 3 * n - 2 * i \r\n        \r\n        while R - L > 2:\r\n            m1 = L + (R - L) // 3\r\n            m2 = R - (R -L) // 3\r\n            \r\n            val1 = S[6 * n -3 * i -2 * m1] + 3* S[m1]\r\n            val2 = S[6 * n -3 * i - 2 * m2] + 3 * S[m2]\r\n            \r\n            if val1 < val2:\r\n                L = m1\r\n                \r\n            else:\r\n                R = m2\r\n                \r\n        for k in range(L, R + 1):\r\n            val = 2 * S[i] + S[6 * n-3 * i - 2 * k] + 3 * S[k]\r\n            if val > best:\r\n                best = val\r\n                \r\n                \r\n    print(best)\r\n            ",
