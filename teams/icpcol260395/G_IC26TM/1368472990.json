  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int MAXM=600005;\r\nlong long a[MAXM];\r\nlong long pref[MAXM];\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int m=3*n;\r\n    vector<long long >a(m);\r\n    for(int i=0;i<m;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    pref[0]=0;\r\n    for(int i=0;i<m;i++){\r\n        pref[i+1]=pref[i]+a[i];\r\n    }\r\n    long long mx=0;\r\n    for(int k=0;k<=n;k++){\r\n        int l=0,r=k-1,best=0;\r\n        while(l<=r){\r\n            int mid=l+(r-l)/2;\r\n\r\n            if(2LL * a[mid]-a[2*k-mid-1]- 3LL* a[m-k-mid-1] >0){\r\n                best=mid+1;\r\n                l=mid+1;\r\n                \r\n            }\r\n            else{\r\n                r=mid-1;\r\n            }\r\n        }\r\n       for(int i=max(0,best-1);i<=min(k,best+1);++i){\r\n           long long curr=2LL* pref[i]+pref[2*k-i] + 3LL * pref[m-k-i];\r\n           mx=max(mx,curr);\r\n       }\r\n        \r\n    }\r\n    cout<<mx<<\"\\n\";\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tif(cin>>t){\r\n\t    while(t--){\r\n\t        solve();\r\n\t    }\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
