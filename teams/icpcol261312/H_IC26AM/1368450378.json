  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nusing vll = vector<long long>;\r\nstatic const ll MOD = 998244353;\r\nconst int MX = 200005;\r\n\r\nint solve(vll &inv, vll &H)\r\n{\r\n    ll n, ans = 0;\r\n    cin>>n;\r\n    vll a(n);\r\n    for(ll i=1;i<=n;i++)\r\n    {\r\n        ll val;\r\n        cin>>val;\r\n        ll coefficient = (H[i-1]+H[n-i]) % MOD;\r\n        ans = (ans + val % MOD * coefficient) % MOD;\r\n    }\r\n    \r\n    cout<<ans<<endl;\r\n    return 0;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n   int t;\r\n   cin>>t;\r\n    vll inv(MX+1) , H(MX+1,0);\r\n    inv[1] = 1;\r\n    for(ll i=2;i<=MX;i++)\r\n       inv[i] = (MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n    \r\n    for(ll i=1;i<=MX;i++)\r\n       H[i] = (H[i-1]+inv[i])%MOD;\r\n       \r\n   while(t--)\r\n   {\r\n       solve(inv,H);\r\n   }\r\n}\r\n",
