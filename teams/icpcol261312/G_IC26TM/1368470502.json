  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long; \r\nusing vll = vector<long long>;   \r\n\r\nll find(vll &S, ll n, ll i, ll w)\r\n{\r\n    return  S[6*n-3*i-2*w] + 3ll * S[w];\r\n}\r\n\r\nint solve()\r\n{\r\n    ll n;\r\n    cin>>n;\r\n    ll m = 3*n;\r\n    vll a(m);\r\n    for(auto &val:a) cin>>val;\r\n    sort(a.rbegin(),a.rend());\r\n    vll S(m+1,0);\r\n    for(int i=0;i<m;i++)\r\n      S[i+1] = S[i] + a[i];\r\n    \r\n    ll ans = 0;\r\n    for(ll i=0;i<=n;i++)\r\n    {\r\n        ll low = 2*n-i , high = 3*n-2*i;\r\n        ll l = low, h = high;\r\n        while(l<h)\r\n        {\r\n            ll mid = (l+h)/2;\r\n            if(find(S,n,i,mid+1)>find(S,n,i,mid))  l = mid+1;\r\n            else h = mid;\r\n        }\r\n        ans = max(ans, 2*S[i]+find(S,n,i,l));\r\n    }\r\n    \r\n    cout<<ans<<endl;\r\n    return 0;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--)\r\n    {\r\n        solve();\r\n    }\r\n    return 0;\r\n}\r\n",
