  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nvector<ll> a, pref;\r\nint n;\r\n\r\nll score(int x, int y) {\r\n    int p = x+2 * y;\r\n    int q = 3*n-2 * x - y;\r\n    return 3 * pref[q] + pref[p] + 2 * pref[x];\r\n}\r\n\r\nint best(int x) {\r\n    int l = 0, r = n-x;\r\n    \r\n    while(l<r) {\r\n        int y = (l+r+1)/2;\r\n        int p = x +2 * (y - 1);\r\n        int q = 3 * n-2 * x - (y-1);\r\n        \r\n        ll diff = a[p] + a[p+1] - 3 * a[q-1];\r\n        if(diff >= 0) l = y;\r\n        else r = y-1;\r\n    }\r\n    return l;\r\n}\r\n\r\nvoid solve() {\r\n\tcin >> n; \r\n\ta.resize(3*n);\r\n\t\r\n\tfor(ll &x: a) cin >> x;\r\n\t\r\n\tsort(a.rbegin(), a.rend());\r\n\t\r\n\tpref.assign(3*n+1, 0);\r\n\t\r\n\tfor(int i =0; i<3*n; i++) {\r\n\t    pref[i+1] = pref[i] + a[i];\r\n\t}\r\n\t\r\n\tll ans = 0;\r\n\tfor(int x = 0; x<=n; x++) {\r\n\t    int y = best(x);\r\n\t    ans = max(ans, score(x, y));\r\n\t}\r\n\tcout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t; cin >> t;\r\n    while(t--) solve();\r\n}\r\n",
