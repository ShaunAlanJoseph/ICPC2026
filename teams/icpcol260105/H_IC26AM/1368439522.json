  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\n\r\nconst int MOD = 998244353;\r\nconst int MX = 200000;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    vector<ll> a(MX + 1);\r\n    a[1] = 1;\r\n    \r\n    for(int i = 2; i<=MX; i++) a[i] = MOD - (MOD/i) * a[MOD % i] %MOD;\r\n    \r\n    vector<ll> harmonic(MX +1 , 0);\r\n    \r\n    for(int i = 1; i<=MX; i++) harmonic[i] = (harmonic[i-1] + a[i]) %MOD;\r\n    \r\n    int t; cin >> t;\r\n    while(t--) {\r\n        int n; cin >> n;\r\n        vector<ll> b(n+1);\r\n        for(int i = 1; i<=n; i++) {\r\n            cin >> b[i];\r\n        }\r\n        \r\n        ll ans = 0;\r\n        for(int i = 1; i<=n; i++) {\r\n            ll coef = (harmonic[i-1] + harmonic[n-i]) %MOD;\r\n            ans = (ans + b[i] * coef) %MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
