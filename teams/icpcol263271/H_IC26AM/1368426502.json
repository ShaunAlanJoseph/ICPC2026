  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nconst int mod = 998244353;\r\n\r\nint modinv(int x) {\r\n    int r = 1, pw = mod - 2;\r\n    while (pw) {\r\n        if (pw & 1) {\r\n            r = r * x % mod;\r\n        }\r\n        pw >>= 1;\r\n        x = x * x % mod;\r\n    }\r\n    return r;\r\n}\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    vector<int> dp(n + 1);\r\n    for (int i = 1, sm = 0; i <= n; i++) {\r\n        dp[i] = (sm * modinv(i) + 1) % mod;\r\n        sm = (sm + dp[i]) % mod;\r\n    }\r\n    int res = 0;\r\n    for (int i = 1; i <= n; i++) {\r\n        int mul = (dp[i - 1] + dp[n - i]) % mod;\r\n        \r\n        int x;\r\n        cin >> x;\r\n        \r\n        res = (res + mul * x) % mod;\r\n    }\r\n    cout << res;\r\n}\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        solve();\r\n        cout << \"\\n\";\r\n    }\r\n}\r\n",
