  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef{\r\n            static final long MOD = 998244353L;\r\n            static final int MAX = 200000;\r\n\t        public static void main (String[] args) throws java.lang.Exception\r\n\t    {\r\n\t\t// your code goes here\r\n\t\tScanner sc = new Scanner(System.in);\r\n\t\tlong[] inv = new long[MAX +1];\r\n\t\tlong[] h = new long[MAX +1];\r\n\t\tinv[1] = 1;\r\n\t\tfor(int i=2;i<=MAX;i++){\r\n\t\t    inv[i] =MOD -(MOD/i) *inv[(int)(MOD%i)] %MOD;\r\n\t\t}\r\n\t\tfor(int i=1;i<=MAX;i++){\r\n\t\t    h[i] = (h[i-1] + inv[i]) %MOD;\r\n\t\t}\r\n\t\tint t= sc.nextInt();\r\n\t\twhile(t-->0){\r\n\t\t    int n= sc.nextInt();\r\n\t\t    long ans = 0;\r\n\t\t    for(int i=0;i<n;i++){\r\n\t\t        long a =sc.nextLong();\r\n\t\t        long coefficient = (h[i] + h[n-1-i]) % MOD;\r\n\t\t        ans = (ans + a*coefficient) %MOD;\r\n\t\t    }\r\n\t\t    System.out.println(ans);\r\n\t\t}\r\n\t\tsc.close();\r\n\r\n\t}\r\n}\r\n",
