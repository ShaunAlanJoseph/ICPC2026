  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\nint32_t main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<int> v(3*n);\r\n        for(int i=0;i<3*n;i++) cin>>v[i];\r\n        sort(v.rbegin(),v.rend());\r\n        vector<int> pr(3*n+1,0);\r\n        for(int i=1;i<=3*n;i++) pr[i]=pr[i-1]+v[i-1];\r\n        auto c=[&](int a,int b) -> int {\r\n            return 2ll*pr[a]+pr[a+2*b]+3ll*pr[3*n-2*a-b];\r\n        };\r\n        int ans=0;\r\n        // ans =max(ans,c(0,n));\r\n        for(int a=0;a<=n;a++){\r\n            int l=0,h=n-a;\r\n            while(l<h){\r\n                int mid=(l+h)/2;\r\n                int v1=c(a,mid);\r\n                int v2=c(a,mid+1);\r\n                if(v1<=v2) l=mid+1;\r\n                else h=mid;\r\n                ans=max(ans,c(a,l));\r\n            }\r\n            ans=max(ans,c(a,0));\r\n            ans=max(ans,c(a,n-a));\r\n        }\r\n        cout<<ans<<\"\\n\";\r\n    }\r\n}\r\n",
