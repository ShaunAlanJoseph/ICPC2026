  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll MOD = 998244353;\r\nconst int N = 200005;\r\nll inv[N],h[N];\r\nint main() {\r\n\t// your code goes here \r\n\tinv[1] = 1;\r\n\tfor(int i = 2;i<N;i++) {\r\n\t    inv[i] = MOD - (MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\th[0] = 0;\r\n\tfor(int i = 1;i<N;i++) {\r\n\t    h[i] = (h[i-1] + inv[i]) % MOD;\r\n\t}\r\n    int t;\r\n    cin>>t;\r\n    while(t--) {\r\n        int n;\r\n        cin>>n;\r\n        vector<ll>a(n);\r\n        for(int i = 0;i<n;i++) {\r\n            cin>>a[i];\r\n        }\r\n        ll ans = 0;\r\n        for(int i = 0;i<n;i++) {\r\n            ll e = (h[i] + h[n-1-i])%MOD;\r\n            ans = (ans + a[i] * e) % MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
