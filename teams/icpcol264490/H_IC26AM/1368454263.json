  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long mod = 998244353 ;\r\n\r\nvector<long long> findh(int n){\r\n    vector<long long> inverse(n+1);\r\n    vector<long long> h(n+1);\r\n    \r\n    inverse[1] = 1 ;\r\n    for(int i=2 ; i<=n ; i++){\r\n        inverse[i] = (mod - mod / i) * inverse[mod%i]%mod;\r\n    }\r\n    for(int i=1 ; i<=n ; i++){\r\n        h[i] = (h[i-1] + inverse[i])%mod ;\r\n    }\r\n    return h ;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t ;\r\n\tcin >> t ;\r\n\t\r\n\twhile(t--){\r\n\t    int n ;\r\n\t    cin >> n ;\r\n\t    \r\n\t    vector<long long> arr(n);\r\n\t    for(int i=0 ; i<n ; i++){\r\n\t        cin >>arr[i];\r\n\t    }\r\n\t    \r\n\t    vector<long long> h = findh(n);\r\n\t    long long answer = 0 ;\r\n\t    for(int i=0 ; i<n ; i++){\r\n\t        long long coef = (h[i] + h[n-1-i]) %mod ;\r\n\t        answer = (answer + coef * arr[i]) % mod ;\r\n\t    }\r\n\t    cout << answer << endl ;\r\n\t}\r\n\r\n}\r\n",
