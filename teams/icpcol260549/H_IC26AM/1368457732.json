  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n    const int N = 200005;\r\n    vector<ll> inv(N + 1), H(N + 1);\r\n    inv[1] = 1;\r\n    for(int i = 2;i <= N ; i++) {inv[i] = (MOD - (MOD / i) * inv[MOD % i] % MOD) % MOD;\r\n    H[i] = (H[i - 1] + inv[i] % MOD);}\r\n    for(int i = 1; i <=N;i++) H[i] = H[i -1] + inv[i] % MOD;\r\n    int t;\r\n    scanf(\"%d\",&t);\r\n    while(t--){\r\n        int n;\r\n        scanf(\"%d\",&n);\r\n        ll ans = 0;\r\n        for(int j = 1;j <= n ;j++){\r\n            ll a;\r\n            scanf(\"%lld\", &a);\r\n            ll w = (H[j -1] + H[n - j]) % MOD;\r\n            ans = ( ans + a % MOD * w) % MOD;\r\n        }\r\n        printf(\"%lld\\n\", ans);\r\n    }\r\n    return 0;\r\n}\r\n",
