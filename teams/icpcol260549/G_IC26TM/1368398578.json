  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nvoid solve(){\r\n    \r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    scanf(\"%d\", &t);\r\n    while(t--){\r\n    int n;\r\n    scanf(\"%d\",&n);\r\n    int m = 3 * n;\r\n    vector<ll> a(m);\r\n    for(auto &x : a) scanf(\"%lld\",&x);\r\n    sort(a.rbegin(),a.rend());\r\n    vector<ll> P(m + 1,0);\r\n    for(int i =0;i < m;i++){\r\n        P[i +1 ] = P[i] + a[i];}\r\n        auto f = [&](int x , int b) -> ll {\r\n            return 2 * P[x] + P[x + 2 * b] + 3 * P[3 * n -2 * x -b];\r\n        };\r\n        ll best =0;\r\n        for(int x = 0;x <=n;x++){\r\n            int lo = 0,hi = n-x;\r\n            while(lo < hi){\r\n                int mid = (lo + hi) / 2;\r\n                if(f(x,mid + 1) - f(x,mid) > 0) lo = mid + 1;\r\n                else hi = mid;\r\n            }\r\n            best = max(best,f(x,lo));\r\n        }\r\n        printf(\"%lld\\n\",best);\r\n    \r\n    }\r\n    return 0;\r\n    \r\n        \r\n       \r\n    \r\n}\r\n",
