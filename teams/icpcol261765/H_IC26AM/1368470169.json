  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll MOD = 998244353;\r\nint main() {\r\n\tint T;\r\n\tcin>> T;\r\n\tvector<int> ns(T);\r\n\tvector<vector<ll>> arr(T);\r\n\t\r\n\tint mx = 0;\r\n\t\r\n\tfor(int tc = 0; tc < T; tc++){\r\n\t    int n ;\r\n\t    cin >> n;\r\n\t    ns[tc] = n;\r\n\t    mx = max(mx, n);\r\n\t    arr[tc].resize(n);\r\n\t    for(auto &x :  arr[tc])\r\n\t    cin >> x;\r\n\t}\r\n\t\r\n\tvector<ll> inv(mx + 1);\r\n\tif(mx >= 1)\r\n\tinv[1] = 1;\r\n\t\r\n\tfor(int i = 2; i <= mx; i++){\r\n\t    inv[i] = MOD - (MOD / i) * inv[MOD % i] % MOD;\r\n\t}\r\n\tvector<ll> H(mx + 1, 0);\r\n\tfor(int i = 1; i <= mx; i++){\r\n\t    H[i] = (H[i - 1] + inv[i]) % MOD;\r\n\t}\r\n\t\r\n\tfor(int tc = 0; tc < T; tc++){\r\n\t    int n = ns[tc];\r\n\t    ll ans = 0;\r\n\t    \r\n\t    for(int i = 0; i < n; i++){\r\n\t        ll coeff = (H[i] + H[n - i - 1]) % MOD;\r\n\t        \r\n\t        ans = (ans + (arr[tc][i] % MOD) * coeff) % MOD;\r\n\t    }\r\n\t    cout << ans << '\\n';\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
