  "source_code": "t = int(input())\r\nwhile t:\r\n    t-=1\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    \r\n    MOD = 998244353\r\n    def inv(x):\r\n        p = MOD-2\r\n        res = 1\r\n        while p:\r\n            if p&1: res = res*x%MOD \r\n            x = x*x%MOD \r\n            p>>=1\r\n        return res\r\n       \r\n    ans = 0\r\n    pre = a[0]\r\n    for i in range(1,n-1):\r\n        pre+=a[i]\r\n        ans+=pre*inv(i+1)%MOD\r\n        ans%=MOD\r\n    suf = a[-1]\r\n    for i in range(2,n):\r\n        suf+=a[n-i]\r\n        ans+=suf*inv(i)%MOD \r\n        ans%=MOD\r\n    if n>1: ans=(ans+sum(a))%MOD\r\n    \r\n    pre = a.copy()\r\n    for i in range(1,n):\r\n        pre[i]+=pre[i-1]\r\n    ppre = pre.copy()\r\n    for i in range(1,n):\r\n        ppre[i]+=ppre[i-1]\r\n    \r\n    for k in range(2,n-1):\r\n        ans+=(ppre[n-2]-ppre[k-1]-ppre[n-k-2])*2*(inv(k)*inv(k+1)%MOD)%MOD\r\n        ans%=MOD\r\n    print(ans)\r\n        ",
