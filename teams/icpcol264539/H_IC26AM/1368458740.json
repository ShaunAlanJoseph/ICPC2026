  "source_code": "MOD=998244353\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    H=[0]*n \r\n    for i in range(1,n):\r\n        H[i]=(H[i-1] + pow(i,MOD-2,MOD))%MOD\r\n    ans=0\r\n    \r\n    for i in range(n):\r\n        weight=(H[i]+H[n-1-i])%MOD\r\n        ans=(ans+a[i]*weight)%MOD\r\n    print(ans)\r\n    \r\n    ",
