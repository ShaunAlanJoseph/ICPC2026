  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nvoid solve() {\r\n    ll n;\r\n    cin >> n;\r\n    vector<ll> a(3 * n + 1);\r\n    for (ll i = 1; i <= 3 * n; i++) cin >> a[i];\r\n    sort(a.begin() + 1, a.end(), greater<ll>());\r\n    \r\n    vector<ll> pref(3 * n + 2, 0);\r\n    for (ll i = 1; i <= 3 * n + 1; i++) {\r\n        pref[i] = (pref[i-1] + a[i]);\r\n    }\r\n    \r\n    ll mxi = 0;\r\n    ll c = n;\r\n    \r\n    for (ll i = 0; i <= n; i++) {\r\n        c = min(c, n - i);\r\n        \r\n        while (c > 0) {\r\n            ll g = a[i + 2 * (c - 1) + 1] + a[i + 2 * (c - 1) + 2] - 3 * a[3 * n - 2 * i - (c - 1)];\r\n            if (g < 0) c--;\r\n            else break;\r\n        }\r\n        \r\n        ll curr = 2 * pref[i] + pref[i + 2 * c] + 3 * pref[3 * n - 2 * i - c];\r\n        mxi = max(mxi, curr);\r\n    }\r\n    \r\n    cout << mxi << '\\n';\r\n}\r\n\r\nint main() {\r\n\tll tt;\r\n\tcin >> tt;\r\n\twhile (tt--) solve();\r\n\treturn 0;\r\n}\r\n",
