  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nconst ll MAXN = 200005;\r\nconst ll MOD = 998244353;\r\n\r\nll inv[MAXN];\r\nll H[MAXN];\r\n\r\nvoid helper() {\r\n    inv[1] = 1;\r\n    for (int i = 2; i < MAXN; i++) {\r\n        inv[i] = (MOD - MOD / i) * inv[MOD % i] % MOD;\r\n    }\r\n    H[0] = 0;\r\n    for (ll i = 1; i < MAXN; i++) {\r\n        H[i] = (H[i - 1] + inv[i]) % MOD;\r\n    }\r\n}\r\n\r\nvoid solve() {\r\n    ll n;\r\n    cin >> n;\r\n    \r\n    ll expS = 0;\r\n    for (int i = 1; i <= n; i++) {\r\n        ll ai;\r\n        cin >> ai;\r\n        ll coef = (H[i - 1] + H[n - i]) % MOD;\r\n        expS = (expS + ai * coef) % MOD;\r\n    }\r\n    \r\n    cout << expS << '\\n';\r\n}\r\n\r\nint main() {\r\n\tll tt;\r\n\tcin >> tt;\r\n\thelper();\r\n\twhile (tt--) solve();\r\n\treturn 0;\r\n}\r\n",
