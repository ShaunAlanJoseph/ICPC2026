  "source_code": "# cook your dish here\r\n\r\ndef solve():\r\n    n=int(input())\r\n    ar = list(map(int,input().split()))\r\n    \r\n    m= 998244353 \r\n    \r\n    def check():\r\n        h=[0]*(n+1)\r\n        iv= [0]*(n+1)\r\n        iv[1]=1\r\n        \r\n        for i in range(1, n+1):\r\n            if i>1:\r\n                iv[i] = m-(m//i)*iv[m%i]%m\r\n            h[i] = (h[i-1]+iv[i])%m\r\n        return sum(ar[i]*(h[i]+h[n-i-1]) for i in range(n))%m\r\n    return check()\r\n    \r\n    \r\nfor _ in range(int(input())):\r\n    print(solve())",
