  "source_code": "# cook your dish here\r\ndef solve():\r\n    n= int(input())\r\n    ar = list(map(int, input().split()))\r\n    \r\n    def check():\r\n        ar.sort(reverse=True)\r\n        s= [0]\r\n        for x in ar:\r\n            s.append(s[-1]+x)\r\n        ans=0\r\n        for p in range(n+1):\r\n            l, r= 0, n-p\r\n            while l<r:\r\n                b=(l+r+1)//2  \r\n                q= p+ 2*(b-1)\r\n                k= 3*n-2*p-b+1 \r\n                if ar[q]+ar[q+1] < 3*ar[k-1]:\r\n                    r=b-1\r\n                else:\r\n                    l=b\r\n            b=l \r\n            q= p+2*b\r\n            k=3* n-2*p-b\r\n            ans= max(ans, 2*s[p]+s[q]+3*s[k])\r\n        return ans \r\n    return check()\r\n\r\nfor _ in range(int(input())):\r\n    print(solve())",
