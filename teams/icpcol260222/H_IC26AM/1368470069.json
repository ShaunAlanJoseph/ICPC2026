  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD = 998244353;\r\nconst int MAXN = 200005;\r\n\r\nlong long inv[MAXN];\r\nlong long H[MAXN];\r\n\r\nvoid precompute(){\r\n    inv[1]  =1;\r\n    for(int i=2; i< MAXN; i++){\r\n        inv[i] = (MOD- MOD/i) * inv[MOD% i] % MOD;\r\n    }\r\n    \r\n    H[0] = 0;\r\n    for(int i=1; i< MAXN; i++){\r\n        H[i] = (H[i-1] + inv[i])%MOD;\r\n    }\r\n}\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long>a(n);\r\n    for(int i=0; i< n; i++) cin>>a[i];\r\n    \r\n    if( n== 1){\r\n         cout<<0<<endl;\r\n         return ;\r\n    }\r\n    long long ans = 0;\r\n    for(int i=1; i <= n; i++){\r\n        long long c_i = (H[i-1] + H[n-i]) %  MOD;\r\n        ans = (ans + (a[i-1] % MOD) * c_i) % MOD;\r\n    }\r\n    cout<<ans<<endl;\r\n    \r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n\tprecompute();\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
