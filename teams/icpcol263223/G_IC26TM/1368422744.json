  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\n\r\n\r\nvoid solve(){\r\n    int n;cin>>n;\r\n    int st = 3*n;\r\n    vector<ll> rt(st);\r\n    for(auto &r:rt) cin>>r;\r\n    sort(rt.rbegin(),rt.rend());\r\n    vector<ll> pre(st+1,0);\r\n    for(int i=0;i<st;i++){\r\n        pre[i+1]=pre[i]+rt[i];\r\n    }\r\n    \r\n    ll bst=0;\r\n    for(int sx = 0;sx<=n;sx++){\r\n        auto sc = [&](int f){\r\n            return 2*pre[sx]+pre[sx+2*f] + 3*pre[st-2*sx-f];\r\n        };\r\n        \r\n        int l=0,r=n-sx;\r\n        while(l<r){\r\n            int mid=l+(r-l)/2;\r\n            if(sc(mid+1)<=sc(mid)) r=mid;\r\n            else l=mid+1;\r\n        }\r\n        bst=max(bst,sc(l));\r\n    }\r\n    cout<<bst<<endl;\r\n    \r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;cin>>t;\r\n    while(t--) solve();\r\n}\r\n",
