  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long mod=998244353;\r\nconst int N=200005;\r\nint main() {\r\n\tvector<long long> in(N);\r\n\tin[1]=1;\r\n\tfor(int i=2;i<N;i++){\r\n\t    in[i]=(mod-(mod/i)*in[mod%i]%mod)%mod;\r\n\t}\r\n\t\r\n\tvector<long long> hn(N);\r\n\tfor(int i=1;i<N;i++){\r\n\t    hn[i]=(hn[i-1]+in[i])%mod;\r\n\t}\r\n\t\r\n\tint t;cin>>t;\r\n\twhile(t--){\r\n\t    int n;cin>>n;\r\n\t    long long ans=0;\r\n\t    for(int j=1;j<=n;j++){\r\n\t        long long a;cin>>a;\r\n\t        long long coef = (hn[j-1]+hn[n-j])%mod;\r\n\t        ans = (ans+(a%mod)*coef)%mod;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
