  "source_code": "import sys\r\ninput=sys.stdin.readline\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    pre=[0]\r\n    for val in a:\r\n        pre.append(val+pre[-1])\r\n    res=0\r\n    for p in range(n+1):\r\n        l,r=0,n-p\r\n        while l<r:\r\n            m=(l+r)//2\r\n            s=p+m*2\r\n            e=3*n-2*p-m\r\n            ga=a[s]+a[s+1]-3*a[e-1]\r\n            if ga>0:\r\n                l=m+1 \r\n            else:\r\n                r=m\r\n        m=l\r\n        score=(2*pre[p]+pre[p+2*m]+3*pre[3*n-2*p-m])\r\n        res=max(res,score)\r\n    print(res)",
