  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing int64 = long long;\r\nconst int64 MOD = 998244353;\r\nconst int MAXN = 200000;\r\nvector < int64 > in(MAXN + 1), h(MAXN + 1);\r\n\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    int64 ans = 0;\r\n    \r\n    for(int i = 1 ; i <= n ; ++i){\r\n        int64 x;\r\n        cin >> x;\r\n        \r\n        int64 coef = (h[i-1] + h[n-i])%MOD;\r\n        ans = (ans+(x%MOD) * coef) % MOD;\r\n    }\r\n    cout << ans << '\\n';\r\n}\r\n\r\nint main() {\r\n    // your code goes here\r\n    in [1] = 1;\r\n\r\n    for (int i = 2; i <= MAXN; ++i) {\r\n        in [i] = MOD - (MOD / i) * in [MOD % i] % MOD;\r\n    }\r\n    for(int i = 1 ; i <= MAXN ; ++i){\r\n        h[i] = (h[i-1]+in[i])%MOD;\r\n    }\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while (t--) {\r\n        solve();\r\n    }\r\n}",
