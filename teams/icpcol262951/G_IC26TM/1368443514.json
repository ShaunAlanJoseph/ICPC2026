  "source_code": "#include <bits/stdc++.h>\r\nusing ll = long long;\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    int total = 3*n;\r\n    ll ans = -1;\r\n    vector<ll> a(total),p(total+1,0);\r\n    \r\n    for(int i = 0 ; i < total ; ++i) cin >> a[i];\r\n    \r\n    sort(a.rbegin(),a.rend());\r\n    for(int i = 0 ; i < total ; ++i) p[i+1] = p[i] + a[i];\r\n    \r\n    for(int x = 0 ; x <= n ; x++){\r\n        int l = 0, r = n-x-1, y = 0;\r\n        \r\n        while(l <= r){\r\n            int m = l + (r-l)/2;\r\n            \r\n            int y1 = m+1;\r\n            \r\n            ll v1 = 3LL* p[total-2*x-m] + p[x + 2*m] + 2LL *p[x];\r\n            ll v2 = 3LL* p[total-2*x-y1] + p[x + 2*y1] + 2LL *p[x];\r\n            \r\n            if(v2 >= v1){\r\n                y = y1;\r\n                l = y1;\r\n            }\r\n            else {\r\n                r = m-1;\r\n            }\r\n        }\r\n        ll cur = 3LL * p[total-2*x-y]+p[x+2*y] + 2LL*p[x];\r\n        if(cur > ans) ans = cur;\r\n    }\r\n    cout << ans << \"\\n\";\r\n    \r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tif(cin >> t){\r\n\t    while(t--) solve();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
