  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve() {\r\n    int n; cin >> n; \r\n    int m = 3*n;\r\n    vector<long long> a(m);\r\n    for(auto &x : a) cin >> x;\r\n    sort(a.rbegin(), a.rend());\r\n    vector<long long> s(m+1);\r\n    for(int i = 0; i < m; ++i) {\r\n        s[i+1] = s[i] + a[i];\r\n    }\r\n    \r\n    auto f = [&](int p, int q) {\r\n        return 2*s[p]+s[p + 2*q] + 3*s[m - 2*p - q];\r\n    };\r\n    \r\n    long long ans = 0;\r\n    for(int p = 0; p <= n; ++p) {\r\n        int low = 0, high = n - p;\r\n        while(low < high) {\r\n            int mid = (low + high) / 2;\r\n            if(f(p, mid + 1) > f(p, mid)) low = mid + 1;\r\n            else high = mid;\r\n        }\r\n        ans = max(ans, f(p, low));\r\n    }\r\n    cout << ans << '\\n';\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--) solve();\r\n}\r\n",
