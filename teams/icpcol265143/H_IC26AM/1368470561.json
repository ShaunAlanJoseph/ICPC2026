  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nvector <long  long>inv(2,1),h(2,0);\r\nvoid extend(int n){\r\n    int cur = inv.size();\r\n    if(cur>n) return;\r\n    inv.resize(n+1);\r\n    h.resize(n+1);\r\n    h[1] = 1;\r\n    for(int i = cur ; i <= n ; i ++){\r\n        inv[i] = (MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n        h[i] = (h[i- 1]+inv[i])%MOD;\r\n    }\r\n}\r\nint main() {\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<long long>a(n+1);\r\n        for(int i = 1 ; i<= n ; i++){\r\n            cin>>a[i];\r\n        }\r\n        extend(n);\r\n        long long ans = 0;\r\n        for(int j = 1 ; j<=n ; j++){\r\n            long long w = (h[j-1] + h[n-j])%MOD;\r\n            ans = (ans + (a[j]%MOD)*w)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
