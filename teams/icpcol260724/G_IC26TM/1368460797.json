  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    pref=[0]*(3*n+1)\r\n    for i,x in enumerate(a):\r\n        pref[i+1]=pref[i]+x\r\n    def value(A,B):\r\n        return 2*pref[A]+pref[A+2*B]+3*pref[3*n-2*A-B]\r\n    ans=0\r\n    B=n\r\n    for A in range(n+1):\r\n        if B>n-A:\r\n            B=n-A\r\n        while B>0 and value(A,B-1)>=value(A,B):\r\n            B-=1\r\n        ans=max(ans,value(A,B))\r\n    print(ans)    ",
