  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n using ll = long long;\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint T;\r\n\tcin>>T;\r\n\t\r\n\twhile(T--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<ll>a(3*n),pre(3*n+1);\r\n\t    for(auto &x:a)cin>>x;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    for (int i=0;i<3*n;i++)\r\n\t    pre[i+1]=pre[i]+a[i];\r\n\t    auto val=[&](int A, int B){\r\n\t        int P=A+2*B;\r\n\t        int R=3*n-2*A-B;\r\n\t        return 2*pre[A]+pre[P]+3*pre[R];\r\n\t    };\r\n\t    ll ans=0;\r\n\t    for(int A=0;A<=n;A++){\r\n\t        int lo=0,hi=n-A-1;\r\n\t        \r\n\t        while(lo<=hi){\r\n\t            int B=(lo+hi)/2;\r\n\t            int P=A+2*B;\r\n\t            int R=3*n-2*A-B;\r\n\t            \r\n\t            ll diff = a[P]+a[P+1]-3*a[R-1];\r\n\t            \r\n\t            if(diff>=0)lo=B+1;\r\n\t            else hi=B-1;\r\n\t        }\r\n\t        for(int B:{max(0,hi),min(n-A,hi+1)})\r\n\t        ans=max(ans,val(A,B));\r\n\t        \r\n\t    }\r\n\t\r\n\tcout<<ans<<'\\n';\r\n}\r\n}\r\n",
