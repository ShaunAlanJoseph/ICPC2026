  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint T;\r\n\tcin>>T;\r\n\tvector<ll>H(200005),inv(200005);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<200005;i++)\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t    for(int i=1;i<200005;i++)\r\n\t     H[i]=(H[i-1]+inv[i])%MOD;\r\n\t     \r\n\t    while(T--){\r\n\t        int n;\r\n\t        cin>>n;\r\n\t        \r\n\t        ll ans=0;\r\n\t        for(int i=1;i<=n;i++){\r\n\t            ll x;\r\n\t            cin>>x;\r\n\t            \r\n\t            ans=(ans+x*(H[i-1]+H[n-i]))%MOD;\r\n\t        }\r\n\t        cout<<ans<<'\\n';\r\n\t    }\r\n\t\r\n\r\n}\r\n",
