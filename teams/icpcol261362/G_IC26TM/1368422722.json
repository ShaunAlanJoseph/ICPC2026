  "source_code": "#include <stdio.h>\r\nint cmp(const void *a,const void *b){\r\n    long long x=*(long long*)a;\r\n    long long y=*(long long*)b;\r\n    return(x<y)-(x>y);\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tscanf(\"%d\",&t);\r\n\twhile(t--){\r\n\t    int n;\r\n\t    scanf(\"%d\",&n);\r\n\t    int m=3*n;\r\n\t    long long a[m],p[m+1];\r\n\t    for(int i=0;i<m;i++){\r\n\t        scanf(\"%lld\",&a[i]);\r\n\t    }\r\n\t    qsort(a,m,sizeof(long long),cmp);\r\n\t    p[0]=0;\r\n\t    for(int i=0;i<m;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t        \r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int A=0;A<=n;A++){\r\n\t        int lo=0,hi=n-A;\r\n\t        while(lo<hi){\r\n\t            int B=(lo+hi)/2;\r\n\t            int j=A+2*B;\r\n\t            int k= 3*n-2*A-B;\r\n\t            if(a[j]+a[j+1]>= 3*a[k-1])\r\n\t                lo=B+1;\r\n\t            else\r\n\t                hi=B;\r\n\t        }\r\n\t        for(int B=lo-1;B <= lo;B++){\r\n\t            if(B<0 || B>n-A)\r\n\t                continue;\r\n\t            int j=A+2*B;\r\n\t            int k=3*n-2*A-B;\r\n\t            long long cur=2*p[A]+p[j]+3*p[k];\r\n\t            if(cur>ans)\r\n\t            ans=cur;\r\n\t        }\r\n\t    }\r\n\t    printf(\"%lld\\n\",ans);\r\n\t}\r\n\t\r\n\r\n}\r\n\r\n",
