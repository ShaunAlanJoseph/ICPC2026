  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nvoid solve(){\r\n    int n,k; cin>>n>>k;\r\n    string s;\r\n    cin >> s;\r\n    int a=0,b=0;\r\n    for(int i=n-1;i>=0;i--){\r\n        if(s[i] == 'I'){\r\n            if(a<b) swap(a,b);\r\n            a += 2;\r\n        }\r\n        else{\r\n            if(a>b) swap(a,b);\r\n            if(a > k){\r\n                cout<<\"NO\\n\";\r\n                return;\r\n            }\r\n            a++;\r\n        }\r\n        // cout<<a<<\" \"<<b<<endl;\r\n    }\r\n    cout<<\"YES\\n\";\r\n    \r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;cin>>t;\r\n    \r\n    while(t--) solve();\r\n}\r\n",
