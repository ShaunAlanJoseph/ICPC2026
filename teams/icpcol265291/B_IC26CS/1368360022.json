  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;cin>>n;\r\n    vector<int> a(n);\r\n    for(int i=0;i<n;i++) cin>>a[i];\r\n    a.push_back(a.front());\r\n    vector<int> ans;\r\n    for(int i=0;i<n;i++) ans.push_back(abs(a[i]-a[i+1]));\r\n    sort(a.rbegin(),a.rend());\r\n    cout<<ans[1]<<endl;\r\n}\r\n\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--) solve();\r\n}\r\n",
