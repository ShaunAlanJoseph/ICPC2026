  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int mod=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n    \r\n    vector<vector<int>> pos(n+1);\r\n    for(int i=1;i<=n;i++){\r\n        int x;\r\n        cin>>x;\r\n        pos[x].push_back(i);\r\n    }\r\n    vector<int> dp(n+2,0),nd(n+2,0);\r\n    dp[0]=1;\r\n    for(int v=1;v<=n;v++){\r\n        fill(nd.begin(),nd.end(),0);\r\n        auto ok=[&](bool l,int c){\r\n            int d=v-c;\r\n            for(int i:pos[v]){\r\n                bool g;\r\n                if(l)g=(c==(i+1)/2&&d<=n-i);\r\n                else g=(d==(n-i+2)/2 && c<=i-1);\r\n                if(!g && v==(n+i)/2&& c>=i)g=true;\r\n                if(!g && v==n-i/2 && d>=n-i+1)g=true;\r\n                if(!g)return false;\r\n            }\r\n            return true;\r\n        };\r\n        for(int c=0;c<v;c++){\r\n            if(!dp[c])continue;\r\n            if(ok(true,c+1))nd[c+1]=(nd[c+1]+dp[c])%mod;\r\n            if(v<n && ok(false,c))nd[c]=(nd[c]+dp[c])%mod;\r\n        }\r\n        swap(dp,nd);\r\n    }long long ans=0;\r\n    for(int c=0;c<=n;c++)ans+=dp[c];\r\n    cout<<ans%mod<<endl;\r\n}\r\n}",
