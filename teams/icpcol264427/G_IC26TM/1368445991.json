  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        ll n;\r\n        cin>>n;\r\n        vector<ll>a(3*n),p(3*n+1,0);\r\n        for(auto &x:a){\r\n            cin>>x;\r\n        }\r\n        sort(a.rbegin(),a.rend());\r\n        for(int i=0;i<3*n;i++){\r\n            p[i+1]=p[i]+a[i];\r\n        }\r\n        auto f=[&](ll k1,ll k2){\r\n            return 3*p[3*n-2*k1-k2]+p[k1+2*k2]+2*p[k1];\r\n        };\r\n        ll ans=0;\r\n        for(ll k1=0;k1<=n;k1++){\r\n            ll lo=0,hi=n-k1;\r\n            while(lo<hi){\r\n                ll mid=(lo+hi)/2;\r\n                if(f(k1,mid)<f(k1,mid+1)){\r\n                    lo=mid+1;\r\n                }else{\r\n                    hi=mid;\r\n                }\r\n            }\r\n            ans=max(ans,f(k1,lo));\r\n        }\r\n        cout<<ans<<endl;\r\n}\r\n}\r\n",
