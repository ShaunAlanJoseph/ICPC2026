  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll mod = 998244353;\r\nconst int n = 200005;\r\n\r\nint main() {\r\n\t// your code goes here\r\n  vector <ll> inv(n),h(n);\r\n  inv[1]=1;\r\n  for(int i = 2; i<n;i++){\r\n      inv[i] = (mod - mod/i)*inv[mod % i] % mod;\r\n      h[0]=0;\r\n      \r\n  }\r\n  for(int i = 1; i< n;i++){\r\n      h[i] = (h[i-1]+inv[i])% mod;\r\n      \r\n  }\r\n  int t ;\r\n  cin>>t;\r\n  while(t--){\r\n      int n;\r\n      cin>>n;\r\n      ll ans =0;\r\n      for(int j =1; j<=n;j++){\r\n          ll a;\r\n          cin>>a;\r\n          ans=(ans+a%mod*((h[j-1] +h[n-j])%mod))%mod;\r\n      }\r\n      cout<<ans<<endl;\r\n  }\r\n}\r\n",
