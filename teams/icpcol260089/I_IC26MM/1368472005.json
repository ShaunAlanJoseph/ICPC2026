  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n#define MaaDurga ios_base::sync_with_stdio(false); cin.tie(NULL);\r\n\r\nconst int mod = 998244353;\r\nint n;\r\nvector<int>arr;\r\nvector<vector<int>>dp;\r\nvector<vector<int>>ps;\r\n\r\nbool check(int x, int l, int r, int p){\r\n    for(int i = 0; i < ps[x].size(); i++){\r\n        int id = ps[x][i];\r\n        bool k = false;\r\n        if(p <= id && max(0, min(id, r) - l + 1) == (id/2) + 1) k = true;\r\n        if(p >= id && max(0, r - max(id, l) + 1) == ((n - id + 1)/2) + 1) k = true;\r\n        if(!k)return false;\r\n        \r\n    }\r\n    return true;\r\n}\r\nint mem(int x, int l){\r\n    if(x == n + 1) return 1;\r\n    if(dp[x][l] != -1) return dp[x][l];\r\n    int r = l + n - x;\r\n    int ans = 0;\r\n    if(check(x, l , r, l))\r\n    {ans = (ans + mem(x+ 1, l+1))%mod;}\r\n    if(x < n && check(x, l , r, r)) ans = (ans + mem(x + 1, l))%mod;\r\n    return dp[x][l] =  ans;\r\n    \r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tMaaDurga\r\n\tll t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t  arr.assign(n + 1, 0);  \r\n\t  ps.assign(n  +1, vector<int>());\r\n\t  dp.assign(n + 1, vector<int>(n + 1, -1));\r\n\t  for(ll i = 1; i <= n; i++){\r\n\t      cin>>arr[i];\r\n\t      ps[arr[i]].push_back(i);\r\n\t      \r\n\t  }\r\n\t  cout<<mem(1, 1)<<endl;\r\n\t  \r\n\t}\r\n\r\n}\r\n",
