  "source_code": "import sys\r\n\r\nd = sys.stdin.read().split()\r\nif d:\r\n    m = 998244353\r\n    v = [0] * 200005\r\n    h = [0] * 200005\r\n    v[1] = h[1] = 1\r\n    \r\n    for i in range(2, 200005):\r\n        v[i] = ( m - m // i) * v[m % i] % m \r\n        h[i] = (h[i-1] + v[i]) % m \r\n        \r\n    o = []\r\n    p = 1 \r\n    \r\n    for _ in range(int(d[0])):\r\n        n = int(d[p])\r\n        p += 1 \r\n        \r\n        if n == 1:\r\n            o.append(0)\r\n            p += 1 \r\n            \r\n        else:\r\n            o.append(sum(int(d[p + i]) * (h[i] + h[n - 1 - i]) for i in range(n)) % m)\r\n            p += n \r\n            \r\n    sys.stdout.write('\\n'.join(map(str, o)) + '\\n')\r\n",
