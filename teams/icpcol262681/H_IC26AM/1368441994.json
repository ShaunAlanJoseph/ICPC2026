  "source_code": "MOD=998244353\r\n\r\nt=int(input())\r\n\r\ntest=[]\r\n\r\nfor i  in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    test.append((n,a))\r\nmax_n=max(n for n,a in test)\r\ninv=[0]*(max_n+1)\r\nif max_n>=1:\r\n    inv[1]=1\r\n    \r\nfor i in range(2,max_n+1):\r\n    inv[i]=MOD-(MOD//i)*inv[MOD%i]%MOD\r\nH=[0]*(max_n+1)\r\nfor i in range(1,max_n+1):\r\n    H[i]=(H[i-1]+inv[i])%MOD\r\nfor n,a in test:\r\n    ans=0\r\n    for i in range(n):\r\n        coeff=(H[i]+H[n-1-i])%MOD\r\n        ans=(ans+a[i]*coeff)%MOD\r\n    print(ans)\r\n        ",
