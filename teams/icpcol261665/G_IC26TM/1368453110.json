  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long> a(m),p(m+1);\r\n\t    for(auto &x:a) cin>>x;\r\n\t    sort(a.begin(),a.end());\r\n\t    for(int i=0;i<m;i++){\r\n\t        p[i+1]=p[i]+a[m-1-i];\r\n\t    }\r\n\t    long long res=0;\r\n\t    for(int x=0;x<=n;x++){\r\n\t        int l=0;\r\n\t        int r=n-x;\r\n\t        while(l<r){\r\n\t            int b=(l+r)/2;\r\n\t            int j=x+2*b;\r\n\t            int k=3*n-2*x-b;\r\n\t            if(a[m-1-j]+a[m-2-j]>=3LL*a[m-k]) l=b+1;\r\n\t            else r=b;\r\n\t        }\r\n\t        for(int b:{l-1,l}){\r\n\t            if(b<0 || b>n-x){\r\n\t                continue;\r\n\t            }\r\n\t            int j=x+2*b;\r\n\t            int k=3*n-2*x-b;\r\n\t            res=max(res,2*p[x]+p[j]+3*p[k]);\r\n\t        }\r\n\t    }\r\n\t    cout<<res<<'\\n';\r\n\t}\r\n}\r\n",
