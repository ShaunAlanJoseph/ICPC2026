  "source_code": "# cook your dish \r\nMOD = 998244353\r\n\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    nums = list(map(int, input().split()))\r\n    \r\n    inv = [0] * (n - 1)\r\n    inv = [0, 1] + inv\r\n    \r\n    for i in range(2, n + 1):\r\n        inv[i] = (MOD - (MOD // i) * inv[MOD % i] % MOD) % MOD\r\n        \r\n    harm = [0] * (n + 1)\r\n    for i in range(1, n + 1):\r\n        harm[i] = (harm[i-1] + inv[i]) % MOD\r\n    \r\n    res = 0\r\n    for i in range(1, n + 1):\r\n        res += nums[i-1] % MOD * (harm[i-1] + harm[n-i])\r\n    \r\n    print(res % MOD)",
