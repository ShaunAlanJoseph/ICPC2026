  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long mod=998244353;\r\nconst int N=200005;\r\nlong long inv[N],H[N];\r\n\r\nint main() {\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<N;i++){\r\n\t    inv[i]=(mod-(mod/i)*inv[mod%i]%mod)%mod;\r\n\t    \r\n\t}\r\n\tH[0]=0;\r\n\tfor(int i=1;i<N;i++){\r\n\t    H[i]=(H[i-1]+inv[i])%mod;\r\n\t    \r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    long long ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long a;\r\n\t        cin>>a;\r\n\t        long long c=(H[n-i]+H[i-1])%mod;\r\n\t        ans=(ans+a%mod*c)%mod;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
