  "source_code": "# cook your dish here\r\nimport sys\r\ndef res():\r\n    M=998244353\r\n    \r\n    MN=200005\r\n    iv=[0]*MN\r\n    L=[0]*MN\r\n    iv[1]=1\r\n    L[1]=1\r\n    for i in range(2,MN):\r\n        iv[i]=M-(M//i)*iv[M%i]%M\r\n        L[i]=(L[i-1]+iv[i])%M\r\n        \r\n    indata=sys.stdin.read().split()\r\n    if not indata:\r\n        return\r\n    t=int(indata[0])\r\n    il=1 \r\n    ot=[]\r\n    for _ in range(t):\r\n        n=int(indata[il])\r\n        il+=1 \r\n        ans=0 \r\n        for i in range(n):\r\n            val=int(indata[il+i])\r\n            cf=(L[i]+L[n-1-i])\r\n            if cf>=M:\r\n                cf-=M\r\n            ans=(ans+val*cf)%M\r\n        il+=n\r\n        ot.append(str(ans))\r\n    sys.stdout.write('\\n'.join(ot)+'\\n')\r\n    \r\nif __name__=='__main__':\r\n    res()\r\n    ",
