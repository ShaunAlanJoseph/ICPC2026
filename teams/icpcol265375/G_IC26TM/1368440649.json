  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvoid ans(){\r\n    int n;\r\n    if(!(cin>>n))return;\r\n    std::vector<long long> a(3*n);\r\n    for (int i=0;i<3*n;++i){\r\n        cin>>a[i];\r\n    }\r\n    std::sort(a.rbegin(), a.rend());\r\n    vector<long long>P(3*n+1,0);\r\n    for(int i=0;i<3*n;++i){\r\n        P[i+1]=P[i]+a[i];\r\n    }\r\n    long long ms=0;\r\n    for(int k1=0;k1<=n;++k1){\r\n        int l=0;\r\n        int h=n-k1;\r\n        long long bfk1=0;\r\n        while(l<=h)\r\n{\r\n    int m1=l+(h-l)/3;\r\n    int m2=h-(h-l)/3;\r\n    auto calc=[&] (int k2)\r\n    {\r\n        return 2*P[k1]+P[k1+2*k2]+3*P[3*n-2*k1-k2];\r\n        \r\n    };\r\n    long long v1=calc(m1);\r\n    long long v2=calc(m2);\r\n    \r\n    bfk1=max({bfk1,v1,v2});\r\n    if(v1<v2){\r\n        l=m1+1;\r\n    }else{\r\n        h=m2-1;\r\n    }\r\n    \r\n    \r\n}  \r\nms=max(ms,bfk1);}\r\n    cout<<ms<<endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tif(cin>>t){\r\n\t    while(t--){\r\n\t        ans();\r\n\t    }\r\n\t}\r\n    return 0;\r\n}\r\n",
