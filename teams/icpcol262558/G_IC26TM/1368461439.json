  "source_code": "# cook your dish here\r\ndef fun(i,ii,n,pr):\r\n    s = 6*pr[i]\r\n    f = 4*pr[i+2*ii]-4*pr[i]\r\n    t = 3*pr[3*n-2*i-ii]-3*pr[i+2*ii]\r\n    return s+f+t\r\n# def b_search(l,h):\r\n#     m = (l+h)//2 \r\n#     if \r\nt = int(input())\r\nfor abc in range(t):\r\n    n =int(input())\r\n    arr = list(map(int,input().split()))\r\n    arr.sort(reverse=True)\r\n    #print(n,arr)\r\n    pr = [0]\r\n    for i in arr:\r\n        pr.append(pr[-1]+i)\r\n    a = float(\"-inf\")\r\n    for i in range(n+1):\r\n        # for ii in range(n-i+1):\r\n        #     a = max(a,fun(i,ii,n,pr))\r\n        l, h =0, n-i\r\n        while l<h:\r\n            m = (l+h)//2 \r\n            if fun(i,m,n,pr)<fun(i,m+1,n,pr):\r\n                l = m+1 \r\n            else:\r\n                h = m \r\n        a = max(a,fun(i,l,n,pr))\r\n    print(a)\r\n# def fun(i,ii,n):\r\n#     s = 6*[i]\r\n#     f = 4*[i+2*ii]-4*[i]\r\n#     t =3*[3*n-2*i-ii]-3*[i+2*ii]\r\n#     return s+f+t",
