  "source_code": "#include <bits/stdc++.h>\r\n#define int long long\r\nusing namespace std;\r\n\r\n\r\nint val(int p, int q, vector<int> &arr, int n) {\r\n    return 2ll*arr[p] + arr[p + 2*q] + 3ll*arr[3*n - 2*p - q];\r\n}\r\n\r\nvoid solve() {\r\n    int n; cin>>n;\r\n    vector<int> arr(3*n); for(auto &i : arr)cin>>i;\r\n    sort(arr.begin(), arr.end(), greater<int>());\r\n    vector<int> psum(3*n + 1, 0ll);\r\n    for(int i = 0; i < 3*n; i++) {\r\n        psum[i + 1] = arr[i] + psum[i];\r\n    }\r\n    int res = 0ll;\r\n    for(int i = 0; i <= n; i++) {\r\n        int low = 0ll; int high = n - i;\r\n        while(low < high) {\r\n            int mid = low + (high - low)/2;\r\n            (val(i, mid, psum, n) <= val(i, mid + 1, psum, n)) ? low = mid + 1 : high = mid;\r\n        }\r\n        res = max(res, val(i, low, psum, n));\r\n    }\r\n    cout<<res<<\"\\n\";\r\n}\r\n\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint t; cin>>t;\r\n\twhile(t--) {\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
