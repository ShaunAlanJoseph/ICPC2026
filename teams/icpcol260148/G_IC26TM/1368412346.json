  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;cin>>t;\r\n\twhile(t--){\r\n\t    ll n;cin>>n;\r\n\t    n*=3;\r\n\t    std::vector<ll>a(n) ;\r\n\t    for(auto&i:a)cin>>i;\r\n\t    std::sort(a.begin(), a.end());\r\n\t    vector<ll>pre(n+1);\r\n\t    for (int i = 0; i < n; i++) {\r\n\t        /* code */\r\n\t        pre[i+1]=pre[i]+a[i];\r\n\t    }\r\n\t    ll ans = 0;\r\n\t    for (int i = 0; i <= n/3; i++) {\r\n\t        /* code */\r\n\t        ll x = 6*(pre[n]-pre[n-i]);\r\n\t        ll l = 2*i;\r\n\t        ll r = l+(n/3-i);\r\n\t       // cout<<l<<' '<<r<<'\\n';\r\n\t        while (l<r){\r\n\t            ll m = (l+r)>>1;\r\n\t            ll y = -3*a[m]+a[n-i-2*(m-2*i)-1]+a[n-i-2*(m-2*i)-2];\r\n\t            if (y>0)l=m+1;\r\n\t            else r = m;\r\n\t        }\r\n\t        x+=3*(pre[n-i-2*(l-2*i)]-pre[l]);\r\n\t       // cout<<x<<'\\n';\r\n\t        x+=4*(pre[n-i]-pre[n-i-2*(l-2*i)]);\r\n\t       // cout<<x<<' '<<l<<'\\n';\r\n\t        ans=max(ans,x);\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n}\r\n",
