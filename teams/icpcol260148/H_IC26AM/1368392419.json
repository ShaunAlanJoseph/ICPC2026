  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst ll mod = 998244353;\r\nll pow(ll a, ll b){\r\n    ll res = 1;\r\n    while(b){\r\n        if (b&1)(res*=a)%=mod;\r\n        (a*=a)%=mod;b>>=1;\r\n    }\r\n    return res;\r\n}\r\nll mod_inv(ll a){\r\n    return pow(a,mod-2);\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;cin>>t;\r\n\twhile(t--){\r\n\t    ll n;cin>>n;\r\n\t    std::vector<ll>a(n);\r\n\t    for(auto&i:a)cin>>i;\r\n\t    vector<ll>v1(n+1);\r\n\t    for (int i = 0; i < n; i++) {\r\n\t        /* code */\r\n\t        v1[i+1]=(v1[i]+mod_inv(i+1))%mod;\r\n\t    }\r\n\t    ll ans = 0;\r\n\t    for (int i = 0; i < n; i++) {\r\n\t        /* code */\r\n\t        ans+=(v1[i]+v1[n-i-1])*a[i];ans%=mod;\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n}\r\n",
