  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint n,m;\r\nvector<long long>pre;\r\n\r\nlong long f(int p,int q){\r\n    int a=p;\r\n    int b=p+2*q;\r\n    int c=m-2*p-q;\r\n    return 6*pre[a]+4*(pre[b]-pre[a])+3*(pre[c]-pre[b]);\r\n}\r\nint main() {\r\n\t// your code goes here\r\n     int t;\r\n     cin>>t;\r\n     while(t--){\r\n          \r\n         cin>>n;\r\n         m=3*n;\r\n         vector<long long>arr(m);\r\n         \r\n         for(int i=0;i<m;i++){\r\n             cin>>arr[i];\r\n         }\r\n         \r\n         sort(arr.begin(),arr.end(),greater<long long>());\r\n         \r\n         pre.assign(m+1,0);\r\n         for(int i=0;i<m;i++){\r\n             pre[i+1]=pre[i]+arr[i];\r\n            \r\n         }\r\n         long long best=0;\r\n         for(int p=0;p<=n;p++){\r\n             int low=0,high=n-p;\r\n             while(low<high){\r\n                 int mid=(low+high)/2;\r\n                 if(f(p,mid+1)>f(p,mid))low=mid+1;\r\n                 else high=mid; \r\n             }\r\n             best=max(best,f(p,low));\r\n         }\r\n         cout<<best<<endl;\r\n     }\r\n}\r\n",
