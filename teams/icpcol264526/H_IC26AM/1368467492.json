  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\n// void solve(){\r\n    \r\n// }\r\nconst ll MOD=998244353;\r\nlong long binpow(ll b,ll a)\r\n{\r\n    ll r=1;\r\n    b=b%MOD;\r\n    while(a>0)\r\n    {\r\n        if(a&1)r=r*b%MOD;\r\n        b=b*b%MOD;\r\n        a=a/2;\r\n    }\r\n    return r;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t; cin >> t;\r\n    while(t--){\r\n        ll n; cin >> n;\r\n        vector<ll> a(n+1);\r\n        for(int i=1;i<=n;i++)cin>>a[i];\r\n        \r\n        vector<ll>pre(n+1,0);\r\n        for(int i=1;i<=n;i++)\r\n        {\r\n            pre[i]=(pre[i-1]%MOD + a[i]%MOD)%MOD;\r\n        }\r\n        \r\n        ll ans=0;\r\n        for(int i=1;i<=n-1;i++)\r\n        {\r\n            \r\n            ll suff=(pre[n]-pre[i]+MOD)%MOD;\r\n            ll sum=(suff%MOD+pre[n-i]%MOD)%MOD;\r\n            ans=(ans+sum*binpow(i,MOD-2))%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n        \r\n    }\r\n}\r\n",
