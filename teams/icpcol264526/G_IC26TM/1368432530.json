  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll =long long;\r\nvoid solve()\r\n{\r\n    \r\n    int n;\r\n    cin>>n;\r\n   vector<ll>a(3*n+1),pre(3*n+1);\r\n\r\n    for(int i=1;i<=3*n;i++)cin>>a[i];\r\n    sort(a.begin()+1,a.end(),greater<long long>());\r\n   \r\n    for(int i=1;i<=3*n;i++)pre[i]=pre[i-1]+a[i];\r\n    \r\n    \r\n    auto check=[&](ll p,ll d)\r\n    {  ll t=3*n - 2*p -d;\r\n        return a[p+2*d+1]+(a[p+2*d+2]-(3*a[t]));\r\n        \r\n    };\r\n    ll maxi=0;\r\n\r\n\r\nauto com=[&](ll p,ll d)\r\n{\r\n    return 6*pre[p] + 4*(pre[p+2*d]-pre[p]) +3*(pre[3*n-2*p-d]-pre[p+2*d]); \r\n};\r\n    for(int p=0;p<=n;p++)\r\n    {\r\n    ll low=0,hi=n-p;\r\n    while(low<hi)\r\n    {\r\n        ll mid=low+(hi-low)/2;\r\n        if(check(p,mid) > 0)low=mid+1;\r\n        else hi=mid;\r\n    }\r\n    \r\n    maxi=max(maxi,com(p,low));\r\n    \r\n    }\r\n    cout<<maxi<<endl;\r\n    \r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;while(t--)solve();\r\n\r\n\r\n}\r\n",
