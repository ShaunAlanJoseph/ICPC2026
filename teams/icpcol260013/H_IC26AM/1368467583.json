  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() \r\n{\r\n    ll M = 998244353;\r\n    int t;\r\n    cin >> t;\r\n    vector<vector<ll>>a(t);\r\n    int k = 1;\r\n    for(int j=0;j<t;j++)\r\n    {\r\n        int n;\r\n        cin >> n;\r\n        a[j].push_back(0);\r\n        for(int i=1;i<=n;i++)\r\n        {\r\n            ll x;\r\n            cin >> x;\r\n            a[j].push_back(x);\r\n        }\r\n        k = max(k,n);\r\n    }\r\n    vector<ll>v(k+2),h(k+2);\r\n    v[1]=1;\r\n    for(int i=2;i<=k;i++)\r\n    {\r\n        v[i]=(M-M/i)*v[M%i]%M;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<=k;i++)\r\n    {\r\n        h[i]=(h[i-1]+v[i])%M;\r\n    }\r\n    for(int j=0;j<t;j++)\r\n    {\r\n        int n = a[j].size()-1;\r\n        ll r = 0;\r\n        for(int i=1;i<=n;i++)\r\n        {\r\n            ll d = a[j][i]%M * ((h[i-1]%M + h[n-i])%M)%M;\r\n            r = (r+d)%M;\r\n        }\r\n        cout << r << \"\\n\";\r\n        }\r\n        return 0;\r\n}",
