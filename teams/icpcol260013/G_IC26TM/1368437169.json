  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing L=long long;\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    int m = 3*n;\r\n\t    vector<L>d(m),p(m+1,0);\r\n\t    for(auto &x:d)\r\n\t        cin >> x;\r\n\t        sort(d.rbegin(),d.rend());\r\n\t        for(int i=0;i<m;i++)\r\n\t        {\r\n\t        p[i+1]=p[i]+d[i];\r\n\t        }\r\n\t        L r=0;\r\n\t        for(int a=0;a<=n;a++)\r\n\t        {\r\n\t            int l =0,h=n-a;\r\n\t            while(l<h)\r\n\t            {\r\n\t                int k =(l+h)/2;\r\n\t                if(d[a+2*k]+d[a+2*k+1] > 3*d[m-2*a-k-1])\r\n\t                l=k+1;\r\n\t                else\r\n\t                h=k;\r\n\t            }\r\n\t            r = max(r,2*p[a]+p[a+2*l]+3*p[m-2*a-l]);\r\n\t        }\r\n\t        cout << r << \"\\n\";\r\n\t}\r\n\t    return 0;\r\n}",
