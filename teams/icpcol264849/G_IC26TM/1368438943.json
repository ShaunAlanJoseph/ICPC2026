  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n  \r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    long long total=3*n;\r\n\t    vector<long long>nums(total);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        cin>>nums[i];\r\n\t    }\r\n\t    sort(nums.rbegin(),nums.rend());\r\n\t    vector<long long>pref(total+1,0);\r\n\t    for(int i=0;i<total;i++){\r\n\t        pref[i+1]=pref[i]+nums[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        int left=0;\r\n\t        int right=n-i;\r\n\t        while(left<right){\r\n\t            int mid=left+(right-left)/2;\r\n\t            long long val1=pref[i+2*(mid+1)]+3*pref[total-2*i-(mid+1)];\r\n\t            long long val2=pref[i+2*mid]+3*pref[total-2*i-mid];\r\n\t            if(val1>val2){\r\n\t                left=mid+1;\r\n\t            }\r\n\t            else{\r\n\t                right=mid;\r\n\t            }\r\n\t        }\r\n\t        long long x=left;\r\n\t        long long power=2*pref[i]+pref[i+2*x]+3*pref[total-2*i-x];\r\n\t        ans=max(ans,power);\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
