  "source_code": "# cook your dish here\r\nfor t in range(int(input())):\r\n    n = int(input())\r\n    \r\n    a = list(map(int,input().split()))\r\n    \r\n    res = 0 \r\n    a.sort(reverse = True)\r\n    \r\n    p = [0]\r\n    for v in a:\r\n        p.append(p[-1] + v)\r\n    \r\n    # ans = 0 \r\n    y = n \r\n    for x in range(n+1):\r\n        y  = min(y,n-x)\r\n        while y and a[x+2*y-2] + a[x + 2*y-1] <= 3*a[3*n-2*x-y]:\r\n            y -=1\r\n        res = max(res,2*p[x] + p[x+2*y]+3*p[3*n-2*x-y]) \r\n    print(res)",
