  "source_code": "#include <stdio.h>\r\n#define M 998244353\r\n#define N 200005\r\nlong long inverse[N], h[N];\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t, n, i;\r\n\tscanf(\"%d\", &t);\r\n\tinverse[1] = 1;\r\n\tfor(i=2; i<N; i++)\r\n\t    inverse[i] = M - (M/i) * inverse[M%i] % M;\r\n\tfor(i=1; i<N; i++)\r\n\t    h[i] = (h[i-1] + inverse[i]) % M;\r\n\twhile(t--) {\r\n\t    scanf(\"%d\", &n);\r\n\t    long long answer = 0, x;\r\n\t    for(i=1; i<=n; i++) {\r\n\t        scanf(\"%lld\", &x);\r\n\t        answer = (answer + x * ((h[i-1] + h[n-i]) % M))% M;\r\n\t    }\r\n\t    printf(\"%lld\\n\", answer);\r\n\t} \r\n\treturn 0;\r\n\r\n}\r\n\r\n",
