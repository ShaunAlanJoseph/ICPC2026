  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m = 3*n;\r\n\t    \r\n\t    vector<long long> r(m);\r\n\t    \r\n\t    for(int i = 0; i<m; i++) cin>>r[i];\r\n\t    \r\n\t    sort(r.rbegin(), r.rend());\r\n\t    \r\n\t    vector<long long> S(m+1, 0);\r\n\t    \r\n\t    for(int i = 0; i<m; i++){\r\n\t        S[i+1] = S[i] + r[i];\r\n\t    }\r\n\t    \r\n\t    auto f = [&](int a, int b){\r\n\t        return 2 * S[a] + S[a + 2*b] + 3 * S[3*n - 2*a - b];\r\n\t    };\r\n\t    \r\n\t    long long best = 0;\r\n\t    \r\n\t    for(int a = 0; a<=n; a++){\r\n\t        int lo = 0, hi = n - a;\r\n\t        while(lo < hi){\r\n\t            int mid = (lo + hi) / 2;\r\n\t            if(f(a, mid + 1) > f(a, mid)) lo = mid + 1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        \r\n\t        best = max(best, f(a, lo));\r\n\t    }\r\n\t    \r\n\t    cout<<best<<endl;\r\n\t}\r\n}\r\n",
