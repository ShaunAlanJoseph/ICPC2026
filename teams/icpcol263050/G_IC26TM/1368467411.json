  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long>a(3*n) ;\r\n    for(int i=0;i<3*n;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector<long long>p(3*n+1, 0);\r\n    \r\n    for(int i=0;i<3*n;i++){\r\n        p[i+1] = a[i] + p[i];\r\n    }\r\n    auto  f=[&](long long c2,long long c3,long long m){\r\n        return 2LL *p[m-c2]+p[m+c2]+3LL*p[n+c2+2*c3];\r\n    };\r\n    long long max_sum=0;\r\n    for(long long c3=0;c3<=n;c3++){\r\n        long long m=n-c3;\r\n        long long low=0,high=m;\r\n        while(high-low>2){\r\n            long long mid1=low+(high-low)/3;\r\n            long long mid2=high -(high-low)/3;\r\n            if(f(mid1,c3,m)<f(mid2,c3,m))\r\n            low=mid1;\r\n            else\r\n            high=mid2;\r\n        }\r\n        for(long long c2=low;c2<=high;c2++){\r\n            max_sum=max(max_sum,f(c2,c3,m));\r\n        }\r\n    }\r\n    cout<<max_sum<<\"\\n\";\r\n    \r\n    \r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\t\r\n    \r\n}\r\n",
