  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nstring ret(int a, int b, int c, int d) {\r\n    string s = \"\";\r\n    while (a > 0 && (d > 0 || b > 0)) {\r\n        s += \"00\";\r\n        --a;\r\n        if (d > 0) --d;\r\n        else --b;\r\n    }\r\n    while (a > 0) {\r\n        s += \"0\";\r\n        --a;\r\n    }\r\n    while (c > 0) {\r\n        s += \"0\";\r\n        --c;\r\n    }\r\n    while (b > 0 && d > 0) {\r\n        s += \"01\";\r\n        --b;\r\n        --d;\r\n    }\r\n    while (b > 0) {\r\n        if (b > 1) {\r\n            s += \"01\";\r\n            b -= 2;\r\n        } else {\r\n            s += \"1\";\r\n            --b;\r\n        }\r\n    }\r\n    while (d > 0) {\r\n        s += \"1\";\r\n        --d;\r\n    }\r\n    return s;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t = 0;\r\n    cin >> t;\r\n    while (t--) {\r\n        int a, b, c, d;\r\n        cin >> a >> b >> c >> d;\r\n        string ans = \"2\";\r\n        if (a > 0) {\r\n            string s = ret(a-1, b, c, d) + \"00\";\r\n            if (s < ans) ans = s;\r\n        }\r\n        if (b > 0) {\r\n            string s = ret(a, b-1, c, d) + \"01\";\r\n            if (s < ans) ans = s;\r\n        }\r\n        if (c > 0) {\r\n            string s = ret(a, b, c-1, d) + \"10\";\r\n            if (s < ans) ans = s;\r\n        }\r\n        if (d > 0) {\r\n            string s = ret(a, b, c, d-1) + \"11\";\r\n            if (s < ans) ans = s;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n}\r\n",
