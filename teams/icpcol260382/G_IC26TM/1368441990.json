  "source_code": "t = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    \r\n    v = list(map(int, input().split()))\r\n    v.sort(reverse=True)\r\n    \r\n    m = 3 * n\r\n    P = [0] * (m + 1)\r\n    for i in range(m):\r\n        P[i + 1] = P[i] + v[i]\r\n    \r\n    b = n\r\n    best = 0\r\n    \r\n    for a in range(n + 1):\r\n        if b > n - a:\r\n            b = n - a\r\n        \r\n        while b > 0 and v[a + 2 * b - 2] + v[a + 2 * b - 1] < 3 * v[m - 2 * a - b]:\r\n            b -= 1\r\n        \r\n        s = 2 * P[a] + P[a + 2 * b] + 3 * P[m - 2 * a - b]\r\n        \r\n        if s > best:\r\n            best = s\r\n    \r\n    print(best)\r\n    \r\n    ",
