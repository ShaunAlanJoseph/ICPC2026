  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD=998244353;\r\nconst int MAX_N=200005;\r\nint main() {\r\n\t// your code goes here\r\n    vector<long long>in(MAX_N+1);\r\n    in[1]=1;\r\n    for(int i=2;i<=MAX_N;i++)\r\n    {\r\n        in[i]=(MOD-(MOD/i)*in[MOD%i]%MOD)%MOD;\r\n    }\r\n    vector<long long>har(MAX_N+1,0);\r\n    for(int i=1;i<=MAX_N;i++)\r\n    {\r\n        har[i]=(har[i-1]+in[i])%MOD;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        long long ans=0;\r\n        for(int j=1;j<=n;j++)\r\n        {\r\n            long long val;\r\n            cin>>val;\r\n            val%=MOD;\r\n            if(val<0)\r\n                val+=MOD;\r\n            long long w=(har[j-1]+har[n-j])%MOD;\r\n            ans=(ans+val*w)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
