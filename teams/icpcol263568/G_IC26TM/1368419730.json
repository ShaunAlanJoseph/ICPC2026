  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int tot=3*n;\r\n        vector<long long>r(tot);\r\n        for(int i=0;i<tot;i++){\r\n            cin>>r[i];\r\n        }\r\n        sort(r.rbegin(),r.rend());\r\n        vector<long long>pre(tot+1,0);\r\n        for(int i=0;i<tot;i++){\r\n            pre[i+1]=pre[i]+r[i];\r\n        }\r\n        long long b=0;\r\n        for(int i=0;i<=n;i++){\r\n            auto value=[&](int q){\r\n            return 2*pre[i]+pre[i+2*q]+3*pre[tot-2*i-q];\r\n            };\r\n            int l=0,h=n-i;\r\n            while(l<h){\r\n                int mid=(l+h)/2;\r\n                if(value(mid+1)>value(mid))\r\n                    l=mid+1;\r\n                else\r\n                  h=mid;\r\n            }\r\n            b=max(b,value(l));\r\n            \r\n        \r\n        }\r\n        cout<<b<<endl;\r\n        \r\n    }\r\n\t// your code goes here\r\n\r\n}\r\n",
