  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int length = 3*n;\r\n        vector<long long> b(length);\r\n        for ( int i=0 ; i < length ; i++){\r\n            cin>>b[i];\r\n        }\r\n        sort ( b.begin() , b.end() , greater<long long>() );\r\n        vector<long long> P(length + 1, 0);\r\n        for ( int i=0 ; i < length ; i++){\r\n            P[i+1] = P[i] + b[i];\r\n            \r\n        }\r\n        auto V = [&](int p, int q){\r\n            return 2*P[p] + P[p+2*q] + 3 * P[length-2*p - q];\r\n        };\r\n        long long ans = 0;\r\n        for ( int p=0 ; p<= n ; p++){\r\n            int lo = 0 , hi = n-p;\r\n            while (lo < hi){\r\n                int mid = (lo + hi) / 2;\r\n                if(V(p, mid + 1 )  > V(p , mid )) lo = mid + 1;\r\n                else hi = mid;\r\n            }\r\n            ans = max(ans , V(p ,lo));\r\n        }\r\n        cout<<ans<<endl;\r\n        \r\n    }\r\nreturn 0;}\r\n",
