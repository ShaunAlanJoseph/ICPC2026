  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t;\r\n    cin >>t;\r\n    while (t--){\r\n        int n;\r\n        cin >>n;\r\n        vector<long long> a(n+1);\r\n        for (int i=1; i<=n; i++){\r\n            cin>> a[i];\r\n            a[i] %=MOD;\r\n            if (a[i]<0) a[i]+=MOD;\r\n        }\r\n        \r\n        vector<long long>inv(n+2, 1), H(n+1,0);\r\n        for (int i=2; i<=n; i++)\r\n            inv[i]=(MOD - (MOD/i)* inv[MOD%i]%MOD)%MOD;\r\n        for(int i=1; i<=n; i++)\r\n            H[i]=(H[i-1]+inv[i])%MOD;\r\n            \r\n        long long ans=0;\r\n        for (int j=1; j<=n; j++){\r\n            long long coef= (H[j-1]+ H[n-j])%MOD;\r\n            ans=(ans+a[j]*coef)%MOD;\r\n        }\r\n        cout <<ans<<\"\\n\";\r\n    }\r\n    return 0;\r\n}\r\n",
