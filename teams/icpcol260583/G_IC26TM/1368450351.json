  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int m=3*n;\r\n        vector<long long> a(m);\r\n        for (auto &x:a) cin >>x;\r\n        sort(a.rbegin(), a.rend());\r\n        \r\n        vector<long long> S(m+1, 0);\r\n        for (int i=0; i<m; i++) S[i+1]=S[i]+a[i];\r\n        \r\n        long long best=0;\r\n        for(int p=0; p<=n; p++){\r\n            auto val=[&](long long q){\r\n                return 2*S[p]+S[p+2*q]+3*S[m-2*p-q];\r\n            };\r\n            int io=0, hi=n-p;\r\n            while(io<hi){\r\n                int mid=(io+hi)/2;\r\n                if (val(mid + 1) >val(mid)) io=mid+1;\r\n                else hi=mid;\r\n            }\r\n            best= max(best, val(io));\r\n        }\r\n        cout << best<<\"\\n\";\r\n    }\r\n    return 0;\r\n}\r\n",
