  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    ar=sorted(map(int,input().split()),reverse=True)\r\n    pr=[0]\r\n    for x in ar:\r\n        pr.append(pr[-1]+x)\r\n    def f(x,y):\r\n        return 2*pr[x]+pr[x+2*y]+3*pr[3*n-2*x-y]\r\n    b=0\r\n    for x in range(n+1):\r\n        lo,hi=0,n-x\r\n        while lo<hi:\r\n            m=(lo+hi)//2 \r\n            if f(x,m+1)>f(x,m):\r\n                lo=m+1 \r\n            else:\r\n                hi=m \r\n        b=max(b,f(x,lo))\r\n    print(b)",
