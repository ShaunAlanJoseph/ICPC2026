  "source_code": "# cook your dish here\r\n\r\nMOD = 998244353\r\nin_t = int(input())\r\npri_t = []\r\nMAXI_N = 1\r\n\r\nfor _ in range(in_t):\r\n    in_n = int(input())\r\n    in_li = list(map(int, input().split()))\r\n    pri_t.append(in_li)\r\n    MAXI_N = max(MAXI_N, in_n)\r\n    \r\npri_inv = [0,1] + [0] * MAXI_N \r\n\r\nfor pri in range(2, MAXI_N+1):\r\n    pri_inv[pri] = (MOD - (MOD // pri) * pri_inv[MOD % pri] % MOD) % MOD\r\npri_dp = [0] * (MAXI_N +1)\r\n\r\nfor pri in range(1, MAXI_N+1):\r\n    pri_dp[pri] = (pri_dp[pri-1] + pri_inv[pri]) % MOD\r\n    \r\npri_res = []\r\nfor pri_li in pri_t:\r\n    n = len(pri_li)\r\n    p_res = 0\r\n    for i in range(n):\r\n        p_res += pri_li[i] * (pri_dp[i] + pri_dp[n-1-i])\r\n    pri_res.append(str(p_res % MOD))\r\nprint(\"\\n\".join(pri_res))\r\n\r\n\r\n\r\n\r\n    \r\n    ",
