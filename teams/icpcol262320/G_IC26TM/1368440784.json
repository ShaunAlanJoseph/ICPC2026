  "source_code": "# cook your dish here\r\nin_t = int(input())\r\n\r\ndef pri_helper(in_n, in_li):\r\n    in_li.sort(reverse = True)\r\n    p_m = 3 * in_n\r\n    pri_prefix = [0] * (p_m+1)\r\n    for i in range(p_m):\r\n        pri_prefix[i+1] = pri_prefix[i] + in_li[i]\r\n    pri_res = 0\r\n    n_2 = in_n\r\n    for n_1 in range(in_n+1):\r\n        if n_2 > in_n - n_1:\r\n            n_2 = in_n - n_1\r\n        \r\n        while n_2 > 0 and in_li[n_1 + 2 * n_2 - 2] + in_li[n_1 + 2 * n_2 - 1] <= 3 * in_li[p_m - 2 * n_1 - n_2]:\r\n            n_2 -= 1 \r\n        pri_val = 2 * pri_prefix[n_1] + pri_prefix[n_1 + 2 * n_2] + 3 * pri_prefix[p_m-2*n_1-n_2]\r\n        if pri_val > pri_res:\r\n            pri_res = pri_val\r\n    return pri_res\r\n\r\nfor _ in range(in_t):\r\n    in_n = int(input())\r\n    in_li = list(map(int, input().split()))\r\n    print(pri_helper(in_n, in_li))",
