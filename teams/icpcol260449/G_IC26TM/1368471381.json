  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n#define ll long long\r\n#define vi vector<int>\r\n#define sz(x) (int)x.size()\r\n\r\nvoid solve(){\r\n    ll n;cin>>n;\r\n    vector<ll>v(3*n+1);\r\n    v[0]=1e10;\r\n    for(int i=1;i<=3*n;i++) cin>>v[i];\r\n    sort(v.rbegin(),v.rend());\r\n    vector<ll>pref(3*n+1,0);\r\n    pref[1] = v[1];\r\n    for(int i=2;i<=3*n;i++) pref[i]=pref[i-1]+v[i];\r\n    auto check = [&](int a,int b){\r\n        if(b)\r\n        return 2*pref[a] + pref[a+2*b] + 3*pref[3*n-2*a-b]; \r\n    }; \r\n    ll ans = 0;\r\n    for(int a=0;a<=n;a++){\r\n        ll lo=0,hi = n-a;\r\n        while(lo<=hi){\r\n            ll mid = (lo+hi)/2;\r\n            ll p1 = check(a,mid);\r\n            ll p2 = 0;\r\n            if(mid+1<=hi) p2= check(a,mid+1);\r\n            if(p1 < p2){\r\n                lo=mid+1;\r\n            }\r\n            else {\r\n                hi=mid-1;\r\n            }\r\n            ans = max(ans,max(p1,p2));\r\n        }\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    int t;cin>>t;\r\n    while(t--) solve();\r\n}\r\n",
