  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\n\r\nconst ll mod = 998244353;\r\nconst int n = 200000;\r\n\r\nll inv[n], h[n];\r\n\r\n\r\nvoid func() {\r\n    inv[1] = 1;\r\n    \r\n    for(int i = 2; i < n; i++) {\r\n        inv[i] = mod - (mod / i) * inv[mod % i] % mod;\r\n    }\r\n    \r\n    for(int i = 1; i < n; i++) {\r\n        h[i] = (h[i-1] + inv[i]) % mod;\r\n    }\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    func();\r\n    while(t--) {\r\n        int n; cin >> n;\r\n        vector<ll>arr(n);\r\n        for(auto &i : arr) cin >> i;\r\n        \r\n        ll ans = 0;\r\n        for(int i = 0; i < n; i++) {\r\n            ll x = h[i] + h[n-i-1];\r\n            x = x % mod; \r\n            \r\n            ans = (ans%mod +( arr[i] * x) %mod ) %mod;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n}\r\n",
