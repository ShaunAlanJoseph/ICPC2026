  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    p=[0]\r\n    for x in a:\r\n        p.append(p[-1]+x)\r\n    def f(x,y):\r\n        z=3*n-2*x-y\r\n        return 6*p[x]+4*(p[x+2*y]-p[x])+3*(p[z]-p[x+2*y])\r\n    ans=0\r\n    for x in range(n+1):\r\n        l,r=0,n-x\r\n        while l<r:\r\n            m=(l+r)//2\r\n            q=x+2*m\r\n            z=3*n-2*x-m\r\n            if a[q]+a[q+1]>=3*a[z-1]:\r\n                l=m+1\r\n            else:\r\n                r=m \r\n        ans=max(ans,f(x,l),f(x,l-1) if l else 0)\r\n    print(ans)",
