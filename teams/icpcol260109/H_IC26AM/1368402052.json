  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n#define int ll\r\nconst ll MOD = 998244353;\r\nconst int MAX_N = 2e5 + 2;\r\nll harm[MAX_N];\r\nll inv_arr[MAX_N];\r\nll binexp(int x, int y) {\r\n    ll res = 1;\r\n    x %= MOD;\r\n    while (y>0) {\r\n        if (y&1) res = res * x % MOD;\r\n        x = x*x % MOD;\r\n        y >>= 1;\r\n    }\r\n    return res;\r\n}\r\nll inv(ll x) {\r\n    return binexp(x, MOD-2);\r\n}\r\nvoid precomp() {\r\n    harm[0] = 0;\r\n    for(int i=1;i<MAX_N;i++) {\r\n        inv_arr[i] = inv(i);\r\n        harm[i] = (harm[i-1] + inv_arr[i])%MOD;\r\n    }\r\n}\r\nsigned main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\tprecomp();\r\n\twhile(t--) {\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    ll arr[n];\r\n\t    for(int i=0;i<n;i++){\r\n\t        cin >> arr[i];\r\n\t    }\r\n\t    ll val = 0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        int j = i+1;\r\n\t        (val += (arr[i] * ((harm[i] + harm[n-j])%MOD))%MOD)%=MOD;\r\n\t    }\r\n\t    cout << val << \"\\n\";\r\n\t}\r\n\t\r\n\r\n}\r\n",
