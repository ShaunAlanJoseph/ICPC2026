  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nvoid solve(){\r\n    int n ; cin >> n ;\r\n    vector<int>a(3*n);\r\n    for(int i = 0;i<3*n;i++)cin>>a[i];\r\n    sort(a.rbegin(), a.rend());\r\n    // for(int  i =0;i<3*n/2;i++)swap(a[i],a[3*n-1-i]);\r\n    vector<int>pref(3*n+1,0);\r\n    for(int i = 0;i<3*n;i++)pref[i+1] = pref[i]+a[i];\r\n    int m = 0;\r\n    for(int x1 = 0;x1<=n;x1++){\r\n        int l = 0, r = n-x1;\r\n        while(l+1<r){\r\n            int m = (l+r)/2;\r\n            int c1 = 2*pref[x1]+pref[x1+2*m]+3*pref[3*n-2*x1-m];\r\n            int c2 = 2*pref[x1]+pref[x1+2*(m+1)]+3*pref[3*n-2*x1-(m+1)];\r\n            if(c1==c2)l=r=m;\r\n            else if(c2>c1)l = m;\r\n            else r=m;\r\n        }\r\n        int c1 = 2*pref[x1]+pref[x1+2*l]+3*pref[3*n-2*x1-l];\r\n        int c2 = 2*pref[x1]+pref[x1+2*r]+3*pref[3*n-2*x1-r];\r\n        m = max(m,max(c1,c2));\r\n    }\r\n    cout<<m<<\"\\n\";\r\n}\r\n\r\n\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\r\n  int t ; cin >> t ;\r\n  while(t--){\r\n      solve();\r\n  }\r\n}\r\n",
