  "source_code": "# cook your dish here\r\nt = int(input())\r\n\r\nwhile t > 0:\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    \r\n    a.sort(reverse=True)\r\n    \r\n    m = 3 * n\r\n    \r\n    \r\n    prefix = [0] * (m + 1)\r\n    \r\n    for i in range(m):\r\n        prefix[i + 1] = prefix[i] + a[i]\r\n        \r\n    ans = 0\r\n    \r\n    for A in range(n+1):\r\n        \r\n        low = 0\r\n        high = n - A\r\n        \r\n        \r\n        while low < high:\r\n            B = (low+high)//2\r\n            \r\n            p = A+2*B \r\n            q = 3*n-2*A - B \r\n            \r\n            change = a[p] + a[p+1] - 3*a[q - 1]\r\n            \r\n            if change >= 0:\r\n                low = B + 1\r\n            else:\r\n                high = B\r\n                \r\n        B = low\r\n        \r\n        p = A + 2*B \r\n        q = 3*n - 2*A - B \r\n        \r\n        value = 3*prefix[q] + prefix[p] + 2*prefix[A]\r\n        \r\n        ans = max(ans, value)\r\n        \r\n    print(ans)\r\n    \r\n    t-=1\r\n        ",
