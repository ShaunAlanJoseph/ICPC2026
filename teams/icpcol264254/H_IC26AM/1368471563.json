  "source_code": "import sys\r\ndef solve():\r\n    input=sys.stdin.read().split()\r\n    if not input:\r\n        return\r\n    mod=998244353\r\n    max_n=200005\r\n    inv=[0]*max_n\r\n    if max_n>1:\r\n        inv[1]=1\r\n    for i in range(2,max_n):\r\n        inv[i]=(mod-mod//i)*inv[mod%i]%mod\r\n    h=[0]*max_n\r\n    for i in range(1,max_n):\r\n        h[i]=(h[i-1]+inv[i])%mod\r\n    iterator=iter(input)\r\n    t=int(next(iterator))\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(next(iterator))\r\n        a=[int(next(iterator)) for _ in range(n)]\r\n        if n<=1:\r\n            out.append(\"0\")\r\n            continue\r\n        ans=0\r\n        for i in range(n):\r\n            coef=(h[i]+h[n-1-i])%mod\r\n            ans=(ans+a[i]*coef)%mod\r\n        out.append(str(ans))\r\n    sys.stdout.write('\\n'.join(out)+'\\n')\r\nif __name__=='__main__':\r\n    solve()",
