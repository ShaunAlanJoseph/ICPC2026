  "source_code": "T = int(input())\r\nfor _ in range(T):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    a.sort()\r\n    m = 3 * n\r\n    pref = [0] * (m+1)\r\n    for i in range(m):\r\n        pref[i+1] = pref[i] + a[i]\r\n    total = pref[m]\r\n    ans = 0\r\n    for p in range(n+1):\r\n        max_q = n - p\r\n        lo, hi = 0,max_q\r\n        while lo < hi:\r\n            q = (lo + hi) // 2\r\n            B = m -p - 2 * q \r\n            C = 2 * p + q\r\n            diff = -(a[B-2]+ a[B-1]) +3 * a[C]\r\n            if diff >=0:\r\n                hi = q \r\n            else:\r\n                lo = q + 1\r\n        for q in (lo -1, lo):\r\n            if 0 <= q <= max_q:\r\n                A = m-p\r\n                B = m - p - 2 * q \r\n                C = 2 * p + q \r\n                value = (6*total - 2 * pref[A] - pref[B] -3*pref[C])\r\n                ans = max(ans,value)\r\n    print(ans)",
