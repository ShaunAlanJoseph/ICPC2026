  "source_code": "import sys\r\nMOD = 998244353\r\ninput = sys.stdin.readline\r\nt = int(input())\r\ntests = []\r\nmx = 0\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    tests.append((n,a))\r\n    mx = max(mx,n)\r\ninv = [0] * (mx + 1)\r\nif mx >= 1:\r\n    inv[1] = 1\r\nfor i in range(2,mx + 1):\r\n    inv[i] = MOD - (MOD // i) * inv[MOD % i] % MOD \r\nH =[0] * (mx + 1)\r\nfor i in range(1,mx + 1):\r\n    H[i] = (H[i - 1] + inv[i]) % MOD\r\nfor n,a in tests:\r\n    ans = 0\r\n    for i in range(n):\r\n        coef = (H[i]+ H[n-1-i]) % MOD \r\n        ans = (ans + (a[i] % MOD) * coef) % MOD \r\n    print(ans)",
