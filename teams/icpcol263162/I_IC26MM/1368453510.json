  "source_code": "import sys\r\ninput = sys.stdin.readline\r\nMOD = 998244353\r\ndef solve(n,a):\r\n    pos = [[] for _ in range(n+1)]\r\n    for i,x in enumerate(a,1):\r\n        pos[x].append(i)\r\n    dp = [1]\r\n    for x in range(1,n):\r\n        ndp = [0] * (x+1)\r\n        for l in range(x):\r\n            if not dp[l]:\r\n                continue\r\n            for side in (0,1):\r\n                L = l + side\r\n                R = x - L \r\n                p = L if side else n -R + 1\r\n                ok = True\r\n                for i in pos[x]:\r\n                    pre = min(i,L) + max(0,i-n+R)\r\n                    suf = x - (min(i-1,L) + max(0,i-1-n+R))\r\n                    if not((p<= i and pre == (i+1)//2) or (p >= i and suf == (n-i+2)//2)):\r\n                        ok = False\r\n                        break\r\n                if ok:\r\n                    ndp[L] = (ndp[L]+dp[l]) % MOD \r\n        dp = ndp\r\n    if pos[n]:\r\n        ans = 0\r\n        for l,v in enumerate(dp):\r\n            peak = l + 1 \r\n            if all(i==1 and peak == 1 or i == n and peak == n \r\n                    for i in pos[n]):\r\n                ans = (ans+v)% MOD\r\n        return ans\r\n    return sum(dp) % MOD\r\n    \r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    print(solve(n,a))",
