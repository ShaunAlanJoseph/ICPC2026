  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int N=3*n;\r\n\t    vector<ll>a(N);\r\n\t    for(ll &x:a)\r\n\t    cin>>x;\r\n\t    sort(a.begin(),a.end());\r\n\t    \r\n\t    vector<ll>pf(N+1,0);\r\n\t    for(int i=0;i<N;i++)\r\n\t    pf[i+1]=pf[i]+a[i];\r\n\t    ll total=pf[N];\r\n\t    auto bot=[&](int k)->ll{\r\n\t        return pf[k];\r\n\t    };\r\n\t    auto top=[&](int k)->ll{\r\n\t        return total-pf[N-k];\r\n\t    };\r\n\t    auto val=[&](int A,int B)->ll{\r\n\t        return 3*total+2*top(A)+top(A+2*B)-3*bot(2*A+B);\r\n\t    };\r\n\t    ll ans=0;\r\n\t    for(int A=0;A<=n;A++){\r\n\t        int l=0;\r\n\t        int h=n-A;\r\n\t        while(l<h){\r\n\t            int mid=(l+h)/2;\r\n\t            ll del=top(A+2*mid+2)-top(A+2*mid)-3*a[2*A+mid];\r\n\t            if(del>=0)l=mid+1;\r\n\t            else h=mid;\r\n\t        }\r\n\t        ans=max(ans,val(A,l));\r\n\t        if(l>0)\r\n\t        ans=max(ans,val(A,l-1));\r\n\t        \r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t    \r\n\t    \r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
