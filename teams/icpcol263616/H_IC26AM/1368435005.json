  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long M=998244353;\r\nint main() {\r\n\t// your code goes here\r\n    int N=200001;\r\n    vector<long long> inv(N+1,1),H(N+1,0);\r\n    for(int i=2;i<=N;i++) inv[i]=(M-M/i) * inv[M%i]%M;\r\n    for(int i = 1 ; i<= N ; i++)\r\n    {H[i] = (H[i-1]+inv[i])%M;}\r\n    int t;scanf(\"%d\",&t);\r\n    while(t--){\r\n        int n;scanf(\"%d\",&n);\r\n        long long s=0;\r\n        for(int j=1;j<=n;j++){\r\n            long long a; scanf(\"%lld\", &a);\r\n            s=(s+a*((H[j-1]+H[n-j]) %  M)) %M;\r\n        }\r\n        printf(\"%lld\\n\",s);\r\n    }\r\n}\r\n",
