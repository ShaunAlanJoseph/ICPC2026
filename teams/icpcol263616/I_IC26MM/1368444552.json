  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int M=998244353;\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        vector<vector<int>> g(n+1);\r\n        for(int i=1,v;i<=n;++i)\r\n            scanf(\"%d\",&v),g[v].push_back(i);\r\n        vector<long long> dp(n+1),nd(n+1);\r\n        dp[0]=1;\r\n        long long ans=0;\r\n        for(int tm=0;tm<n;++tm){\r\n            int v=tm+1;\r\n            fill(nd.begin(),nd.end(),0);\r\n            for(int x=0;x<=tm;++x){\r\n                if(!dp[x]) continue;\r\n                int y=tm-x;\r\n                auto un=[&](int j){return x<j && j<=n-y;};\r\n                auto ok=[&](int f){\r\n                    for(int i:g[v]){\r\n                        int A=(i+1)/2, al=n-i/2, B=(n+i+1)/2, be=i-1+(n-i+2)/2;\r\n                        bool pre=(v<al && f==A) || (v==al && un(A));\r\n                        bool suf=(v<be && f==B) || (v==be && un(B));\r\n                        if(!pre && !suf) return false;\r\n                    }\r\n                    return true;\r\n                };\r\n                if(tm==n-1){\r\n                    if(ok(x+1)) ans+=dp[x];\r\n                    continue;\r\n                }\r\n                if(ok(x+1)) nd[x+1]=(nd[x+1] +dp[x])%M;\r\n                if(ok(n-y)) nd[x]=(nd[x]+dp[x])%M;\r\n        }\r\n        swap(dp,nd);\r\n    }\r\n    printf(\"%lld\\n\",ans%M);\r\n\r\n}\r\n}",
