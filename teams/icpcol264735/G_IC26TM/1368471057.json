  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint main() {\r\n\t// your code goes here\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t   ll n; cin>>n;\r\n\t   vector<ll> a(3*n);\r\n\t   for(ll i=0; i<3*n; i++){\r\n\t       cin>>a[i];\r\n\t   }\r\n\t   \r\n\t   sort(a.rbegin(), a.rend());\r\n\t   vector<ll> pre(3*n+1,0);\r\n\t   \r\n\t   for(ll i=0; i<3*n;i++){\r\n\t       pre[i+1]=pre[i]+a[i];\r\n\t   }\r\n\t   ll to=0;\r\n\t   for(ll i=0; i<=n; i++){\r\n\t       ll mB=n-i;\r\n\t       ll lo=0, hi=mB-1;\r\n\t       ll B=0;\r\n\t       while(lo<=hi){\r\n\t           ll mi=(lo+hi)/2;\r\n\t           ll q=i+2*mi, r=3*n-2*i-mi;\r\n\t           ll ga=a[q]+a[q+1]-3LL*a[r-1];\r\n\t           if(ga>=0){\r\n\t               B=mi+1;\r\n\t               lo=mi+1;\r\n\t           }\r\n\t           else hi=mi-1;\r\n\t       }\r\n\t       for(ll j=max(0LL,B-2); j<=min(mB,B+2); j++){\r\n\t           ll c=n-i-j;\r\n\t           ll p1=i, p2=i+2*j, p3=p2+3*c;\r\n\t           ll val=6LL*pre[p1]+4LL*(pre[p2]-pre[p1])+3LL*(pre[p3]-pre[p2]);\r\n\t           to=max(to,val);\r\n\t       }\r\n\t       \r\n\t   }\r\n\t   cout<<to<<endl;\r\n\t}\r\n\t\r\n\r\n}\r\n",
