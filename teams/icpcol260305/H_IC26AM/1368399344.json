  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int m = 998244353;\r\nconst int k = 200000;\r\n\r\nlong long v[k + 1], h[k + 1];\r\n\r\nvoid solve()\r\n{\r\n    int n ;\r\n    cin >> n;\r\n    long long s = 0;\r\n    for(int i = 1; i <= n;i++)\r\n    {\r\n        long long x;\r\n        cin >> x;\r\n        s = (s + x * ((h[i - 1] + h[n - i]) % m)) % m;\r\n        // cout << s << endl;\r\n    }\r\n    cout << s << endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    v[1] = 1;\r\n    for(int i = 2; i <= k; i++)\r\n    {\r\n        v[i] = m - (m / i) * v[m %i] % m;\r\n    }\r\n    for(int i = 1; i <= k; i++)\r\n    {\r\n        h[i] = (h[i - 1] + v[i]) % m;\r\n    }\r\n    int t;\r\n    cin >> t;\r\n    while(t--)\r\n        solve();\r\n    \r\n    return 0;\r\n}\r\n",
