  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve()\r\n{\r\n    int n;\r\n    cin >> n;\r\n    int m = 3*n;\r\n    vector<long long> a(m + 1), p(m + 1);\r\n    for(int i = 1; i <= m; i++)\r\n        cin >> a[i];\r\n    sort(a.begin() + 1, a.end(), greater<long long>());\r\n    for(int i = 1; i <= m; i++)\r\n    {\r\n        p[i] = p[i - 1] + a[i];\r\n    }\r\n    long long s = 0;\r\n    for(int i = 0; i <= n; i++)\r\n    {\r\n        int l = 0, r = n - i;\r\n        while(l < r)\r\n        {\r\n            int j = l + (r - l) /2 ;\r\n            if(a[i + 2 * j + 1] + a[i + 2 * j + 2] >= 3LL * a[m - 2 * i - j])\r\n            {\r\n                l = j + 1;\r\n            }\r\n            else\r\n            {\r\n                r = j;\r\n            }\r\n        }\r\n        long long yxz = 2LL * p[i] + p[i + 2 *l] + 3LL *p[m - 2*i - l];\r\n        s = max(s, yxz);\r\n    }\r\n    cout << s << endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--)\r\n\t{\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
