  "source_code": "# cook your dish here\r\nMOD=998244353\r\nfor _ in range(int(input())):\r\n    n=int(input());\r\n    a=list(map(int, input().split()))\r\n    h=[0]*(n+1)\r\n    for i in range(1,n+1):\r\n        h[i]=(h[i-1]+pow(i,MOD-2,MOD))%MOD\r\n    print(sum(x*(h[i]+h[n-1-i]) for i,x in enumerate(a))%MOD)\r\n        \r\n",
