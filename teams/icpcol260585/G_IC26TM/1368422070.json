  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    p=[0]\r\n    for x in a:\r\n        p.append(p[-1]+x)\r\n    def calc(A,B):\r\n        \r\n        y=A+2*B\r\n        z=3*n-2*A-B\r\n        return 6*p[A]+4*(p[y]-p[A])+3*(p[z]-p[y])\r\n    ans=0\r\n    \r\n    for A in range(n+1):\r\n        l=0\r\n        r=n-A\r\n        while l<r:\r\n            B=(l+r)//2\r\n            y=A+2*B\r\n            z=3*n-2*A-B\r\n            d=a[y]+a[y+1]-3*a[z-1]\r\n            \r\n            if d>=0:\r\n                l=B+1\r\n                \r\n            else:\r\n                r=B\r\n        \r\n        ans=max(ans,calc(A,l))\r\n        if l>0:\r\n         ans=max(ans,calc(A,l-1))\r\n        \r\n    print(ans)",
