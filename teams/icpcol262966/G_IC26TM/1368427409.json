  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nvoid solve()\r\n{\r\n    int n;\r\n    cin >> n;\r\n    \r\n    int tot = 3 * n;\r\n    \r\n    vector<int>a(tot);\r\n    \r\n    for(auto &i : a)\r\n    {\r\n        cin >> i;\r\n    }\r\n    \r\n    \r\n    sort(a.begin() , a.end() , greater<int>() );\r\n    \r\n    vector<long long>s(tot+1 , 0);\r\n    for(int i = 0 ; i < tot ; ++i){\r\n        s[i+1] = s[i] + a[i];\r\n    }\r\n    \r\n    long long ans = 0;\r\n    int c2 = n;\r\n    \r\n    for(int c1 = 0 ; c1 <= n ; ++c1 )\r\n    {\r\n        c2 = min(c2 , n - c1);\r\n        \r\n        while(c2 > 0)\r\n        {\r\n            long long diff = (long long)a[c1 + 2 * c2 - 2] + a[c1 + 2 * c2 - 1] - 3LL * a[tot - 2 * c1 - c2];\r\n            \r\n            if(diff < 0){\r\n                c2--;\r\n            }else{\r\n                break;\r\n            }\r\n        }\r\n        \r\n        long long cur = 2LL * s[c1] + s[c1+ 2 * c2] + 3LL * s[tot - 2 * c1 - c2];\r\n        \r\n        if(cur > ans ) ans = cur;\r\n        \r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n        \r\n   \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\twhile(t--)\r\n\t{\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
