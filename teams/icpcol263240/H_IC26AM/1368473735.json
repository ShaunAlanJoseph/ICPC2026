  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int mod = 998244353;\r\nconst int N = 200005;\r\n\r\nint inv[N];\r\nint H[N];\r\n\r\nvoid pre() {\r\n    inv[1] = 1;\r\n    for(int i=2;i<N;i++) {\r\n        inv[i] = (mod - mod / i) * inv[mod % i] % mod;\r\n    }\r\n    H[0] = 0;\r\n    for(int i=1;i<N;i++) {\r\n        H[i] = (H[i-1] + inv[i]) % mod;\r\n    }\r\n}\r\n\r\nvoid solve() {\r\n     int n;\r\n     cin >> n;\r\n     \r\n     int ex = 0;\r\n     for(int i=1;i<=n;i++) {\r\n         int curr;\r\n         cin >> curr;\r\n         \r\n         int ex1 = (H[i-1] + H[n-i]) % mod;\r\n         ex = (ex + curr*ex1 % mod) % mod;\r\n     }\r\n     cout << ex << \"\\n\";\r\n}\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n\tpre();\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--) {\r\n\t    solve();\r\n\t}\r\n}\r\n\r\n",
