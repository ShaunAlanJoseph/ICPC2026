  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvector<long long>pre;\r\nlong long score(int n,int six,int four){\r\n    int three=n-six-four;\r\n    int used=six;\r\n    long long res=6*pre[six];\r\n    res+=4*(pre[used+2*four]-pre[used]);\r\n    used+=2*four;\r\n    res+=3*(pre[used+3*three]-pre[used]);\r\n    return res;\r\n}\r\nint main() {\r\n\t// your code goes here\r\nint t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<int>a(3*n);\r\n    for(int i=0;i<3*n;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    pre.assign(3*n+1,0);\r\n    for(int i=0;i<3*n;i++){\r\n        pre[i+1]=pre[i]+a[i];\r\n    }\r\n    long long ans=0;\r\n    for(int six=0;six<=n;six++){\r\n        int l=0;\r\n        int r=n-six;\r\n        while(l<r){\r\n            int mid=(l+r)/2;\r\n            if(score(n,six,mid)<=score(n,six,mid+1)) l=mid+1;\r\n            else r=mid;\r\n        }\r\n        ans=max(ans,score(n,six,l));\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nreturn 0;\r\n}\r\n",
