  "source_code": "# cook your dish here\r\nimport sys\r\ninput= sys.stdin.buffer.readline \r\nt=int(input())\r\nres=[]\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    nn=3*n \r\n    bef=[0]*(nn+1)\r\n    for i,x in enumerate(a,1):\r\n        bef[i]=bef[i-1]+x \r\n    def fn(p,q):\r\n        abc=(2*bef[p] + bef[p+2*q] + 3*bef[3*n-2*p-q])\r\n        return abc \r\n    \r\n    ans=0 \r\n    q=n \r\n    for p in range(n+1):\r\n        if q>n-p:\r\n            q=n-p\r\n        while q>0:\r\n            prof=(a[p+2*q-2] +a[p+2*q-1]-3*a[3*n-2*p-q]) \r\n            if prof<0:\r\n                q-=1 \r\n            else:\r\n                break \r\n        ans=max(ans,fn(p,q))\r\n    res.append(str(ans))\r\nprint(\"\\n\".join(res))\r\n        ",
