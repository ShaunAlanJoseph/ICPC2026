  "source_code": "#include <bits/stdc++.h>\r\n#define all(v) (v).begin(), (v).end()\r\n#define nl << \"\\n\"\r\nusing namespace std;\r\nusing ll = long long;\r\nusing vll = vector<long long>;\r\n\r\n\r\nint main() {\r\n\t\r\n    ll n, t, k;\r\n    cin >> t;\r\n    \r\n    while(t--){\r\n        \r\n        cin >> n;\r\n        k = 3*n;\r\n        \r\n        vll v(k), v1(k+1);\r\n        for(ll& ele : v)\r\n            cin >> ele;\r\n        \r\n        sort(all(v));\r\n        reverse(all(v));\r\n        \r\n        for(int i=0; i<k; i++)\r\n            v1[i+1] = v[i] + v1[i];\r\n        \r\n        ll b = 0;\r\n        for(ll i=0; i<=n; i++){\r\n            ll l = 0, h = n-i;\r\n            while(l<h){\r\n                ll m = l + (h-l)/2, j = i + 2*m;\r\n                if(v[j]+v[j+1] > 3*v[k - 2*i - m - 1])\r\n                    l = m+1;\r\n                else h = m;\r\n            }\r\n            b = max(b, 2*v1[i] + v1[i + 2*l] + 3*v1[k  - 2*i - l]);\r\n        }\r\n        \r\n        cout << b nl;\r\n        \r\n    }\r\n    return 0;\r\n}\r\n",
