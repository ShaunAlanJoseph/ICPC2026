  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\nll M = 998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    \r\n    while(t--) {\r\n        int n; \r\n        cin >> n;\r\n        \r\n        vector<ll> a(n+1);\r\n        \r\n        for(int i = 1; i <= n; i++) {\r\n            cin >> a[i];\r\n        }\r\n        \r\n        \r\n        vector<ll> iv(n+1);\r\n        vector<ll> h(n+1);\r\n        \r\n        if(n >= 1)\r\n            iv[1] = 1;\r\n            \r\n        for(int i = 2; i <= n; i++) {\r\n            iv[i] = M - (M / i) * iv[M % i] % M;\r\n        }\r\n        \r\n        for(int i = 1; i <= n; i++) {\r\n            h[i] = (h[i - 1] + iv[i]) % M;\r\n        }\r\n        \r\n        ll ans = 0;\r\n        \r\n        for(int i = 1; i <= n; i++) {\r\n            ll coff = (h[i-1] + h[n - i]) % M;\r\n            ans = (ans + a[i] * coff) % M;\r\n        }\r\n        \r\n        cout << ans << endl;\r\n    }\r\n}\r\n",
