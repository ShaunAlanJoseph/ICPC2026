  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD = 998244353;\r\nconst int MAXN = 200005;\r\nlong long inv[MAXN];\r\nlong long H[MAXN];\r\n\r\nvoid pc(){\r\n    inv[1] = 1;\r\n    for(int i = 2; i < MAXN; ++i){\r\n        inv[i] = (MOD - (MOD / i)* inv[MOD % i] % MOD) % MOD;\r\n    }\r\n    H[0] =0;\r\n    for(int i = 1;i < MAXN; ++i){\r\n        H[i] = (H[i-1] + inv[i]) % MOD;\r\n    }\r\n}\r\n\r\nvoid pc1(){\r\n    int n;\r\n    cin>> n;\r\n    long long expected_value =0;\r\n    for( int i = 0; i < n; ++i){\r\n        long long a_i;\r\n        cin>>a_i;\r\n        long long coeff = (H[i] + H[n -1 -i])  % MOD;\r\n        expected_value = (expected_value + a_i * coeff) % MOD;\r\n    }\r\n    cout <<  expected_value << \"\\n\";\r\n}\r\nint main() {\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(NULL);\r\n    pc();\r\n    int tos;\r\n    if(cin>>tos ){\r\n        while(tos--){\r\n            pc1();\r\n        }\r\n    }\r\n    \r\n    return 0;\r\n}\r\n",
