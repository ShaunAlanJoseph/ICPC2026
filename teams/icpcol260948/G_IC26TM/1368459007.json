  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nll cal(ll a ,  ll n ,ll b, vector <ll> &pref){\r\n    ll gg1 = a;\r\n    ll gg2 = a + 2*b;\r\n    ll gg3 = 3*n - 2*a - b;\r\n    \r\n    ll gf1 = pref[gg1];\r\n    ll gf2 = pref[gg2] - pref[gg1];\r\n    ll gf3 = pref[gg3] - pref[gg2];\r\n    \r\n    return 6*gf1 + 4*gf2 + 3*gf3;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tll t;cin>> t;\r\n\twhile(t--){\r\n\t    ll n;cin >>n;\r\n\t    \r\n\t    ll k = 3*n;\r\n\t    vector <ll> temp(k);\r\n\t    for(int i =0;i<k;i++)cin>> temp[i];\r\n\t    sort(temp.rbegin() , temp.rend());\r\n\t    vector <ll> pref(k+1 , 0);\r\n\t    for(ll i = 0;i<k;i++){\r\n\t        pref[i+1] = pref[i] + temp[i];\r\n\t    }\r\n\t    ll maxi = 0;\r\n\t    for(ll i = 0;i<n+1;i++){\r\n\t        ll low = 0 , high = n-i;\r\n\t        \r\n\t        while(low <high){\r\n\t            ll mid = (low + high)/2;\r\n\t            if(cal(i ,n , mid , pref) < cal(i , n , mid+1 , pref)) low = mid+1;\r\n\t            else{\r\n\t                high = mid;\r\n\t            }\r\n\t        }\r\n\t        maxi = max(maxi , cal(i , n , low , pref));\r\n\t    }\r\n\t    cout << maxi << endl;\r\n\t    \r\n\t}\r\n}\r\n",
