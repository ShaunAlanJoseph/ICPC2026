  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD = 998244353;\r\nconst int mx1 = 200005;\r\n\r\nlong long ver1[mx1];\r\nlong long arr[mx1];\r\n\r\nvoid help1(){\r\n    ver1[1]=1;\r\n    int i=2;\r\n    while( i<mx1){\r\n        ver1[i]= (MOD- MOD/i)*ver1[MOD%i]%MOD;\r\n        i++;\r\n    }\r\n    arr[0]=0;\r\n    i=1;\r\n    while( i<mx1){\r\n        arr[i]= (arr[i-1]+ ver1[i])%MOD;\r\n        i++;\r\n    }\r\n}\r\n\r\n\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    vector<long long>p1(n+1);\r\n    int i=1;\r\n    while( i<=n){\r\n        cin >> p1[i];\r\n        i++;\r\n    }\r\n    long long res =0;\r\n    i=1;\r\n    while( i<=n){\r\n        long long cff =  (arr[i-1] + arr[n-i])%MOD;\r\n        res = ( res + p1[i]%MOD*cff)%MOD;\r\n        i++;\r\n    }\r\n    cout << res << endl;\r\n}\r\n\r\nint main() {\r\n\thelp1();\r\n\tint t;\r\n\tif( cin >> t){\r\n\t    while( t--){\r\n\t        solve();\r\n\t    }\r\n\t}\r\n    return 0;\r\n}\r\n",
