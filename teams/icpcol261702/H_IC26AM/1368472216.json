  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ndef solve():\r\n    data=sys.stdin.read().split()\r\n    if not data:\r\n        return\r\n    MOD=998244353\r\n    MAXN=200005\r\n    inv=[0]*MAXN\r\n    inv[1]=1\r\n    for i in range(2,MAXN):\r\n        inv[i]=(MOD - MOD // i) * inv[MOD%i] %MOD\r\n        \r\n    h=[0]*(MAXN)\r\n    for i in range(1,MAXN):\r\n        h[i]=(h[i-1] + inv[i])% MOD\r\n    \r\n    it=iter(data)\r\n    t=int(next(it))\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(next(it))\r\n        a=[int(next(it)) for _ in range(n)]\r\n        total=0 \r\n        for i in range(n):\r\n            weight=(h[i]+ h[n-1-i]) %MOD\r\n            total = (total+a[i]*weight) % MOD\r\n        out.append(str(total))\r\n    sys.stdout.write('\\n'.join(out))\r\n    \r\nif __name__ == \"__main__\":\r\n    solve()",
