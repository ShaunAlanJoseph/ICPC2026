  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tlong long mod=998244353;\r\n\tint lim=200000;\r\n\tvector<long long >inv(lim+1,0);\r\n\tvector<long long>hm(lim+1,0);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=lim;i++){\r\n\t    inv[i]=mod-(mod/i )*inv[mod%i]%mod;\r\n\t}\r\n  for(int i=1;i<=lim;i++){\r\n      hm[i]=(hm[i-1]+inv[i])%mod;\r\n      \r\n  }\r\n  int t;\r\n  cin>>t;\r\n  while(t--){\r\n      int n;\r\n      cin>>n;\r\n      long long ans=0;\r\n      for(int i=0;i<n;i++){\r\n          long long val;\r\n          cin>>val;\r\n          long long wt=(hm[i]+hm[n-i-1])%mod;\r\n          ans=(ans+val*wt)%mod;\r\n          \r\n      }\r\n      cout<<ans<<endl;\r\n  }\r\n  return 0;\r\n}\r\n",
