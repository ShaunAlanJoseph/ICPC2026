  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n    static long mod = 998244353;\r\n\tpublic static void main (String[] args) throws java.lang.Exception\r\n\t{\r\n    Scanner ch = new Scanner(System.in);\r\n    int t = ch.nextInt();\r\n    int max = 200000;\r\n    long[] inv = new long[max+1];\r\n    long[] h = new long[max+1];\r\n    \r\n    inv[1]=1;\r\n    for(int i =2;i<=max;i++)\r\n    inv[i]= mod- (mod/i)*inv[(int)(mod%i)]%mod;\r\n    for(int i =1;i<=max;i++)\r\n    h[i]=(h[i-1]+inv[i])%mod;\r\n    \r\n    while(t-->0){\r\n        int n = ch.nextInt();\r\n        long ans=0;\r\n        for(int i =0;i<n;i++){\r\n            long x = ch.nextLong();\r\n            long c = (h[i]+h[n-i-1])%mod;\r\n            ans=(ans+x*c)%mod;\r\n        }\r\n        System.out.println(ans);\r\n    }\r\n\t}\r\n}\r\n",
