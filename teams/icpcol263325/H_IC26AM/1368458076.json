  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\n#define ll long long\r\nconst ll MOD=998244353;\r\nconst int MAXN=200005;\r\nint main() {\r\n\tvector<ll>inv(MAXN);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<MAXN ; i++){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\tvector<ll>H(MAXN,0);\r\n\tfor(int i=1;i<MAXN;i++){\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    ll ans=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        ll x;\r\n\t        cin>>x;\r\n\t        ll prob=(H[i]+H[n-i-1])%MOD;\r\n\t        ans=(ans+x*prob)%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
