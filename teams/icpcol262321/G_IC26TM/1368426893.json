  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int N=3*n;\r\n\t    vector<long long>a(N);\r\n\t    \r\n\t    for(int i=0;i<N;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long>p(N+1,0);\r\n\t    \r\n\t    for(int i=0;i<N;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    \r\n\t    for(int x=0;x<=n;x++){\r\n\t        int l=0;\r\n\t        int r=n-x;\r\n\t        \r\n\t        while(l<r){\r\n\t            int y=l-((l-r)/2);\r\n\t            long long d=a[x+2*y]+a[x+2*y+1]-3LL*a[N-2*x-y-1];\r\n\t           // cout<<d<<endl;\r\n\t            if(d>=0) l=y+1;\r\n\t            else r=y;\r\n\t        }\r\n\t        \r\n\t        int y=l;\r\n\t        int z=n-x-y;\r\n\t       // cout<<y<<\" \"<<z<<endl;\r\n\t        long long cur=6LL*p[x]+4LL*(p[x+2*y]-p[x])+3LL*(p[x+2*y+3*z]-p[x+2*y]);\r\n\t        \r\n\t        ans=max(ans,cur);\r\n\t       // cout<<cur<<endl;\r\n\t       // cout<<ans<<end;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
