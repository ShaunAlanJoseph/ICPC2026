  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nlong long MOD=998244353;\r\nint maxi=200000;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tvector<long long> inv(maxi+1);\r\n\tvector<long long> h(maxi+1);\r\n\t\r\n\tinv[1]=1;\r\n\tint i=2;\r\n\twhile(i<=maxi){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t    i++;\r\n\t}\r\n\ti=1;\r\n\twhile(i<=maxi){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t    i++;\r\n\t}\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<long long>a(n);\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t   // for(int i=0;i<n;i++){\r\n\t   //     cout<<inv[i]<<\" \";\r\n\t   // }\r\n\t   // cout<<endl;\r\n\t   // for(int i=0;i<n;i++){\r\n\t   //     cout<<h[i]<<\" \";\r\n\t   // }\r\n\t   // cout<<endl;\r\n\t   \r\n\t    long long ans=0;\r\n\t    int i=0;\r\n\t    while(i<n){\r\n\t        long long c=(h[i]+h[n-i-1])%MOD;\r\n\t       // cout<<c<<endl;\r\n\t        ans=(ans+a[i]*c)%MOD;\r\n\t        i++;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
