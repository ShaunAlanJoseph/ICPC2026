  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD = 998244353;\r\nconst int N = 200005;\r\nlong long inv_[N], H[N];\r\nint main() {\r\n\t// your code goes here\r\n\tios:: sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\t/*vector<long long> H(N, 0);\r\n\tfor(int k = 1; k<N; k++){\r\n\t    H[k] = (H[k - 1] * power(k, MOD - 2)) % MOD;\r\n\t}*/\r\n\tinv_[1] = 1;\r\n\tfor(int i = 2; i < N; i++){\r\n\t    inv_[i] = (MOD - (MOD/i) * inv_[MOD%i]%MOD) % MOD;\r\n\t}\r\n\tfor(int i = 1; i < N; i++){\r\n\t    H[i] = (H[i-1] + inv_[i])%MOD;\r\n\t    \r\n\t}\r\n\tint t ;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n ;\r\n\t    cin>>n;\r\n\t    long long ans = 0;\r\n\t    for(int j = 1; j <= n; j++){\r\n\t        long long a;\r\n\t        cin>> a;\r\n\t        long long expD = (H[j - 1] + H[n - j]) % MOD;\r\n\t        ans = (ans + a % MOD * expD) % MOD;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n return 0;\r\n}\r\n",
