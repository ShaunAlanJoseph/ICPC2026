  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\t// your code goes here\r\n\tios:: sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n ;\r\n        cin>>n;\r\n        int m = 3*n;\r\n        vector<ll>v(m);\r\n        for(auto &x: v){\r\n            cin>>x;\r\n        }\r\n        sort(v.rbegin(), v.rend());\r\n        vector<ll>P(m+1, 0);\r\n        for(int i = 0; i< m; i++){\r\n            P[i+1] = P[i]+v[i];\r\n        }\r\n        ll best = 0;\r\n        for(int a; a<=n; a++){\r\n            auto f = [&](int b){\r\n                return 2*P[a]+P[a+2*b]+3*P[m-2*a-b];\r\n                \r\n            };\r\n            int lo = 0, hi = n-a;\r\n            while(lo<hi){\r\n                int mid = (lo+hi)/2;\r\n                if(f(mid+1)>f(mid)) lo = mid+1;\r\n                \r\n                else  hi = mid;\r\n                \r\n                \r\n            }\r\n            best = max(best, f(lo));\r\n            \r\n        }\r\n        cout<<best<<endl;\r\n        \r\n    }\r\n}\r\n",
