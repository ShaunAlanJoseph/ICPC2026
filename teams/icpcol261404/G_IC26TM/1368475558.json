  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin >>t ;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        int m = n*3;\r\n        vector<long long> v(m);\r\n        for(auto&x : v) cin >> x;\r\n        sort(v.rbegin(), v.rend());\r\n        \r\n        vector<long long> p(m+1, 0);\r\n        for(int i=0; i<m; i++) p[i+1]=p[i]+v[i];\r\n        \r\n        long long yxz=0;;\r\n        for(int a=0; a<=n;a++){\r\n            auto h=[&](int b) -> long long{\r\n                return 2*p[a] + p[a+2*b] + 3* p[m-2*a-b];\r\n            };\r\n            int l = 0, hi = n-a;\r\n            while(l<hi){\r\n                int mid = (l+hi)/2;\r\n                if(h(mid+1) > h(mid)) l = mid+1;\r\n                else hi = mid;\r\n            }\r\n            yxz = max(yxz, h(l));\r\n            \r\n        }\r\n        cout << yxz << \"\\n\";\r\n    }\r\n\r\n    return 0;\r\n}\r\n",
