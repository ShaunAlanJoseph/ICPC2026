  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint mod=998244353;\r\nint maxi=200005;\r\nvector<long long>inv(maxi,0);\r\nvector<long long>modi(maxi,0);\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<maxi;i++){\r\n\t    inv[i]=mod-(mod/i)*inv[mod%i]%mod;\r\n\t}\r\n\tmodi[0]=0;\r\n\tfor(int i=1;i<maxi;i++){\r\n\t    modi[i]=(modi[i-1]+inv[i])%mod;\r\n\t}\r\n\tint t,n;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    long long tot=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        long long x;\r\n\t        cin>>x;\r\n\t        long long coef=(modi[i-1]+modi[n-i])%mod;\r\n\t        tot=(tot+x*coef)%mod;\r\n\t    }\r\n\t    cout<<tot<<endl;\r\n\t}\r\n}\r\n",
