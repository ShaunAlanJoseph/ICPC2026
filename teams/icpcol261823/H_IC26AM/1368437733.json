  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nconst int MAXN = 200005;\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tvector<long long> inv(MAXN), H(MAXN);\r\n\tinv[1] = 1;\r\n\tfor(int i = 2; i<MAXN; i++)\r\n\t    inv[i] = (MOD - (MOD / i)*inv[MOD % i]%MOD)%MOD;\r\n\t    H[0] = 0;\r\n\t    for(int i = 1; i<MAXN; i++) H[i] = (H[i - 1] + inv[i])%MOD;\r\n\t    int t;\r\n\t    cin>>t;\r\n\t    while(t--){\r\n\t        int n;\r\n\t        cin>>n;\r\n\t        long long ans = 0;\r\n\t        for(int j = 1; j<= n; j++){\r\n\t            long long a;\r\n\t            cin>>a;\r\n\t            long long coef = (H[j - 1] + H[n - j]) % MOD;\r\n\t            ans = (ans + a % MOD *coef)%MOD;\r\n\t        }\r\n\t        cout<<ans<<\"\\n\";\r\n\t    }\r\n\t    return 0;\r\n}\r\n",
