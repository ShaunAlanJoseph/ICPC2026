  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(3*n);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    vector<long long >p(3*n+1,0);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    \r\n\t    long long op=0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        int l=0;\r\n\t        int r=n-i;\r\n\t        \r\n\t        auto c=[&](int y)->long long{\r\n\t            int m=i+2*y;\r\n\t            int q=3*n-2*i-y;\r\n\t            return 2LL*p[i]+p[m]+3LL*p[q];\r\n\t        };\r\n\t        \r\n\t        while(l<r){\r\n\t            int mid= l+(r-l)/2;\r\n\t            \r\n\t            if(c(mid)<=c(mid+1)){\r\n\t                l=mid+1;\r\n\t            }\r\n\t            else{\r\n\t                r=mid;\r\n\t            }\r\n\t        }\r\n\t        op=max(op,c(l));\r\n\t    }\r\n\t    cout<<op<<endl;\r\n\t}\r\n    return 0;\r\n}\r\n",
