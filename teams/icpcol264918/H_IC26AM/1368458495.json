  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD=998244353;\r\n\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<long long>a(n);\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t    vector<long long>v(n+1,0);\r\n\t    vector<long long>v2(n+1,0);\r\n\t    \r\n\t    if(n>=1){\r\n\t        v[1]=1;\r\n\t        \r\n\t    }\r\n\t    for(int i=2;i<=n;i++){\r\n\t        v[i]= MOD-(MOD/i)* v[MOD%i]%MOD;\r\n\t    }\r\n\t    for(int i=1;i<=n;i++){\r\n\t        v2[i]=(v2[i-1]+ v[i])%MOD;\r\n\t    }\r\n\t    \r\n\t    long long op=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        long long l=v2[i];\r\n\t        long long r=v2[n-1-i];\r\n\t        long long cf=(l+r)%MOD;\r\n\t        op=(op+(a[i]%MOD)*cf)%MOD;\r\n\t    }\r\n\t    cout<<op<<endl;\r\n\t}\r\n    return 0;\r\n}\r\n",
