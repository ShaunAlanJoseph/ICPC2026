  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\n#define fast ios::sync_with_stdio(false); cin.tie(nullptr);\r\n#define pb push_back\r\n\r\nconst ll MOD = 998244353;\r\nconst int MAXI = 200099;\r\nvector<ll> modi(MAXI), F(MAXI);\r\nvoid sum(){\r\nmodi[1] = 1;\r\nfor(int i=2; i < MAXI; i++){\r\n    modi[i] = (MOD- (MOD/i) * modi[MOD % i] % MOD) % MOD;\r\n    \r\n}\r\nF[0] = 0;\r\nfor(int i=1; i<MAXI; i++){\r\n    F[i] = (F[i-1] + modi[i]) % MOD;\r\n}\r\n\r\n}\r\n\r\nvoid solve(){\r\nint a ; cin >> a;\r\nll res =0;\r\nfor( int j =1; j<=a; j++){\r\n    ll b; cin >> b;\r\n    ll p = (F[j-1] + F[a-j]) % MOD;\r\n    res = (res + ( b% MOD) * p) % MOD;\r\n}\r\n    cout << res <<\"\\n\";\r\n}\r\n\r\n\r\n\r\nint main() {\r\nfast;\r\nsum();\r\nint t; cin >> t;\r\nwhile(t--) solve();\r\nreturn 0;\r\n\t// your code goes here\r\n\r\n}\r\n",
