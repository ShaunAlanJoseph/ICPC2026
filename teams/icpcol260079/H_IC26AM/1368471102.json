  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint maxN = 2e5+5;\r\nvector<long long> vec(maxN);\r\nint mod = 998244353;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    long long ans = 0;\r\n    \r\n    for(int i = 1; i<= n; i++){\r\n        long long a;\r\n        cin >> a;\r\n        \r\n        long long val = (vec[i - 1] + vec[n - i])%mod;\r\n        ans = (ans + a * val)%mod;\r\n    }\r\n    cout << ans << endl;\r\n    return;\r\n}\r\n\r\nvector<long long> inv(maxN);\r\n\r\nvoid precompute(){\r\n    inv[1] = 1;\r\n    for(int i = 2; i < maxN; i++){\r\n        inv[i] = (mod - (mod/i)) * inv[mod%i] % mod;\r\n    }\r\n    \r\n    vec[0] = 0;\r\n    for(int i = 1; i< maxN; i++){\r\n        vec[i] = (vec[i-1] + inv[i])%mod;\r\n    }\r\n}\r\n\r\n\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\tprecompute();\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n    return 0;\r\n}\r\n",
