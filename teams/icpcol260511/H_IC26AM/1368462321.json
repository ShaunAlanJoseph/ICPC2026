  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int MOD = 998244353;\r\n\r\nint main() {\r\n    vector<long long > inv(200005);\r\n    inv[1]=1;\r\n    for(int i=2;i<200005;i++){\r\n        inv[i]=(MOD-MOD/i)*(inv[MOD%i])%MOD;\r\n    }\r\n    vector<long long> P(200005,0);\r\n    for(int i=1;i<200005;i++){\r\n        P[i]=(P[i-1]+inv[i])%MOD;\r\n    }\r\n    \r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    long long sum=0;\r\n\t    for(int i=0;i<n;i++){\r\n\t        long long b;\r\n\t        cin>>b;\r\n\t        long long cuff = (P[i]+P[n-1-i])%MOD;\r\n\t        sum=(sum+b%MOD*cuff)%MOD;\r\n\t    }\r\n\t    cout<<sum<<endl;\r\n\t}\r\n\r\n}\r\n",
