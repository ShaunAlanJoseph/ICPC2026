  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n ;\r\n\t    cin>>n;\r\n\t    vector<long long>a(3*n), p(3*n+1);\r\n\t    \r\n\t    for(auto &x: a){\r\n\t        cin>>x;\r\n\t        \r\n\t    }\r\n\t    \r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    for(int i=0;i<3*n;i++){\r\n\t        p[i+1] = p[i] + a[i];\r\n\t        \r\n\t        \r\n\t    }\r\n\t    long long ans = 0;\r\n\t    for(int A = 0;A<=n;A++){\r\n\t        int l=0, r =n-A;\r\n\t        while(l<r){\r\n\t            int B = (l+r)/2;\r\n\t            long long gain = a[A+2*B]+a[A+2*B+1] - 3*a[3*n-2*A-B-1];\r\n\t            if(gain>=0) l = B+1;\r\n\t            else r = B;\r\n\t        }\r\n\t        \r\n\t        for(int B :{l,max(0,l-1)}){\r\n\t            int Q = A+2*B;\r\n\t            int R = 3*n-2*A-B;\r\n\t            long long cur  = 2*p[A]+p[Q]+3*p[R];\r\n\t            ans = max(ans, cur);\r\n\t        }\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
