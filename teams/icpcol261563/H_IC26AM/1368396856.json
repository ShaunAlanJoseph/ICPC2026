  "source_code": "# cook your dish here\r\nimport sys\r\nMOD = 998244353\r\ndef solve():\r\n    input = sys.stdin.readline\r\n    t = int(input())\r\n    tests = []\r\n    mx = 0\r\n    for i in range(t):\r\n        n = int(input())\r\n        a = list(map(int, input().split()))\r\n        tests.append((n,a))\r\n        mx = max(mx,n)\r\n    inv = [0] * (mx+1)\r\n    h = [0] * (mx+1)\r\n    if mx>= 1:\r\n        inv[1] = 1\r\n    for i in range(2, mx+1):\r\n        inv[i]=MOD-(MOD//i)*inv[MOD%i]%MOD\r\n    for i in range(1,mx+1):\r\n        h[i]=(h[i-1]+inv[i])%MOD\r\n    for n,a in tests:\r\n        ans = 0\r\n        for i in range(n):\r\n            coef = (h[i]+ h[n-i-1])%MOD\r\n            ans=(ans+a[i]*coef)%MOD\r\n        print(ans)\r\nsolve()",
