  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve()\r\n{\r\n    int n; cin >> n;\r\n    vector<int> arr(n);\r\n    for(int i=0;i<n;i++){\r\n        cin >> arr[i];\r\n        \r\n    }\r\n    int ans = 1e9;\r\n    for(int i=0;i<n-1;i++){\r\n        ans = max(ans , abs(arr[i] - arr[i+1]));\r\n    }\r\n    ans = min(ans , abs(arr[0]-arr[n-1]));\r\n    cout << ans << endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t    \r\n\t}\t\r\n\r\n}\r\n",
