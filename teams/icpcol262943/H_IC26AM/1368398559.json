  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tconst ll mod = 998244353;\r\n\tconst int limit = 200005;\r\n\t\r\n\tvector<ll>inv(limit);\r\n\tvector<ll>pref(limit);\r\n\t\r\n\tinv[1] = 1;\r\n\tpref[1] = 1;\r\n\t\r\n\tfor(int i=2;i<limit;i++){\r\n\t    inv[i] = mod - (mod/i)*inv[mod%i]%mod;\r\n\t    pref[i] = (pref[i-1]+inv[i])%mod;\r\n\t}\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    ll ans = 0;\r\n\t    \r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll x;\r\n\t        cin>>x;\r\n\t        \r\n\t        ll factor = (pref[i-1] + pref[n-i])%mod;\r\n\t        \r\n\t        ans = (ans+(x%mod)*factor)%mod;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<'\\n';\r\n\t    \r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
