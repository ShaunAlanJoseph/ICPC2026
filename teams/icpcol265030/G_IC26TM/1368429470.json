  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        int N = 3*n;\r\n        vector<long long> a(N);\r\n        for(long long &x:a){\r\n            cin >> x;\r\n        }\r\n        sort(a.rbegin(),a.rend());\r\n        vector<long long> pr(N+1,0);\r\n        for(int i=0;i<3*n;i++)pr[i+1] = pr[i] + a[i];\r\n        auto score = [&](int a ,int b) ->long long {\r\n            int q = a+2*b;\r\n            int t = 3*n-2*a-b;\r\n            return 2LL*pr[a]+pr[q] + 3LL*pr[t];\r\n        };\r\n        long long ans = 0;\r\n        for(int a=0;a<=n;a++){\r\n            int high = n-a;\r\n            int low = 0;\r\n            while( low<high ){\r\n                int mid = (low+high)/2;\r\n                if(score(a,mid)<=score(a,mid+1)){\r\n                    low = mid+1;\r\n                }else{\r\n                    high = mid;\r\n                }\r\n            }\r\n            ans = max(ans,score(a,low));\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
