  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t int t;\r\n\t cin>>t;\r\n\t while(t--){\r\n\t     int n;\r\n\t     cin>>n;\r\n\t     int m=3*n;\r\n\t     vector<long long>a(m),pref(m+1,0);\r\n\t     for(auto &x:a){\r\n\t         cin>>x;\r\n\t     }\r\n\t     sort(a.rbegin(),a.rend());\r\n\t     for(int i=0;i<m;i++){\r\n\t         pref[i+1]=pref[i]+a[i];\r\n\t     }\r\n\t     long long ans=0;\r\n\t     for(int A=0;A<=n;A++){\r\n\t         int lo=0,hi=n-A;\r\n\t         \r\n\t         while(lo<hi){\r\n\t             int B=(lo+hi)/2;\r\n\t             int x=A+2*B;\r\n\t             int z=3*n-2*A-B;\r\n\t             long long diff=a[x]+a[x+1]-3LL*a[z-1];\r\n\t             if(diff>=0){\r\n\t                 lo=B+1;\r\n\t             }\r\n\t             else{\r\n\t                 hi=B;\r\n\t             }\r\n\t         }\r\n\t         for(int B:{max(0,lo-1),lo}){\r\n\t             if(B>n-A){\r\n\t                 continue;\r\n\t             }\r\n\t             int x=A+2*B;\r\n\t             int z=3*n-2*A-B;\r\n\t             long long cur=2LL*pref[A]+pref[x]+3LL*pref[z];\r\n\t             ans=max(ans,cur);\r\n\t         }\r\n\t     }\r\n\t     cout<<ans<<endl;\r\n\t }\r\nreturn 0;\r\n}\r\n",
