  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int MOD=998244353;\r\nconst int MAXN=200005;\r\n\r\nlong long iv[MAXN+1];\r\nlong long  h[MAXN+1];\r\n\r\nvoid pre(){\r\n    iv[1]=1;\r\n    for(int i=2;i<=MAXN;i++){\r\n        iv[i]=MOD-(MOD/i)*iv[MOD%i]%MOD;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<=MAXN;i++){\r\n        h[i]=(h[i-1]+iv[i])%MOD;\r\n    }\r\n}\r\n void sol(){\r\n     int n;\r\n     cin>>n;\r\n     vector<long long>v(n+1);\r\n     for(int i=1;i<=n;i++){\r\n         cin>>v[i];\r\n     }\r\n    \r\n     long long an=0;\r\n     for(int i=1;i<=n;i++){\r\n         long long cf=(h[i-1]+h[n-i])%MOD;\r\n         an=(an+v[i]*cf)%MOD;\r\n     }\r\n     cout<<an<<endl;\r\n }\r\nint main(){\r\n    pre();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        sol();\r\n    }\r\n   \r\nreturn 0;\r\n}\r\n",
