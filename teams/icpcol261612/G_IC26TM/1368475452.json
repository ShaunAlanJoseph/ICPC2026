  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint main() {\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    int n; cin>>n;\r\n\t   int  N = 3*n;\r\n\t    vector<ll> a(N);\r\n\t    for(auto&i : a){\r\n\t        cin>>i;\r\n\t    }\r\n\t    sort(a.begin(), a.end());\r\n\t    vector<ll> pref(N+1, 0);\r\n\t    for(int i = 0; i<N; i++){\r\n\t        pref[i+1] = pref[i] + a[i];\r\n\t    }\r\n\t    ll total = pref[N];\r\n\t    ll ans = 3ll * total;\r\n\t    ll bonus = 0;\r\n\t    for(int u = 0; u<=n; u++){\r\n\t        auto getbonus = [&](int k)-> ll{\r\n\t            return 3ll * total - 2ll*pref[N-k] - pref[N+k - 2*u] - 3ll*pref[u+k];\r\n\t        };\r\n\t        int low = 0, high = u;\r\n\t        while (low<high){\r\n\t            int mid = low + (high-low) / 2;\r\n\t            if (getbonus(mid) <= getbonus(mid+1)){\r\n\t                low = mid+1;\r\n\t            }\r\n\t            else{\r\n\t                high = mid;\r\n\t            }\r\n\t        }\r\n\t            bonus = max(bonus,getbonus(low));\r\n\t        }\r\n\t        ans += bonus;\r\n\t        cout<<ans<<endl;\r\n\t    }\r\n\t   \r\n\r\n}\r\n",
