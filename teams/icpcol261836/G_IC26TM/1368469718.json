  "source_code": "import sys\r\ninput=sys.stdin.readline\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    pre=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        pre[i+1]=pre[i]+a[i]\r\n    def cal(a,b):\r\n        p1=a;\r\n        p2=a+2*b\r\n        p3=3*n-2*a-b;\r\n        return (3*pre[p3]+pre[p2]+2*pre[p1])\r\n    ans=0\r\n    b=n;\r\n    for i in range(n+1):\r\n        b=min(b,n-i)\r\n        while b>0 and cal(i,b-1)>cal(i,b):\r\n            b-=1;\r\n        ans=max(ans,cal(i,b))\r\n    print(ans)\r\n    ",
