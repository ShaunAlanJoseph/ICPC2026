  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long \r\n#define all(v) (v).begin(),(v).end()\r\n#define FI(i,a,b) for(int i=a;i<b;++i)\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    int m=3*n;\r\n    vector<ll> arr(3*n);\r\n    FI(i,0,3*n)cin>>arr[i];\r\n    sort(all(arr),greater<ll>());\r\n    vector<ll> g(3*n+1,0);\r\n    FI(i,0,m) g[i+1]=g[i]+arr[i];\r\n    auto get_func=[&](int x, int i)->ll{\r\n        return 2LL* g[n-i]+g[n-i+2*x]+3LL*g[n+2*i-x];\r\n    };\r\n    ll temp_res=0;\r\n    FI(i,0,n+1){\r\n        int l=0,h=i;\r\n        while(h-l>2){\r\n            int x1=l+(h-l)/3;\r\n            int x2=h-(h-l)/3;\r\n            if(get_func(x1,i)<get_func(x2,i)){\r\n                l=x1;\r\n            }\r\n            else h=x2;\r\n        }\r\n        for(int x=l;x<=h;++x){\r\n            temp_res=max(temp_res,get_func(x,i));\r\n        }\r\n    }\r\n    cout<<temp_res<<\"\\n\";\r\n}\r\n\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--)solve();\r\n\r\n}\r\n",
