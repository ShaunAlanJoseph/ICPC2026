  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\n#define ll long long\r\nint main() {\r\n\t// your code goes here\r\n\tconst int MAXN = 200005;\r\n\tvector<ll> inv(MAXN),H(MAXN);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<MAXN;i++){\r\n\t    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n\t}\r\n\tH[0]=0;\r\n\tfor(int i=1;i<MAXN;i++) H[i] = (H[i-1] + inv[i])%MOD;\r\n\t\r\n\tint t;\r\n\tscanf(\"%d\",&t);\r\n\twhile(t--){\r\n\t    int n;\r\n\t    scanf(\"%d\",&n);\r\n    \tll ans = 0;\r\n    \tfor(int i=1;i<=n;i++){\r\n    \t    ll a;\r\n    \t    scanf(\"%lld\",&a);\r\n    \t    ans = (ans + a%MOD*((H[i-1] + H[n-i])%MOD))%MOD;\r\n    \t}\r\n\tprintf(\"%lld\\n\",ans);\r\n}\r\nreturn 0;\r\n}\r\n",
