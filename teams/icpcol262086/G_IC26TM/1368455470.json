  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tscanf(\"%d\",&t);\r\n\twhile(t--){\r\n\t    int n;\r\n\t    scanf(\"%d\",&n);\r\n\t    vector<ll> s(3*n);\r\n\t    for(auto &v:s) scanf(\"%lld\",&v);\r\n\t    sort(s.rbegin(),s.rend());\r\n\t    vector<ll> P(3*n+1,0);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        P[i+1] = P[i]+s[i];\r\n\t    }\r\n\t    ll best = 0;\r\n\t    for(int d = 0;d<=2*n;d++){\r\n\t        int lo = max(0,d-n),hi=d/2;\r\n\t        if(lo > hi) continue;\r\n\t        auto g = [&](int a){return 2*P[a]+P[2*d - 3*a];};\r\n\t        int l=lo,h=hi;\r\n\t        while(l<h){\r\n\t            int m = (l+h)/2;\r\n\t            if(g(m+1) > g(m)) l=m+1;\r\n\t            else h=m;\r\n\t        }\r\n\t        ll xyz = 3*P[3*n-d]+g(l);\r\n\t        best = max(best,xyz);\r\n\t    }\r\n\t    printf(\"%lld\\n\",best);\r\n\t}\r\n}\r\n",
