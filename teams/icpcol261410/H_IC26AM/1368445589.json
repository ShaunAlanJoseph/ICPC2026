  "source_code": "#include<cstdio>\r\n#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll mod=998244353;\r\nconst int MX=200005;\r\nll inv[MX],h[MX];\r\nint main() {\r\n    inv[1]=1;\r\n    for(int i=2;i<MX;i++)\r\n        inv[i]=(mod-(mod/i)*inv[mod%i]%mod)%mod;\r\n    for(int i=1;i<MX;i++)\r\n        h[i]=(h[i-1]+inv[i])%mod;\r\n    int t;\r\n    scanf(\"%d\",&t);\r\n    while(t--){\r\n        int n;\r\n        scanf(\"%d\",&n);\r\n        ll ans=0;\r\n        for(int i=1;i<=n;i++){\r\n            ll x;\r\n            scanf(\"%lld\",&x);\r\n            x%=mod;\r\n            if(x<0) x+=mod;\r\n            ll c=(h[i-1]+h[n-i])%mod;\r\n            ans=(ans+x*c)%mod;\r\n        }\r\n        printf(\"%lld\\n\",ans);\r\n    }\r\n\t// yourr\r\n\treturn 0;\r\n\r\n}\r\n",
