  "source_code": "# cook your dish here\r\nMOD=998244353\r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    inv=[0] * (n+1)\r\n    h=[0] * (n+1)\r\n    inv[1]=1\r\n    for i in range(2,n+1):\r\n        inv[i]=MOD-(MOD//i) * inv[MOD % i] % MOD\r\n    for i in range(1,n+1):\r\n        h[i]=(h[i-1]+ inv[i]) % MOD\r\n    ans=0\r\n    for i in range(n):\r\n        ans+=a[i] * (h[i] + h[n-1-i])\r\n    print(ans % MOD)\r\n        \r\n    ",
