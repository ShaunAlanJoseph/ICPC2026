  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nconst long long N = 200005;\r\nint main() {\r\n    \r\n    \r\n\t// your code goes here\r\n\tstd::vector<long long> a(N), b(N);\r\n    a[1] = 1;\r\n    for (int i=2; i<N; i++){\r\n        a[i] = (MOD - (MOD / i) * a[MOD % i]%MOD) %MOD;\r\n    }\r\n    b[0]=0;\r\n    for(int i=1; i<N; i++){\r\n        b[i] = (b[i-1]+ a[i]) %MOD;\r\n    }\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        \r\n        long long ans = 0;\r\n        \r\n        for (int i=1; i<=n; i++){\r\n            long long temp;\r\n            cin >> temp;\r\n            long long c = (b[i-1]+ b[n-i]) % MOD;\r\n            ans = (ans + temp % MOD * c) % MOD;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n}\r\n",
