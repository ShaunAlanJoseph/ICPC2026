  "source_code": "import sys \r\n\r\ndef solve():\r\n    input_data = sys.stdin.read().split()\r\n    if not input_data:\r\n        return\r\n     \r\n    t = int(input_data[0])\r\n    out=[]\r\n     \r\n    MOD = 998244353\r\n    MAXN = 200005\r\n     \r\n    inv = [0] * MAXN\r\n    if MAXN > 1:\r\n         inv[1] = 1\r\n    for i in range(2, MAXN):\r\n        inv[i] = (MOD - MOD // i) * inv[MOD % i] % MOD\r\n    \r\n    H = [0] * MAXN\r\n    for i in range(1, MAXN):\r\n        H[i] = (H[i-1] + inv[i]) % MOD\r\n    idx = 1 \r\n    for n in range(t):\r\n        n = int(input_data[idx])\r\n        idx += 1 \r\n        a = []\r\n        for _ in range(n): \r\n            a.append(int(input_data[idx]))\r\n            idx += 1 \r\n        ans = 0 \r\n        for j in range(n): \r\n            coeff = (H[j] + H[n-1-j]) % MOD \r\n            ans = (ans + a[j] * coeff) % MOD\r\n        out.append(str(ans))\r\n    print('\\n'.join(out))\r\n    \r\nif __name__ == \"__main__\":\r\n    solve()",
