  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nint func(int k1, int k2, vector<int>& p, int m){\r\n    \r\n    return (2*p[k1]+p[k1+2*k2]+3*p[m-(2*k1)-k2]);\r\n}\r\n\r\nint32_t main() {\r\n\t// your code goes here\r\n\t\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    \r\n\t    int n; cin>>n;\r\n\t    \r\n\t    int m=3*n;\r\n\t    vector<int> a(m), p(m+1,0); for(auto &x : a) cin>>x;\r\n\t    \r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    for(int i=0;i<m;i++){\r\n\t        p[i+1] = p[i] + a[i];\r\n\t    }\r\n\t    \r\n\t    int best = 0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        \r\n\t        int low =0, high =n-i;\r\n\t        \r\n\t        while(low<high){\r\n\t            int mid = low + (high-low)/2;\r\n\t            \r\n\t            if(func(mid+1,i,p,m) < func(mid,i,p,m)){\r\n\t                high = mid;\r\n\t                \r\n\t            }\r\n\t            else low = mid+1;\r\n\t        }\r\n\t        \r\n\t        best = max(best,func(low,i,p,m));\r\n\t    }\r\n\t    \r\n\t    \r\n\t    cout << best << \"\\n\";\r\n\t    \r\n\t    \r\n\t    \r\n\t}\r\n\r\n}\r\n",
