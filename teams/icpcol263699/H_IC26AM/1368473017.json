  "source_code": "# cook your dish here\r\nt = int(input())\r\nmod = 998244353\r\nwhile t:\r\n    t -= 1\r\n    n = int(input())\r\n    a = input().split()\r\n    for i in range(n):\r\n        a[i] = int(a[i])\r\n    # a = [int(input()) for _ in range(n)]\r\n    prefSums = [0 for _ in range(n + 1)]\r\n    for i in range(1, n+ 1):\r\n        prefSums[i] = (prefSums[i - 1] + pow(i, -1, mod)) % mod\r\n    ans = 0\r\n    for i in range(n):\r\n        ans += a[i] * (prefSums[i] + prefSums[n - i - 1])\r\n        ans %= mod\r\n    print(ans)\r\n    ",
