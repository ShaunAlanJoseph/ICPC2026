  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long>a(3*n);\r\n\t    for(auto &x:a)\r\n\t        cin>>x;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long>pref(3*n+1,0);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        pref[i+1]=pref[i]+a[i];\r\n\t    }\r\n\t    long long ans=0;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        int l=0,r=n-i;\r\n\t        auto val=[&](int m){\r\n\t            long long j=i+2*m;\r\n\t            long long k=3*n-2*i-m;\r\n\t            \r\n\t            return 2*pref[i]+pref[j]+3*pref[k]*1LL;\r\n\t        };\r\n\t        while(l<r){\r\n\t            int m=(l+r)/2;\r\n\t            int j=i+2*m;\r\n\t            int k=3*n-2*i-m;\r\n\t            long long d=(pref[j+2]-pref[j])+3*(pref[k-1]-pref[k]);\r\n\t            if(d>=0)\r\n\t                l=m+1;\r\n\t            else\r\n\t                r=m;\r\n\t        }\r\n\t            ans=max(ans,(val(l)));\r\n\t            if(l>0)\r\n\t                ans=max(ans,val(l-1));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
