  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nint n;\r\nvector<int>S;\r\n\r\nint solve(int i,int j){\r\n    int k = n - i - j;\r\n    int a = 6 * S[i];\r\n    int b = 4 * (S[i + 2*j] - S[i]);\r\n    int c = 3 *(S[i + 2*j + 3*k] - S[i + 2 *j]);\r\n    return a + b + c;\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    int m = 3 * n ;\r\n\t    vector<int>a(m);\r\n\t    for(int i = 0; i < m; i++) cin>>a[i];\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    \r\n\t    S.assign(m + 1,0);\r\n\t    for(int i = 0; i < m; i++) S[i +\r\n\t     1] = S[i] + a[i];\r\n\t     \r\n\t     int ans = 0;\r\n\t     \r\n\t     for(int i = 0; i <= n; i++){\r\n\t         int s = 0;\r\n\t         int e = n - i;\r\n\t         \r\n\t         while(s < e){\r\n\t             int mid = s + (e - s)/2;\r\n\t             if(solve(i,mid + 1) > solve(i,mid)){\r\n\t                 s = mid + 1;\r\n\t             }else{\r\n\t                 e = mid;\r\n\t             }\r\n\t         }\r\n\t         ans = max(ans,solve(i,s));\r\n\t     }\r\n\t     cout<<ans<<endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
