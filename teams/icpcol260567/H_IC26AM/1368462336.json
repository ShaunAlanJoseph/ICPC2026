  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nint mod = 998244353;\r\nconst int N = 200005;\r\n\r\nint H[N];\r\n\r\nsigned main() {\r\n    \r\n    vector<int>inv(N);\r\n    inv[1] = 1;\r\n    \r\n    for(int i = 2; i < N; i++) inv[i] = (mod - (mod/i) * inv[mod % i] % mod) % mod;\r\n    \r\n    H[0] = 0;\r\n    for(int i = 1; i < N; i++) H[i] = (H[i - 1] + inv[i]) % mod;\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int ans = 0;\r\n\t    \r\n\t    for(int k = 1; k <= n; k++){\r\n\t        int a;\r\n\t        cin>>a;\r\n\t        \r\n\t        int contri = (H[k - 1] +H[n - k])%mod;\r\n\t        ans = (ans + a % mod * contri) % mod;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
