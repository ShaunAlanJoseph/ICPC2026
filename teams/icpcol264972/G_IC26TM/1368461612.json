  "source_code": "# cook your dish here\r\nimport sys\r\ninput=sys.stdin.readline\r\nt=int(input())\r\n\r\nfor _ in range(t):\r\n    n=int(input())\r\n    arr=list(map(int,input().split()))\r\n    \r\n    arr.sort(reverse=True)\r\n    m=3*n \r\n    \r\n    pref=[0]*(m+1)\r\n    for i in range(m):\r\n        pref[i+1]=pref[i]+arr[i]\r\n    \r\n    ans=0\r\n    for a in range(n+1):\r\n        max_b=n-a\r\n        \r\n        def val(b):\r\n            j=a+2*b \r\n            k=3*n-2*a-b\r\n            return 2*pref[a]+pref[j]+3*pref[k]\r\n        \r\n        def gain(b):\r\n            j=a+2*b \r\n            k=3*n-2*a-b\r\n            return arr[j]+arr[j+1]-3*arr[k-1]\r\n        \r\n        low=0\r\n        high=max_b\r\n        \r\n        while low<high:\r\n            mid=(low+high+1)//2\r\n            if gain(mid-1)>=0:\r\n                low=mid \r\n            else:\r\n                high=mid-1\r\n        ans=max(ans,val(low))\r\n    print(ans)\r\n        \r\n        ",
