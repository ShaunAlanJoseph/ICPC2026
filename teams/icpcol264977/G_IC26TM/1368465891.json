  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    int n; cin>>n; \r\n\t    int m; m=3*n;\r\n\t    vector<ll>a(m),P(m+1,0);\r\n\t    for(auto &x:a)\r\n\t    cin>>x;\r\n\t    sort(a.rbegin(), a.rend());\r\n\t    for(int i=0; i<m; i++){\r\n\t        P[i+1]=P[i]+a[i];\r\n\t    }\r\n\t    auto f=[&](ll p, ll q){\r\n\t        return 2*P[p]+P[p+2*q]+3*P[m-2*p-q];\r\n\t    };\r\n\t    ll best=0;\r\n\t    for(int p=0; p<=n; p++){\r\n\t        int lo=0; int hi=n-p;\r\n\t        while(lo<hi){\r\n\t            int mid=(lo+hi)/2;\r\n\t            if(f(p,mid+1)>f(p,mid)) lo=mid+1;\r\n\t            else\r\n\t            hi=mid;\r\n\t        }\r\n\t        best=max(best,f(p,lo));\r\n\t        \r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\r\n}\r\n",
