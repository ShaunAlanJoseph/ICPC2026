  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n int n;\r\n vector<long long> P;\r\n \r\n long long g(int A, int B){\r\n     return P[A+2*B] + 3*P[3*n -2*A-B];\r\n }\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    cin>>n;\r\n\t    vector<long long> a(3*n);\r\n\t    for(int i=0;i<3*n; i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    sort(a.begin(), a.end(), greater<long long>());\r\n\t    P.assign(3*n+1, 0);\r\n\t    for(int i=0;i<3*n;i++){\r\n\t        P[i+1]=P[i] + a[i];\r\n\t    }\r\n\t    long long best=0;\r\n\t    for(int A=0;A<=n;A++){\r\n\t        int lo=0,hi=n-A;\r\n\t        while(lo<hi){\r\n\t            int mid=lo+(hi-lo)/2;\r\n\t            if(g(A, mid+1) - g(A,mid)<=0) hi = mid;\r\n\t            else lo=mid+1;\r\n\t        }\r\n\t        long long yxz= 2*P[A]+g(A,lo);\r\n\t        best=max(best, yxz);\r\n\t    }\r\n\t    cout<<best<<\"\\n\";\r\n\t}\r\n    return 0;\r\n}\r\n",
