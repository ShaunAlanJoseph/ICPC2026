  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll =long long;\r\nconst ll mod = 998244353;\r\nconst int N = 200005;\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0);\r\n\t\r\n\tvector<ll> inv(N),h(N);\r\n\t\r\n\tinv[1]=1;\r\n\t\r\n\tfor(int i=2;i<N;i++){\r\n\t    inv[i] = mod-(mod/i)*inv[mod%i]%mod;\r\n\t    \r\n\t}\r\n\tfor(int i=1;i<N;i++){\r\n\t    h[i] = (h[i-1]+inv[i])%mod;\r\n\t}\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<ll>a(n);\r\n\t    for(ll &x:a)cin>>x;\r\n\t    \r\n\t    ll ans=0;\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        ll w = (h[i]+h[n-1-i])%mod;\r\n\t        ans = (ans+a[i]*w)%mod;\r\n\t    }\r\n\t    cout<<ans<<'\\n';\r\n\t}\r\n\treturn 0;\r\n  \r\n}\r\n",
