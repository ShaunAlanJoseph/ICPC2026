  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int mod=998244353;\r\nconst int maxn=200005;\r\nvector<long long> inv(maxn), h(maxn);\r\nvoid pre(){\r\n    inv[1]=1;\r\n    for(int i=2;i<maxn;i++){\r\n        inv[i]=mod-(mod/i)*inv[mod%i]%mod;\r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<maxn;i++){\r\n        h[i]=(h[i-1]+inv[i])%mod;\r\n    }\r\n}\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    long long ans=0;\r\n    for(int i=1;i<=n;i++){\r\n        long long a;\r\n        cin>>a;\r\n        long long co=(h[i-1]+h[n-i])%mod;\r\n        ans+=(co*a)%mod;\r\n    }\r\n    cout<<ans%mod<<endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    pre();\r\n    while(t--){\r\n        solve();\r\n    }\r\n    \r\n}\r\n",
