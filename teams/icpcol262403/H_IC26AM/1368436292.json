  "source_code": "# cook your dish here\r\nimport sys\r\nmod=998244353\r\ndef main():\r\n    data=sys.stdin.read().split()\r\n    t=int(data[0])\r\n    pos=1\r\n    m=200002\r\n    inv=[0,1]+[0]*m\r\n    for i in range(2,m+1):\r\n        inv[i]=(mod-(mod//i)*inv[mod%i]%mod)%mod\r\n    h=[0]*(m+1)\r\n    for i in range(1,m+1):\r\n        h[i]=(h[i-1]+inv[i]%mod)\r\n    res=[]\r\n    for _ in range(t):\r\n        n=int(data[pos])\r\n        arr=data[pos+1:pos+1+n]\r\n        pos=pos+n+1 \r\n        total=0\r\n        for j in range(n):\r\n            total = total + int(arr[j])*(h[j]+h[n-1-j])\r\n        res.append(total%mod)\r\n    print('\\n'.join(map(str,res)))\r\nmain()",
