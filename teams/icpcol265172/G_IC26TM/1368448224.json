  "source_code": "# cook your dish here\r\nimport sys\r\ndef solve():\r\n    it=iter(map(int, sys.stdin.buffer.read().split()))\r\n    t=next(it)\r\n    out=[]\r\n    for _ in range(t):\r\n        n=next(it)\r\n        a=[next(it) for _ in range(3*n)]\r\n        a.sort(reverse=True)\r\n        p=[0]*(3*n+1)\r\n        for i, x in enumerate(a,1):\r\n            p[i]=p[i-1]+x \r\n        ans=0\r\n        \r\n        for A in range(n+1):\r\n            lo, hi=0,n-A\r\n            while lo<hi:\r\n                B=(lo+hi)//2\r\n                if B==n-A:\r\n                    hi=B \r\n                    continue\r\n                d=(p[A+2 *B +2]-p[A+2*B]- 3*a[3*n-2*A-B-1])\r\n                if d>=0:\r\n                    lo=B+1 \r\n                else:\r\n                    hi=B \r\n            B=lo \r\n            for b in (B,B-1):\r\n                if 0<=b<=n-A:\r\n                    m=3*n-2*A-b \r\n                    v=2*p[A]+p[A+2*b]+3*p[m]\r\n                    ans=max(ans,v)\r\n        out.append(str(ans))\r\n    print(\"\\n\".join(out))\r\nif __name__== \"__main__\":\r\n    solve()\r\n                        ",
