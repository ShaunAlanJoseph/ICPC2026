  "source_code": "# cook your dish here\r\nz = int(input())\r\n\r\nfor _ in range(z):\r\n    n = int(input())\r\n    s = input()\r\n    a = [int(x) for x in s.split()]\r\n    \r\n    a.sort(reverse=True)\r\n    m = 3*n\r\n    p = [0]\r\n    for x in a:\r\n        p.append(p[-1]+x)\r\n    b = n\r\n    ans = 0\r\n    for i in range(n+1):\r\n        b = min(b,n-i)\r\n        while b>0 and a[i+2*b-2]+a[i+2*b-1]<=3*a[m-2*i-b]:\r\n            b-=1\r\n        curr = 2*p[i]+p[i+2*b]+3*p[m-2*i-b]\r\n        ans = max(ans,curr)\r\n    print(ans)",
