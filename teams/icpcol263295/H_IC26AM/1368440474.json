  "source_code": "# cook your dish here\r\nM=998244353\r\nmaxn = 200000\r\ninv = [0]*(maxn+1)\r\nh=[0]*(maxn+1)\r\ninv[1]=1\r\nfor i in range(2,maxn+1):\r\n    inv[i]=M-(M//i)*inv[M%i]%M\r\nfor i in range(1,maxn+1):\r\n    h[i]=(h[i-1]+inv[i])% M\r\nfor _ in range(int(input())):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    ans =0\r\n    for i in range(n):\r\n        co=(h[i]+h[n-i-1])%M\r\n        ans = (ans+a[i]*co)%M\r\n    print(ans)",
