  "source_code": "# cook your dish here\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    N= 3*n\r\n    pref = [0]*(N+1)\r\n    for i in range(N):\r\n        pref[i+1]=pref[i]+a[i]\r\n    t=pref[N]\r\n    def f(m,k):\r\n        return( 2*pref[k]+pref[2*m-k]+3*pref[N-m-k]-3*t)\r\n    b=0\r\n    for m in range(1,n+1):\r\n        lo= 0\r\n        hi = m\r\n        while lo <hi:\r\n            mid =(lo+hi)//2\r\n            if f(m,mid)<=f(m,mid+1):\r\n                lo=mid+1\r\n            else:\r\n                hi= mid\r\n        b = max(b,f(m,lo))\r\n    ans= 3*t+b\r\n    print(ans)",
