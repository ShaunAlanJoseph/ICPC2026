  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    \r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<long long>v(3*n);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++){\r\n\t        cin>>v[i];\r\n\t    }\r\n\t    \r\n\t    sort(v.rbegin(),v.rend());\r\n\t    \r\n\t    vector<long long>pre(3*n+1,0);\r\n\t    \r\n\t    for(int i=0;i<3*n;i++){\r\n\t        pre[i+1] = pre[i] + v[i];\r\n\t    }\r\n\t    \r\n\t    auto it = [&](int p,int l) -> long long{\r\n\t        int k = 6*n-3*p-2*l;\r\n\t        return 2LL*pre[p]+pre[k]+3LL*pre[l];\r\n\t    };\r\n\t    \r\n\t    long long ans = 0;\r\n\t    \r\n\t    for(int l=n;l<=3*n;l++){\r\n\t        int lo = max(0,2*n-l);\r\n\t        int hi = min(n,(3*n-l)/2);\r\n\t    \r\n\t    \r\n\t    while(lo < hi){\r\n\t        \r\n\t        int mid = lo + (hi-lo)/2;\r\n\t        \r\n\t        if(it(mid,l) <= it(mid+1,l)){\r\n\t            lo = mid+1;\r\n\t        }else{\r\n\t            hi = mid;\r\n\t        }\r\n\t    }\r\n\t    \r\n\t    ans = max(ans,it(lo,l));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
