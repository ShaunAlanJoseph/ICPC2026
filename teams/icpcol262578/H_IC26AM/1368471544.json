  "source_code": "m=998244353\r\nt=int(input())\r\nt1=[]\r\nEx=0\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    t1.append((n,a))\r\n    Ex=max(Ex,n)\r\ni=[0]*(Ex+1)\r\nif Ex>=1:\r\n    i[1]=1 \r\nfor j in range(2,Ex+1):\r\n    i[j]=m-(m//j)*i[m%j]%m\r\nh=[0]*(Ex+1)\r\nfor k in range(1,Ex+1):\r\n    h[k]=(h[k-1]+i[k])%m\r\nfor n,a in t1:\r\n    res=0\r\n    for l in range(n):\r\n        cof=(h[l]+h[n-1-l])%m \r\n        res=(res+a[l]*cof)%m \r\n    print(res)\r\n        ",
