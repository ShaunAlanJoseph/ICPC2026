  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\nvoid solve() {\r\n    long long n;\r\n    cin >> n;\r\n    vector < long long > a(3 * n + 1), v(3 * n + 1, 0);\r\n    for (long long i = 1; i <= 3 * n; i++) cin >> a[i];\r\n    sort(a.begin() + 1, a.end(), greater < int > ());\r\n    for (long long i = 1; i <= 3 * n; i++) v[i] = v[i - 1] + a[i];\r\n    long long ans = 0, j = n;\r\n    for (long long i = 0; i <= n; i++) {\r\n    j = min(j, n - i);\r\n    while (j > 0) {\r\n        long long temp = a[i + 2 * j - 1] + a[i + 2 * j] - 3 * a[3 * n - 2 * i - j + 1];\r\n        if (temp >= 0) break;\r\n        j--;\r\n    }\r\n    ans = max(ans, 2 * v[i] + v[i + 2 * j] + 3 * v[3 * n - 2 * i - j]);\r\n}\r\ncout << ans << endl;\r\n}\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    while (t--) solve();\r\n    return 0;\r\n}",
