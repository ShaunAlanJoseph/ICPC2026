  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\t\r\n\tint M = 998244353;\r\n\t\r\n\tint N = 200001;\r\n\t\r\n\tvector<int>v(N+1) , h(N+1, 0);\r\n\tv[1] = 1;\r\n\t\r\n\tfor(int i = 2 ; i <= N ; i++){\r\n\t    v[i] = (M - M/i) * v[M % i] % M;\r\n\t}\r\n\t\r\n\tfor(int i = 1 ; i <= N ; i++){\r\n\t    h[i] = (h[i-1] + v[i]) % M;\r\n\t}\r\n\t\r\n\tint t, n;\r\n\tcin >> t;\r\n\t\r\n\twhile(t--){\r\n\t    cin >> n;\r\n\t    \r\n\t    int r = 0 , x;\r\n\t    \r\n\t    for(int j = 1 ; j <= n ; j++){\r\n\t        cin >> x;\r\n\t        r = (r + x % M  *(( h[j-1] + h[n-j] ) % M )) % M;\r\n\t    }\r\n\t    cout << r << endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
