  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nint main() {\r\n    \r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int m = 3*n;\r\n        vector<ll> a(m);\r\n        for(auto &v:a) cin>>v;\r\n        \r\n        sort(a.rbegin(),a.rend());\r\n        \r\n        vector<ll> P(m+1,0);\r\n        for(int i =0;i<m;i++){\r\n            P[i+1] = P[i] + a[i];\r\n        }\r\n        \r\n        ll best = 0;\r\n        \r\n        for(int p = 0;p<=n;p++){\r\n            int lo = 0; \r\n            int hi = n - p;\r\n            while(lo<hi){\r\n                int q = (lo+hi)/2;\r\n                int b2 = p + 2*q;\r\n                int b3 = 3*n - 2*p - q;\r\n                ll gain = a[b2] + a[b2+1] - 3*a[b3-1];\r\n                if(gain>0) lo = q+1;\r\n                else hi = q;\r\n            }\r\n            int q = lo;\r\n            \r\n            ll yxz = 2* P[p] + P[p+2*q] + 3*P[3*n - 2*p - q];\r\n            best = max(best,yxz);\r\n        }\r\n        cout<<best<<\"\\n\";\r\n    }\r\nreturn 0;\r\n}\r\n",
