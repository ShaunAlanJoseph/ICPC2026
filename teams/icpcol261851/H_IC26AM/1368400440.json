  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n#define rep(i,a,b) for (int i=(a);i<(b);++i)\r\nconst int MOD=998244353;\r\nconst int N= 200005;\r\nll iv[N];\r\nvoid solve(){\r\n    int n;\r\n    cin >>n;\r\n    vector<ll> p(n+1,0);\r\n    rep(i,1, n+1){\r\n        ll x;\r\n        cin>>x;\r\n        p[i]=(p[i-1]+x)%MOD;\r\n    }\r\n    ll ans=0;\r\n    rep(d,1,n) ans =(ans+iv[d]*((p[n]-p[d]+p[n-d]+MOD)%MOD)) %MOD;\r\n    cout<<ans<<'\\n';\r\n}\r\n\r\n\r\nint main() {\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tiv[1]=1;\r\n\trep(i,2,N) iv[i]=(MOD-MOD/i) * iv[MOD%i]%MOD;\r\n\t\r\n\tint t4=1;\r\n\tcin>>t4;\r\n\t\r\n\twhile(t4--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
