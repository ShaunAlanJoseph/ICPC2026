  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\nconst int MOD=998244353;\r\nconst int MAX=1000005;\r\nint h[MAX];\r\nint im[MAX];\r\n\r\nvoid pc(){\r\n    im[1]=1;\r\n    for(int i=2;i<MAX;i++){\r\n        im[i]=(MOD-(MOD/i)*im[MOD%i]%MOD)%MOD;\r\n    }\r\n    h[0]=0;\r\n    for(int i=0;i<MAX;i++){\r\n        h[i]=(h[i-1]+im[i])%MOD;\r\n    }\r\n}\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<int>a(n);\r\n    for(int i=0;i<n;i++){\r\n        cin>>a[i];\r\n    }\r\n    if(n==1){\r\n        cout<<0<<endl;\r\n        return;\r\n    }\r\n    int e=0;\r\n    for(int i=0;i<n;i++){\r\n        int eo=(h[i]+h[n-1-i])%MOD;\r\n        int t=(eo*a[i])%MOD;\r\n        e=(e+t)%MOD;\r\n    }\r\n    cout<<e<<endl;\r\n}\r\nsigned main() {\r\n    pc();\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n\t\r\n}\r\n",
