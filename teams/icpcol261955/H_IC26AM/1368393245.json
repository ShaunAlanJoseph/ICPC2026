  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int m = 998244353 , n = 200000;\r\n\r\n#define ll long long int\r\nint main() {\r\n\t// your code goes here\r\n\tvector<ll> v(n+1), h(n+1);\r\n\tv[1] = 1;\r\n\tfor(int i = 2;i<=n;i++) v[i] = m - (m/i)*v[m%i]%m;\r\n\tfor(int i = 1;i<=n;i++) h[i] = (h[i-1]+v[i])%m;\r\n    int t;cin>>t;\r\n    while(t--){\r\n        int n;cin>>n;\r\n        // vector<int> a(n);\r\n        // for(auto &i:a) cin>>i;\r\n        ll ans = 0;\r\n        for(int i = 1;i<=n;i++){\r\n            ll x;cin>>x;\r\n            // ll c = (h[i-1] + h[n-i])%m;\r\n            ans = (ans + x*((h[i-1] + h[n-i])%m))%m;\r\n        }\r\n        cout<<ans<<\"\\n\";\r\n        \r\n    }\r\n}\r\n",
