  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    string types[4] = {\"00\",\"01\",\"10\",\"11\"};\r\n    int t;cin>>t;\r\n    while(t--){\r\n        int c00,c01,c10,c11;cin>>c00>>c01>>c10>>c11;\r\n        int counts[4] = {c00,c01,c10,c11};\r\n        int n=c00+c01+c10+c11;\r\n        string small;bool firstCan = true;\r\n        for(int i = 0;i<4;i++){\r\n            if(counts[i] == 0) continue;\r\n            counts[i]--;\r\n            int leadZero = min(n-1,2*counts[0]+counts[2]);\r\n            int remLen = n-1-leadZero;\r\n            int alterPair = min(counts[1],remLen/2);\r\n            string candidate(leadZero,'0');\r\n            candidate.reserve(n+1);\r\n            for(int i = 0;i<alterPair;i++){\r\n                candidate+=\"01\";\r\n            }\r\n            int trilOne = remLen - 2*alterPair;\r\n            candidate.append(trilOne,'1');\r\n            candidate+=types[i];\r\n            if(firstCan || candidate<small){\r\n                small = move(candidate);\r\n                firstCan = false;\r\n            }\r\n            counts[i]++;\r\n        }\r\n        cout<<small<<\"\\n\";\r\n    }\r\n}\r\n",
