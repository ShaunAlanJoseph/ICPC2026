  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nconst int MAXN=200000;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tvector<long long> inv(MAXN +1), pref(MAXN+1);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<=MAXN;++i){\r\n\t    inv[i]= MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\tfor(int i=1;i<=MAXN;++i)\r\n\t    pref[i]=(pref[i-1]+inv[i])%MOD;\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    long long ans=0;\r\n\t    for(int i=1;i<=n;++i){\r\n\t        long long x;\r\n\t        cin>>x;\r\n\t        x%=MOD;\r\n\t        ans=(ans+x*((pref[i-1]+pref[n-i])% MOD))%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
