  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long> s(m);\r\n\t    for(auto &v:s) cin>>v;\r\n\t    sort(s.begin(),s.end(), greater<long long>());\r\n\t    vector<long long> p(m+1,0);\r\n\t    for(int i=0;i<m;i++) p[i+1]=p[i]+s[i];\r\n\t    auto f=[&](int a, int b)-> long long{\r\n\t        return 2*p[a]+p[a+2*b]+ 3*p[m-2*a-b];\r\n\t    };\r\n\t    long long best=0;\r\n\t    for(int a=0;a<=n;a++){\r\n\t        int lo=0, hi=n-a;\r\n\t        while(lo<hi) {\r\n\t            int mid=lo+(hi-lo)/2;\r\n\t            if(f(a, mid+1)>f(a,mid) )lo=mid+1;\r\n\t            else hi=mid;\r\n\t        }\r\n\t        long long xyz=f(a,lo);\r\n\t        best=max(best,xyz);\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\t    return 0;\r\n\t    \r\n\r\n}\r\n",
