  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint n;\r\nvector<long long> P;\r\nlong long f(int a, int b){\r\n    ll g=6*P[a];\r\n    ll h=4*(P[a+2*b] - P[a]);\r\n    ll i=3*(P[3*n-2 * a - b] - P[a+2*b]);\r\n    return  g+h+i;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t   \r\n\t   cin>>n; \r\n\t   vector<long long> e(3*n);\r\n\t   for(int i=0; i<3*n; i++){\r\n\t       cin>>e[i];\r\n\t   }\r\n\t       sort(e.begin(), e.end(), greater<long long>());\r\n\t   \r\n\t   P.assign(3*n+1, 0);\r\n\t   for(int i=0; i<3*n; i++){\r\n\t       P[i+1] = P[i] + e[i];\r\n\t       \r\n\t   }\r\n\t   \r\n\t   long long ans = 0;\r\n\t   for(int a = 0; a<=n; a++){\r\n\t       int lo = 0, hi = n-a;\r\n\t       while(lo<hi){\r\n\t           int mid = (lo + hi+1)/2;\r\n\t           if(f(a,mid) > f(a,mid-1)) lo = mid;\r\n\t           else{\r\n\t               hi = mid - 1;\r\n\t           }\r\n\t           \r\n\t       }\r\n\t       ans = max(ans,f(a,lo));\r\n\t   }\r\n\t   cout<<ans<<endl;\r\n\t   \r\n\t}\r\n\r\n}\r\n",
