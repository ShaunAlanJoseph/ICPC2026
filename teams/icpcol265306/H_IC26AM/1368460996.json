  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\nconst int N = 200005;\r\nint main() {\r\n\t// your code goes here\r\n    long long v[N] , h[N];\r\n    v[1] = 1;\r\n    h[0] = 0;\r\n    h[1] = 1;\r\n    \r\n    for(int i=2; i<N; i++){\r\n        v[i] = (MOD - (MOD/i) * v[MOD%i] %MOD)%MOD;\r\n        h[i] = (h[i-1] + v[i])%MOD;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        long long fans = 0;\r\n        for(int j=1; j<=n; j++){\r\n            long long a;\r\n            cin>>a;\r\n            fans = (fans+a*((h[j-1] + h[n-j]) % MOD ) )%MOD;\r\n        }\r\n        cout<<fans<<endl;\r\n    }\r\n}\r\n",
