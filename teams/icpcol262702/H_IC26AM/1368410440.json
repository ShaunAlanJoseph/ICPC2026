  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nconst ll mod = 998244353;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<ll> a(n+1);\r\n\t    \r\n\t    for(int i=1; i<=n; i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    \r\n\t    vector<ll> inv(n+1);\r\n\t    vector<ll> h(n+1);\r\n\t    \r\n\t    if(n>=1) inv[1]=1;\r\n\t    \r\n\t    for(int i=2; i<=n; i++){\r\n\t        inv[i]=mod - (mod/i)*inv[mod%i]%mod;\r\n\t        \r\n\t       \r\n\t        \r\n\t    }\r\n\t    \r\n\t    for(int i=1; i<=n; i++){\r\n\t       // ll x = (h[i-1]+h[n-i])%mod;\r\n\t       h[i]=(h[i-1]+inv[i])%mod;\r\n\t    }\r\n\t    ll ans=0;\r\n\t    \r\n\t    for(int i =1; i<=n; i++){\r\n\t        ll x = (h[i-1]+h[n-i])%mod;\r\n\t        ans=(ans+a[i]*x)%mod;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n",
