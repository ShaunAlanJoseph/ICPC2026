  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m=n*3;\r\n\t    \r\n\t    vector<long long>all(m);\r\n\t    \r\n\t    for(int i=0; i<m; i++){\r\n\t        cin>>all[i];\r\n\t    }\r\n\t    \r\n\t    sort(all.rbegin(),all.rend());\r\n\t    \r\n\t    vector<long long> prefix(m+1,0);\r\n\t    for(int i=0; i<m; i++){\r\n\t        prefix[i+1]=prefix[i]+all[i];\r\n\t    }\r\n\t    \r\n\t    long long ans=0;\r\n\t    \r\n\t    for(int x=0; x<=n ; x++){\r\n\t        int low=0;\r\n\t        int high= n-x;\r\n\t    \r\n\t    while(low<high){\r\n\t        int y = (low + high+1)/2;\r\n\t        int pos = x+2 *(y-1);\r\n\t        int last = 3*n- 2*x-y;\r\n\t        \r\n\t        long long change = all[pos]+ all[pos+1] - 3LL*all[last];\r\n\t        \r\n\t        if(change>=0) low=y;\r\n\t        else high = y-1;\r\n\t    }\r\n\t    int y=low;\r\n\t    int first= x;\r\n\t    int second = x+ 2 *y;\r\n\t    int third = 3*n-2*x-y;\r\n\t    \r\n\t    long long cur= 6ll*prefix[first]+4ll*(prefix[second]-prefix[first])+3ll*(prefix[third]-prefix[second]);\r\n\t    \r\n\t    ans=max(ans,cur);\r\n\t}\r\n\tcout<<ans<<endl;\r\n}\r\nreturn 0;\r\n}\r\n",
