  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\twhile (t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    \r\n\t    int m = 3*n;\r\n\t    \r\n\t    vector<ll> v (m);\r\n\t    \r\n\t    for (int i = 0; i < m; i++){\r\n\t        cin >> v[i];\r\n\t    }\r\n\t    \r\n\t    sort(v.begin(), v.end(), greater<ll> ());\r\n\t    \r\n\t    vector<ll> p (m+1, 0);\r\n\t    \r\n\t    for (int i = 0; i < m; i++){\r\n\t        p[i + 1] = p[i] + v[i];\r\n\t    }\r\n\t    ll best = 0;\r\n\t    \r\n\t    for (int a = 0; a <= n; a++){\r\n\t        int mx = n - a;\r\n\t        auto f = [&](int k)->ll{\r\n\t            return 2*p[a] + p[a+2*k] + 3*p[3*n - 2*a - k];\r\n\t        };\r\n\t        int low = 0,high = mx;\r\n\t        \r\n\t        while (low < high){\r\n\t            ll mid = low + (high - low)/2;\r\n\t            \r\n\t            if (f(mid + 1) > f(mid)){\r\n\t                low = mid + 1;\r\n\t            }\r\n\t            else{\r\n\t                high = mid;\r\n\t            }\r\n\t        }\r\n\t        best = max(best, f(low));\r\n\t        \r\n\t    }\r\n\t    cout << best << endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
