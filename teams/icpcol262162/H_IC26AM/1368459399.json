  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing int64 = long long;\r\nconst int64 MOD = 998244353;\r\nconst int MAXN = 200000;\r\nint main() {\r\n\t// your code goes here\r\n    vector<int64> inv(MAXN+1),h(MAXN+1);\r\n    inv[1] = 1;\r\n    \r\n    for(int i=2;i<=MAXN;++i)\r\n        inv[i] =MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    for(int i =1;i<=MAXN;++i)\r\n        h[i] = (h[i-1] + inv[i]) % MOD;\r\n        \r\n        int t;\r\n        cin>>t;\r\n        \r\n        while(t--){\r\n            int n;\r\n            cin>>n;\r\n            int64 ans = 0;\r\n            for(int i=0; i<n; i++){\r\n                int64 x;\r\n                cin>>x;\r\n                int64 w = (h[i] + h[n-1-i]) % MOD;\r\n                ans = (ans+x*w)%MOD;\r\n            }\r\n            cout<<ans<<'\\n';\r\n        }\r\n    return 0;\r\n}\r\n",
