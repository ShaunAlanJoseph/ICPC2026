  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        vector<long long> a(3*n);\r\n        for(auto &x : a) cin >> x;\r\n        sort(a.rbegin(),a.rend());\r\n        vector<long long> pref(3*n+1,0);\r\n        for(int i = 0;i<3*n;++i)\r\n            pref[i+1] = pref[i] + a[i];\r\n            \r\n            auto calc = [&](int x,int y) ->long long{\r\n                return 2LL * pref[x] + pref[x+2*y]+3LL*pref[3*n-2*x-y];\r\n            };\r\n            long long ans = 0;\r\n            for(int x =0;x<=n;++x){\r\n                int l = 0,r = n-x;\r\n                while(l<r){\r\n                    int m = l+(r-l)/2;\r\n                    if(calc(x,m+1)>= calc(x,m)) l = m+1;\r\n                    else r = m;\r\n                }\r\n                ans = max(ans,calc(x,l));\r\n            }\r\n            cout << ans << '\\n';\r\n        }\r\n        return 0;\r\n}\r\n",
