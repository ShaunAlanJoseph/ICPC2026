  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long M = 998244353;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    \r\n    vector<long long>a(n),h(n+1);\r\n    for(auto &x : a)cin>>x;\r\n    \r\n    vector<long long> iv(n+1);\r\n    \r\n    iv[1]=1;\r\n    for(int i =2; i<=n; i++)\r\n    {\r\n        iv[i] = M-M / i*iv[M % i] % M;\r\n    }\r\n    \r\n    for(int i = 1; i <=n; i++)\r\n    {\r\n        h[i] = (h[i-1] + iv[i]) % M;\r\n    }\r\n    long long ans = 0;\r\n    \r\n    for(int i = 0; i<n;i++)\r\n    {\r\n        ans = (ans + a[i] * (h[i] + h[n-i-1])) % M;\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--) solve();\r\n    \r\n}\r\n",
