  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long> a(3*n), p(3*n+1);\r\n    \r\n    for(auto &x : a) cin>>x;\r\n    sort(a.rbegin(), a.rend());\r\n    \r\n    for(int i=0; i<3*n; i++){\r\n        p[i+1] = p[i] + a[i];\r\n    }\r\n    \r\n    long long ans=0;\r\n    \r\n    for(int x = 0; x<=n; x++){\r\n        int l=0, r=n-x;\r\n        \r\n        while(l<r){\r\n            int q = (l+r)/2;\r\n            int i = x + 2*q;\r\n            int j = 3*n - 2*x -q;\r\n            \r\n            if( q < n-x && a[i] + a[i+1] >= 3*a[j-1]) l=q+1;\r\n            else r=q;\r\n        }\r\n        \r\n        int q = l;\r\n        int i = x+2*q;\r\n        int j = 3*n - 2*x - q;\r\n        \r\n        ans = max(ans, 2*p[x]+p[i]+3*p[j]);\r\n    }\r\n    \r\n    cout<< ans << endl;\r\n    \r\n    \r\n}\r\n\r\nint main() {\r\n    \r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--) solve();\r\n\t\r\n\r\n}\r\n",
