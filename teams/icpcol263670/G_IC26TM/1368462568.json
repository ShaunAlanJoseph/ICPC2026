  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\nsigned main() {\r\n\t// your code goes here\r\n    int t; cin>>t; while(t--){\r\n        int n;cin>>n;\r\n        vector<int> v;\r\n        for(int i=0;i<3*n;i++){\r\n            int x; cin>>x; v.push_back(x);\r\n        }\r\n        sort(v.begin(),v.end());\r\n        reverse(v.begin(),v.end());\r\n        vector<int>pref((3*n)+1,0);\r\n        for(int i=0;i<3*n;i++) pref[i+1]=pref[i]+v[i];\r\n        int bl=0, c2=n;\r\n        for(int c1=0;c1<=n;c1++){\r\n            c2=min(c2,n-c1);\r\n            while(c2>0){\r\n                int b=c1+2*(c2-1), c=(3*n)-2*c1-(c2-1);\r\n                //cout<<b<<\" \"<<c<<endl;\r\n                if(v[b]+v[b+1]>3*v[c-1]) break;\r\n                c2--;\r\n            }\r\n            //for(auto &x:pref) cout<<x<<endl;\r\n            int tot=3*pref[(3*n)-2*c1-c2]+pref[c1+2*c2]+ 2*pref[c1];\r\n            bl=max(bl,tot);\r\n        }\r\n        cout<< bl << endl;\r\n    }\r\n    return 0;\r\n}\r\n",
