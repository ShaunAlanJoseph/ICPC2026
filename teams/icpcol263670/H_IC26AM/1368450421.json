  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int MOD= 998244353;\r\nint power(int b,int e){\r\n    int r=1;\r\n    b%=MOD;\r\n    while(e>0){\r\n        if(e&1)r=r*b%MOD;\r\n        b=(b*b)%MOD;\r\n        e>>=1;\r\n    }\r\n    return r;\r\n}\r\n\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    int n; cin>>n;\r\n\t    vector<int>arr(n+1,0);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        arr[i]= (arr[i-1]+power(i,MOD-2))%MOD;\r\n\t    }\r\n\t    int ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        int a; cin>>a;\r\n\t        ans=(ans+a*((arr[i-1]+arr[n-i])%MOD))%MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
