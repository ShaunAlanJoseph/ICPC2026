  "source_code": "# cook your dish here\r\nimport sys\r\ntc=int(input())\r\nresult=[]\r\nfor h in range(tc):\r\n    nm=int(input())\r\n    lg=3*nm\r\n    st=list(map(int,input().split()))\r\n    st.sort(reverse=True)\r\n    pt=[0]*(lg+1)\r\n    for k in range(lg):\r\n        pt[k+1]=pt[k]+st[k]\r\n    def ft(k,y):\r\n        return pt[k+2*y]+3*pt[lg-2*k-y]\r\n    bt=0\r\n    for k in range(nm+1):\r\n        mn=nm-k\r\n        le=0\r\n        ri=mn\r\n        while le<ri:\r\n            btw=(le+ri)//2\r\n            if ft(k,btw+1)>ft(k,btw):\r\n                le=btw+1\r\n            else:\r\n                ri=btw\r\n        vld=2*pt[k]+ft(k,le)\r\n        if vld>bt:\r\n            bt=vld\r\n    result.append(str(bt))\r\nsys.stdout.write(\"\\n\".join(result))\r\n    ",
