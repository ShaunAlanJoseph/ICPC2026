  "source_code": "# cook your dish here\r\nimport sys\r\nMOD=998244353\r\nMAX=200005\r\ninve=[0]*(MAX+1)\r\ninve[1]=1\r\nfor h in range(2,MAX+1):\r\n    inve[h]=(MOD-(MOD//h)*inve[MOD%h]%MOD)%MOD\r\nJ=[0]*(MAX+1)\r\nfor h in range(1,MAX+1):\r\n    J[h]=(J[h-1]+inve[h])%MOD\r\ntc=int(input())\r\nresult=[]\r\nfor h in range(tc):\r\n    nm=int(input())\r\n    arr=list(map(int,input().split()))\r\n    t=0\r\n    for k in range(1,nm+1):\r\n        ap=arr[k-1]%MOD\r\n        wp=(J[k-1]+J[nm-k])%MOD\r\n        t=(t+ap*wp)%MOD\r\n    result.append(str(t))\r\nsys.stdout.write(\"\\n\".join(result))",
