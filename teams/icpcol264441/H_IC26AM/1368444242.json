  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\n#define MOD 998244353\r\n\r\nint main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile ( t-- )\r\n\t{\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    vector<ll> a( n + 1 );\r\n\t    for ( int i = 1; i <= n; i++ )\r\n\t    {\r\n\t        cin >> a[i];\r\n\t    }\r\n\t    vector<ll> inv( n + 1 );\r\n\t    inv[1] = 1;\r\n\t    \r\n\t    for ( int i = 2; i <= n; i++ )\r\n\t    {\r\n\t        inv[i] = MOD - ( MOD / i ) * inv[MOD % i] % MOD; \r\n\t    }\r\n\t    \r\n\t    vector<ll> H( n + 1, 0 );\r\n\t    for ( int i = 1; i <= n; i++ )\r\n\t    {\r\n\t        H[i] = ( H[i - 1] + inv[i] ) % MOD;\r\n\t    }\r\n\t    \r\n\t    ll ans = 0;\r\n\t    for ( int i = 1; i <= n; i++ )\r\n\t    {\r\n\t        ll weight = ( H[i-1] + H[n-i] ) % MOD;\r\n\t        ans = ( ans + a[i] * weight ) % MOD;\r\n\t    }\r\n\t    cout << ans << '\\n';\r\n\t}\r\n    return 0;\r\n}\r\n",
