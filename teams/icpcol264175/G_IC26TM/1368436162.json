  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    if(!(cin>>n)) return;\r\n    \r\n    int total=3*n;\r\n    vector<long long>a(total);\r\n    for(int i=0;i<total;++i){\r\n        cin>>a[i];\r\n    }\r\n    \r\n    sort(a.rbegin(),a.rend());\r\n    \r\n    vector<long long>pref(total+1,0);\r\n    for(int i=0;i<total;++i){\r\n        pref[i+1]=pref[i]+a[i];\r\n    }\r\n    auto gv=[&](int c1,int c2) -> long long {\r\n        return 2*pref[c1]+pref[c1+2*c2]+3*pref[3*n-(2*c1+c2)];\r\n    };\r\n    \r\n    long long maxi=0;\r\n    for(int c1=0;c1<=n;++c1){\r\n        int low=0;\r\n        int high=n-c1;\r\n        \r\n        while(high-low >3){\r\n            int m1=low+(high-low)/3;\r\n            int m2=high-(high-low)/3;\r\n            \r\n            if(gv(c1,m1) < gv(c1,m2)){\r\n                low=m1;\r\n            }else{\r\n                high=m2;\r\n            }\r\n        }\r\n        for(int c2=low;c2<=high;++c2){\r\n            maxi=max(maxi,gv(c1,c2));\r\n        }\r\n    }\r\n    cout<<maxi<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
