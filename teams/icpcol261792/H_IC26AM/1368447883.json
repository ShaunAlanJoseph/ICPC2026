  "source_code": "import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\r\nclass Codechef\r\n{\r\n\tpublic static void main (String[] args) throws java.lang.Exception\r\n\t{\r\n\t\tScanner sc=new Scanner(System.in);\r\n\t\tint mod=998244353;\r\n\t\t\r\n\t\tint t=sc.nextInt();\r\n\t\twhile(t-->0)\r\n\t\t{\r\n\t\t    int n=sc.nextInt();\r\n\t\t    long a[]=new long[n];\r\n\t\t    for(int i=0;i<n;i++)\r\n\t\t    {\r\n\t\t        a[i]=sc.nextLong();\r\n\t\t    }\r\n\t\t    \r\n\t\t    long inv[]=new long[n+1];\r\n\t\t    long h[]=new long[n+1];\r\n\t\t    \r\n\t\t    if(n>1)\r\n\t\t    {\r\n\t\t        inv[1]=1;\r\n\t\t    }\r\n\t\t    for(int i=2;i<=n;i++)\r\n\t\t    {\r\n\t\t        inv[i]=mod-(mod/i)*inv[mod%i]%mod;\r\n\t\t    }\r\n\t\t    for(int i=1;i<=n;i++)\r\n\t\t    {\r\n\t\t        h[i]=((h[i-1])+inv[i])%mod;\r\n\t\t    }\r\n\t\t    \r\n\t\t    long ans=0;\r\n\t\t    for(int i=0;i<n;i++)\r\n\t\t    {\r\n\t\t        long w=(h[i]+h[n-1-i])%mod;\r\n\t\t        \r\n\t\t        ans=(ans+a[i]*w)%mod;\r\n\t\t    }\r\n\t\t    \r\n\t\t    System.out.println(ans);\r\n\t\t    \r\n\t\t}\r\n\r\n\t}\r\n}\r\n",
