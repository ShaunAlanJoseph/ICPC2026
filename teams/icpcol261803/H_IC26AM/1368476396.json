  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\tvector<pair<int,vector<long long>>> te(t);\r\n\tint mx = 0;\r\n\tfor(auto &[n, a] : te) {\r\n\t    cin >> n;\r\n\t    a.resize(n);\r\n\t    for(auto &i : a) {\r\n\t        cin >> i;\r\n\t    }\r\n\t    mx = max(mx, n);\r\n\t}\r\n\tvector<long long> xx(mx + 1), h(mx + 1);\r\n\tif(mx >= 1) xx[1] = 1;\r\n\tfor(int i = 2; i <= mx; ++i) {\r\n\t    xx[i] = MOD - (MOD / i) * xx[MOD % i] % MOD;\r\n\t}\r\n\tfor(int i = 1; i <= mx; ++i) {\r\n\t    h[i] = (h[i - 1] + xx[i]) % MOD;\r\n\t}\r\n\tfor(auto &[n, a] : te) {\r\n\t    long long ans = 0;\r\n\t    for(int i = 0; i < n; ++i) {\r\n\t        long long cff = (h[i] + h[n - i - 1]) % MOD;\r\n\t        ans = (ans + a[i] * cff) % MOD;\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n}\r\n\r\n",
