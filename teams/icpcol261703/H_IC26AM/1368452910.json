  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nll MOD = 998244353;\r\nll MAXN = 200000;\r\n\r\nint main() {\r\n    vector < ll > inv(MAXN + 1);\r\n    vector < ll > harmonic(MAXN + 1);\r\n    inv[1] = 1;\r\n    for (int i = 2; i <= MAXN; i++) {\r\n        inv[i] = MOD - (MOD / i) * inv[MOD % i] % MOD;\r\n\r\n    }\r\n    for (int i = 1; i <= MAXN; i++) {\r\n        harmonic[i] = (harmonic[i - 1] + inv[i]) % MOD;\r\n    }\r\n    ll t;\r\n    cin >> t;\r\n    while (t--) {\r\n        \r\n        ll n;\r\n        cin >> n;\r\n        ll ans = 0;\r\n        for (int i = 0; i < n; i++) {\r\n            ll x;\r\n            cin >> x;\r\n            ll times = (harmonic[i] + harmonic[n - i - 1]) % MOD;\r\n\r\n            ans = (ans + x * times) % MOD;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n}",
