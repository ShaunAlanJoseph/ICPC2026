  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<int> arr(3*n+1);\r\n    for(int i=1;i<=3*n;i++) cin>>arr[i];\r\n    sort(arr.begin()+1,arr.end(),greater<int>());\r\n    vector<int> v(3*n+1,0);\r\n    for(int i=1;i<=3*n;i++) v[i] = v[i-1]+arr[i];\r\n    int res=0;\r\n    for(int i=0;i<=n;i++){\r\n        int low = 0;\r\n        int high =n-i;\r\n        \r\n        while(low<high){\r\n            int mid= low + (high-low)/2;\r\n            int diff=  arr[i+2*mid+1]+arr[i+2*mid+2]-(long long)3*arr[3*n-2*i-mid];\r\n            if(diff>=0){\r\n                low = mid+1;\r\n            }else{\r\n                high = mid;\r\n            }\r\n        }\r\n        int stj  = max((long long)0,low-2);\r\n        int enj = min(n-i,low+2);\r\n        for(int j=stj;j<=enj;j++){\r\n            int cnt = (2*(1LL) * v[i])+v[i+2*j]+3*(1LL) * v[3*n-2*i-j];\r\n            if(cnt>res){\r\n                res = cnt;\r\n            }\r\n        }\r\n    }\r\n    cout<<res<<endl;\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n",
