  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long \r\n\r\nint main() {\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n,m;\r\n\t    cin >> n >> m;\r\n\t    vector<int> v(m);\r\n\t    for(int i=0;i<m;i++){\r\n\t        cin >> v[i];\r\n\t    }\r\n\t    sort(v.begin(),v.end());\r\n\t    int mgap=v[0]-1;\r\n\t    for(int i=1;i<m;i++){\r\n\t        mgap=max(v[i]-v[i-1]-1,mgap);\r\n\t    }\r\n\t    mgap=max(mgap,n-v[m-1]);\r\n\t    int k=min(v[0]-1,n-v[m-1]);\r\n\t    cout << 2*k+max(mgap-k,max(v[0]-1,n-v[m-1])) << \"\\n\";\r\n\t}\r\n\r\n}\r\n",
