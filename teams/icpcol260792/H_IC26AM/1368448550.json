  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200000 + 5;\r\n\r\nll inv[MAXN];\r\nll H[MAXN];\r\n\r\nvoid precompute() {\r\n    inv[1] = 1;\r\n    \r\n    for(int i = 2; i < MAXN; i++) {\r\n        inv[i] = MOD - (MOD / i) * inv[MOD % i] % MOD;\r\n    }\r\n    \r\n    H[0] = 0;\r\n    \r\n    for(int i = 1; i < MAXN; i++) {\r\n        H[i] = (H[i-1] + inv[i] % MOD);\r\n    }\r\n}\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    \r\n    ll ans = 0;\r\n    \r\n    for(int i = 1; i <= n; i++) {\r\n        ll x;\r\n        cin >> x;\r\n        \r\n        ll coeff = (H[i-1] + H[n-i]) % MOD;\r\n        \r\n        ans = (ans + x % MOD * coeff) % MOD;\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n    precompute();\r\n    \r\n    int t;\r\n    cin >> t;\r\n    \r\n    while(t--) {\r\n        solve();\r\n    }\r\n    \r\n    return 0;\r\n\r\n}\r\n",
