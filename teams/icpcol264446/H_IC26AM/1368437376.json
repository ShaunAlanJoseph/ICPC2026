  "source_code": "# cook your dish here\r\nimport sys\r\nMOD=998244353\r\ndef solve():\r\n    input=sys.stdin.readline\r\n    t=int(input())\r\n    MAXN=200000\r\n    H=[0]*(MAXN+1)\r\n    for i in range(1,MAXN+1):\r\n        H[i]=(H[i-1]+pow(i,MOD-2,MOD))%MOD\r\n    for _ in range(t):\r\n        n=int(input())\r\n        a=list(map(int,input().split()))\r\n        ans=0\r\n        for i in range(n):\r\n            coefficient=(H[i]+H[n-i-1])%MOD\r\n            ans=(ans+a[i]*coefficient)%MOD\r\n        print(ans)\r\nif __name__ ==\"__main__\":\r\n    solve()",
