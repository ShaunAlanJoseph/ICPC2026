  "source_code": "# cook your dish here\r\nMOD=998244353\r\nMAXN=200000\r\nH=[0]*(MAXN+1)\r\nfor i in range(1,MAXN+1):\r\n    H[i]=(H[i-1]+pow(i,MOD-2,MOD))%MOD\r\ndef solve():\r\n    import sys\r\n    input=sys.stdin.readline\r\n    t=int(input())\r\n    ans=[]\r\n    for v in range(t):\r\n        n=int(input())\r\n        a=list(map(int,input().split()))\r\n        total=0\r\n        for i in range(n):\r\n            coefficient=(H[i]+H[n-i-1])%MOD\r\n            total=(total+a[i]*coefficient)%MOD\r\n        ans.append(str(total))\r\n    print(\"\\n\".join(ans))\r\nif __name__ ==\"__main__\":\r\n    solve()",
