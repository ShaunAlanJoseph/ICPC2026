  "source_code": "# cook your dish here\r\nimport sys\r\nTP=[\"00\",\"01\",\"10\",\"11\"]\r\ndef solve(c):\r\n    if sum(c)==1:\r\n        return TP[c.index(1)]\r\n    best=None\r\n    for last in range(4):\r\n        if c[last]==0:\r\n            continue\r\n        d=c[:]\r\n        d[last]-=1\r\n        A,B,C,E=d\r\n        ps=max(0,min(B,(B+E-A)//2)) if B+E -A>=0 else 0\r\n        for p in (ps,ps+1):\r\n            if p>B:\r\n                continue\r\n            fr=B-p+E-p\r\n            if fr <0:\r\n                continue\r\n            a2=min(A,fr)\r\n            s=\"0\"*(A+a2+C)+\"01\"*p+\"1\"*(fr-a2)+TP[last]\r\n            if best is None or s<best:\r\n                best=s\r\n    return best\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0])\r\n    out=[]\r\n    for q in range(t):\r\n        out.append(solve([int(v) for v in data [1+4*q:5+4*q]]))\r\n    sys.stdout.write(\"\\n\".join(out)+\"\\n\")\r\nmain()",
