  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0]);idx=1\r\n    out=[]\r\n    for r in range(t):\r\n        n=int(data[idx]);idx+=1\r\n        m=3*n\r\n        s=sorted(map(int,data[idx:idx+m]),reverse=True);idx+=m\r\n        S=[0]*(m+1)\r\n        for i in range(m):\r\n            S[i+1]=S[i]+s[i]\r\n        best=0\r\n        for a in range(n+1):\r\n            lo,hi=0,n-a\r\n            base=3*n-2*a-1\r\n            while lo<hi:\r\n                mid=(lo+hi)>>1\r\n                j=a+2*mid\r\n                if s[j]+s[j+1]-3*s[base-mid]>0:\r\n                    lo=mid+1\r\n                else:\r\n                    hi=mid\r\n            v=2*S[a]+S[a+2*lo]+3*S[3*n-2*a-lo]\r\n            if v>best:\r\n                best=v\r\n        out.append(best)\r\n    sys.stdout.write(\"\\n\".join(map(str,out))+\"\\n\")\r\nmain()\r\n            ",
