  "source_code": "import sys\r\ninput = sys.stdin.buffer.readline\r\n\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    \r\n    m=3*n\r\n    p=[0]*(m+1)\r\n    for  i  in range (m):\r\n        p[i+1]=p[i]+a[i]\r\n    ans=0\r\n    for A in range(n+1):\r\n        lo, hi =0,n-A\r\n        def value(B):\r\n            j=A+2*B \r\n            k=3*n-2*A-B\r\n            return 2*p[A]+p[j]+3*p[k]\r\n        while lo<hi:\r\n            B=(lo+hi)//2 \r\n            j=A+2*B \r\n            k=3*n-2*A-B \r\n            diff=a[j]+a[j+1]-3*a[k-1]\r\n                \r\n            if diff >0:\r\n                lo= B+1 \r\n            else:\r\n                hi=B \r\n        ans= max(ans, value(lo))\r\n        if lo>0:\r\n            ans=max(ans, value(lo-1))\r\n    print(ans)",
