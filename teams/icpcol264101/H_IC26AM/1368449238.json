  "source_code": "import sys\r\nMOD=998244353\r\ninput= sys.stdin.buffer.readline\r\nt=int(input())\r\ntests=[]\r\nmx=0\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    tests.append((n,a))\r\n    mx=max(mx,n)\r\nh=[0]*mx\r\n\r\nfor i in range(1,mx):\r\n    h[i]=(h[i-1]+pow(i,MOD-2,MOD))%MOD\r\nfor n,a in tests:\r\n    ans=0\r\n    for i in range(n):\r\n        ans+=a[i]*(h[i]+h[n-1-i])\r\n    print(ans%MOD)",
