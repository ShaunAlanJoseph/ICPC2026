  "source_code": "# cook your dish here\r\nimport sys\r\ndef func():\r\n    d=sys.stdin.read().split()\r\n    c,p=int(d[0]),1\r\n    for k in range(c):\r\n        n=int(d[p]); p+=1\r\n        v=sorted(map(int,d[p:p+3*n]),reverse=True); p+=3*n\r\n        P=[0]\r\n        for x in v:\r\n            P.append(P[-1]+x)\r\n        best=0\r\n        for a in range(n+1):\r\n            g=lambda b:2*P[a]+P[a+2*b]+3*P[3*n-2*a-b]\r\n            o,h=0,n-a\r\n            while o<h:\r\n                m=(o+h)//2 \r\n                if g(m)<g(m+1):\r\n                    o=m+1 \r\n                else:\r\n                    h=m\r\n            best=max(best,g(o))\r\n        print(best)\r\nfunc()\r\n                    ",
