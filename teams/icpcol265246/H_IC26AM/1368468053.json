  "source_code": "import sys\r\n\r\ndef f():\r\n    d = sys.stdin.read().split()\r\n    \r\n    if not d :\r\n        return \r\n    t = int(d[0])\r\n    p = 1\r\n    m = 998244353\r\n    x = 200005\r\n    v = [0] * x\r\n    v[1] = 1\r\n    for i in range(2, x):\r\n        v[i] = (m - m// i) * v[m % i] % m \r\n    h =[0] * x \r\n    \r\n    for i in range(1, x):\r\n        h[i] = (h[i - 1] + v[i]) % m\r\n    o = []\r\n    for _ in range(t):\r\n        n = int(d[p])\r\n        p+= 1\r\n        a = 0 \r\n        for i in range(n):\r\n            c = (h[i] + h[n - 1 - i]) % m \r\n            a = (a + int(d[p]) * c) % m \r\n            p += 1\r\n        o.append(str(a))\r\n    sys.stdout.write('\\n'.join(o) + '\\n')\r\nif __name__ == '__main__':\r\n    f()\r\n        \r\n",
