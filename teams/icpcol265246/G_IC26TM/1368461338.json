  "source_code": "import sys\r\n\r\ndef solve():\r\n    it = iter(sys.stdin.read().split())\r\n    t_str = next(it, None)\r\n    if not t_str:\r\n        return\r\n    t = int(t_str)\r\n    out = []\r\n    \r\n    for _ in range(t):\r\n        n = int(next(it))\r\n        a = [int(next(it)) for _ in range(3 * n)]\r\n        a.sort(reverse = True)\r\n        s = [0] * (3 * n + 1)\r\n        \r\n        for i in range(3 * n):\r\n            s[i + 1] = s[i] + a[i]\r\n        ans = 0\r\n        p = 0\r\n        for y in range(2 * n + 1):\r\n            if p < y - n:\r\n                p = y - n \r\n            while p < y // 2:\r\n                v1 = 2 * s[p] + s[2 * y - 3 * p]\r\n                v2 = 2 * s[p + 1] + s[2 * y - 3 * (p + 1)]\r\n                if v2 >= v1:\r\n                    p += 1\r\n                else:\r\n                    break \r\n            val = 2 * s[p] + s[2 * y - 3 * p] + 3 * s[3 * n - y]\r\n            if val > ans:\r\n                ans = val\r\n        out.append(str(ans))\r\n    sys.stdout.write('\\n'.join(out) + '\\n')\r\nif __name__ == '__main__':\r\n    solve()\r\n",
