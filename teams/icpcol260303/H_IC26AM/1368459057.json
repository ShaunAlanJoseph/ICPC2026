  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200000;\r\n\r\nint main() {\r\n    int t;\r\n    cin>>t;\r\n\tvector<int>n(t);\r\n\tvector<vector<ll>>a(t);\r\n\tint mx=0;\r\n\tfor(int tc=0;tc<t;tc++)\r\n\t{\r\n\t    cin>>n[tc];\r\n\t    mx = max(mx,n[tc]);\r\n\t    a[tc].resize(n[tc]);\r\n\t    \r\n\t    for(int i = 0;i<n[tc];i++){\r\n\t        cin>>a[tc][i];\r\n\t    }\r\n\t}\r\n\tvector<ll>inv(mx+1,0);\r\n\tif(mx>=1){\r\n\t    inv[1] = 1;\r\n\t    for(int i = 2;i<=mx;i++){\r\n\t        inv[i] = MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t    }\r\n\t}\r\n\tvector<ll>H(mx+1,0);\r\n\tfor(int i = 1;i<=mx;i++){\r\n\t    H[i] = (H[i-1] +inv[i])%MOD;\r\n\t}\r\n\tfor(int tc = 0;tc<t;tc++){\r\n\t    int N = n[tc];\r\n\t    ll ans = 0;\r\n\t    for(int i = 0;i<N;i++){\r\n\t        ll coef = (H[i] + H[N-1-i])%MOD;\r\n\t        ans+=a[tc][i]*coef;\r\n\t        ans%=MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\t\r\nreturn 0;\r\n}\r\n",
