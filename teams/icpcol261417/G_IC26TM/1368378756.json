  "source_code": "# cook your dish here\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    a.sort(reverse=True)\r\n    pre = [0]\r\n    for x in a:\r\n        pre.append(pre[-1]+x)\r\n    def solve(A, B):\r\n        x = A + 2*B\r\n        y = 3*n-2*A-B\r\n        return 6*pre[A]+4*(pre[x]-pre[A])+3*(pre[y]-pre[x])\r\n    ans = 0\r\n    for A in range(n+1):\r\n        left = 0\r\n        right = n-A\r\n        while left<right:\r\n            mid = (left+right)//2 \r\n            if solve(A, mid)<=solve(A, mid+1):\r\n                left = mid+1 \r\n            else:\r\n                right = mid\r\n        ans = max(ans, solve(A, left))\r\n    print(ans)",
