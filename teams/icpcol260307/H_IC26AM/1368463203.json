  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nconst ll mod = 998244353;\r\n\r\nll binpow(ll a, ll b) {\r\n    ll res = 1;\r\n    while(b) {\r\n        if(b & 1)\r\n            res = (res * a) % mod;\r\n            \r\n        a = (a * a) % mod;\r\n        b /= 2;\r\n    }\r\n    return res;\r\n}\r\n\r\nvoid solve() {\r\n    ll n;\r\n    cin >> n;\r\n    vector<ll> a(n);\r\n    for(int i = 0; i < n; i++) cin >> a[i];\r\n    vector<ll> dd(n + 1);\r\n    dd[1] = 1;\r\n    for(int i = 2; i <= n; i++) {\r\n        dd[i] = dd[i - 1];\r\n        dd[i] = (dd[i] + binpow(i, mod - 2)) % mod;\r\n    }\r\n    \r\n    ll ans = 0;\r\n    for(int i = 0; i < n; i++) {\r\n        ll l = i, r = n - 1 - i;\r\n        ll val = (dd[l] + dd[r]) % mod;\r\n        val = (val * a[i]) % mod;\r\n        ans = (ans + val) % mod;\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--) solve();\r\n}\r\n",
