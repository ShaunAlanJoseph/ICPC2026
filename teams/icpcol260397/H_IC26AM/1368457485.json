  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nconst ll MOD = 998244353;\r\n\r\n\r\nll modPower(ll a,ll b){\r\n    ll result = 1;\r\n    while(b){\r\n        if(b&1) result = result * a %MOD;\r\n        a = a * a % MOD;\r\n        b>>=1;\r\n    }\r\n    return result;\r\n}\r\nint main(){\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    int T; cin>>T;\r\n    const int MAXN = 200000;\r\n    vector<ll> invert(MAXN+1);\r\n    for(int i =1;i<=MAXN;i++) invert[i] = modPower(i,MOD-2);\r\n    vector<ll> height(MAXN+1,0);\r\n    for(int i = 1;i<=MAXN;i++) height[i] = (height[i-1]+invert[i])%MOD;\r\n    while(T--){\r\n        int n; cin>>n;\r\n        vector<ll> a(n);\r\n        for(auto &x : a) cin>>x;\r\n        ll ans = 0;\r\n        for(int i = 0;i<n;i++){\r\n            ll coeff = (height[i]+height[n-i-1])%MOD;\r\n            ans = (ans+a[i]%MOD*coeff) %MOD;\r\n        }\r\n        cout<<ans<<'\\n';\r\n    }\r\n    return 0;\r\n}\r\n",
