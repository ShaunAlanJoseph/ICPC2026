  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nlong long mod=998244353;\r\nconst int maxn=200001;\r\nlong long Inv[maxn],H[maxn];\r\nint main() {\r\n    Inv[1]=1;\r\n    for(int i=2;i<maxn;i++){\r\n        Inv[i]=mod-((mod/i)*Inv[mod%i])%mod;\r\n    }\r\n    H[0]=0;\r\n    for(int i=1;i<maxn;i++){\r\n        H[i]=(H[i-1]+Inv[i])%mod;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        long long int ans=0;\r\n        for(int i=1;i<=n;i++){\r\n            long long x;\r\n            cin>>x;\r\n            long long coeff=(H[i-1]+H[n-i])%mod;\r\n            ans=(ans+(x%mod)*coeff)%mod;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
