  "source_code": "MOD=998244353\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    inv=[0]*(n+1)\r\n    if n>=1:\r\n        inv[1]=1\r\n    for i in range(2,n+1):\r\n        inv[i]=MOD-(MOD//i)*inv[MOD%i]%MOD\r\n    H=[0]*n\r\n    for i in range(1,n):\r\n        H[i]=(H[i-1]+inv[i])%MOD\r\n    ans=0\r\n    for i in range(n):\r\n        coe=(H[i]+H[n-1-i])%MOD\r\n        ans=(ans+a[i]*coe)%MOD\r\n    print(ans)\r\n",
