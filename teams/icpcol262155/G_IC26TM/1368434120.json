  "source_code": "from itertools import accumulate\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()))\r\n    b=3*n\r\n    p=[0]+list(accumulate(a))\r\n    def f(k,x):\r\n       return 3*(p[b]-p[b-x])+p[b-x]-p[b-2*k+x]-3*p[k+x]\r\n    ans=0\r\n    for k in range(1,n+1):\r\n        l,r=0,k\r\n        while l<r:\r\n            m=(l+r)//2\r\n            if f(k,m)<=f(k,m+1):\r\n                l=m+1\r\n            else:\r\n                r=m\r\n        ans=max(ans,f(k,l))\r\n    print(3*p[b]+ans)\r\n        \r\n",
