  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing vi= vector<int>;\r\n#define pb push_back\r\n#define all(x) (x).begin(),(x).end()\r\n#define F(i,j,k) for(int i=(j);i<(k);i++)\r\n#define EACH(x,a) for(auto &x:a)\r\n#define endl '\\n'\r\n\r\nconst int M=998244353;\r\n\r\nvoid solve(){\r\n    int n;cin>>n;\r\n    vector<vi> p(n+1);\r\n    F(i,1,n+1){\r\n        int x;\r\n        cin>>x;\r\n        p[x].pb(i);\r\n    }\r\n    auto g= [&](int x,int l,int s){\r\n        int r=x-1-l;\r\n        int q=s?n-r:l+1;\r\n        EACH(i,p[x]){\r\n            int a=min(i,l)+max(0,i-n+r);\r\n            int b=max(0,l-i+1)+min(r,n-i+1);\r\n            \r\n            if(!((q<=i && a==(i-1)/2)||(q>=i && b==(n-i)/2))){\r\n                return 0;\r\n            }\r\n        }\r\n        return 1;\r\n    };\r\n    vi d(n+1),e(n+1);\r\n    d[0]=1;\r\n    F(x,1,n+1){\r\n        fill(all(e),0);\r\n        F(l,0,x){\r\n            if(!d[l]) continue;\r\n            F(s,0,(x<n?2:1)){\r\n                if(!g(x,l,s)) continue;\r\n                \r\n                int &z = e[l+!s];\r\n                z+=d[l];\r\n                \r\n                if(z>=M) z-=M;   \r\n                }\r\n        }\r\n        d.swap(e);\r\n    }\r\n    int a=0;\r\n    EACH(x,d){\r\n        a+=x;\r\n        if(a>=M) a-=M;\r\n    }\r\n    \r\n    cout<<a<<endl;\r\n    \r\n}\r\n\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tcout.tie(0);\r\n\t\r\n\tint t=1;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
