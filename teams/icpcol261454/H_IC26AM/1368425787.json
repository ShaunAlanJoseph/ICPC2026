  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\n#define FOR(i,n) for(int i=0;i<(n);i++)\r\n#define F(i,j,k) for(int i=(j);i<(k);i++)\r\n#define endl '\\n'\r\n\r\nconst ll M=998244353;\r\nconst int N =2e5+5;\r\n\r\nll v[N],h[N];\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    ll x,a=0;\r\n    FOR(i,n){\r\n        cin>>x;\r\n        a = (a+x*(h[i]+h[n-i-1]))%M;\r\n    }\r\n    cout<<a<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tcout.tie(0);\r\n\t\r\n\tv[1]=1;\r\n\tF(i,2,N){\r\n\t    v[i]= M-M/i*v[M%i]%M;\r\n\t}\r\n\tF(i,1,N){\r\n\t    h[i]=(h[i-1]+v[i])%M;\r\n\t}\r\n\t\r\n\tint t=1;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t    \r\n\t}\r\n}\r\n",
