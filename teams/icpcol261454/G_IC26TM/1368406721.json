  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll=long long;\r\nusing vl=vector<ll>;\r\n\r\n#define rall(x) (x).rbegin(),(x).rend()\r\n#define FOR(i,n) for(int i=0; i<(n);i++)\r\n#define F(i,j,k) for(int i=(j);i<(k);i++)\r\n#define EACH(x,a) for(auto &x:a)\r\n\r\n#define endl '\\n'\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int m=3*n;\r\n    vl a(m),p(m+1);\r\n    EACH(x,a) cin>>x;\r\n    sort(rall(a));\r\n    FOR(i,m)\r\n        p[i+1]=p[i]+a[i];\r\n    \r\n    ll z=0;\r\n    F(x,0,n+1){\r\n        int l=0,r=n-x;\r\n        while(l<r){\r\n            int y=(l+r)/2;\r\n            \r\n            if(a[x+2*y]+a[x+2*y+1]>3*a[m-2*x-y-1])\r\n                l=y+1;\r\n            \r\n            else\r\n                r=y;\r\n        }\r\n            \r\n            auto g=[&](int y){\r\n                return 2*p[x]+p[x+2*y]+3*p[m-2*x-y];\r\n            };\r\n            \r\n            z= max(z,g(l));\r\n            if(l)\r\n                z=max(z,g(l-1));\r\n            \r\n        \r\n    }\r\n    \r\n    cout<<z<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tcout.tie(0);\r\n\tint t=1;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n}\r\n",
