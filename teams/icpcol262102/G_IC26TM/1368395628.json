  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in  range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    P=[0]\r\n    for x in a:\r\n        P.append(P[-1]+x)\r\n        best=0\r\n    for p in range(n+1):\r\n        lo,hi=0,n-p\r\n        while(lo<hi):\r\n            m=(lo+hi)//2\r\n            if P[p+2*m+2]+3*P[3*n-2*p-m-1]>P[p+2*m]+3*P[3*n-2*p-m]:\r\n                lo=m+1 \r\n            else:\r\n                hi=m \r\n        best=max(best,2*P[p]+P[p+2*lo]+3*P[3*n-2*p-lo])\r\n    print(best)\r\n    ",
