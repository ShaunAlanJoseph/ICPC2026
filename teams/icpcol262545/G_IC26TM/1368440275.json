  "source_code": "# cook your dish here\r\nimport sys\r\nintput = sys.stdin.readline\r\n    \r\nfor _ in range(int(intput())):\r\n    n=int(intput())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    p=[0]\r\n    for x in a:p.append(p[-1]+x)\r\n    \r\n    def f(x,y):\r\n        return 2*p[x]+p[x+2*y]+3*p[3*n-2*x-y]\r\n        \r\n    ans=0\r\n    for x in range(n+1):\r\n        l,r=0,n-x\r\n        while l<r:\r\n            m=(l+r)//2\r\n            if f(x,m)<=f(x,m+1): l=m+1\r\n            else:r=m\r\n        ans=max(ans,f(x,l))\r\n    print(ans)    \r\n            ",
