  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n; cin>>n;\r\n    vector<int> a(n);\r\n    for(int i=0;i<n;i++){cin>>a[i];}\r\n    \r\n    vector<int> diff;\r\n    for(int i=0;i<n-1;i++){\r\n        diff.push_back(abs(a[i]-a[i+1]));\r\n    }\r\n    diff.push_back(abs(a[0]-a[n-1]));\r\n    \r\n    sort(diff.begin(), diff.end());\r\n  \r\n    cout<<diff[n-2]<<\"\\n\";\r\n    \r\n}\r\n\r\nint main() {\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n}\r\n",
