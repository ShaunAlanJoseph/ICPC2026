  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll =  long long;\r\n\r\nint main() {\r\n\t\r\n\t\r\n\tll t; cin >> t;\r\n\t\r\n\twhile(t--){\r\n\t    \r\n\t    ll n; cin >> n;\r\n\t    \r\n\t    vector<ll> a(n);\r\n\t    vector<ll> v;\r\n\t    \r\n\t    for(ll i = 0; i < n; i++) cin >> a[i];\r\n\t    \r\n\t    for(ll i=0; i<n-1; i++){\r\n\t        v.push_back(abs(a[i] - a[i+1]));\r\n\t    }\r\n\t    v.push_back(abs(a[0] - a[n-1]));\r\n\t    sort(v.begin(), v.end());\r\n\t    cout << v[n-2] << '\\n';\r\n\t}\r\n\r\n}\r\n",
