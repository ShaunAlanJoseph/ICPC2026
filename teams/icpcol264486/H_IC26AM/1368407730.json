  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll mod=998244353;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<ll>a(n+1);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    vector<ll>v(n+1),h(n+1);\r\n\t    if(n>=1)v[1]=1;\r\n\t    for(int i=2;i<=n;i++){\r\n\t        v[i]=mod-(mod/i)*v[mod%i]%mod;\r\n\t        \r\n\t    }\r\n\t    for(int i=1;i<=n;i++){\r\n\t        h[i]=(h[i-1]+v[i])%mod;\r\n\t        \r\n\t    }\r\n\t    ll ans=0;\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll c=(h[i-1]+h[n-i])%mod;\r\n\t        ans=(ans+a[i]%mod*c)%mod;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
