  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll=long long;\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<ll>a(3*n);\r\n\t    for(auto & x:a)cin>>x;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<ll>p(3*n+1);\r\n\t    for(int i=0;i<3*n;++i){\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    ll ans=0;\r\n\t    for(int x=0;x<=n;x++){\r\n\t        int l=0,r=n-x;\r\n\t        auto c=[&](int y){\r\n\t            int pr=x+2*y;\r\n\t            int q=3*n-2*x-y;\r\n\t            return 3LL*p[q]+p[pr]+2LL*p[x];\r\n\t        };\r\n\t        while(l<r){\r\n\t            int m=(l+r)/2;\r\n\t            if(c(m)<=c(m+1))l=m+1;\r\n\t            else r=m;\r\n\t        }\r\n\t        ans=max(ans,c(l));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
