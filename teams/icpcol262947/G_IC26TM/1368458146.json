  "source_code": "t = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = sorted(map(int, input().split()))\r\n    pre = [0]\r\n    \r\n    for val in a:\r\n        pre.append(pre[-1] + val)\r\n    \r\n    def value(x, y):\r\n        l = 2*x + y\r\n        m = 3*n - x -2*y\r\n        r = 3*n - x\r\n        return 3*(pre[m]-pre[l])+4*(pre[r]-pre[m])+6*(pre[3*n]-pre[r])\r\n    \r\n    ans = 0\r\n    for x in range(n+1):\r\n        left, right = 0, n-x\r\n        while left < right :\r\n            mid = (left + right)// 2\r\n            if value(x, mid) < value(x, mid+1): \r\n                left=mid+1\r\n            else:\r\n                right = mid\r\n        yxz = value(x, left)\r\n        ans = max(ans, yxz)\r\n    print(ans)",
