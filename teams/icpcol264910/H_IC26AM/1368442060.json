  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nconst ll mod = 998244353;\r\n\r\nll pw(ll a, ll b) {\r\n    ll r = 1;\r\n    while(b) {\r\n        if(b & 1) {\r\n            r = r*a%mod;\r\n        }\r\n        a = a*a%mod;\r\n        b>>=1;\r\n    }\r\n    return r;\r\n}\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    vector<ll> a(n);\r\n    for(auto &x : a) {\r\n        cin >> x;\r\n    }\r\n    \r\n    vector<ll> h(n+1);\r\n    for(int i = 1; i <= n; i++) {\r\n        h[i] = (h[i-1] + pw(i, mod - 2))% mod;\r\n    }\r\n    \r\n    ll ans = 0;\r\n    for(int i = 0;i < n; i++) {\r\n        ll x = (a[i] % mod + mod) % mod;\r\n        ll c = (h[i] + h[n - 1 - i]) % mod;\r\n        ans = (ans + x * c) % mod;\r\n    }\r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n    \r\n    return 0;\r\n}\r\n",
