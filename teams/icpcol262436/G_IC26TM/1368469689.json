  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int m=3*n;\r\n        vector<ll> s(m);\r\n        for(ll&x:s)cin>>x;\r\n        sort(s.rbegin(),s.rend());\r\n        vector<ll> p(m+1,0);\r\n        for(int i=0;i<m;i++){\r\n            p[i+1]=p[i]+s[i];\r\n        }\r\n        auto f=[&](int a,int b){\r\n            return 2*p[a]+p[a+2*b]+3*p[m-2*a-b];\r\n        };\r\n        auto d=[&](int a,int b){\r\n            return (s[a+2*b]+s[a+2*b+1])-3*s[m-2*a-b-1];\r\n        };\r\n        ll best=0;\r\n        for(int a=0;a<=n;a++){\r\n            int l=0;\r\n            int h=n-a;\r\n            while(l<h){\r\n                int mid=l+(h-l)/2;\r\n                if(d(a,mid)<=0)h=mid;\r\n                else l=mid+1;\r\n            }\r\n            best=max(best,f(a,l));\r\n        }\r\n        cout<<best<<'\\n';\r\n    }\r\n}\r\n",
