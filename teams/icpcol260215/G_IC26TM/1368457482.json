  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        int m =3*n;\r\n     vector<long long> a(m);\r\n    for(auto&x:a) cin>>x;\r\n    \r\n    sort(a.rbegin(),a.rend());\r\n    \r\n    vector<long long>pre(m+1,0);\r\n    for(int i=0;i<m;i++)pre[i+1]=pre[i]+a[i];\r\n    auto value=[&](int i,int b){return 2* pre[i]+pre[i+2*b]+3*pre[m-2*i-b];\r\n    \r\n     };\r\n     long long best=0;\r\n     for(int i=0;i<=n;i++){\r\n         int lo=0;\r\n         int hi=n-i;\r\n         while(lo<hi){\r\n             int b=(lo+hi)/2;\r\n             long long gain=a[i+2*b]+a[i+2*b+1]-3*a[m-2*i-b-1];\r\n             if(gain>0) lo=b+1;\r\n             else hi=b;\r\n         }best=max(best,value(i,lo));\r\n         \r\n     }cout<<best<<endl;\r\n}return 0;\r\n}",
