  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nconst int MAXN=200005; \r\nint main() {\r\n\t// your code goes here\r\n\r\nvector<long long> inv(MAXN),H(MAXN);\r\ninv[1]=1;\r\nfor(int i=2;i<MAXN;i++){\r\n    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n    \r\n    \r\n}\r\n\r\nH[0]=0;\r\nfor(int i=1;i<MAXN;i++){\r\n    H[i]=(H[i-1]+inv[i])%MOD;\r\n    \r\n}int t;\r\ncin>>t;\r\nwhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    long long ans=0;\r\n    for(int j=1;j<=n;j++){\r\n        long long x;\r\n        cin>>x;\r\n        long long times=(H[j-1]+H[n-j])%MOD;\r\n        ans=(ans+x%MOD*times)%MOD;}\r\ncout<<ans<<endl;\r\n}\r\n\r\n}",
