  "source_code": "t = int(input())\r\n\r\n\r\nfor _ in range (t):\r\n    n = int(input())\r\n    \r\n    a = sorted(map(int, input().split()), reverse = True)\r\n    p = [0]\r\n    for x in a:\r\n        p.append(p[-1] + x)\r\n    def f(A, B):\r\n        k = A+2*B\r\n        return 6*p[A] + 4*(p[k] - p[A]) + 3*(p[3*n - 2*A - B] - p[k])\r\n    \r\n    b = n\r\n    ans = 0\r\n    \r\n    \r\n    for A in range (n+1):\r\n        \r\n        b = min(b, n-A)\r\n        while b and f(A, b-1) >= f(A, b):\r\n            b -= 1\r\n        ans = max (ans, f(A, b))\r\n        \r\n    print(ans)",
