  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define endl '\\n'\r\nconst int N = 200005;\r\nconst int mod = 998244353;\r\nint a[N],inv[N],dp[N];\r\nint rec(int n) {\r\n    if(n == 1) return 0;\r\n    if(dp[n] != -1) return dp[n];\r\n    return dp[n] = (rec(n - 1) + inv[n -1]) % mod;\r\n}\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    for(int i = 1 ; i <= n ; i++) cin >> a[i];\r\n    int ans = 0;\r\n    for(int i = 1 ; i <= n ; i++) {\r\n        int D = (rec(i) + rec(n - i + 1)) % mod;\r\n        ans = (ans + (a[i] % mod) * D) % mod;\r\n    }\r\n    cout << ans << '\\n';\r\n}\r\nsigned main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    inv[1] = 1;\r\n    for(int i = 2 ; i < N ; i++) inv[i] = (mod - mod / i) * inv[mod%i] % mod;\r\n    memset(dp,-1,sizeof(dp));\r\n    dp[1] = 0;\r\n    int tt;\r\n    cin >> tt;\r\n    while(tt--) {\r\n        solve();\r\n    }\r\n    return 0;\r\n}",
