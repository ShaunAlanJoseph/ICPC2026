  "source_code": "import sys\r\nit = iter(map (int, sys.stdin.buffer.read().split()))\r\nt = next(it)\r\nans = []\r\nfor i in range(t):\r\n    n = next(it)\r\n    a = sorted((next(it) for i in range(3*n)), reverse = True)\r\n    p = [0]\r\n    for x in a:p.append(p[-1]+x)\r\n    best = 0\r\n    for A in range(n+1):\r\n        lo, hi = 0, n-A\r\n        while(lo<hi):\r\n            B = (lo+hi)//2\r\n            g = a[A+2*B]+a[A+2*B+1] - 3*a[3*n - 2*A - B - 1]\r\n            if(g>=0):\r\n                lo = B+1\r\n            else:\r\n                hi = B\r\n        B = lo\r\n        v = 6*p[A]+4*(p[A+2*B] - p[A])+3*(p[3*n-2*A- B] - p[A+2*B])\r\n        best = max(best, v)\r\n    ans.append(str(best))\r\nprint('\\n'.join(ans))    ",
