  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nconst int M = 998244353, N = 200005;\r\nll inv[N], H[N];\r\n\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;ll ans =0;\r\n    for(int j=1;j<=n;j++){\r\n        ll x;\r\n        cin >> x;\r\n        ans = (ans + x*((H[j-1]+H[n-j]) % M)) % M;\r\n    }\r\n    \r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n\tios::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tinv[1]=1;\r\n\tfor(int i =2;i<N;i++) inv[i] = (M-M/i)*inv[M%i]%M;\r\n\tfor(int i=1;i<N;i++) H[i] = (H[i-1]+inv[i])%M;\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--) solve();\r\n\r\n}\r\n",
