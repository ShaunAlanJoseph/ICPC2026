  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define ll long long\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >>n;int m=3*n; vector<ll> a(m),P(m+1);\r\n    for(auto &x:a)cin >> x;\r\n    sort(a.rbegin(),a.rend());\r\n    for(int i =0;i<m;i++)P[i+1]=P[i]+a[i];\r\n    ll ans =0;\r\n    for(int p=0;p<=n;p++){\r\n        int lo = 0,hi=n-p;\r\n        while(lo<hi){\r\n            int q = (lo+hi)/2;\r\n            if(a[p+2*q] + a[p+2*q+1] > 3*a[m-2*p-q-1]) lo =q+1;\r\n            else hi = q;\r\n        }\r\n        ans = max(ans, 2* P[p]+ P[p+2*lo] + 3*P[m-2*p-lo]);\r\n    }\r\n    cout << ans << endl;\r\n}\r\n\r\nint main() {\r\n\tios::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tint t;\r\n\tcin >>t;\r\n\twhile(t--) solve();\r\n\t\r\n\r\n}\r\n",
