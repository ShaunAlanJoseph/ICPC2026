  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long \r\nconst int M =998244353;\r\nvoid solve(){\r\n    int n;\r\n    cin >>n;\r\n    vector<int> a(n+1);\r\n    vector<vector<int>>g(n+1);\r\n    for(int i =1;i<=n;i++)cin>>a[i],g[a[i]].push_back(i);\r\n    auto ok = [&](int i,int L, int R, int d){\r\n        int h = (i+1)/2;\r\n        int c=n-i/2;\r\n        int m=n-i+1;\r\n        int k=(m+1)/2,e=n-m/2,v=a[i];\r\n        bool p = (v == c && L < h) || (v < c && d==0 && L==h-1);\r\n        bool s = (v == e && R < k) || (v<e && d==1 && R==k-1);\r\n        return p || s;\r\n    };\r\n    vector<ll> dp(n+1,0), nd(n+1,0); dp[0]=1;\r\n    for(int t=1;t<n;t++){\r\n        fill(nd.begin(),nd.begin() + t+1,0);\r\n        for(int L =0;L<t;L++){\r\n            if(!dp[L]) continue;\r\n            int R = t-1-L;\r\n            bool l =1,r=1;\r\n            for(int i : g[t]) {\r\n                if(l&& !ok(i,L,R,0))l=0; if(r&& !ok(i,L,R,1))r=0;\r\n            }\r\n            if(l) nd[L+1] = (nd[L+1]+dp[L])%M;\r\n            if(r) nd[L] = (nd[L]+ dp[L]) % M;\r\n        }\r\n        swap(dp,nd);\r\n    }\r\n    \r\n    ll ans =0;\r\n    for(int L=0;L<n;L++){\r\n        if(!dp[L]) continue;\r\n        bool f =1;\r\n        for(int i: g[n]) if(!ok(i,L,n-1-L,2)){f=0;break;}\r\n        if(f) ans = (ans+dp[L]) %M;\r\n    }\r\n    cout <<ans << endl;\r\n    \r\n    \r\n    \r\n}\r\nint main() {\r\n\tios::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tint t;\r\n\tcin >>t;\r\n\twhile(t--) solve();\r\n\r\n}\r\n",
