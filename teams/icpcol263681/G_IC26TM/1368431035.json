  "source_code": "import sys\r\ninput = sys.stdin.readline\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = sorted(map(int,input().split()), reverse = True)\r\n    p = [0] * (3 * n+1)\r\n    for i,j in enumerate(a):\r\n        p[i+1] = p[i] + j\r\n    res = 0\r\n    for i in range(n + 1):\r\n        m = n - i\r\n        low,high = 0,m\r\n        while low < high:\r\n            j = (low + high) // 2\r\n            d = a[i + 2 * j] + a[i + 2 * j + 1] - 3 * a[3 * n - 2 * i - j - 1]\r\n            if d >= 0:\r\n                low = j + 1\r\n            else:\r\n                high = j \r\n        j = low\r\n        res = max(res,2 * p[i] + p[i+2*j] + 3*p[3 * n - 2 * i - j])\r\n    print(res)",
