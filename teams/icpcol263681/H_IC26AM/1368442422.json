  "source_code": "import sys\r\nmod = 998244353\r\ninput = sys.stdin.readline\r\nt = int(input())\r\ntest = []\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    test.append((n,a))\r\nN = max(n for n,_ in test)\r\ninv = [0] * (N + 1)\r\ninv[1] = 1\r\nfor i in range(2,N + 1):\r\n    inv[i] = mod - (mod // i) * inv[mod % i]% mod\r\nh = [0] * (N + 1)\r\nfor i in range(1 , N + 1):\r\n    h[i] = (h[i-1] + inv[i]) % mod\r\nfor n,a in test:\r\n    res = 0\r\n    for i,x in enumerate(a):\r\n        coe = (h[i] + h[n-1-i]) % mod\r\n        res = (res + x * coe) % mod \r\n    print(res)",
