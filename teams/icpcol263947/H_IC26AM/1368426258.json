  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\nconst int mod = 998244353;\r\n\r\nint bexp(int a, int b){\r\n    int r = 1;\r\n    while(b){\r\n        if(b&1){\r\n            r = (r * a)%mod;\r\n        }\r\n        a = (a*a)%mod;\r\n        b/=2;\r\n    }\r\n    return r;\r\n}\r\n\r\nint modinv(int x){\r\n    return bexp(x, mod - 2);\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    vector<int> harm(2e5 + 5, 0);\r\n    for(int i = 1; i < 2e5 + 5; i++){\r\n        harm[i] = harm[i-1] + modinv(i);\r\n        harm[i]%=mod;\r\n    }\r\n    \r\n    int t; cin>> t;\r\n    while(t--){\r\n        int n; cin >> n;\r\n        vector<int> a(n);for(auto& x : a) cin >> x;\r\n        \r\n        int ans = 0;\r\n        \r\n        for(int i = 0; i < n; i++){\r\n            \r\n            int t1 = harm[i] + harm[n - 1 - i];\r\n            t1%=mod;\r\n            ans += (a[i] * t1)%mod;\r\n            ans %=mod;\r\n        }\r\n        \r\n        cout << ans << '\\n';\r\n    }\r\n}\r\n",
