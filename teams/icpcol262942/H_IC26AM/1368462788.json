  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int MOD = 998244353;\r\nconst int MAX_N = 200005;\r\nlong long inv[MAX_N];\r\nlong long H[MAX_N];\r\n\r\nvoid preComp (){\r\n    inv[1] = 1;\r\n    for(int i = 2 ; i < MAX_N ; i++){\r\n        inv[i] = (MOD - MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    H[0] = 0;\r\n    for(int i = 1 ; i < MAX_N ; i++){\r\n        H[i] = (H[i-1] + inv[i] )%MOD;\r\n    }\r\n    \r\n}\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    std::vector<long long>a(n) ;\r\n    for(int i = 0 ; i < n ;i++){\r\n        cin>>a[i];\r\n    }\r\n    \r\n    if(n == 1) {\r\n        cout<<0<<endl;\r\n        return ;\r\n    }\r\n    \r\n    long long expt = 0;\r\n    for(int p = 1 ; p <= n ; p++){\r\n        long long coff = (H[p-1] + H[n-p])%MOD;\r\n        long long term =( a[p-1]%MOD)*coff%MOD;\r\n        expt = (expt + term )%MOD;\r\n    }\r\n    cout<<expt<<endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tpreComp();\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\t\r\n    \r\n}\r\n",
