  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\n#define ll long long\r\nconst ll MOD = 998244353;\r\nconst ll MAXN = 200005;\r\nll in [MAXN];\r\nll h[MAXN];\r\n\r\nvoid pre() {\r\n\r\n    in [1] = 1;\r\n    for (ll i = 2; i < MAXN; i++) {\r\n        in [i] = (MOD - MOD / i) * in [MOD % i] % MOD;\r\n    }\r\n    h[0] = 0;\r\n\r\n    for (ll i = 1; i < MAXN; i++) {\r\n        h[i] = (h[i - 1] + in [i]) % MOD;\r\n    }\r\n}\r\n\r\n\r\nint main() {\r\n    // your code goes here\r\n    int t;\r\n    cin >> t;\r\n    pre();\r\n    while (t--) {\r\n\r\n        ll n;\r\n\r\n        cin >> n;\r\n\r\n        vector < ll > a(n);\r\n        ll ans = 0;\r\n        for (ll i = 1; i <= n; i++) {\r\n            long long a;\r\n            cin >> a;\r\n            ll temp = (h[i - 1] + h[n - i]) % MOD;\r\n            ans = (ans + a * temp % MOD) % MOD;\r\n\r\n        }\r\n        cout << ans << endl;\r\n        // cout<<in[1]<<endl;\r\n    }\r\n    return 0;\r\n\r\n}",
