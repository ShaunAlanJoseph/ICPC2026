  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n\r\nconst int mod = 998'244'353;\r\n\r\nint modpow(int b, int e) {\r\n    int a = 1;\r\n    while (e) {\r\n        if (e&1) a = a * b % mod;\r\n        b = b * b % mod;\r\n        e >>= 1;\r\n    }\r\n    return a;\r\n}\r\n\r\nint harm[2'00'001];\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n    harm[0] = 0;\r\n    for (int i = 1; i <= 2'00'000; i++) {\r\n        harm[i] = (harm[i-1] + modpow(i, mod-2))%mod;\r\n    }\r\n    int t; cin >> t;\r\n    \r\n    while (t--) {\r\n        int n; cin >> n;\r\n        vector<int> a(n); for (auto& u : a) cin >> u;\r\n        int ans = 0;\r\n        for (int i = 0; i < n; i++) {\r\n            int vi = (harm[i]+harm[n-i-1])%mod;\r\n            ans = (ans + (vi*a[i]%mod)) % mod;\r\n        }\r\n        cout << ans << '\\n';\r\n    }\r\n}\r\n",
