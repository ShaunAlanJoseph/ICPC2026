  "source_code": "# cook your dish here\r\ndef solve():\r\n    n=int(input())\r\n    arr=list(map(int,input().split()))\r\n    \r\n    arr.sort(reverse=True)\r\n    prefix=[0]\r\n    \r\n    for x in arr:\r\n        prefix.append(prefix[-1]+x)\r\n        \r\n    ans=0\r\n    \r\n    for first in range(n+1):\r\n        \r\n        limit=n-first\r\n        \r\n        \r\n        \r\n        low,high=0,limit\r\n        \r\n        while low<high:\r\n            mid=(low+high)//2\r\n            p=first+2*mid\r\n            q=3*n-2*first-mid\r\n            \r\n            change=arr[p]+arr[p+1]-3*arr[q-1]\r\n            \r\n            if change>=0:\r\n                low=mid+1\r\n\r\n            else:\r\n                high=mid \r\n                \r\n        second=low\r\n        \r\n        p=first+2*second\r\n        q=3*n-2*first-second\r\n        \r\n        current=(2*prefix[first]+prefix[p]+3*prefix[q])\r\n        \r\n        ans=max(ans,current)\r\n    print(ans)\r\n\r\n    \r\n    \r\nt=int(input())\r\n\r\nfor _ in range(t):\r\n    solve()",
