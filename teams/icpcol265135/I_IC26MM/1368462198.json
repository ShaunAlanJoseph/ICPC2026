  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    int M= (119<< 23 ) + 1;\r\n    int t; scanf ( \"%d\", &t);\r\n    while (t--){\r\n        int n; scanf(\"%d\", &n);\r\n        vector<vector< int>> idx(n+2);\r\n        for(int i =1; i<=n;i++){ int x; scanf(\"%d\", &x); idx[x].push_back(i); }\r\n        auto ok= [& ] (int m, int L, int C, int j) {\r\n            for (int i :idx [m]){\r\n                bool g= false;\r\n                if( i>=j && L+max(0,i-n+C)== (i+1)/2-1) g= true;\r\n                if(!g && i<=j && C+ max(0, L-i+1)== (n-i+2)/2-1) g=true;\r\n                if(!g) return false;\r\n            }\r\n            return true;\r\n        };\r\n        vector <int> dp(n+2, 0), nd(n+2,0);\r\n        dp[0]=1 ; long long ans=0;\r\n        for(int m=1; m<=n; m++){\r\n            fill (nd.begin(), nd.end(),0);\r\n            for(int L=0; L<m; L++){\r\n                if(!dp[L]) continue;\r\n                int C= m-1-L;\r\n                if(m==n) { if(ok (m,L,C, L+1)) ans= (ans+dp[L]) % M;}\r\n                else{\r\n                    if(ok(m, L,C,L+1)) nd[L+1]= (nd[L+1]+ dp[L]) % M;\r\n                    if(ok(m,L,C, n-C))  nd[L] = (nd[L] +dp[L]) %M;\r\n                }\r\n            }\r\n            swap(dp, nd);\r\n        }\r\n        printf(\"%lld\\n\", ans);\r\n    }\r\n}\r\n",
