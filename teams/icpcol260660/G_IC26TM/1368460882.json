  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    long long n;\r\n    cin>>n;\r\n    long long n3=3*n;\r\n    vector<long long> a(n3);\r\n    for(int i=0;i<n3;i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.rbegin(),a.rend());\r\n    vector<long long> p(n3+1);\r\n    for(long long i=0;i<n3;i++){\r\n        p[i+1]=p[i]+a[i];\r\n        \r\n    }\r\n    long long ans=0;\r\n    for(long long m=n;m<=2*n;m++){\r\n        long long l=0;\r\n        long long r=m-n;\r\n        while(l<r){\r\n            long long mid=l+(r-l)/2;\r\n            long long val1=p[m-2*mid]+3LL*p[m+mid];\r\n            long long val2=p[m-2*(mid+1)]+3LL*p[m+mid+1];\r\n            if(val2<val1){\r\n                r=mid;\r\n            }\r\n            else{\r\n                l=mid+1;\r\n            }\r\n            \r\n            \r\n        }\r\n        long long yxz=2LL*p[2*n-m]+p[m-2*l]+3LL*p[m+l];\r\n        if(yxz>ans){\r\n            ans=yxz;\r\n        }\r\n        \r\n    }\r\n        cout<<ans<<endl;\r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\t\r\n\r\n}\r\n",
