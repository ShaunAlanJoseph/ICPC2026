  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst int p=998244353;\r\nlong long inv[200005],h[200005];\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    long long ans=0;\r\n    for(int i=1;i<=n;i++){\r\n        long long a;\r\n        cin>>a;\r\n        long long c=(h[i-1]+h[n-i])%p;\r\n        ans=(ans+a*c)%p;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tinv[1]=1;\r\n\th[0]=0;\r\n\th[1]=1;\r\n\tfor(long long i=2;i<=200005;i++){\r\n\t    inv[i]=p-(p/i)*inv[p%i]%p;\r\n\t    h[i]=(h[i-1]+inv[i])%p;\r\n\t}\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    \r\n\t    solve();\r\n\t}\r\n\t\r\n\r\n}\r\n",
