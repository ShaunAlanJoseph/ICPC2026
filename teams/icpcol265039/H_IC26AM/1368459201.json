  "source_code": "mod=998244353\r\n\r\nt=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    r=0;\r\n    h=[0]*(n+1)\r\n    for j in range(1,n+1):\r\n        h[j]=(h[j-1]+pow(j,mod-2,mod))%mod\r\n    for j in range(n):\r\n        r=(r+a[j]*(h[j]+h[n-1-j]))%mod\r\n    print(r)",
