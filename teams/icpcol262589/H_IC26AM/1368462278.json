  "source_code": "#include <bits/stdc++.h>\r\n#define ll long long\r\n#define MOD 998244353\r\nusing namespace std;\r\n\r\nll modPow(ll a,ll b,ll mod){\r\n    ll res = 1;\r\n    while(b > 0){\r\n        if(b&1) res = (res*a)%mod;\r\n        a = (a*a)%mod;\r\n        b >>= 1;\r\n    }\r\n    return res;\r\n}\r\nll modInverse(ll a, ll mod){\r\n    return modPow(a,mod-2,mod);\r\n}\r\nconst int M = 2e5+1;\r\nvector<int> har(M);\r\nvoid pre(){\r\n    har[1] = 1;\r\n    for (int i = 2; i < M; i++) {\r\n        har[i] = (har[i-1] + modInverse(i,MOD))%MOD;\r\n    }\r\n}\r\n\r\n\r\nint main() {\r\n\tpre();\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<ll> v(n+1);\r\n\t    for (int i = 1; i <= n; i++) {\r\n\t        cin>>v[i];\r\n\t    }\r\n\t    ll e = har[n-1];\r\n\t    ll ans = (e*v[1])%MOD;\r\n\t    for (int i = 2; i <= n; i++) {\r\n\t        e = e + modInverse(i-1,MOD);\r\n\t        e %= MOD;\r\n\t        e = (e-modInverse(n-i+1,MOD)+MOD)%MOD;\r\n\t        ans += (e*v[i])%MOD;\r\n\t        ans %= MOD;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
