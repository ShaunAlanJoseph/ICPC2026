  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint T; cin >> T;\r\n\twhile (T--) {\r\n\t    int n; cin >> n;\r\n\t    vector<int> a(n);\r\n\t    for (auto &x : a)\r\n\t        cin >> x;\r\n\t    multiset<int> ms;\r\n\t    for (int i = 1; i < n; i++) {\r\n\t        ms.insert(abs(a[i] - a[i - 1]));\r\n\t    }\r\n\t    ms.insert(abs(a[0] - a[n - 1]));\r\n\t    auto it = ms.end();\r\n\t    it--;\r\n\t    it--;\r\n\t    cout << *it << \"\\n\";\r\n\t}\r\n}\r\n",
