  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\tconst long long cat=998244353;\r\n\tlong long dog[2000005];\r\n\tlong long meow(long long mouse, long long loin){\r\n\t    long long tiger=1;\r\n\t    while(loin){\r\n\t        if(loin&1) tiger=tiger*mouse%cat;\r\n\t        mouse=mouse*mouse%cat;\r\n\t        loin>>=1;\r\n\t    }\r\n\t    return tiger;\r\n\t}\r\n\tint main(){\r\n\t    ios::sync_with_stdio(false);\r\n\t    cin.tie(nullptr);\r\n\t    for(int i=1;i<=200000;i++)\r\n\t        dog[i]=(dog[i-1]+meow(i,cat-2))%cat;\r\n\t        int monkey; cin>>monkey;\r\n\t        while(monkey--){\r\n\t            int zebra; cin>> zebra;\r\n\t            long long giraffe=0,snail;\r\n\t            for(int i=1;i<=zebra;i++){\r\n\t                cin>>snail;\r\n\t                giraffe=(giraffe+snail*(dog[i-1] + dog[zebra-i])%cat)%cat;\r\n\t            }\r\n\t            cout<<giraffe<<\"\\n\";\r\n\t        }\r\n\t}\r\n\r\n\r\n",
