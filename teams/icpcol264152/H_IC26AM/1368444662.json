  "source_code": "#include <stdio.h>\r\n#include<stdlib.h>\r\n\r\n#define MOD 998244353LL\r\n#define MAXN 200005\r\nlong long inv[MAXN];\r\nlong long H[MAXN];\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tscanf(\"%d\",&t);\r\n\tinv[1]=1;\r\n\tfor(int i=2;i<MAXN;i++)\r\n\t{\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\tH[0]=0;\r\n\tfor(int i=1;i<MAXN;i++)\r\n\t{\r\n\t    H[i]=(H[i-1]+inv[i])%MOD;\r\n\t    \r\n\t}\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    scanf(\"%d\",&n);\r\n\t    long long ans=0;\r\n\t    for(int i=1;i<=n;i++)\r\n\t    {\r\n\t        long long a;\r\n\t        scanf(\"%lld\",&a);\r\n\t        long long coefficient=(H[i-1]+H[n-i])%MOD;\r\n\t        ans=(ans+a*coefficient)%MOD;\r\n\t    }\r\n\t    printf(\"%lld\\n\",ans);\r\n\t}\r\n\treturn 0;\r\n}\r\n\r\n",
