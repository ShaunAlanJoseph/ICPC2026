  "source_code": "# cook your dish here\r\nimport sys\r\ninput=sys.stdin.readline\r\n\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    pref=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        pref[i+1]=pref[i]+a[i]\r\n    def value(k,l):\r\n        return(\r\n            6*pref[k]\r\n            +4*(pref[k+2*l]-pref[k])\r\n            +3*(pref[3*n-2*k-l]-pref[k+2*l])\r\n            )\r\n    l=n\r\n    ans=0\r\n    for k in range(n+1):\r\n        if l>n-k:\r\n            l=n-k\r\n        while l>0 and value(k,l-1)>=value(k,l):\r\n            l-=1\r\n        ans=max(ans,value(k,l))\r\n    print(ans)\r\n        \r\n",
