  "source_code": "# cook your dish here\r\nmod=998244353\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    inv=[0]*n\r\n    h=[0]*n\r\n    if n>1:\r\n        inv[1]=1\r\n        for i in range(2,n):\r\n            inv[i]=mod-(mod//i)*inv[mod%i]%mod\r\n        for i in range(1,n):\r\n            h[i]=(h[i-1]+inv[i])%mod\r\n    ans=0\r\n    for i in range(n):\r\n        ans+=a[i]*(h[i]+h[n-1-i])\r\n        ans%=mod\r\n    print(ans)",
