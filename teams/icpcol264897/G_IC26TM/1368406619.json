  "source_code": "# cook your dish here\r\nt=int(input())\r\nfor _ in range(t):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    N=3*n\r\n    p=[0]\r\n    for x in a:\r\n        p.append(p[-1]+x)\r\n    S=p[N]\r\n    ans=0\r\n    for A in range(n+1):\r\n        lo,hi=0,n-A\r\n        while lo<hi:\r\n            B=(lo+hi)//2\r\n            d=a[A+2*B]+a[A+2*B+1]-3*a[N-2*A-B-1]\r\n            if d>=0:\r\n                lo=B+1\r\n            else:\r\n                hi=B\r\n        for B in (lo,lo-1):\r\n            if 0<=B<=n-A:\r\n                bonus=(2*p[A]+p[A+2*B]+3*p[N-2*A-B]-3*S)\r\n                ans=max(ans,bonus)\r\n    print(3*S+ans)\r\n                    ",
