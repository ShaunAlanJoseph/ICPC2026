  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nll hel(ll x,ll y,vector<ll> &a,ll m){\r\n    return 2ll*a[x]+a[x+2ll*y]+3ll*a[m-2ll*x-y];\r\n}\r\nvoid solve(){\r\n    int n;cin>>n;\r\n    int m=3ll*n;\r\n    vector<ll> v(m),a(m+1,0);\r\n    for(int i=0;i<m;i++){\r\n        int l;cin>>l;v[i]=l;\r\n    }\r\n    sort(v.rbegin(),v.rend());\r\n    for(int i=0;i<m;i++){\r\n        a[i+1]=a[i]+v[i];\r\n    }\r\n    \r\n    ll ans=0;\r\n    for(ll i=0;i<=n;i++){\r\n        ll lo=0,hi=n-i;\r\n        while(lo<hi){\r\n            ll mid=(lo+hi)/2ll;\r\n            ll c=hel(i,mid+1,a,m);\r\n            ll c1=hel(i,mid,a,m);\r\n            if(c>c1)lo=mid+1;\r\n            else hi=mid;\r\n        }\r\n        ll c2=hel(i,lo,a,m);\r\n        ans=max(ans,c2);\r\n        \r\n    }\r\n    cout<<ans<<\"\\n\";\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    int t;cin>>t;\r\n    while(t--){solve();}\r\n}\r\n",
