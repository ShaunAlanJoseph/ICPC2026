  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n ll mod=998244353; const ll n=200005;\r\nll v[n],h[n];\r\nvoid solve(){\r\n    int m;cin>>m;\r\n    ll ans=0;\r\n    for(ll i=1;i<=m;i++){\r\n        ll l;cin>>l;\r\n        ans=(ans+l%mod*((h[i-1]+h[m-i])%mod))%mod;\r\n    }\r\n    cout<<ans<<\"\\n\";\r\n}\r\nint main() {\r\n\t// your code goes here\r\n    v[1]=1;\r\n    for(int i=2;i<n;i++){\r\n        v[i]=(mod-(mod/i)*v[mod%i]%mod)%mod;\r\n    \r\n    }\r\n    h[0]=0;\r\n    for(int i=1;i<n;i++){\r\n        h[i]=(h[i-1]+v[i])%mod;\r\n    }\r\n    int t;cin>>t;\r\n    while(t--){solve();}\r\n    return 0;\r\n}\r\n",
