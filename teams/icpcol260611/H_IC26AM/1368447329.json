  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long \r\n#define mod 998244353\r\n\r\nint bpow(int x, int y) {\r\n    int z=1;\r\n    while(y>0) {\r\n        if(y%2!=0) {\r\n            z=(z*x)%mod;\r\n        }\r\n        x=(x*x)%mod;\r\n        y/=2;\r\n    }\r\n    return z;\r\n}\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tint tt;\r\n\tcin>>tt;\r\n\twhile(tt--) {\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<int>a(n+1),b(n+1),c(n+1);\r\n\t    for(int i=1;i<=n;i++) {\r\n\t        int k;\r\n\t        cin>>k;\r\n\t        a[i]=b[i]=c[i]=k;\r\n\t    }\r\n\t    vector<int>h(n+2,0);\r\n\t    for(int i=1;i<=n;i++) {\r\n\t        int w=bpow(i,mod-2);\r\n\t        h[i]=(h[i-1]+w)%mod;\r\n\t    }\r\n\t    int s=0;\r\n\t    for(int i=1;i<=n;i++) {\r\n\t        int x=(h[i-1]+h[n-i])%mod;\r\n\t        int v=(a[i]+b[i]+c[i])%mod;\r\n\t        v=(v*bpow(3,mod-2))%mod;\r\n\t        s=(s+(v*x)%mod)%mod;\r\n\t    }\r\n\t    cout<<s<<endl;\r\n\t    \r\n\t}\r\n\r\n}\r\n",
