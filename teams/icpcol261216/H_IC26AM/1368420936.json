  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long; \r\nconst ll MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tint t; \r\n\tcin>>t; \r\n\tvector<int>ns(t); \r\n\tvector<vector<ll>>arr(t); \r\n\tint mx = 0; \r\n\tfor(int tc = 0;tc < t;tc++){\r\n\t    cin>>ns[tc]; \r\n\t    mx = max(mx,ns[tc]); \r\n\t    arr[tc].resize(ns[tc]); \r\n\t    for(auto &x : arr[tc]){\r\n\t        cin>>x; \r\n\t    } }\r\n\t    vector<ll>inv(mx + 1); \r\n\t    if(mx >= 1)inv[1] = 1; \r\n\t    for(int i = 2;i <= mx;i++){\r\n\t        inv[i] = MOD - (MOD/i) * inv[MOD % i] % MOD;\r\n\t    }\r\n\t    vector<ll>H(mx + 1,0); \r\n\t    for(int i = 1;i <= mx;i++){\r\n\t        H[i] = H[i - 1] + inv[i] % MOD; \r\n\t    }\r\n\t    for(int tc = 0;tc < t;tc++){\r\n\t        int n = ns[tc]; \r\n\t        ll ans = 0; \r\n\t        for(int i = 1;i <=n;i++){\r\n\t            ll coefficient = (H[i - 1] + H[n - i])%MOD; \r\n\t            ans = (ans+ arr[tc][i - 1] * coefficient)%MOD; \r\n\t        }\r\n\t        cout<<ans<<endl;\r\n\t    }\r\n\t\r\n}\r\n",
