  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t; \r\n\tcin>>t; \r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n; \r\n\t    vector<long long>arr(3*n); \r\n\t    for(auto &x : arr)cin>>x; \r\n\t    sort(arr.rbegin(),arr.rend()); \r\n\t    vector<long long>pre(3 * n + 1); \r\n\t    for(int i = 0;i < 3 * n;i++){\r\n\t        pre[i + 1] = pre[i] + arr[i];}\r\n\t   long long ans = 0;\r\n\t   for(int A = 0;A <= n;A++){\r\n\t       int lo = 0,hi = n - A; \r\n\t       while(lo < hi){\r\n\t           int B = (lo + hi)/2; \r\n\t           int q = A + 2 * B; \r\n\t           int m = 3 * n - 2 * A - B; \r\n\t           long long diff = arr[q] + arr[q + 1] - 3LL * arr[m - 1];\r\n\t           if(diff >= 0)lo = B + 1; \r\n\t           else hi = B;\r\n\t       }\r\n\t       for(int B = max(0,lo - 1);B <= min(n - A,lo + 1);B++){\r\n\t           int q = A + 2 * B; \r\n\t           int m = 3 * n - 2 * A - B; \r\n\t           long long val = 2LL * pre[A] + pre[q] + 3LL * pre[m]; \r\n\t           ans = max(ans , val);\r\n\t       }\r\n\t   }   \r\n\t   cout<<ans<<endl;\r\n\t}\r\n}\r\n",
