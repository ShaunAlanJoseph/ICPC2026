  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nll pre[600003];\r\nint n;\r\nll func(int x,int y){\r\n    return 2LL*pre[x]+pre[x+2*y] + 3LL*pre[3*n-2*x-y];\r\n}\r\n\r\n\r\nvoid solve(){\r\n    cin>>n;\r\n    vector<ll> a(3*n);\r\n    for(int i=0;i<3*n;i++) cin>>a[i];\r\n    sort(a.rbegin(),a.rend());\r\n    pre[0] = 0;\r\n    for(int i=0;i<3*n;i++){\r\n        pre[i+1] = pre[i] + a[i];\r\n    }\r\n    ll ans = 0;\r\n    for(int x=0;x<=n;x++){\r\n        int l = 0;\r\n        int r = n-x;\r\n        while(r-l>2){\r\n            int m1 = l + (r-l)/2;\r\n            int m2 = r - (r-l)/3;\r\n            if(func(x,m1)<func(x,m2)) l=m1;\r\n            else r = m2;\r\n        }\r\n        for(int y = l;y<=r;y++){\r\n            ans=max(ans,func(x,y));\r\n        }\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    int t;\r\n    cin>>t;\r\n    while(t--) solve();\r\n    return 0;\r\n}\r\n",
