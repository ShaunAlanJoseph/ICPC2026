  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nint main() {\r\n    int t;\r\n    cin>>t;\r\n   for(int i=0;i<t;i++){\r\n        int n;\r\n        cin>>n;\r\n        int m = 3*n;\r\n        vector<ll>arr(m);\r\n        for(auto &i :arr){\r\n            cin>>i;\r\n        }\r\n        sort(arr.rbegin(),arr.rend());\r\n        vector<ll>pref(m+1,0);\r\n        for(int i=0;i<m;i++){\r\n            pref[i+1]=pref[i]+arr[i];\r\n        }\r\n        ll result=0;\r\n        for(int i=0;i<=n;i++){\r\n         int low=0;\r\n         int hight=n-i;\r\n         while(low<hight){\r\n             int mid=(low+hight+1)/2;\r\n             int d=mid-1;\r\n             ll det=arr[i+2*d]+arr[i+2*d+1]-3LL*arr[3*n-2*i-d-1];\r\n             if(det>=0){\r\n                 low=mid;\r\n             }\r\n             else{\r\n                 hight=mid-1;\r\n             }\r\n         }\r\n         int y=low;\r\n         ll curr=2LL*pref[i]+pref[i+2*y]+3LL*pref[3*n-2*i-y];\r\n         result=max(result,curr);\r\n         }\r\n         cout<<result<<'\\n';\r\n    }\r\n    return 0;\r\n}\r\n",
