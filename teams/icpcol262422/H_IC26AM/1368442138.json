  "source_code": "import sys\r\nfrom array import array \r\n\r\nMOD = 998244353\r\nMAXN = 2000000\r\n\r\ninv = array('I', [0]) * (MAXN + 1)\r\ninv[1] = 1\r\n\r\nfor i in range(2, MAXN + 1):\r\n    inv[i] = MOD - (MOD // i ) * inv[MOD % i] % MOD\r\n    \r\nH = array('I' , [0]) * (MAXN + 1)\r\n\r\nfor i in range(1,MAXN + 1):\r\n    H[i] = (H[i - 1] + inv[i]) % MOD\r\ndef solve():\r\n    input = sys.stdin.buffer.readline\r\n    t = int(input())\r\n    \r\n    out = []\r\n    \r\n    for _ in range(t):\r\n        n = int(input())\r\n        a = list(map(int, input().split()))\r\n        \r\n        ans = 0\r\n        for i in range(n):\r\n            coefficient = H[i] + H[n - 1 - i]\r\n            if coefficient >= MOD :\r\n                coefficient -= MOD\r\n            ans = (ans + a[i] * coefficient) % MOD\r\n        out.append(str(ans))\r\n        \r\n    sys.stdout.write(\"\\n\".join(out))\r\n    \r\nsolve()",
