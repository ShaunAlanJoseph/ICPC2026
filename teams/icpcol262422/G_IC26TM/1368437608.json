  "source_code": "# cook your dish here\r\nimport sys \r\n\r\ndata = list(map(int, sys.stdin.buffer.read().split()))\r\nt = data[0]\r\nidx = 1\r\nout = []\r\n\r\nfor _ in range(t):\r\n    n = data[idx]\r\n    idx += 1\r\n    \r\n    m = 3 * n\r\n    a = sorted(data[idx:idx + m],reverse = True)\r\n    idx += m \r\n    s = [0] * (m + 1)\r\n    for i in range(m):\r\n        s[i + 1] = s[i] + a[i]\r\n    best =  0\r\n    for x in range(n + 1):\r\n        l , h = 0, n -x\r\n        while l < h :\r\n            mid = (l + h) // 2\r\n            \r\n            j = x + 2 * mid\r\n            k = 3 * n - 2 * x - mid - 1\r\n             \r\n            if a[j] + a[j + 1] - 3 * a[k] > 0 :\r\n                l = mid + 1\r\n            else :\r\n                h = mid\r\n        y = l\r\n        value = ( 2 * s[x] + s[x + 2 * y] + 3 * s[3 * n - 2 * x - y])\r\n        best = max(best,value)\r\n    out.append(str(best))\r\n    \r\nsys.stdout.write(\"\\n\".join(out))\r\n            ",
