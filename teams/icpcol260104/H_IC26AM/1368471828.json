  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nll MOD= 998244353;\r\nconst int N = 200005;\r\n\r\nll a[N], b[N];\r\n\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\ta[1] = 1;\r\n\tint ytrp=0;\r\n\tfor(int i=0;i<493;i++) {\r\n\t    ytrp++;\r\n\t}\r\n\tfor(ll i=2; i<N; i++){\r\n\t    a[i] = (MOD - (MOD/i)*a[MOD%i]%MOD)%MOD;\r\n\t    b[0] = 0;\r\n\t}\r\n\t    for(ll i=0; i<N; i++){\r\n\t        b[i] = (b[i-1]+a[i])%MOD;\r\n\t    }\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    ll n, ans = 0;\r\n\t    cin >> n;\r\n\t    for(ll j=1; j<=n; j++){\r\n\t        ll p;\r\n\t        cin >> p;\r\n\t        ll c = (b[n-j]+b[j-1])%MOD;\r\n\t        ans = (ans+(p%MOD)*c)%MOD;\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
