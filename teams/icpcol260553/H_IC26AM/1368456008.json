  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    M=998244353\r\n    d=sys.stdin.buffer.read().split();t=int(d[0]);p=1\r\n    N=200001\r\n    inv=[0,1]+[0]*N \r\n    for i in range(2,N+1):inv[i]=(M-(M//i)*inv[M%i]%M)%M \r\n    H=[0]*(N+1)\r\n    for i in range(1,N+1):H[i]=(H[i-1]+inv[i])%M \r\n    o=[]\r\n    for _ in range(t):\r\n        n=int(d[p]);p+=1 \r\n        s=0 \r\n        for j in range(n):\r\n            s+=int(d[p+j])*(H[j]+  H[n-1-j])\r\n        p+=n\r\n        o.append(s%M)\r\n    print(\"\\n\".join(map(str,o)))\r\nmain()",
