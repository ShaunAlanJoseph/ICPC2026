  "source_code": "# cook your dish here\r\nimport sys\r\nimport numpy as np \r\ndef main():\r\n    d=np.array(sys.stdin.buffer.read().split(),dtype=np.int64);t=int(d[0]);p=1;o=[]\r\n    for _ in range(t):\r\n        n=int(d[p]);N=3*n \r\n        s=np.sort(d[p+1:p+1+N])[::-1];p+=N+1 \r\n        P=[0]*(N+1)\r\n        if n<=10:\r\n            s=s.tolist()\r\n            for i in range(N):P[i+1]=P[i]+s[i]\r\n            o.append(max(2*P[a]+P[a+2*b]+3*P[N-2*a-b]for a in range(n+1) for b in range(n-a+1)))\r\n            continue\r\n        P=np.zeros(N+1,dtype=np.int64);np.cumsum(s,out=P[1:])\r\n        a=np.arange(n+1);lo=a*0;hi=n-a\r\n        for _ in range(n.bit_length()+1):\r\n            m=(lo+hi)>>1;m1=np.minimum(m+1,hi)\r\n            g=P[a+2*m1]+3*P[N-2*a-m1]>P[a+2*m]+3*P[N-2*a-m]\r\n            lo=np.where(g,m+1,lo);hi=np.where(g,hi,m)\r\n        o.append(int((2*P[a]+P[a+2*lo]+3*P[N-2*a-lo]).max()))\r\n    print(\"\\n\".join(map(str,o)))\r\nmain()",
