  "source_code": "# cook your dish here\r\nimport sys \r\nI= sys.stdin.read().split()\r\nif I:\r\n    m,x= 998244353,200005\r\n    v,h=[0]*x,[0]*x \r\n    v[1]=1\r\n    for i in range(2,x):\r\n        v[i]=(m-(m//i)* v[m%i]%m)%m \r\n    for i in range(1,x):\r\n        h[i]= h[i-1]+v[i]%m\r\n        \r\n    o,j=[],1 \r\n    for _ in range(int(I[0])):\r\n        n= int(I[j])\r\n        s=0 \r\n        for k in range(n):\r\n            s= (s+int(I[j+1+k])*(h[k]+h[n-1-k]))%m \r\n        o.append(str(s))\r\n        j+= n+1 \r\n    print('\\n'.join(o))",
