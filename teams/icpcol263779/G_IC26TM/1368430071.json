  "source_code": "# cook your dish here\r\nfor _ in range(int(input())):\r\n    n = int(input())\r\n    a = sorted( map(int,input().split()),reverse=True)\r\n    p=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        p[i+1]=p[i]+a[i]\r\n         \r\n    ans = 0\r\n    for k in range(n+1):\r\n        lo, hi = 0, n-k\r\n        while lo<hi:\r\n            l = (lo+hi+1)// 2\r\n            if a[k+2*l-2]+a[k+2*l-1]>=3* a[3*n-2 *k-l]:\r\n                lo=l \r\n            else:\r\n                hi = l-1\r\n        ans = max(ans,2*p[k]+p[k+2*lo]+3*p[3*n-2*k-lo])\r\n    \r\n    print(ans)\r\n",
