  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define endl '\\n'\r\nvoid solve(){\r\n    int n,m;\r\n    cin>>n>>m;\r\n    vector<int> a(m);\r\n    for(int i = 0 ; i < m ; i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.begin(),a.end());\r\n    int l = a.front() - 1;\r\n    int r = n - a.back();\r\n    int mx = 0;\r\n    for(int i = 1 ; i < m ; i++){\r\n        mx = max(mx,a[i] - a[i-1] - 1); \r\n    }\r\n    int x = 2*l + max(r,mx - l);\r\n    int y = 2*r + max(l,mx - r);\r\n    int ans = min(x,y);\r\n    cout<<ans<<endl;\r\n    \r\n}\r\nsigned main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
