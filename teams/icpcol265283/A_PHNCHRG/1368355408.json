  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nvoid solve(){\r\n    int x,a,b;\r\n    cin>>x>>a>>b;\r\n    if(x<80)\r\n    {\r\n        int ans1=(80-x)*a;\r\n        int ans2=20*b;\r\n        cout<<ans1+ans2<<endl;\r\n    }\r\n    else if(x>=80)\r\n    {\r\n        cout<<(100-x)*b<<endl;\r\n    }\r\n}\r\nsigned main(){\r\n    ios_base::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    cout.tie(0);\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n",
