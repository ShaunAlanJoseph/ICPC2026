  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define endl '\\n'\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<int> a(3*n+1),s(3*n+1);\r\n    for(int i = 1 ; i <= 3*n ; i++){\r\n        cin>>a[i];\r\n    }\r\n    sort(a.begin()+1,a.end(),greater<int>());\r\n    for(int i = 1 ; i <= 3*n ; i++){\r\n        s[i] = s[i-1] + a[i];\r\n    }\r\n    int ans = 0;\r\n    for(int p = 0 ; p <= n ; p++){\r\n        int l = 1;\r\n        int r = n-p;\r\n        int q = 0;\r\n        while(l <= r){\r\n            int m = (l + r)/2;\r\n            int b = p + 2*m;\r\n            int c = 3*n - 2*p - m;\r\n            if(a[b-1] + a[b] > 3*a[c+1]){\r\n                q = m;\r\n                l = m+1;\r\n            }\r\n            else{\r\n                r = m-1 ;\r\n            }\r\n        }\r\n        int b = p + 2*q;\r\n        int c = 3*n - 2*p - q;\r\n        int yxz = 6*s[p] + 4*(s[b] - s[p]) + 3*(s[c] - s[b]);\r\n        ans = max(ans,yxz);\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nsigned main() {\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tcout.tie(0);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
