  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n#define endl '\\n'\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<int> a(n);\r\n    for(int i = 0 ; i < n ; i++){\r\n        cin>>a[i];\r\n    }\r\n    \r\n    vector<int> arr;\r\n    for(int i=0;i<n-1;i++)\r\n    {\r\n        arr.push_back(abs(a[i]-a[i+1]));\r\n    }\r\n    \r\n    sort(arr.begin(),arr.end());\r\n    if(arr.size()==1)\r\n    {\r\n        cout<<arr[arr.size()-1]<<endl;\r\n    }\r\n    else\r\n    {\r\n        cout<<arr[arr.size()-2]<<endl;\r\n    }\r\n}\r\nsigned main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
