  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define endl '\\n'\r\nvoid solve(){\r\n    int n,k;\r\n    string s;\r\n    cin>>n>>k>>s;\r\n    int mx = min(k+1,2*n);\r\n    int inf = 1e9;\r\n    vector<int> dp(mx + 1,inf),nd(mx+1);\r\n    dp[0] = 0;\r\n    for(char c : s){\r\n        fill(nd.begin(),nd.end(),inf);\r\n        int w = ((c == 'G') ? 1 : 2);\r\n        for(int a = 0 ; a <= mx ; a++){\r\n            int b = dp[a];\r\n            if(b == inf) continue;\r\n            int x = ((a == 0 && c == 'I') ? 0 : (a+w));\r\n            if(x <= mx){\r\n                nd[x] = min(nd[x],b);\r\n            }\r\n            if(b == 0 && c == 'I'){\r\n                nd[a] = 0;\r\n            }\r\n            else if(b+w <= mx){\r\n                nd[a] = min(nd[a],b+w);\r\n            }\r\n        }\r\n        swap(nd,dp);\r\n    }\r\n    bool ans = ( (*min_element(dp.begin(),dp.end())) < inf);\r\n    if(ans){\r\n        cout<<\"YES\"<<endl;\r\n    }\r\n    else{\r\n        cout<<\"NO\"<<endl;\r\n    }\r\n}\r\nsigned main() {\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tcout.tie(0);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
