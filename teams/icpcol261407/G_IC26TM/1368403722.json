  "source_code": "t = int(input())\r\nres = []\r\nfor _ in range(t):\r\n    n = int(input())\r\n    arr = list(map(int, input().split()))\r\n    arr.sort(reverse=True)\r\n    m = 3 * n \r\n    P = [0] * (m + 1)\r\n    for i in range(m):\r\n        P[i + 1] = P[i] + arr[i]\r\n    best = 0\r\n    for a in range(n + 1):\r\n        base = 2 * P[a]\r\n        k = 3 * n - 2 * a \r\n        lo, hi = 0, n - a \r\n        while lo < hi:\r\n            mid = (lo + hi) // 2\r\n            g1 = P[a + 2 * mid] + 3 * P[k - mid]\r\n            g2 = P[a + 2 * mid + 2] + 3 * P[k - mid - 1]\r\n            if g2 > g1:\r\n                lo = mid + 1 \r\n            else:\r\n                hi = mid\r\n        val = base + P[a + 2 * lo] + 3 * P[k - lo]\r\n        if val > best:\r\n            best = val \r\n    res.append(str(best))\r\nprint(\"\\n\".join(res))",
