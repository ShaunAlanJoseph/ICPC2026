  "source_code": "MOD = 998244353\r\nt = int(input())\r\ninv = [0,1]\r\nH = [0,1]\r\nres = []\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    while len(H) <= n:\r\n        i = len(inv)\r\n        inv.append((MOD - (MOD // i ) * inv[MOD % i] % MOD) % MOD)\r\n        H.append((H[-1] + inv[i]) % MOD)\r\n        \r\n    total = 0\r\n    for j in range(1, n + 1):\r\n        total = (total + a[j - 1] * (H[j - 1] + H[n - j])) % MOD\r\n    \r\n    res.append(str(total))\r\n\r\nprint(\"\\n\".join(res))",
