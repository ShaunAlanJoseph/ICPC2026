  "source_code": "# cook your dish here\r\nimport sys \r\nfrom itertools import accumulate as acc \r\ndef sol(n,a):\r\n    a.sort(reverse=True)\r\n    p = [0]+list(acc(a))\r\n    k = 0 \r\n    l =n \r\n    z = 0 \r\n    while k <= n :\r\n        l = min(l,n-k)\r\n        while l and a[k+2*l-2]+a[k+2*l-1] <= 3*a[3*n-2*k-l]:\r\n            l -= 1 \r\n        z = max(z,2*p[k]+p[k+2*l]+3*p[3*n-2*k-l])\r\n        k += 1 \r\n    return z \r\ndef run():\r\n    it = iter(map(int,sys.stdin.buffer.read().split()))\r\n    t = next(it)\r\n    o = []\r\n    while t :\r\n        n = next(it)\r\n        a = [next(it) for _ in range(3*n)]\r\n        o.append(str(sol(n,a)))\r\n        t -= 1 \r\n    sys.stdout.write(\"\\n\".join(o))\r\nrun()\r\n",
