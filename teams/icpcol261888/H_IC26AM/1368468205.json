  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\n\r\nll binary_expo(ll a,ll b){\r\n      ll ansti=1;\r\n      while(b>0){\r\n           if(b%2){\r\n               ansti=ansti*a%MOD;\r\n           }\r\n           a=a*a%MOD;\r\n           b=b/2;\r\n      }\r\n      return ansti;\r\n}\r\n\r\nint main() {\r\n\tll t;\r\n\tcin>>t;\r\n\t\r\n\twhile(t--){\r\n\t     ll n;\r\n\t     cin>>n;\r\n\t     \r\n\t     vector<ll>a(n);\r\n\t     for(ll i=0;i<n;i++) cin>>a[i];\r\n\t     \r\n\t     \r\n\t     vector<ll>h(n,0);\r\n\t     \r\n\t     for(ll i=1;i<n;i++){\r\n\t          int inv=binary_expo(i,MOD-2);\r\n\t          \r\n\t          h[i]=(h[i-1]+inv)%MOD;\r\n\t     }\r\n\t     \r\n\t     ll ansi=0;\r\n\t     for(ll i=0;i<n;i++){\r\n\t         ll contri=(h[i]+h[n-1-i])%MOD;\r\n\t         ansi=(ansi+a[i]*contri)%MOD;\r\n\t     }\r\n\t     \r\n\t     cout<<ansi<<endl;\r\n\t    \r\n\t}\r\n}\r\n",
