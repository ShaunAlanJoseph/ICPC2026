  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m = 3*n;\r\n\t    vector<long long> a(m);\r\n\t    for(auto &x:a) cin>>x;\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    vector<long long> pref(m+1,0);\r\n\t    for(int i=0;i<m;i++) pref[i+1] = pref[i] + a[i];\r\n\t    auto value = [&](int A,int B) -> long long {\r\n\t        int T = A+2*B;\r\n\t        int K=3*n-2*A-B;\r\n\t        return 2LL*pref[A] + pref[T] + 3LL*pref[K];\r\n\t    };\r\n\t    long long ans=0;\r\n\t    int B=n;\r\n\t    for(int i=0;i<=n;i++){\r\n\t        B=min(B,n-i);\r\n\t        while(B>0 && value(i,B-1) >= value(i,B)) {\r\n\t            B--;\r\n\t        }\r\n\t        ans = max(ans,value(i,B));\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\nreturn 0;\r\n}\r\n",
