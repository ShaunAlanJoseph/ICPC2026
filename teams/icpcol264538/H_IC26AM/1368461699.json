  "source_code": "# cook your dish\r\nimport sys\r\nfrom operator import mul\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    mod=998244353\r\n    n=200001\r\n    inv=[0,1]+[0]*(n-1)\r\n    \r\n    h=[0]*(n+1)\r\n    h[1]=1\r\n    for i in range(2,n+1):\r\n        inv[i]=(mod-mod//i)*inv[mod%i]%mod\r\n        h[i]=(h[i-1]+inv[i])%mod\r\n    \r\n    \r\n    t=int(data[0])\r\n    p=1\r\n    o=[]\r\n\r\n    for _ in range(t):\r\n        n=int(data[p])\r\n        a=list(map(int,data[p+1:p+1+n]))\r\n        p+=1+n\r\n        s=sum(map(mul,a,h[:n]))+sum(map(mul,a,h[n-1::-1]))\r\n        o.append(s%mod)\r\n    print(\"\\n\".join(map(str,o)))\r\n\r\nmain()\r\n    ",
