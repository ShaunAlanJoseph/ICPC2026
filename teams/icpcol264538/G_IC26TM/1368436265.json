  "source_code": "# cook your dish here\r\nt=int(input())\r\n\r\nfor _ in range(t):\r\n    n=int(input())\r\n    r=list(map(int,input().split()))\r\n    r.sort(reverse=True)\r\n    p=[0]\r\n    for v in r:\r\n        p.append(p[-1]+v)\r\n    best=0\r\n    for a in range(n+1):\r\n        l=0\r\n        h=n-a\r\n        while(l<h):\r\n            mid=(l+h)//2\r\n            f1=p[a+2*mid]+3*p[3*n-2*a-mid]\r\n            f2=p[a+2*(mid+1)]+3*p[3*n-2*a-(mid+1)]\r\n            \r\n            if f1<f2:\r\n                l=mid+1\r\n            else:\r\n                h=mid\r\n        val=2*p[a]+p[a+2*l]+3*p[3*n-2*a-l]\r\n        if val>best:\r\n            best=val\r\n    print(best)\r\n    \r\n        \r\n    ",
