  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nconst ll MOD = 998244353;\r\n\r\nvector<ll> v,h;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    \r\n    vector<ll> a(n);\r\n    \r\n    for(int i=0;i<n;i++){\r\n        cin>>a[i];\r\n    }\r\n    \r\n    ll ans = 0;\r\n    \r\n    for(int i=0;i<n;i++){\r\n        ll cf = (h[i] + h[n - i - 1])%MOD ;\r\n        ans = (ans + a[i] * cf)%MOD;\r\n    }\r\n    \r\n    cout<<ans<<'\\n';\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    int T;\r\n    cin>>T;\r\n    \r\n    int m = 200000;\r\n    \r\n    v.resize(m+1);\r\n    h.resize(m+1);\r\n    \r\n    v[1] = 1;\r\n    \r\n    for(int i=2;i<=m;i++){\r\n        v[i] = MOD - (MOD/i)*v[MOD%i]%MOD;\r\n    }\r\n    \r\n    for(int i=1;i<=m;i++){\r\n        h[i] = h[i-1] + v[i] %MOD; \r\n    }\r\n    \r\n    while(T--){\r\n        solve();\r\n    }\r\n}\r\n",
