  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t int t;\r\n\t cin>>t;\r\n\t while(t--){\r\n\t     int n;\r\n\t     cin>>n;\r\n\t     int total =3*n;\r\n\t     vector<long long>r(total);\r\n\t     for(int i=0;i<total;i++){\r\n\t           cin>>r[i];\r\n\t     }\r\n\t     sort(r.rbegin(),r.rend());\r\n\t     vector<long long>pr(total+1,0);\r\n\t     for(int i=0;i<total;i++){\r\n\t         pr[i+1]=pr[i]+r[i];\r\n\t     }\r\n\t     long long b =0;\r\n\t      for(int p=0;p<=n;p++){\r\n\t          auto value =[&](int q){\r\n\t              return 2*pr[p]+pr[p+2*q]+3*pr[total-2*p-q];\r\n\t          };\r\n\t          int l=0;\r\n\t          int h=n-p;\r\n\t          while(l<h){\r\n\t              int mid =(l+h)/2;\r\n\t              if(value(mid+1)>value(mid))\r\n\t              l=mid+1;\r\n\t              else \r\n\t              h=mid;\r\n\t          }\r\n\t              b=max(b,value(l));\r\n\t          \r\n\t      }\r\n\t      cout<<b<<endl;\r\n\t }\r\n\r\n}\r\n",
