  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    a.sort(reverse = True)\r\n    \r\n    pref = [0] * (3 * n + 1)\r\n    for i,x in enumerate(a):\r\n        pref[i + 1] = pref[i] + x\r\n        \r\n        \r\n    def value(x,y):\r\n        z = 3 * n - 2 * x - y\r\n        q = x + 2 * y\r\n        \r\n        return 3 * pref[z] + pref[q] + 2 * pref[x]\r\n    b = n\r\n    ans = 0\r\n    \r\n    for x in range(n + 1):\r\n        b = min(b,n-x)\r\n        \r\n        while b > 0:\r\n            q = x + 2 * b\r\n            r = 3 * n - 2 * x - b\r\n            \r\n            delta = a[q-1] + a[q-2] - 3 * a[r]\r\n            if delta >= 0:\r\n                break\r\n            b -= 1\r\n        ans = max(ans,value(x,b))\r\n    print(ans)",
