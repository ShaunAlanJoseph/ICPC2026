  "source_code": "# cook your dish here\r\nimport sys\r\n\r\nMOD = 998244353\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\ntest = []\r\n\r\nmax_n = 0\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split())) \r\n    test.append((n, a))\r\n    max_n = max(max_n, n)\r\n    \r\ninv = [0] * (max_n + 1)\r\nif max_n >= 1:\r\n    inv[1] = 1\r\nfor i in range(2, max_n + 1):\r\n    inv[i] = MOD - (MOD // i) * inv[MOD % i] % MOD\r\nh = [0] * (max_n + 1)\r\nfor i in range(1, max_n + 1):\r\n    h[i] = (h[i - 1] + inv[i]) % MOD\r\n        \r\nfor n, a in test:\r\n    ans = 0\r\n    for i, x in enumerate(a):\r\n        c = (h[i] + h[n - i - 1]) % MOD\r\n        ans = (ans + x * c) % MOD\r\n    print(ans)",
