  "source_code": "#include <bits/stdc++.h>\r\n#define ll long long\r\nusing namespace std;\r\n\r\nll func(const vector<ll>&pref,ll i,ll j,ll m){\r\n    ll p=2*pref[i];\r\n    ll q=pref[i+2*j];\r\n    ll r=3*pref[m-j];\r\n    return p+q+r;\r\n}\r\n\r\nll solve(vector<ll>&pref,ll n,ll i){\r\n    ll m=3*n-2*i;\r\n    ll low=0;\r\n    ll high=n-i;\r\n    while(low<high){\r\n        ll mid=low+(high-low)/2;\r\n        ll a=func(pref,i,mid+1,m);\r\n        ll b=func(pref,i,mid,m);\r\n        \r\n        if(a>b){\r\n            low=mid+1;\r\n        }\r\n        else{\r\n            high=mid;\r\n        }\r\n    }\r\n        return func(pref,i,low,m);\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ll t;\r\n    cin>>t;\r\n    while(t--){\r\n        ll n;\r\n        cin>>n;\r\n        ll sizee=3*n;\r\n        vector<ll>v(sizee);\r\n        for(ll i=0;i<sizee;i++){\r\n            cin>>v[i];\r\n        }\r\n        sort(v.rbegin(),v.rend());\r\n        vector<ll>pref(sizee+1,0);\r\n        for(ll i=0;i<sizee;i++){\r\n            pref[i+1]=pref[i]+v[i];\r\n        }\r\n        ll str=0;\r\n        for(ll i=0;i<=n;i++){\r\n            str=max(str,solve(pref,n,i));\r\n        }\r\n        cout<<str<<endl;\r\n        \r\n    }\r\n}\r\n",
