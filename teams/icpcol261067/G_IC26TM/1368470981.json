  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nvoid solve(){\r\n    ll n; cin>>n;\r\n    vector<ll> arr(3*n,0),arr1(3*n+2,0);\r\n    ll n1=arr.size(),ans=0;\r\n    for(int i=0;i<n1;i++) cin>>arr[i];\r\n    sort(arr.rbegin(),arr.rend());\r\n    for(int j=0;j<n1;j++) arr1[j+1]=arr1[j]+arr[j];\r\n    for(ll j=0;j<=n;j++){\r\n        ll r=n,l=j;\r\n        while(r-l>2){\r\n            ll u=l+(r-l)/3,v=r-(r-l)/3;\r\n            if(arr1[2*v-j]+3*arr1[n1-j-v]>arr1[2*u-j]+3*arr1[n1-j-u]) l=u;\r\n            else r=v;\r\n        }\r\n        for(ll k=l;k<=r;k++) ans=max(ans,2*arr1[j]+arr1[2*k-j]+3*arr1[n1-j-k]);\r\n    }\r\n    cout<<ans<<\"\\n\";\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t; cin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
