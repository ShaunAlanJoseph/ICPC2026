  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ndef solve():\r\n    it= iter(map(int,sys.stdin.buffer.read().split()))\r\n    t = next(it)\r\n    tokens=(\"00\",\"01\",\"10\",\"11\")\r\n    out=[]\r\n    \r\n    for _ in range(t):\r\n        c=[next(it) for _ in range(4)]\r\n        length = sum(c)-1\r\n        best = None\r\n        \r\n        for k in range(4):\r\n            if c[k]==0:\r\n                continue\r\n            \r\n            c[k]-=1\r\n            zeros = min(length,2*c[0]+c[2])\r\n            remaing = length-zeros\r\n            pairs = min(c[1],remaing//2)\r\n            \r\n            candi =(\r\n                \"0\"*zeros\r\n                +\"01\"*pairs+\r\n                \"1\"*(remaing - 2 * pairs)\r\n                +tokens[k]\r\n                )\r\n            if best is None or candi< best:\r\n                best= candi\r\n                    \r\n            c[k]+=1\r\n                \r\n        out.append(best)\r\n    sys.stdout.write(\"\\n\".join(out))\r\n        \r\nsolve()",
