  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ndef solve():\r\n    it = iter(map(int , sys.stdin.buffer.read().split()))\r\n    t = next(it)\r\n    out= []\r\n    \r\n    for _ in range(t):\r\n        n = next(it)\r\n        a = [next(it) for _ in range(3*n)]\r\n        a.sort(reverse=True)\r\n        \r\n        s=[0]\r\n        for x in a:\r\n            s.append(s[-1]+x)\r\n        b =n \r\n        ans =0\r\n        \r\n        for i in range(n+1):\r\n            if b> n-i:\r\n                b=n-i\r\n            base = 2*s[i]\r\n            cur = base+ s[i+2*b]+3*s[3*n-2*i-b]\r\n            \r\n            while b>0:\r\n                v = base+ s[i+2*b-2]+3*s[3*n-2*i-b+1]\r\n                if v<cur :\r\n                    break\r\n                b-=1\r\n                cur =v\r\n                \r\n            if cur > ans:\r\n                ans= cur\r\n        out.append(str(ans))\r\n    sys.stdout.write(\"\\n\".join(out))\r\n\r\nsolve()\r\n                ",
