  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long  ll;\r\n\r\nvoid solve() {\r\n    ll n; cin>>n;\r\n    vector<ll> v(3*n);\r\n    for(auto &x:v) cin>>x;\r\n    ll ans=0;\r\n    sort(v.rbegin(),v.rend());\r\n    vector<ll> pre(3*n+1,0);\r\n    \r\n    for(int i=0; i<3*n; i++) {\r\n        pre[i+1] = pre[i]+v[i];   \r\n    }\r\n    \r\n    for(int i=0; i<=n; i++) {\r\n        ll l = 0, h = n-i;\r\n        \r\n        while(h-l>2) {\r\n            ll m1 = l+(h-l)/3;\r\n            ll m2 = h-(h-l)/3;\r\n            \r\n            ll val1 = pre[i+2*m1] + 3*pre[3*n - 2*i -m1]+ 2*pre[i];\r\n            ll val2 = pre[i+2*m2] + 3*pre[3*n - 2*i - m2] + 2*pre[i];\r\n            \r\n            if (val1<val2){\r\n                l = m1;\r\n            }\r\n            else \r\n            h=m2;\r\n        }\r\n        \r\n        for(int j =l; j<=h; j++) \r\n            ans = max(ans, pre[i+2*j] + 3*pre[3*n -2*i- j] + 2* pre[i]);\r\n\r\n    }\r\n    \r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\tint t = 0;\r\n\tcin>>t;\r\n\twhile(t--) {\r\n\t    solve();\r\n\t}\r\n}\r\n",
