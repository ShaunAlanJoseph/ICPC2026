  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\tint n;\r\n\tcin >> n;\r\n\tint m = 3*n;\r\n\tstd::vector<int>a(m);\r\n\tfor(int i = 0;i<m;i++){\r\n\t    cin >> a[i];\r\n\t}\r\n\tsort(a.rbegin(),a.rend());\r\n\tvector<long long>p(m+1,0);\r\n\tfor(int i = 0;i<m;i++){\r\n\t    p[i+1] = p[i] + a[i];\r\n\t}\r\n\tlong long ans = 0;\r\n\tauto val = [&](int x,int y){\r\n\t    return 2LL * p[x] + p[x+2*y] + 3LL * p[3 * n-2 *x-y];\r\n\t};\r\n\t\r\n\tfor(int x= 0;x<= n;x++){\r\n\t    int lo = 0;\r\n\t    int hi = n-x;\r\n\t    \r\n\t    while(lo < hi){\r\n\t        int y = (lo + hi) / 2;\r\n\t        long long d = a[x + 2 * y] + a[x+2*y+1] - 3LL * a[3 * n - 2 * x - y - 1];\r\n\t        \r\n\t        if(d > 0){\r\n\t            lo = y+1;\r\n\t        }\r\n\t        else{\r\n\t            hi = y;\r\n\t        }\r\n\t    }\r\n\t    ans = max(ans,val(x,lo));\r\n\t    if(lo > 0){\r\n\t        ans = max(ans,val(x,lo-1));\r\n\t    }\r\n\t}\r\n\tcout << ans << endl;\r\n\t}\r\n\treturn 0;\r\n}\r\n\r\n",
