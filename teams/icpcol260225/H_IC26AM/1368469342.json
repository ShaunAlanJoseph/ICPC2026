  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int mod = 998244353;\r\nconst int maxn = 200000;\r\nint main() {\r\n    \r\n    std::vector<long long> inv(maxn+1), h(maxn+1);\r\n    inv[1] = 1;\r\n    for(int i= 2;i<=maxn;i++){\r\n        inv[i] = mod - (mod/i) *inv[mod % i] % mod;\r\n    }\r\n    h[0] = 0;\r\n    for(int i = 1;i<=maxn;i++){\r\n        h[i] = (h[i-1] + inv[i]) % mod;\r\n    }\r\n    \r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        int n;\r\n        cin >> n;\r\n        vector<long long >a(n);\r\n        for(int i = 0;i<n;i++){\r\n            cin >> a[i];\r\n        }\r\n        long long ans = 0;\r\n        for(int i = 0;i<n;i++){\r\n            long long co = (h[i] + h[n-1-i]) % mod;\r\n            ans = (ans + a[i] * co) % mod;\r\n        }\r\n        cout << ans << endl;\r\n    }\r\n\treturn 0;\r\n}\r\n",
