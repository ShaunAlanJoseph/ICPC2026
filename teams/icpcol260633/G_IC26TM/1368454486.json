  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0]);pos=1\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(data[pos]);pos+=1\r\n        a=sorted(map(int,data[pos:pos+3*n]),reverse=True);pos+=3*n \r\n        p=[0]*(3*n+1)\r\n        s=0\r\n        for i in range(3*n):\r\n            s+=a[i]\r\n            p[i+1]=s \r\n        N3=3*n \r\n        best = n \r\n        cur=n \r\n        for n1 in range(n+1):\r\n            lim=n-n1\r\n            if cur>lim:\r\n                cur=lim\r\n            base=2*p[n1]\r\n            co=N3-2*n1\r\n            g=base+p[n1+2*cur]+3*p[co-cur]\r\n            while cur>0:\r\n                g2=base+p[n1+2*cur-2]+3*p[co-cur+1]\r\n                if g2>=g:\r\n                    g=g2;cur-=1 \r\n                else:\r\n                    break\r\n            if g>best:\r\n                best=g \r\n        out.append(best)\r\n    print(\"\\n\".join(map(str,out)))\r\nmain()    \r\n            \r\n        \r\n        \r\n        ",
