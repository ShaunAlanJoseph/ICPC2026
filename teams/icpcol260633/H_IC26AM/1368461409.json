  "source_code": "# cook your dish here\r\nimport sys\r\ndef main():\r\n    mod=998244353\r\n    data=sys.stdin.buffer.read().split()\r\n    t=int(data[0])\r\n    N=200001\r\n    inv=[0,1]+[0]*(N-1)\r\n    for i in range(2,N+1):\r\n        inv[i]=(mod-(mod//i)*inv[mod%i]%mod)%mod\r\n    h=[0]*(N+1)\r\n    for i in range(1,N+1):\r\n        h[i]=(h[i-1]+inv[i])%mod\r\n    pos=1\r\n    out=[]\r\n    for _ in range(t):\r\n        n=int(data[pos]);pos+=1 \r\n        tot=0 \r\n        for i in range(n):\r\n            tot+=int(data[pos+i])*(h[i]+h[n-1-i])\r\n        pos+=n \r\n        out.append(tot%mod)\r\n    print(\"\\n\".join(map(str,out)))\r\nmain()    \r\n            ",
