  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int M = 998244353;\r\n\r\nint nz;\r\n\r\nbool fina(int iz,int vz,int xz,int yz){\r\n    int mz = nz-iz + 1;\r\n    \r\n    auto p = [&](int vz,int xz){\r\n        return min(xz,iz) + max(0,iz - nz + vz - xz);\r\n    };\r\n    \r\n    auto s = [&](int vz,int xz){\r\n        return max(0,xz-iz+1) + min(vz-xz,mz);\r\n        \r\n    };\r\n    \r\n    return (p(vz,yz) >= (iz+1) / 2 && p(vz-1,xz) <(iz+1)/2) || (s(vz,yz)>= (mz+1)/2 && s(vz-1,xz) < (mz+1)/2);\r\n}\r\nint main() {\r\n\tint rimjhim;\r\n\t\r\n\tcin >> rimjhim;\r\n\t\r\n\twhile(rimjhim--){\r\n\t   // int nz;\r\n\t    \r\n\t    cin >> nz;\r\n\t    \r\n\t    vector<vector<int>> az(nz+1);\r\n\t    \r\n\t    for(int i = 1,a;i <=nz;i++){\r\n\t        cin >> a,az[a].push_back(i);\r\n\t    }\r\n\t    vector<int> dpp(nz+2),ndd(nz+2);\r\n\t    \r\n\t    dpp[0] = 1;\r\n\t    \r\n\t    for(int v = 1;v <= nz;v++){\r\n\t        fill(ndd.begin(),ndd.end(),0);\r\n\t        \r\n\t        for(int x = 0;x<v;x++) if(dpp[x])\r\n\t            for(int c = v == nz;c<=1;c++){\r\n\t                if( all_of(az[v].begin(), az[v].end(), [&](int i) { return fina(i,v,x,x+c); } ))\r\n\t                \r\n\t                ndd[x+c] = (ndd[x+c] + dpp[x])%M;\r\n\t                \r\n\t                \r\n\t            }\r\n\t            \r\n\t            swap(dpp,ndd);\r\n\t    }\r\n\t    \r\n\t    long long sz = 0;\r\n\t    \r\n\t    for(int x : dpp) sz+=x;\r\n\t    \r\n\t    cout << sz%M << endl;\r\n\t}\r\n\r\n}\r\n",
