  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nint mod = 998244353;\r\nint m = 500001;\r\n\r\nlong long inh[500001];\r\nlong long h[500001];\r\n\r\nvoid find(){\r\n    inh[1] = 1;\r\n    h[1] = 1;\r\n    h[0] = 0;\r\n    for(int i = 2;i<m;i++){\r\n        inh[i] = (mod - mod/i)*inh[mod%i]%mod;\r\n        \r\n        h[i] = (h[i-1] + inh[i])%mod;\r\n    }\r\n}\r\nint main() {\r\n\tint rim;\r\n\tcin >> rim;\r\n\t\r\n\tfind();\r\n\twhile(rim--){\r\n\t    int nz;\r\n\t    cin >> nz;\r\n\t    \r\n\t    vector<long long> vicky(nz);\r\n\t    \r\n\t    for(auto &x : vicky) cin >> x;\r\n\t    \r\n\t    long long fin = 0;\r\n\t    for(int i = 0;i<nz;i++){\r\n\t        long long temp = (h[i] + h[nz-i-1]) % mod;\r\n\t        \r\n\t        long long temp2 = ((vicky[i]%mod)*temp)%mod;\r\n\t        \r\n\t        fin = (fin+temp2)%mod;\r\n\t    }\r\n\t    \r\n\t    cout << fin << endl;\r\n\t}\r\n\r\n}\r\n",
