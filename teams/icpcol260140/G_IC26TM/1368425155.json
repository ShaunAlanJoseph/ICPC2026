  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint rimjhim;\r\n\t\r\n\tcin >> rimjhim;\r\n\t\r\n\twhile(rimjhim--){\r\n\t    int nz;\r\n\t    cin >> nz;\r\n\t    \r\n\t    vector<long long> sahil(3*nz),vicky(3*nz+1);\r\n\t    \r\n\t    for(auto &xz : sahil) cin >> xz;\r\n\t    \r\n\t    sort(sahil.rbegin(),sahil.rend());\r\n\t    \r\n\t    for(int i = 0;i<3*nz;i++) vicky[i+1] = vicky[i] + sahil[i];\r\n\t    \r\n\t    long long opti = 0;\r\n\t    \r\n\t    for(int i = 0;i<=nz;i++){\r\n\t        auto gz = [&](int qz){ return 2*vicky[nz-qz -i] +vicky[nz+qz-i] +3*vicky[nz+qz+2*i]; };\r\n\t        \r\n\t        int low = 0,hig = nz-i;\r\n\t        \r\n\t        while(low<hig){\r\n\t            int m = (low+hig)/2;\r\n\t            if(gz(m+1) > gz(m)) low = m+1;\r\n\t            else hig = m;\r\n\t        }\r\n\t        \r\n\t        opti = max(opti,gz(low));\r\n\t        \r\n\t    }\r\n\t    \r\n\t    cout << opti << endl;\r\n\t}\r\n}\r\n",
