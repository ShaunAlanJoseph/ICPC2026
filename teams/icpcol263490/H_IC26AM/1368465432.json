  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\nstatic const long long MOD = 998244353;\r\nconst int MAXN = 200000;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    \r\n    vector<ll> inv(MAXN+1);\r\n    vector<ll> H(MAXN+1);\r\n    inv[1] = 1;\r\n    for(int i=2; i<=MAXN; ++i) inv[i] = MOD - (MOD/i)*inv[MOD%i]%MOD;\r\n    // H[0] = 0;\r\n    for(int i=1; i<=MAXN; ++i) H[i] = (H[i-1] + inv[i])%MOD;\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        // ll ans = 0;\r\n        vector<long long> a(n);\r\n        for(auto &x: a) cin>>x;\r\n        long long ans = 0;\r\n        for(int i=1; i<=n; ++i){\r\n            ll weight = (H[i-1] + H[n-i]) % MOD;\r\n            // ans = (ans + a % coefficient) % MOD;\r\n            ans += (a[i-1] %MOD)*weight%MOD;\r\n            if(ans >= MOD) ans-=MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
