  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    vector<long long int> inv(200005), h(200005);\r\n    \r\n    inv[1] = 1;\r\n    long long int i = 2;\r\n    while (i < 200005) {\r\n        inv[i] = (998244353 - (998244353 / i) * inv[998244353 % i] % 998244353) % 998244353;\r\n        i = i + 1;\r\n    }\r\n    \r\n    h[0] = 0;\r\n    i = 1;\r\n    while (i < 200005) {\r\n        h[i] = (h[i - 1] + inv[i]) % 998244353;\r\n        i = i + 1;\r\n    }\r\n    \r\n    long long int t;\r\n    cin>>t;\r\n    \r\n    while (t--) {\r\n        long long int n;\r\n        cin >> n;\r\n        \r\n        long long int ans = 0;\r\n        \r\n        i = 1;\r\n        while (i<=n) {\r\n            long long int x;\r\n            cin >> x;\r\n            \r\n            long long int coef = (h[i - 1] + h[n-i]) % 998244353;\r\n            ans = (ans + x % 998244353 * coef) % 998244353;\r\n            \r\n            i = i + 1;\r\n        }\r\n        \r\n        cout <<ans<<endl;\r\n    }\r\n    \r\n    return 0;\r\n}\r\n",
