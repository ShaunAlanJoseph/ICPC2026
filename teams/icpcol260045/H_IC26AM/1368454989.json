  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long mod = 998244353;\r\nconst int mx = 1000005;\r\n\r\nlong long l[mx];\r\nlong long m[mx];\r\n\r\nvoid solve(){\r\n    int n ;\r\n    cin>>n;\r\n    long long ans = 0;\r\n    for(int i = 1; i<=n; i++){\r\n        long long a;\r\n        cin>>a;\r\n        a%=mod;\r\n        if(a<0) a+=mod;\r\n        long long w = (m[i-1]+m[n-i])%mod;\r\n        ans = (ans+a*w)%mod;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\n\r\nint main(){\r\n    l[1] = 1;\r\n    for(int i = 2; i<mx; i++){\r\n        l[i] = (mod-(mod/i)*l[mod%i]%mod)%mod;\r\n    }\r\n    m[0] = 0;\r\n    for(int i = 1; i<mx; i++){\r\n        m[i] = m[i-1]+l[i]%mod;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        solve();\r\n    }\r\n}\r\n\r\n\r\n",
