  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    int m = 3*n;\r\n    vector<long long>v(m);\r\n    for(long long &i : v){\r\n        cin>>i;\r\n    }\r\n    sort(v.rbegin(), v.rend());\r\n    vector<long long>dp(m+1, 0);\r\n    \r\n    for(int i = 0; i<m; i++){\r\n        dp[i+1] = dp[i] + v[i];\r\n    }\r\n    \r\n    auto s = [&](long long a, long long b)->long long{\r\n        return 6*dp[a]+4*(dp[a+2*b]-dp[a])+3*(dp[m-2*a-b]-dp[a+2*b]);\r\n    };\r\n    \r\n    long long ans = 0;\r\n    for(int i = 0; i<=n; i++){\r\n        int l = 0; \r\n        int h = n-i;\r\n        while(l<h){\r\n            int mid=(l+h)/2;\r\n            if(s(i,mid+1)>s(i,mid)) l=mid+1;\r\n            else{\r\n                h=mid;\r\n            }\r\n        }\r\n        ans=max(ans,s(i,l));\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
