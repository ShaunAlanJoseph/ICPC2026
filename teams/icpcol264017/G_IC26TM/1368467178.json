  "source_code": "# cook your dish here\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort()\r\n    m=3*n\r\n    a=[0]+a\r\n    p=[0]*(m+1)\r\n    for i in range(1,m+1):\r\n        p[i]=p[i-1]+a[i]\r\n    def df(k,l):\r\n        return (a[m-k-2*l]+a[m-k-2*l-1]-3*a[2*k+l+1])\r\n    def b(k,l):\r\n        n=-3*p[2*k+l]\r\n        p1=p[m-k]-p[m-k-2*l]\r\n        p3=3*(p[m]-p[m-k])\r\n        return n+p1+p3\r\n    bb=0\r\n    for k in range(n+1):\r\n        maxi=n-k\r\n        lo=0\r\n        hi=maxi\r\n        while(lo<hi):\r\n            mid=(lo+hi)//2 \r\n            if mid<maxi and df(k,mid)>=0:\r\n                lo=mid+1 \r\n            else:\r\n                hi=mid \r\n        l=lo \r\n        bb=max(bb,b(k,l))\r\n        if l>0:\r\n            bb=max(bb,b(k,l-1))\r\n    b=3*p[m]\r\n    print(b+bb)",
