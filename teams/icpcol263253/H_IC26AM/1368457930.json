  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\n#define py cout << \"YES\" << endl \r\n#define pn cout << \"NO\" << endl \r\nint MAXN = 2000003;\r\nconst int MOD = 998244353;\r\n\r\nvector<int> inv_mod(MAXN + 10);\r\nvector<int> prefix(MAXN + 10);\r\n\r\nvoid pre() {\r\n    inv_mod[1] = 1;\r\n    for(int i=2;i<=MAXN;i++) {\r\n        inv_mod[i] = MOD - (MOD / i) * (inv_mod[MOD % i]) % MOD;\r\n    }\r\n    \r\n    prefix[0] = 0;\r\n    for(int i=1;i<=MAXN;i++) {\r\n        prefix[i] = prefix[i-1] + inv_mod[i] % MOD;\r\n    }\r\n}\r\n\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    \r\n    vector<int> arr(n);\r\n    for(int i=0;i<n;i++) {\r\n        cin >> arr[i];\r\n    }\r\n    \r\n    int ans = 0;\r\n    for(int i=0;i<n;i++) {\r\n        int mul = (prefix[i]) % MOD + (prefix[n - i - 1]) % MOD;\r\n        ans = (ans % MOD + (mul * arr[i]) % MOD);\r\n    }\r\n    \r\n    cout << ans % MOD << '\\n';\r\n}\r\n\r\nsigned main() {\r\n\r\n    int t;\r\n\tcin >> t ; \r\n\tpre();\r\n\twhile(t--)\r\n\t{\r\n\r\n\t    solve() ; \r\n\t}\r\n\r\n}\r\n",
