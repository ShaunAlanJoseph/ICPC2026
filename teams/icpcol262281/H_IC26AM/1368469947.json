  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define int long long\r\n\r\nconst int MOD = 998244353;\r\n\r\nsigned main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--) {\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    vector<int> a(n + 1);\r\n\t    for(int i = 1; i<=n; i++) {\r\n\t        cin>>a[i];\r\n\t        a[i] %= MOD;\r\n\t        if(a[i] < 0) a[i] += MOD;\r\n\t    }\r\n\t    \r\n\t    vector<int> inv(n + 1);\r\n\t    vector<int> H(n +1);\r\n\t    \r\n\t    if(n >= 1) inv[1] = 1;\r\n\t    \r\n\t    for(int i = 2; i<=n; i++) {\r\n\t        inv[i] = MOD - (MOD/i) * inv[MOD % i] % MOD;\r\n\t    }\r\n\t    for(int i = 1; i<=n;i++) {\r\n\t        H[i] = (H[i - 1] + inv[i]) % MOD;\r\n\t    }\r\n\t    int ans = 0;\r\n\t    for(int i = 1; i<=n; i++) {\r\n\t        int coefficient = (H[i - 1] + H[n - i]) % MOD;\r\n\t        ans = (ans + a[i] * coefficient) % MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t    \r\n\t    \r\n\t}\r\n\r\n}\r\n",
