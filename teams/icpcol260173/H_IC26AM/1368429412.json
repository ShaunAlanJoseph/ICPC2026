  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\n\r\nconst ll MOD=998244353;\r\nconst int N=200000;\r\nint main() {\r\n\t// your code goes here\r\n    vector<ll> inv(N+1),h(N+1);\r\n    \r\n    inv[1]=1;\r\n    \r\n    for(int i=2; i<=N;i++)\r\n    inv[i]=(MOD-(MOD/i)*inv[MOD%i]%MOD)%MOD;\r\n    \r\n    for (int i=1;i<=N;i++)\r\n    h[i]=(h[i-1]+inv[i])%MOD;\r\n    \r\n    int t;\r\n    cin>>t;\r\n    \r\n    while(t--){\r\n        \r\n        int n;\r\n        cin>>n;\r\n        ll ans=0;\r\n        \r\n        for(int j=1;j<=n;j++){\r\n            ll x;\r\n            cin>>x;\r\n            ll w= (h[j-1]+h[n-j])%MOD;\r\n            ans=(ans+x*w)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
