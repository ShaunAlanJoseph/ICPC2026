  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define int long long\r\n#define f(i,x,n) for(int i=x;i<n;i++)\r\n\r\nint formula(int x, int y, int n, vector<int>&ve){\r\n    return 2LL*ve[x]+ve[x+2*y]+3LL*ve[3*n-2*x-y];\r\n}\r\n\r\nsigned main() {\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    int newn=3*n;\r\n\t    vector<int>v(newn);\r\n\t    f(i,0,newn)cin >> v[i];\r\n\t    sort(v.begin(),v.end());\r\n\t    reverse(v.begin(),v.end());\r\n\t    vector<int>ve(newn+1,0);\r\n\t    f(i,0,newn) ve[i+1]=ve[i]+v[i];\r\n\t    int ans=0;\r\n\t    f(i,0,n+1){\r\n\t        int low=0, high=n-i;\r\n\t        while(low<high){\r\n\t            int mid=low+(high-low)/2;\r\n\t            if(formula(i,mid+1,n,ve)>=formula(i,mid,n,ve)) low=mid+1;\r\n\t            else high=mid;\r\n\t        }\r\n\t        ans=max(ans,formula(i,low,n,ve));\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
