  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long> a(3*n),p(3*n+1);\r\n\t    \r\n\t    for(auto &x:a)\r\n\t    cin>>x;\r\n\t    sort(a.begin(), a.end());\r\n\t    for(int i=0; i<3*n;i++) p[i+1]=p[i]+a[i];\r\n\t    long long ans = 0,s=p[3*n];\r\n\t    for(int k=0;k<=2*n;k++){\r\n\t        int l=max(0,k-n),r=k/2;\r\n\t        auto f=[&](int x){\r\n\t            return 6*s-3*p[k]-p[3*n-2*k+3*x]-2*p[3*n-x];\r\n\t        };\r\n\t        while(l<r){\r\n\t            int m=(l+r)/2;\r\n\t            if(f(m)<=f(m+1)) l=m+1;\r\n\t            else r=m;\r\n\t        }\r\n\t        ans=max(ans,f(l));\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n}\r\n",
