  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nconst int M=998244353,X=200005;\r\nll v[X],h[X];\r\nvoid s(){\r\n    int n;\r\n    cin>>n;\r\n    ll r=0;\r\n    for(int i=1;i<=n;i++){\r\n        ll a;\r\n        cin>>a;\r\n        ll c=(h[i-1]+h[n-i]%M);\r\n        r=(r+a*c)%M;\r\n    }\r\n    cout<<r<<\"\\n\";\r\n}\r\nint main() {\r\n    ios_base::sync_with_stdio(0);\r\n    cin.tie(0);\r\n    v[1]=1;\r\n    h[1]=1;\r\n    for(int i=2;i<X;i++){\r\n        v[i]=M-(M/i)*v[M%i]%M;\r\n        h[i]=(h[i-1]+v[i])%M;\r\n    }\r\n    int t;\r\n    if(cin>>t){\r\n        while(t--) s();\r\n    }\r\n    return 0;\r\n}\r\n",
