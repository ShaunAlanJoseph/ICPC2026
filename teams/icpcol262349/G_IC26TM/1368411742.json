  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nvoid s(){\r\n    int n;\r\n    cin>>n;\r\n    int N=3*n;\r\n    vector<ll>a(N);\r\n    for(int i=0;i<N;i++) cin>>a[i];\r\n    sort(a.rbegin(),a.rend());\r\n    vector<ll>p(N+1,0);\r\n    for(int i=0;i<N;i++) p[i+1]=p[i]+a[i];\r\n    ll mx=0;\r\n    for(int m=0;m<=n;m++){\r\n        int l=0,r=m;\r\n        while(l<r){\r\n            int md=l+(r-l)/2;\r\n            ll v1=3ll*p[N-m-md]+p[2*m-md]+2ll*p[md];\r\n            int md1=md+1;\r\n            ll v2=3ll*p[N-m-md1]+p[2*m-md1]+2ll*p[md1];\r\n            if(v1<=v2) l=md+1;\r\n            else r=md;\r\n        }\r\n        ll v=3ll*p[N-m-l]+p[2*m-l]+2ll*p[l];\r\n        if(v>mx) mx=v;\r\n    }\r\n    cout<<mx<<\"\\n\";\r\n}\r\nint main() {\r\n\tios_base::sync_with_stdio(0);\r\n\tcin.tie(0);\r\n\tint t;\r\n\tif(cin>>t){\r\n\t    while(t--) s();\r\n\t}\r\n\treturn 0;\r\n}\r\n",
