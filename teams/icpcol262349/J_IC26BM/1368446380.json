  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvoid s(){\r\n    int c[4];\r\n    cin>>c[0]>>c[1]>>c[2]>>c[3];\r\n    string a=\"\";\r\n    for(int l=0;l<4;l++){\r\n        if(c[l]==0) continue;\r\n        int t[4];\r\n        for(int i=0;i<4;i++) t[i]=c[i];\r\n        t[l]--;\r\n        int p1=min(t[0],t[3]);\r\n        t[0]-=p1; t[3]-=p1;\r\n        int p2=min(t[0],t[1]);\r\n        t[0]-=p2; t[1]-=p2;\r\n        int p3=min(t[1],t[3]);\r\n        t[1]-=p3; t[3]-=p3;\r\n        int p4=t[1]/2;\r\n        t[1]-=p4*2;\r\n        int z=2*(p1+p2)+t[0]+t[2];\r\n        int n01=p3+p4;\r\n        int o=t[1]+t[3];\r\n        string r=\"\";\r\n        r.reserve(z+n01*2+o+2);\r\n        r.append(z,'0');\r\n        for(int i=0;i<n01;i++) r+=\"01\";\r\n        r.append(o,'1');\r\n        if(l==0) r+=\"00\";\r\n        else if(l==1) r+=\"01\";\r\n        else if(l==2) r+=\"10\";\r\n        else if(l==3) r+=\"11\";\r\n        if(a==\"\" or r<a) a=r;\r\n    }\r\n    cout<<a<<\"\\n\";\r\n}\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--) s();\r\n\treturn 0;\r\n};\r\n",
