  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m=3*n;\r\n\t    vector<long long>a(m+1),pref(m+1);\r\n\t    for(int i=1;i<=m;i++)cin>>a[i];\r\n\t    sort(a.begin()+1, a.end(), greater<long long>());\r\n\t    for(int i=1;i<=m;i++)pref[i]=pref[i-1]+a[i];\r\n\t    long long ans=0;\r\n\t    for(int x=0;x<=n;x++){\r\n\t        int lo=0;\r\n\t        int hi=n-x;\r\n\t        while(lo < hi){\r\n\t            int b=(lo + hi)/2;\r\n\t            int k = x+2*b;\r\n\t            int w=3*n-2 * x-b;\r\n\t            long long delta=(pref[k+2]-pref[k]) - 3LL * (pref[w]-pref[w-1]);\r\n\t            if(delta >= 0)lo = b+1;\r\n\t            else hi = b;\r\n\t        }\r\n\t        for(int b:{lo, lo-1}){\r\n\t            if(b<0 || b>n-x)continue;\r\n\t            int k=x+2*b;\r\n\t            int w=3*n-2*x-b;\r\n\t            long long cur=2LL*pref[x]+pref[k]+ 3LL*pref[w];\r\n\t            ans = max(ans, cur);\r\n\t        }\r\n\t    }\r\n\t    cout << ans << '\\n';\r\n\t}\r\n    return 0;\r\n}\r\n",
