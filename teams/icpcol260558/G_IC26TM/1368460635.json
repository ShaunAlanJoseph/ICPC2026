  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\n\r\nint main() {\r\n\t// Never say Never\r\n\t\r\n\tint t;\r\n\tcin >> t;\r\n\twhile(t--){\r\n\t    \r\n\t    int n; \r\n\t    cin >> n;\r\n\t    int m = 3*n;\r\n\t    vector<ll> vim(m);\r\n\t    for(auto &x:vim) cin>>x;\r\n\t    sort(vim.rbegin(),vim.rend());\r\n\t    \r\n\t    vector<ll> Pp(m+1,0);\r\n\t    \r\n\t    for(int i=0;i<m;i++) Pp[i+1] =Pp[i]+vim[i];\r\n\t    \r\n\t    auto fnc =[&](int a, int b) ->ll {\r\n\t        return 2*Pp[a] +Pp[a+2*b] + 3 * Pp[m-2 * a- b];\r\n\t    };\r\n\t    \r\n\t    ll ans = 0;\r\n\t    for (int a = 0 ; a<=n;a++){\r\n\t // i think we need to make f(a,b) concave in b naa so for that - b -- [0,n-as];\r\n\t      int lo = 0, hi = n-a;\r\n\t      while (lo<hi){\r\n\t          int mid = (lo+hi)/2;\r\n\t          if(fnc(a,mid+1)> fnc(a,mid)) lo = mid + 1;\r\n\t          else hi = mid;\r\n\t      }\r\n\t      ans = max(ans, fnc(a,lo));\r\n\t    }\r\n\t   cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
