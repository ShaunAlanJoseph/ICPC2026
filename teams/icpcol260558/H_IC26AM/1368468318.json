  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\nconst ll MOD = 998244353;\r\nconst int N = 200005;\r\n\r\n\r\nll inverse_[N], Hero[N];\r\n\r\nint main() {\r\n\t// marlboro RED.\r\n\t\r\n\tinverse_[1]=1;\r\n\tfor(int i=2;i<N;i++) inverse_[i] =(MOD -(MOD/i)*inverse_[MOD%i]%MOD) %MOD;\r\n\tHero[0]=0;\r\n\tfor(int i=1;i<N;i++) Hero[i] = Hero[i-1] + inverse_[i] % MOD;\r\n\t\r\n    int t;\r\n    cin >> t;\r\n    while(t--){\r\n        \r\n        int n;\r\n        cin >> n;\r\n        \r\n        ll ans = 0;\r\n        \r\n        for(int j=1;j<=n;j++){\r\n            ll a;\r\n            cin >> a;\r\n            ll c = (Hero[j-1]+Hero[n-j])%MOD;\r\n            ans = (ans +a%MOD *c)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n}\r\n",
