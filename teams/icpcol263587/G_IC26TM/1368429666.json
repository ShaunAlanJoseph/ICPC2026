  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ninput=sys.stdin.readline\r\nfor _ in range(int(input())):\r\n    n=int(input())\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    s=[0]\r\n    for x in a:\r\n        s.append(s[-1]+x)\r\n    \r\n    def f(A,B):\r\n        j=A+2*B\r\n        k=3*n-2*A-B\r\n        return 2*s[A]+s[j]+3*s[k]\r\n        \r\n    ans=0\r\n    \r\n    for A in range(n+1):\r\n        l,r=0,n-A\r\n        while l<r:\r\n            m=(l+r)//2\r\n            if f(A,m)<=f(A,m+1):\r\n                l=m+1\r\n            else:\r\n                r=m\r\n        ans=max(ans,f(A,l))\r\n    print(ans)",
