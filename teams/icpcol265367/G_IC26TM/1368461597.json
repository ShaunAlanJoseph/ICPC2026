  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long> a(3*n);\r\n    for(ll &x:a)cin>>x;\r\n    sort(a.rbegin(),a.rend());\r\n    vector<ll> p(3*n+1);\r\n    for(int i=0;i<3*n;i++){\r\n        p[i+1]=p[i]+a[i];\r\n    }\r\n    ll ans=0;\r\n    for(int x=0;x<=n;x++){\r\n        auto f=[&](int y){\r\n            return 2LL*p[x]+p[x+2*y]+3LL*p[3*n-2*x-y];\r\n        };\r\n        int l=0,r=n-x;\r\n        while(l<r){\r\n            int m=(l+r)/2;\r\n            if(f(m)<=f(m+1)){\r\n                l=m+1;\r\n            }else{\r\n                r=m;\r\n            }\r\n        }\r\n        ans=max(ans,f(l));\r\n    }\r\n    cout<<ans<<endl;\r\n\t}\r\n\r\n}\r\n",
