  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n#define mod  998244353\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin >> t;\r\n\t\r\n\tvector<long long>hing(200005) , vis(200005);\r\n\thing[0] = 0;\r\n\thing[1] = 1;\r\n\tvis[1] = 1;\r\n\t\r\n\tfor(int i = 2 ; i < 200005 ; i++){\r\n\t    vis[i] = mod-(mod/i) * vis[mod % i] % mod;\r\n\t    hing[i] = (hing[i-1] + vis[i]) % mod;\r\n\t}\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin >> n;\r\n\t    \r\n\t    long long res = 0, ans;\r\n\t    \r\n\t    for(int i = 1 ; i <= n ; i++){\r\n\t        cin >> ans;\r\n\t        \r\n\t        res = (res + ans * ((hing[i-1] + hing[n-i]) % mod)) % mod;\r\n\t    }\r\n\t    \r\n\t    cout << res << endl;\r\n\t}\r\n\r\n}\r\n",
