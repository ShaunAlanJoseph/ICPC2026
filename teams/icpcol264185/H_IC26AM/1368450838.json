  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    long long t, m = 998244353;\r\n    auto p = [&](auto& f, long long b, long long e) -> long long {\r\n        return e ? (e & 1 ? b * f(f,b, e - 1) % m : f(f, b * b % m, e / 2)) : 1;\r\n    };\r\n    auto s = [&](){\r\n        int n;\r\n        cin >> n;\r\n        vector <long long> a(n), h(n, 0);\r\n        for(long long &x : a) cin >> x;\r\n        for(int i = 1; i < n; i++) h[i] = (h[i - 1] + p(p, i, m - 2)) % m;\r\n        long long z = 0;\r\n        for(int i = 0; i < n; i++) z = (z + a[i] * (h[i] + h[n - 1 - i]) % m) % m;\r\n        cout << z << endl;\r\n    };\r\n    for(cin >> t; t--;) s();\r\n}\r\n",
