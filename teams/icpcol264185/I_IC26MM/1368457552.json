  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n    int t;\r\n    cin >> t;\r\n    auto f = [&](){\r\n        int n, x; cin >> n;\r\n        vector<vector<int>> P(n + 1);\r\n        for(int i = 1; i <= n; i++) cin >> x, P[x].push_back(i);\r\n        vector<long long> v(n + 1, 0);\r\n        v[0] = 1;\r\n        auto A = [](int a, int b){ return a > b ? a : b;};\r\n        auto B = [](int a, int b){ return a < b ? a : b;};\r\n        for(int x = 1; x <= n; x++){\r\n            vector<long long> u(n + 1, 0);\r\n            for(int l = 0; l < x; l++){\r\n                if(!v[l]) continue;\r\n                for(int d = 0; d < 2; d++){\r\n                    if(x == n && !d) continue;\r\n                    int c = l + d, o = 1;\r\n                    for(int i : P[x]){\r\n                        int p = d ? c : n - x + c + 1;\r\n                        int F = B(c, i) + A(0, i - n + x - c);\r\n                        int S = A(0, c - i + 1) + B(x - c, n - i + 1);\r\n                        o &= ((p <= i) && (F == (i + 1) / 2)) || ((p >= i) && (S == (n - i + 2) / 2));\r\n                    }\r\n                    if(o) u[c] = (u[c] + v[l]) % 998244353;\r\n                }\r\n            }\r\n            v = u;\r\n        }\r\n        long long ppg = 0;\r\n        for(long long y : v) ppg = (ppg + y) % 998244353;\r\n        cout << ppg << endl;\r\n        \r\n    };\r\n    while(t--) f();\r\n    return 0;\r\n}\r\n",
