  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nvoid solve(){\r\n    int n;\r\n    cin >> n;\r\n    vector<long long> a(3*n);\r\n    for (int i =0;i<3*n;++i){\r\n        cin>>a[i];\r\n    }\r\n    \r\n    sort(a.begin(),a.end());\r\n    \r\n    vector<long long> p(3*n+1,0);\r\n    for (int i=0;i<3*n;++i){\r\n        p[i+1]=p[i]+a[i];\r\n    }\r\n    \r\n    auto f = [&](int x,int y){\r\n        return 2LL * p[3 * n - x] + p[3 * n - x - 2 * y]  + 3LL * p[2 * x + y];\r\n    };\r\n    \r\n    long long min_f=4e18;\r\n    for(int x=0;x <= n; ++x) {\r\n        int l = 0, r = n - x;\r\n        while (l < r) {\r\n            int m = l + (r-l) / 2;\r\n            if (f(x, m) < f(x, m + 1)) {\r\n                r = m;\r\n            } else {\r\n                l = m + 1;\r\n            }\r\n        }\r\n        min_f = min(min_f, f(x, l));\r\n    }\r\n    cout << 6LL * p[3 * n] - min_f << \"\\n\";\r\n}\r\n\r\nint main() {\r\n    ios_base::sync_with_stdio(false);\r\n    cin.tie(NULL);\r\n    int t;\r\n    if (cin >> t) {\r\n        while (t--) {\r\n            solve();\r\n        }\r\n    }\r\n    return 0;\r\n}",
