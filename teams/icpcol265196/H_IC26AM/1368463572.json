  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD = 998244353;\r\n\r\nint main() {\r\n    const int N = 200005;\r\n    vector<long long> inv(N), H(N,0);\r\n    inv[1] = 1;\r\n    for(int i=2; i<N; i++){\r\n        inv[i] = (MOD - (MOD / i) * inv[MOD % i] % MOD) % MOD;\r\n    }\r\n    for(int i=1; i<N; i++){\r\n        H[i] = (H[i-1] + inv[i]) %MOD;\r\n    }\r\n    \r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    long long ans = 0;\r\n\t    for(int i=1; i<=n; i++){\r\n\t        long long a;\r\n\t        cin>>a;\r\n\t        a %= MOD;\r\n\t        long long c = (H[i-1] + H[n-i]) % MOD;\r\n\t        ans = (ans + a * c) %MOD;\r\n\t    }\r\n\t    cout<<ans<<\"\\n\";\r\n\t}\r\n\t\r\n\treturn 0;\r\n\r\n}\r\n",
