  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint t; \r\n\tcin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n; \r\n        int m = 3*n;\r\n        vector<long long> v(m), P(m+1, 0);\r\n        for(auto &x : v) cin>> x;\r\n        sort(v.rbegin(), v.rend());\r\n        for(int i=0; i<m; i++){\r\n            P[i+1] = P[i] + v[i];\r\n        }\r\n        long long best = 0;\r\n        for(int b=0; b<=n; b++){\r\n            auto f = [&](int a) -> long long {\r\n                return 2 * P[a] + P[a+2*b] + 3*P[m-2 * a-b];\r\n            };\r\n            int lo = 0, hi = n-b;\r\n            \r\n            while(lo<hi){\r\n                int mid = (lo+hi)/2;\r\n                if(f(mid+1) - f(mid) <=0 ) hi = mid;\r\n                else lo = mid+1;\r\n            }\r\n            best = max(best, f(lo));\r\n        }\r\n        \r\n        cout<<best<<\"\\n\";\r\n        \r\n    }\r\n    return 0;\r\n\r\n}\r\n",
