  "source_code": "# cook your dish here\r\nfor _ in range(int(input())):\r\n    k=int(input())\r\n    n=3*k\r\n    a=sorted(map(int,input().split()),reverse=True)\r\n    p=[0]\r\n    for x in a: p.append(p[-1]+x)\r\n    b=k\r\n    ans=0\r\n    for A in range(k+1):\r\n        b=min(b,k-A)\r\n        while b and a[A+2*b-2]+a[A+2*b-1]<3*a[n-2*A-b]:\r\n            b-=1\r\n        P=n-2*A-b\r\n        ans=max(ans,3*p[P]+2*p[A]+p[A+2*b])\r\n    print(ans)\r\n    ",
