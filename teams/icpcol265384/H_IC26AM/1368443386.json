  "source_code": "# cook your dish here\r\nPoRiHa=998244353\r\nprh=int(input())\r\nfor _ in range(prh):\r\n    ritn=int(input())\r\n    pooja=list(map(int, input().split()))\r\n    hars=[0]*ritn\r\n    for i in range(1,ritn):\r\n        hars[i]=(hars[i-1]+pow(i,PoRiHa-2,PoRiHa))%PoRiHa\r\n    san=0\r\n    for i in range(ritn):\r\n        san+=pooja[i]*(hars[i]+ hars[ritn-i-1])\r\n        san%=PoRiHa\r\n    print(san)",
