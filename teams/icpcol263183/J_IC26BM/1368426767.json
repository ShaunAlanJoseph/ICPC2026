  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nusing ll = long long;\r\n\r\nstring solving(int a, int b , int c, int d){\r\n    string res = \"\";\r\n    int x= min(a,b+d);\r\n    int d11 = min(d,x);\r\n    int d01 = x -d11;\r\n    a -= x;\r\n    b -= d01;\r\n    d -= d11;\r\n    \r\n    int y = min(b,(b+d)/2);\r\n    \r\n    int zeros = a+c;\r\n    int ones = b+d- 2*y;\r\n    res.append(2*x + zeros, '0');\r\n    for(int i = 0; i<y; i++) res+= \"01\";\r\n    res.append(ones, '1');\r\n    return res;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n\tint tc;\r\n\tcin >> tc;\r\n\t\r\n\twhile(tc--)\r\n\t{\r\n\t    vector<int> c(4);\r\n\t    \r\n\t    for(auto &x : c) cin >> x;\r\n\t    \r\n\t    string res = \"\";\r\n\t    \r\n\t    string choice[4] = {\"00\", \"01\", \"10\", \"11\"};\r\n\t    \r\n\t    bool x = 0;\r\n\t    for(int i = 0; i< 4; i++){\r\n\t        if(c[i] == 0){\r\n\t            continue;\r\n\t        }\r\n\t        vector<int> arr = c;\r\n\t        arr[i]--;\r\n\t        string curr = solving(arr[0], arr[1], arr[2], arr[3]);\r\n\t        curr += choice[i];\r\n\t        if(res.size() == 0 || curr < res) res = curr;\r\n\t    }\r\n\t    cout<<res<<endl;\r\n\t}\r\n\r\n}\r\n",
