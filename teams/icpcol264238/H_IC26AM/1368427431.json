  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll= long long;\r\nconst ll MOD= 998244353;\r\nint main() {\r\n\tint t;\r\n\tcin>>t;\r\n\tvector<int> ns(t);\r\n\tvector<vector<ll>> a(t);\r\n\tint mx=1;\r\n\tfor(int tc=0; tc<t; tc++){\r\n\t   int n;\r\n\t   cin>>n;\r\n\t   ns[tc]=n;\r\n\t   mx= max(mx, n);\r\n\t   a[tc].resize(n);\r\n\t   for(auto &x: a[tc]){\r\n\t       cin>>x;\r\n\t   }\r\n\t}\r\n\t   vector<ll> inv(mx+1);\r\n\t   vector<ll> h(mx+1);\r\n\t   if(mx>=1) inv[1]=1;\r\n\t   for(int i=2; i<=mx; i++){\r\n\t       inv[i]= MOD- (MOD/i) * inv[MOD%i]%MOD;\r\n\t   }\r\n\t   for(int i=1; i<=mx; i++){\r\n\t       h[i]= (h[i-1]+inv[i])%MOD;\r\n\t   }\r\n\t   for(int tc=0; tc<t; tc++){\r\n\t       int n= ns[tc];\r\n\t       ll ans=0;\r\n\t       for(int i=0; i<n; i++){\r\n\t           ll coeff= (h[i]+ h[n-i-1])%MOD;\r\n\t           ans= (ans+ a[tc][i]*coeff)%MOD;\r\n\t       }\r\n\t       cout<<ans<<'\\n';\r\n\t   }\r\n}\r\n",
