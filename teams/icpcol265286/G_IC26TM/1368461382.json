  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<int> v(3*n);\r\n    for(int i=0;i<3*n;i++) cin>>v[i];\r\n   sort(v.rbegin(),v.rend());\r\n   vector<long long> pre(3*n+1,0);\r\n   for(int i=0;i<3*n;i++){\r\n       pre[i+1]=pre[i]+v[i];\r\n   }\r\n   long long ans=0;\r\n   for(int i=0;i<=n;i++){\r\n       int l=0,r=n-i;\r\n       while(l<r){\r\n           int m=(l+r)/2;\r\n           int p=i+2*m;\r\n           int q=3*n-2*i-m;\r\n           long long cur=2*pre[i]+pre[p]+3*pre[q];\r\n           p=i+2*(m+1);\r\n           q=3*n-2*i-(m+1);\r\n           long long nxt=2*pre[i]+pre[p]+3*pre[q];\r\n           if(cur<=nxt) l=m+1;\r\n           else r=m;\r\n       }\r\n       int y=l;\r\n       int p=i+2*y;\r\n       int q=3*n-2*i-y;\r\n       long long cur=2*pre[i]+pre[p]+3*pre[q];\r\n       ans=max(ans,cur);\r\n   }\r\n   cout<<ans<<endl;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tios_base::sync_with_stdio(false);\r\n\tcin.tie(NULL);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\n\r\n}\r\n",
