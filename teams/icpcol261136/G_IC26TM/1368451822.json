  "source_code": "# cook your dish here\r\nimport sys\r\ninput = sys.stdin.buffer.readline\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    a.sort(reverse = True)\r\n    pref = [0] * ( 3 * n + 1)\r\n    for i in range(3 * n):\r\n        pref[i+1] = pref[i] + a[i]\r\n    \r\n    answer = 0\r\n    for n1 in range(n + 1):\r\n        low = 0\r\n        high = n - n1\r\n        \r\n        while low < high:\r\n            mid = (low + high)//2 \r\n            \r\n            p = n1 + 2 * mid\r\n            m = 3 * n -2 * n1 - mid\r\n            delta = a[p] + a[p+1] - 3 * a[m-1] \r\n            if delta > 0:\r\n                low = mid + 1 \r\n            else:\r\n                high = mid\r\n        for n2 in (low, low-1):\r\n            if(n2<0):\r\n                continue\r\n            p = n1 + 2*n2\r\n            m = 3*n -2 * n1 - n2\r\n            cur = (6*pref[n1] + 4*(pref[p]-pref[n1]) + 3*(pref[m]-pref[p]))\r\n            answer = max(answer, cur)\r\n            \r\n    print(answer)\r\n    ",
