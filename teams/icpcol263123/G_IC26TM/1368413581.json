  "source_code": "# cook your dish here\r\nimport sys\r\n\r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    t = int(data[0]);pos=1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[pos]);pos+=1\r\n        m = 3*n \r\n        arr = sorted(map(int,data[pos:pos+m]),reverse=True)\r\n        pos+=m \r\n        \r\n        P =[0]*(m+1)\r\n        for i in range(m):\r\n            P[i+1] = P[i] + arr[i]\r\n        \r\n        best = 0\r\n        for a in range(n+1):\r\n            lo,hi = 0,n-a\r\n            base = m-2*a-1\r\n            while lo<hi:\r\n                mid = (lo+hi)>>1 \r\n                if arr[a+2*mid]+arr[a+2*mid+1]>3*arr[base-mid]:\r\n                    lo = mid+1 \r\n                else:\r\n                    hi = mid\r\n            v = 2*P[a]+P[a+2*lo]+3*P[m-2*a-lo]\r\n            if v>best:\r\n                best = v \r\n        out.append(best)\r\n        \r\n    print(\"\\n\".join(map(str,out)))\r\nmain()\r\n",
