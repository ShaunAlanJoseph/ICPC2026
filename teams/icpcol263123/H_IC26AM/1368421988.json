  "source_code": "# cook your dish here\r\n\r\nimport sys\r\nMOD = 998244353\r\n\r\ndef main():\r\n    data = sys.stdin.buffer.read().split()\r\n    t = int(data[0]);pos = 1\r\n    N = 200001\r\n    inv = [0,1] + [0]*(N-1)\r\n    for i in range(2,N+1):\r\n        inv[i] = (MOD-(MOD//i)*inv[MOD%i]%MOD) %MOD\r\n        \r\n    H = [0]*(N+1)\r\n    for i in range(1,N+1):\r\n        H[i] = (H[i-1]+inv[i])%MOD\r\n    \r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[pos]);pos+=1 \r\n        res = 0 \r\n        for i in range(1,n+1):\r\n            res += int(data[pos+i-1])*(H[i-1]+H[n-i])\r\n        pos += n \r\n        out.append(res%MOD)\r\n    \r\n    print(\"\\n\".join(map(str,out)))\r\n\r\nmain()\r\n    ",
