  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long> arr(3*n);\r\n    for(auto &x:arr)\r\n    cin>>x;\r\n    sort(arr.rbegin(),arr.rend());\r\n    vector<long long> p(3*n+1,0);\r\n    for(int i=0;i<3*n;i++){\r\n        p[i+1]=p[i]+arr[i];\r\n        \r\n    }\r\n    long long res=0;\r\n    for(int x=0;x<=n;x++){\r\n        int l=0,h=n-x;\r\n        while(l<h){\r\n            int y=(l+h)/2;\r\n            long long g=p[x+2*y+2]-p[x+2*y]-3*(p[3*n-2*x-y]-p[3*n-2*x-y-1]);\r\n            if(g>=0){\r\n                l=y+1;\r\n            }\r\n            else\r\n            h=y;\r\n        }\r\n        for(int y:{l,l-1}){\r\n            if(y<0||y>n-x)\r\n            continue;\r\n            long long curr=6*p[x]+4*(p[x+2*y]-p[x])+3*(p[3*n-2*x-y]-p[x+2*y]);\r\n            res=max(res,curr);\r\n        }\r\n    }\r\n    cout<<res<<'\\n';\r\n}\r\nint main() {\r\n\tios::sync_with_stdio(false);\r\n\tcin.tie(nullptr);\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    solve();\r\n\t}\r\nreturn 0;\r\n}\r\n",
