  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nvoid solve(){\r\n    int n;\r\n    cin>>n;\r\n    vector<long long> arr(n);\r\n    for(auto &x:arr){\r\n        cin>>x;\r\n    }\r\n    vector<long long> inv(n+1),h(n+1);\r\n    if(n>=1)\r\n    inv[1]=1;\r\n    for(int i=2;i<=n;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    for(int i=1;i<=n;i++){\r\n        h[i]=(h[i-1]+inv[i])%MOD;\r\n    }\r\n    long long res=0;\r\n    for(int i=0;i<n;i++){\r\n        long long w=(h[i]+h[n-1-i])%MOD;\r\n        res=(res+(arr[i]%MOD)*w)%MOD;\r\n    }\r\n    cout<<res<<'\\n';\r\n}\r\nint main() {\r\n\t// your code goes here\r\n ios::sync_with_stdio(false);\r\n cin.tie(nullptr);\r\n int t;\r\n cin>>t;\r\n while(t--){\r\n     solve();\r\n }\r\n return 0;\r\n}\r\n",
