  "source_code": "t=int(input())\r\nMOD=998244353\r\n\r\nwhile(t>0):\r\n    t-=1\r\n    n=int(input())\r\n    *a, = map(int, input().split())\r\n    \r\n    f=[0]*n\r\n    suum=0\r\n    for i in range(1,n):\r\n        f[i] = (1 + ((pow(i,-1,MOD)*suum)%MOD))%MOD\r\n        suum = (suum+f[i])%MOD\r\n        \r\n    ans=0\r\n    for i in range(n):\r\n        ans = (ans+((a[i]*((f[i]+f[n-1-i])%MOD))%MOD))%MOD\r\n    \r\n    print(ans)\r\n        ",
