  "source_code": "import sys\r\n\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\n\r\nfor _ in range(t):\r\n    n = int(input())\r\n    a = list(map(int, input().split()))\r\n    \r\n    a.sort(reverse=True)\r\n    \r\n    pref = [0] * (3 * n + 1)\r\n    for i in range(3 * n):\r\n        pref[i + 1] = pref[i] + a[i]\r\n    \r\n    ans = 0\r\n    \r\n    for p in range(n + 1):\r\n        \r\n        lo = 0\r\n        hi = n - p\r\n        \r\n        def value(q):\r\n            b = p + 2 * q\r\n            c = 3 * n - 2 * p - q\r\n            \r\n            return(\r\n                2 * pref[p]\r\n                + pref[b]\r\n                + 3 * pref[c]\r\n            )\r\n        \r\n        while lo < hi:\r\n            mid = (lo + hi) // 2\r\n            \r\n            if value(mid) <= value(mid + 1):\r\n                \r\n                lo = mid + 1\r\n            else:\r\n                hi = mid\r\n                    \r\n        ans = max(ans, value(lo))\r\n    print(ans)",
