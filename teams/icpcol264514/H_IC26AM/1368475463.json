  "source_code": "MOD = 998244353\r\nimport sys\r\n\r\ninput = sys.stdin.readline\r\n\r\nt = int(input())\r\ntests = []\r\nmx = 1\r\n\r\nfor _ in range (t):\r\n    n = int(input())\r\n    a = list(map(int,input().split()))\r\n    tests.append((n,a))\r\n    mx = max(mx,n)\r\n    \r\ninv = [0]*(mx + 1)\r\ninv [1] = 1\r\nfor i in range(2, mx + 1):\r\n    inv[i]=MOD - (MOD // i) * inv[MOD % i] % MOD\r\n\r\n\r\nh = [0] * (mx + 1)\r\nfor i in range (1,mx + 1):\r\n    h[i] = (h[i-1] + inv[i]) % MOD\r\n\r\nfor n, a in tests:\r\n    ans = 0\r\n    for i in range(n):\r\n        ans += a[i]*(h[i]+h[n-i-1])\r\n    print(ans % MOD)",
