  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\nint t;\r\ncin>>t;\r\n\r\nwhile(t--)\r\n{\r\n    int n;\r\n    cin>>n;\r\n    \r\n    vector<ll>inv(n+1),H(n+1,0);\r\n    \r\n    if(n>=1)inv[1]=1;\r\n    \r\n    for(int i=2;i<=n;i++)\r\n    {\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    \r\n    for(int i=1;i<=n;i++)\r\n    {\r\n        H[i]=(H[i-1]+inv[i])%MOD;\r\n    }\r\n    \r\n    ll ans=0;\r\n    \r\n    for(int i=0;i<n;i++)\r\n    {\r\n        ll a;\r\n        cin>>a;\r\n        \r\n        ll coeff=(H[i]+H[n-1-i])%MOD;\r\n        ans=(ans+(a%MOD)*coeff)%MOD;\r\n    }\r\n    cout<<ans<<endl;\r\n}\r\nreturn 0;\r\n}\r\n",
