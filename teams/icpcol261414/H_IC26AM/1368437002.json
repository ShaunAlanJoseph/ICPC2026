  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long MOD=998244353;\r\nconst int MAXN=200000+5;\r\nlong long inv[MAXN],H[MAXN];\r\n\r\nint main() {\r\n    ios::sync_with_stdio(false);\r\n    cin.tie(nullptr);\r\n    inv[1]=1;\r\n    for(int i=2;i<MAXN;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n    }\r\n    H[0]=0;\r\n    for(int i=1;i<MAXN;i++){\r\n        H[i]=(H[i-1]+inv[i])%MOD;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        long long ans=0;\r\n        for(int j=1;j<=n;j++){\r\n            long long a;\r\n            cin>>a;\r\n            long long coefficient=(H[j-1]+H[n-j])%MOD;\r\n            ans=(ans+(a%MOD)*coefficient)%MOD;\r\n            \r\n        }\r\n        cout<<ans<<'\\n';\r\n    }\r\n    return 0;\r\n\t// your code goes here\r\n\r\n}\r\n",
