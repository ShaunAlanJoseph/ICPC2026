  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst int MAXN=200000;\r\nconst long long MOD = 998244353;\r\nint main() {\r\n\t// your code goes here\r\n\tvector<long long>res(MAXN+1), hr(MAXN+1,0);\r\n\tres[1]=1;\r\n\tfor(int i=2; i<=MAXN; i++){\r\n\t    res[i]=(MOD-MOD/i)*res[MOD%i]%MOD;\r\n\t}\r\n\tfor(int m=1; m<=MAXN; m++){\r\n\t    hr[m]=(hr[m-1]+res[m])%MOD;\r\n\t}\r\n    int t;\r\n    cin>>t;\r\n    while(t--){\r\n        int n;\r\n        cin>>n;\r\n        long long ans=0;\r\n        for(int i=1; i<=n; i++){\r\n            long long val;\r\n            cin>>val;\r\n            long long em=(hr[i-1]+hr[n-i])%MOD;\r\n            long long new_val=val%MOD*em;\r\n            ans=(ans+new_val)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n    return 0;\r\n}\r\n",
