  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing int64 = long long;\r\nconst int64 MOD = 998244353;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint T; cin >> T;\r\n\twhile(T--){\r\n\t    int n; cin >> n;\r\n\t    vector<int64> a(n);\r\n\t    for(auto &x : a) cin >> x;\r\n\t    if (n ==1){\r\n\t        cout << 0 << '\\n';\r\n\t        continue;\r\n\t    }\r\n\t    vector<int64> inv(n+1);\r\n\t    inv[1] = 1;\r\n\t    for(int i = 2; i <= n; ++i){\r\n\t        inv[i] = MOD - (MOD/i) * inv[MOD % i] % MOD;\r\n\t    }\r\n\t    vector<int64> H(n+1, 0);\r\n\t    for(int i = 1; i <= n; ++i){\r\n\t        H[i] = (H[i-1] + inv[i]) % MOD;\r\n\t    }\r\n\t    int64 answer = 0;\r\n\t    for(int i = 0; i < n; ++i){\r\n\t        int64 coefficient = (H[i] + H[n-i-1]) % MOD;\r\n\t        answer = (answer + (a[i] % MOD)* coefficient)% MOD;\r\n\t    }\r\n\t    cout << answer << endl;\r\n}}\r\n",
