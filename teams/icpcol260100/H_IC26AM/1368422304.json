  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll= long long;\r\nconst ll MOD= 998244353;\r\nint main() {\r\n\t// your code goes here\r\nint t;\r\ncin>>t;\r\n//while(t--){\r\n    vector<vector<ll>> tests(t);\r\n    int maxi=0;\r\n    for(int i=0;i<t;i++){\r\n        int n;\r\n        cin>>n;\r\n        tests[i].resize(n);\r\n        for(ll &x: tests[i]) cin>>x;\r\n        maxi=max(maxi,n);\r\n    }\r\n    \r\n    vector<ll> inv(maxi+1,0);\r\n    if(maxi>=1) inv[1]=1;\r\n    for(int i=2;i<=maxi;i++){\r\n        inv[i]=MOD-(MOD/i)*inv[MOD%i] %MOD;\r\n    }\r\n    vector<ll> H(maxi+1,0);\r\n    \r\n    for(int i=1;i<=maxi;i++){\r\n        H[i]=(H[i-1]+inv[i])%MOD;\r\n    }\r\n    for(int ii=0;ii<t;ii++){\r\n        int n= tests[ii].size();\r\n        ll ans= 0;\r\n        for(int i=0;i<n;i++){\r\n            ll coff= (H[i]+H[n-1-i])%MOD;\r\n            \r\n            ans=(ans+tests[ii][i]*coff)%MOD;\r\n        }\r\n        cout<<ans<<endl;\r\n    }\r\n   \r\n\r\nreturn 0;\r\n}\r\n",
