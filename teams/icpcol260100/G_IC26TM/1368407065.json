  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll= long long;\r\nint main() {\r\n\t// your code goes here\r\nint t;cin>>t;\r\nwhile(t--){\r\n    int n;cin>>n;\r\n    int m= 3*n;\r\n    vector<ll> a(m);\r\n    for(ll &x: a) cin>>x;\r\n    \r\n    sort(a.rbegin(), a.rend());\r\n    vector<ll> pre(m+1,0);\r\n    \r\n    for(int i=0;i<m;i++) pre[i+1]=pre[i]+a[i];\r\n    \r\n    auto getv=[&] (int A,int B) -> ll{\r\n        int post1=A;\r\n        int post2= A+2*B;\r\n        int pos3= 3*n-2*A-B;\r\n        \r\n        ll ans=0;\r\n        ans+=6LL*pre[post1];\r\n        ans+=4LL*(pre[post2]-pre[post1]);\r\n        ans+= 3LL*(pre[pos3]-pre[post2]);\r\n        return ans;\r\n    };\r\n    ll answer=0;\r\n    for(int A=0;A<=n;A++){\r\n        int lo= 0;\r\n        int hi= n-A;\r\n        while(lo<hi){\r\n            int mid= (lo+hi)/2;\r\n            ll cur= getv(A,mid);\r\n            ll next= getv(A,mid+1);\r\n            if(next>=cur) lo=mid+1;\r\n            else hi= mid;\r\n        }\r\n        answer=max(answer, getv(A,lo));\r\n    }\r\n    cout<<answer<<'\\n';\r\n}\r\nreturn 0;\r\n}\r\n",
