  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nconst ll MOD = 998244353;\r\nconst int MAXN = 200000;\r\n\r\nint main() {\r\n\t// your code goes here\r\n    vector<ll> inverse(MAXN + 1);\r\n    vector<ll> harmonic(MAXN + 1, 0);\r\n    \r\n    inverse[1] = 1;\r\n    \r\n    for(int i=2; i<=MAXN; i++){\r\n        inverse[i] = MOD - (MOD/i) * inverse[MOD % i] % MOD;\r\n    }\r\n    \r\n    for(int i=1; i<=MAXN; i++){\r\n        harmonic[i]= (harmonic[i-1] + inverse[i]) % MOD;\r\n    }\r\n    \r\n    int t;\r\n    \r\n    cin>>t;\r\n    \r\n    while(t--){\r\n        int n;\r\n        cin >>n;\r\n        \r\n        vector<ll> a(n);\r\n        \r\n        for(ll &x : a){\r\n            cin >> x;\r\n        }\r\n        ll ans = 0;\r\n        \r\n        for(int i=0; i<n; i++){\r\n            ll contri = (harmonic[i] + harmonic[n-1-i]) % MOD;\r\n            ans = (ans+a[i] * contri) % MOD;\r\n        }\r\n        cout << ans << \"\\n\";\r\n    }\r\n    return 0;\r\n}\r\n",
