  "source_code": "import sys\r\n\r\nMOD = 998244353\r\n\r\ndef solve():\r\n    input = sys.stdin.read\r\n    \r\n    data = input().split()\r\n    if not data:\r\n        return \r\n    \r\n    t = int(data[0])\r\n    idx = 1\r\n\r\n    MAX_N = 200005\r\n    inv = [0] * MAX_N\r\n    inv[1] = 1\r\n    for i in range(2, MAX_N): \r\n        inv[i] = MOD - (MOD//i) * inv[MOD % i] % MOD\r\n        \r\n    H = [0] * MAX_N\r\n    for i in range(1, MAX_N):\r\n        H[i] = (H[i-1] + inv[i]) % MOD\r\n        \r\n    out= []\r\n    \r\n    for _ in range(t):\r\n        n = int(data[idx])\r\n        idx += 1\r\n        \r\n        a = [int(x) for x in data[idx:idx + n]]\r\n        idx += n \r\n        if n== 1:\r\n            out.append(\"0\")\r\n            continue\r\n        \r\n        ans = 0 \r\n        for i in range(1, n +1):\r\n            weight = (H[i-1] + H[n-i]) % MOD\r\n            ans = (ans + a[i-1] * weight) % MOD\r\n            \r\n        out.append(str(ans))\r\n        \r\n    print('\\n'.join(out))\r\n    \r\nsolve()",
