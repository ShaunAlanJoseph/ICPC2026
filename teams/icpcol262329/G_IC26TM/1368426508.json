  "source_code": "import sys \r\ninput = sys.stdin.readline\r\n\r\ndef solve():\r\n    t = int(input())\r\n    \r\n    for _ in range(t):\r\n        n = int(input())\r\n        a = list(map(int, input().split()))\r\n        \r\n        a.sort(reverse=True)\r\n        \r\n        pref = [0] * (3 * n + 1)\r\n        for i in range(3 * n):\r\n            pref[i + 1] = pref[i] + a[i]\r\n            \r\n        def score(p, q):\r\n            \r\n            return (2 * pref[p] + pref[p + 2 * q] + 3 * pref[3 * n - 2 * p -q])\r\n            \r\n        Anus = 0\r\n        q = n\r\n        \r\n        for p in range(n + 1):\r\n            q = min(q, n - p)\r\n            while q > 0 and score(p, q - 1) >= score(p, q):\r\n                q -= 1\r\n            Anus = max(Anus, score(p, q))\r\n        print(Anus)\r\n        \r\nsolve()",
