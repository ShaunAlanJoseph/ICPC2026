  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\tint tt; cin >> tt;\r\n\twhile(tt--){\r\n\tint n; cin >> n; \r\n\tvector<int> a(n); for(auto& it : a) cin >> it; \r\n\tvector<int> diff;\r\n\tfor(int i = 1; i < n; i++){\r\n\t    diff.push_back(abs(a[i] - a[i-1]));\r\n\t}\r\n\tdiff.push_back(abs(a[0] - a[n-1]));\r\n\tsort(diff.rbegin(),diff.rend());\r\n\tif(diff.size() > 1) cout << diff[1] << '\\n';\r\n\telse cout << diff[0] <<'\\n';\r\n\t}\r\n\t\r\n}\r\n",
