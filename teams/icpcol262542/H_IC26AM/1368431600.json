  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\ntypedef long long ll;\r\n\r\nll MOD = 998244353;\r\n\r\nll modpow(ll n, ll r){\r\n    ll x = r, ans = 1;\r\n    while (x) {\r\n        if (x%2 == 1) ans = (ans*n)%MOD;\r\n        if(x==1)break;\r\n        x = x>>1;\r\n        n = (n*n)%MOD;\r\n    }\r\n    return ans;\r\n}\r\n\r\nll modinv(ll n){\r\n    return modpow(n,MOD-2LL);\r\n}\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;cin>>t;\r\n\twhile(t--){\r\n\t    ll n;cin>>n;\r\n\t    vector<ll> add(n+1,0);\r\n\t    for(int i=1;i<=n;i++){\r\n\t        ll temp=modinv(i);\r\n\t        add[i] = (add[i-1]+temp)%MOD;\r\n\t    }\r\n\t    ll ans = 0;\r\n\t    vector<ll> a(n);\r\n\t    for(int i=0;i<n;i++)cin>>a[i];\r\n\t    for(int i=0;i<n;i++){\r\n\t        ll temp2 = (add[i]+add[n-1-i])%MOD;\r\n\t        ans  = (ans + (temp2*a[i])%MOD)%MOD;\r\n\t    }\r\n\t    cout << ans << \"\\n\";\r\n\t}\r\n    \r\n}\r\n",
