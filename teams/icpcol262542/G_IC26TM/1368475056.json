  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n#define ll long long\r\n#define loop(i, n) for (int i = 0; i < n; i++)\r\n\r\nint main() {\r\n\tint t, n;\r\n\tcin >> t;\r\n\twhile (t--) {\r\n\t    cin >> n;\r\n\t    ll a[3*n];\r\n\t    ll sum = 0;\r\n\t    loop (i, 3*n) {\r\n\t        cin >> a[i];\r\n\t        sum += a[i];\r\n\t    }\r\n\t    sort(a, a+3*n);\r\n\t    ll temp = 0;\r\n\t    ll tempmax = temp;\r\n\t    ll j = 3*n-1;\r\n\t    ll k = 3*n-1;\r\n\t    bool is = false;\r\n\t    loop (i, 3*n) {\r\n\t        temp -= 3*a[i];\r\n\t        if (k == j && j >= 1) {\r\n\t            temp += a[j] + a[j-1];\r\n\t            j -= 2;\r\n\t        } else if (j >= 1 && j <= 3*n-2) {\r\n\t            if (a[k]*2 > a[j+1] + a[j] + a[j-1]) {\r\n\t                temp += 2*a[k]-a[j+1];\r\n\t                k--; j++;\r\n\t            } else {\r\n\t                temp += a[j] + a[j-1];\r\n\t                j -= 2;\r\n\t            }\r\n\t        } else if (j == 0) {\r\n\t            temp += 2*a[k]-a[j+1];\r\n\t            k--; j++;\r\n\t        }\r\n\t        tempmax = max(tempmax, temp);\r\n\t        if (temp < 0) break;\r\n\t    }\r\n\t    cout << sum*3+tempmax << endl;\r\n\t}\r\n\r\n}\r\n",
