  "source_code": "MOD=998244353\r\n\r\nT=int(input())\r\nq=[]\r\n\r\nfor _ in range(T):\r\n    n=int(input())\r\n    a=list(map(int, input().split()))\r\n    q.append((n,a))\r\n    \r\nN=max(n for n,a in q)\r\n\r\ninv=[0]*(N+1)\r\nh=[0]*(N+1)\r\ninv[1]=1\r\n\r\nfor i in range(2,N+1):\r\n    inv[i]=MOD-(MOD//i)*inv[MOD%i]%MOD\r\n    \r\nfor i in range(1,N+1):\r\n    h[i]=(h[i-1]+inv[i])%MOD\r\n    \r\nfor n,a in q:\r\n    ans=0\r\n    \r\n    for i,x in enumerate(a):\r\n        ans=(ans+x*(h[i]+h[n-1-i]))%MOD\r\n\r\n    print(ans)",
