  "source_code": "#include <bits/stdc++.h>\r\n\r\nusing namespace std;\r\n\r\ntypedef long long ll;\r\n\r\nll score(vector < ll > & pre, int total, int i, int j) {\r\n    return 2 * pre[i] + pre[i + 2 * j] + 3 * pre[total - 2 * i - j];\r\n}\r\nvoid solve() {\r\n    int n;\r\n    cin >> n;\r\n    int total = 3 * n;\r\n\r\n    vector < ll > v(total);\r\n    for (int k = 0; k < total; k++) {\r\n        cin >> v[k];\r\n    }\r\n\r\n    sort(v.begin(), v.end(), greater < ll > ());\r\n\r\n    vector < ll > pre(total + 1, 0);\r\n    for (int k = 0; k < total; k++) {\r\n        pre[k + 1] = pre[k] + v[k];\r\n    }\r\n\r\n    ll ans = 0;\r\n    for (int i = 0; i <= n; i++) {\r\n        int lo = 0;\r\n        int hi = n - i;\r\n        while (lo < hi) {\r\n            int mid = (lo + hi) / 2;\r\n            if (score(pre, total, i, mid + 1) > score(pre, total, i, mid)) lo = mid + 1;\r\n            else hi = mid;\r\n        }\r\n        ans = max(ans, score(pre, total, i, lo));\r\n    }\r\n\r\n    cout << ans << \"\\n\";\r\n}\r\nint main() {\r\n    // your code goes here\r\n    int t;\r\n    cin >> t;\r\n    while (t--) solve();\r\n}",
