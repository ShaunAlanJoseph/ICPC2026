  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nusing ll=long long;\r\nconst ll MOD=998244353;\r\n\r\nll modpow(ll a, ll b){\r\n    ll res=1;\r\n    \r\n    while(b>0){\r\n        if(b&1){\r\n            res=res*a%MOD;\r\n        }\r\n        \r\n        a=a*a%MOD;\r\n        b>>=1;\r\n    }\r\n    return res;\r\n}\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\tconst int MAXN=200000;\r\n\t\r\n\tvector<ll> inv(MAXN+1);\r\n\tvector<ll> h(MAXN+1,0);\r\n\t\r\n\tinv[1]=1;\r\n\t\r\n\tfor(int i=2;i<=MAXN;i++){\r\n\t    inv[i]=MOD-(MOD/i)*inv[MOD%i]%MOD;\r\n\t}\r\n\t\r\n\tfor(int i=1;i<=MAXN;i++){\r\n\t    h[i]=(h[i-1]+inv[i])%MOD;\r\n\t}\r\n\t\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    ll ans=0;\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        ll x;\r\n\t        cin>>x;\r\n\t        \r\n\t        ll coefficient= (h[i]+h[n-1-i])%MOD;\r\n\t        \r\n\t        ans=(ans+(x%MOD)*coefficient)%MOD;\r\n\t    }\r\n\t    \r\n\t    cout<<ans<<endl;\r\n\t}\r\n\t\r\n\treturn 0;\r\n}\r\n",
