  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nconst long long mod = 998244353;\r\nconst int maxn = 200000;\r\nlong long mp(long long a , long long e){\r\n    long long res = 1;\r\n    while(e > 0){\r\n        if(e&1)res = res* a % mod;\r\n        a = a*a % mod;\r\n        \r\n        e >>= 1;\r\n        \r\n    }\r\n    \r\n    return res;\r\n}\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\t\r\n\t\r\n\tvector<long long> in(maxn+1);\r\n\tin[1] = 1;\r\n\t\r\n\tfor(int i=2;i<=maxn;i++){\r\n\t    in[i] = mod-(mod/i) * in[mod%i] % mod;\r\n\t    \r\n\t}\r\n\t\r\n\tvector<long long> h(maxn+1,0);\r\n\tfor(int i=1;i<=maxn;i++){\r\n\t    h[i] = (h[i-1] + in[i]) % mod;\r\n\t}\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    vector<long long> a(n);\r\n\t    \r\n\t    for(auto &x:a){\r\n\t        cin>>x;\r\n\t    }\r\n\t    long long ans = 0;\r\n\t    \r\n\t    for(int i=0;i<n;i++){\r\n\t        long long coe = (h[i]  + h[n-i-1])%mod;\r\n\t        ans = (ans+a[i] * coe)%mod;\r\n\t    }\r\n\t    cout<<ans<<endl;\r\n\t}\r\n}\r\n",
