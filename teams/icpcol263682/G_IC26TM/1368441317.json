  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\t\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--){\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    int m = 3*n;\r\n\t    \r\n\t    vector<long long> a(m);\r\n\t    \r\n\t    for(auto &x : a){\r\n\t        cin>>x;\r\n\t    }\r\n\t    sort(a.begin(),a.end(),greater<long long>());\r\n\t    \r\n\t    vector<long long> pref(m+1 , 0);\r\n\t    for(int i= 0 ; i<m ; i++){\r\n\t        pref[i+1] = pref[i]  + a[i];\r\n\t    }\r\n\t    \r\n\t    int b = n;\r\n\t    long long ans = 0;\r\n\t    \r\n\t    for(int x= 0 ; x<= n ; x++){\r\n\t        b= min(b,n-x);\r\n\t        while(b>0){\r\n\t            int oldb = b-1;\r\n\t            int left = x+2*oldb;\r\n\t            int right = 3*n-2*x-oldb;\r\n\t            long long diff= a[left] + a[left+1] - 3LL * a[right-1];\r\n\t            \r\n\t            if(diff < 0)b--;\r\n\t            else break;\r\n\t        }\r\n\t            \r\n\t            long long current  = 2LL * pref[x] + pref[x+2 * b] + 3LL* pref[3*n-2*x-b];\r\n\t            ans = max(ans,current);\r\n\t        }\r\n\t        cout<<ans<<endl;\r\n\t}\r\n}\r\n",
