  "source_code": "import sys \r\ninput = sys.stdin.readline\r\nt = int(input())\r\nfor _ in range(t):\r\n    n = int(input())\r\n    m = 3*n\r\n    a = list(map(int , input().split()))\r\n    a.sort(reverse = True)\r\n    pre = [0]*(m+1)\r\n    for i in range(m):\r\n        pre[i+1] = pre[i] + a[i]\r\n        \r\n        \r\n    def cal(A,B):\r\n        C = n-A-B\r\n        ans = 0\r\n        ans += 6*pre[A]\r\n        ans += 4 * (pre[A+2 * B] - pre[A])\r\n        ans += 3* (pre[3*n-2*A-B] - pre[A+2*B])\r\n        return ans \r\n    ans = 0\r\n    for i in range(n+1):\r\n        l = 0\r\n        h = n-i\r\n        while l <h :\r\n            B = (l+h+1) // 2\r\n            p = i+2 * (B-1)\r\n            e = 3*n-2*i-(B-1)\r\n            d = a[p] + a[p+1]-3 * a[e-1]\r\n            if d >= 0 :\r\n                l = B \r\n            else:\r\n                h = B-1\r\n        ans = max(ans , cal(i ,l))\r\n    print(ans )\r\n        \r\n        \r\n    ",
