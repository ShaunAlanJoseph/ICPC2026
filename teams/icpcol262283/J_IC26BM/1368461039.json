  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\tconst char* s[4]={\"00\",\"01\",\"10\",\"11\"};\r\n\twhile(t--)\r\n\t{\r\n\t    long long c[4];\r\n\t    for(int i=0;i<4;i++)\r\n\t    {\r\n\t        cin>>c[i];\r\n\t    }\r\n\t    \r\n\t    string best;\r\n\t    bool flag=false;\r\n\t    \r\n\t    for(int l=0;l<4;l++)\r\n\t    {\r\n\t        if(!c[l])\r\n\t        {\r\n\t            continue;\r\n\t        }\r\n\t        long long a=c[0],b=c[1],d=c[2],e=c[3];\r\n\t        if(l==0)\r\n\t        {\r\n\t            a--;\r\n\t        }\r\n\t        else if(l==1)\r\n\t        {\r\n\t            b--;\r\n\t        }\r\n\t        else if(l==2)\r\n\t        {\r\n\t            d--;\r\n\t        }\r\n\t        else\r\n\t        {\r\n\t            e--;\r\n\t        }\r\n\t        \r\n\t        long long w0=min(a,b+e);\r\n\t        long long w1=min(b,(b+e-w0)/2);\r\n\t        long long z=a+d+w0;\r\n\t        long long o=b+e-w0-2*w1;\r\n\t        \r\n\t        string r;\r\n\t        r.reserve(z+2*w1+o+2);\r\n\t        r.append(z,'0');\r\n\t        for(long long i=0;i<w1;i++)\r\n\t        {\r\n\t            r+=\"01\";\r\n\t        }\r\n\t        r.append(o,'1');\r\n\t        r+=s[l];\r\n\t        \r\n\t        if(!flag || r<best)\r\n\t        {\r\n\t            best=r;\r\n\t            flag=true;\r\n\t        }\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\r\n}\r\n",
