  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nconst long long m = 998244353;\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tconst int n=200005;\r\n\tvector<long long> v(n),h(n);\r\n\t\r\n\tv[1]=1;\r\n\tfor(int i=2;i<n;i++)\r\n\t{\r\n\t    v[i]=(m-(m/i) * v[m%i]%m)%m;\r\n\t}\r\n    h[0]=0;\r\n    for(int i=1;i<n;i++)\r\n    {\r\n        h[i]=(h[i-1]+v[i])%m;\r\n    }\r\n    int t;\r\n    cin>>t;\r\n    while(t--)\r\n    {\r\n        int n;\r\n        cin>>n;\r\n        long long r=0;\r\n        for(int i=1;i<=n;i++)\r\n        {\r\n            long long x;\r\n            cin>>x;\r\n            r=(r+x%m *((h[i-1] + h[n-i])%m))%m;\r\n        }\r\n        cout<<r<<endl;\r\n    }\r\n}\r\n",
