  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\n\r\nint main() {\r\n\t// your code goes here\r\n\tint t;\r\n\tcin>>t;\r\n\twhile(t--)\r\n\t{\r\n\t    int n;\r\n\t    cin>>n;\r\n\t    \r\n\t    int m=3*n;\r\n\t    vector<long long>a(m),p(m+1,0);\r\n\t    for(int i=0;i<m;i++)\r\n\t    {\r\n\t        cin>>a[i];\r\n\t    }\r\n\t    sort(a.rbegin(),a.rend());\r\n\t    for(int i=0;i<m;i++)\r\n\t    {\r\n\t        p[i+1]=p[i]+a[i];\r\n\t    }\r\n\t    long long best=0;\r\n\t    \r\n\t    for(int x=0;x<=n;x++)\r\n\t    {\r\n\t        auto g =[&](int b)\r\n\t        {\r\n\t            return p[x+2*b]+3*p[m-2*x-b];\r\n\t        };\r\n\t        \r\n\t        int l=0,h=n-x;\r\n\t        while(l<h)\r\n\t        {\r\n\t            int mid=(l+h)/2;\r\n\t            if(g(mid+1)>g(mid))\r\n\t            {\r\n\t                l=mid+1;\r\n\t            }\r\n\t            else\r\n\t            {\r\n\t                h=mid;\r\n\t            }\r\n\t        }\r\n\t        best=max(best,2*p[x]+g(l));\r\n\t    }\r\n\t    cout<<best<<endl;\r\n\t}\r\n\r\n}\r\n",
