  "source_code": "# cook your dish here\r\n\r\nimport sys\r\ndef main():\r\n    d = sys.stdin.buffer.read().split()\r\n    t = int(d[0]); p = 1\r\n    names = ['00','01','10','11']\r\n    out = []\r\n    for _ in range(t):\r\n        c = [int(x) for x in d[p:p + 4]];p+=4\r\n        best = None\r\n        for zi in range(4):\r\n            if c[zi] == 0:\r\n                continue\r\n            a = c[:]\r\n            a[zi] -= 1\r\n            a00,a01,a10,a11 = a\r\n            o = a01 + a11\r\n            m1 = min(a00,o)\r\n            d11 = min(a11,m1)\r\n            r01 = a01 - (m1 - d11)\r\n            r11 = a11 - d11\r\n            rem = r01 + r11\r\n            m2 = min(r01,rem//2)\r\n            r = rem - 2*m2\r\n            s = '0'*(a00 + a10 + m1) + '01' *m2 + '1'*r + names[zi]\r\n            if best is None or s < best:\r\n                best = s\r\n        out.append(best)\r\n    print(\"\\n\".join(out))\r\nmain()",
