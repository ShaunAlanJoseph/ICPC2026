  "source_code": "import sys\r\ndef solve():\r\n    data = sys.stdin.buffer.read().split()\r\n    t = int(data[0])\r\n    pos = 1\r\n    out = []\r\n    for _ in range(t):\r\n        n = int(data[pos]); pos += 1\r\n        a = sorted(map(int,data[pos:pos + 3*n]), reverse = True)\r\n        pos += 3*n\r\n        p = [0]*(3 * n + 1)\r\n        s = 0\r\n        for i in range(3*n):\r\n            s += a[i]\r\n            p[i + 1] = s\r\n        def f(m,c1):\r\n            return 2*p[c1] + p[2*m - c1] + 3*p[3*n -m - c1]\r\n        def g(m):\r\n            l,h = 0,m\r\n            while l < h:\r\n                mid = (l + h)//2\r\n                if f(m,mid + 1) > f(m,mid):\r\n                    l = mid + 1\r\n                else:\r\n                    h = mid\r\n            return f(m,l)\r\n        l,h = 0,n\r\n        while l < h:\r\n            mid = (l + h)//2\r\n            if g(mid + 1) > g(mid):\r\n                l = mid + 1\r\n            else:\r\n                h = mid\r\n        out.append(str(g(l)))\r\n    sys.stdout.write(\"\\n\".join(out) + \"\\n\")\r\n\r\nsolve()\r\n    ",
