  "source_code": "t=int(input())\r\nfor i in range(t):\r\n    n=int(input())\r\n    a=list(map(int,input().split()))\r\n    a.sort(reverse=True)\r\n    prfx=[0]*(3*n+1)\r\n    for i in range(3*n):\r\n        prfx[i+1]=prfx[i]+a[i]\r\n    def get_value(A,B):\r\n        C=n-A-B\r\n        sec1=6*prfx[A]\r\n        start=A\r\n        end=A+2*B\r\n        sec2=4*(prfx[end]-prfx[start])\r\n        start=end\r\n        end=start+3*C\r\n        sec3=3*(prfx[end]-prfx[start])\r\n        return sec1+sec2+sec3\r\n    res=0\r\n    for A in range(n+1):\r\n        max_B=n-A\r\n        low=0\r\n        high=max_B\r\n        while low<high:\r\n            mid=(low+high+1)//2\r\n            B=mid-1\r\n            if B<max_B:\r\n                p=A+2*B \r\n                last=3*n-2*A-B-1\r\n                change=(a[p]+a[p+1]-3*a[last])\r\n                if change>0:\r\n                    low=mid\r\n                else:\r\n                    high=mid-1\r\n        yxz=low\r\n        res=max(res,get_value(A,yxz))\r\n            \r\n    print(res)\r\n            ",
