  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\n\r\nll mod = 998244353;\r\n\r\nll update_ans(ll ans_, ll x, ll coef){\r\n    return (ans_ + (x % mod)  * coef) % mod;\r\n}\r\n\r\nint main() {\r\n\tint t; cin >> t;\r\n\tll inv[300001];\r\n\tll h[300001];\r\n\t\r\n\tinv[1] = 1;\r\n\tfor(int i = 2; i < 300001; i++){\r\n\t    inv[i] = (mod - (mod /i) * inv[mod % i] % mod) % mod;\r\n\t}\r\n\t\r\n\th[0] = 0LL;\r\n\tfor(int i= 1; i < 300001; i++){\r\n\t    h[i] = (h[i-1] + inv[i]) % mod;\r\n\t}\r\n\t\r\n\twhile(t--){\r\n\t    int n; cin >> n;\r\n\t    ll ans = 0;\r\n\t    for(int j = 1; j <= n; j++){\r\n\t        ll x; cin >> x;\r\n\t        ll coef__ = (h[j-1] + h[n-j]) % mod;\r\n\t       ans = 1LL * update_ans(ans, x, coef__);\r\n\t    }\r\n\t    cout << ans << endl;\r\n\t}\r\n\r\n}\r\n",
