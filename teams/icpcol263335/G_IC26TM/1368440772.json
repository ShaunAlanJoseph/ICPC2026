  "source_code": "#include <bits/stdc++.h>\r\nusing namespace std;\r\nusing ll = long long;\r\nint main() {\r\n\tint t;cin>>t;\r\n\t\r\n\twhile(t--){\r\n\t    int n;cin>>n;\r\n\t    int m = 3*n;\r\n\t    \r\n\t    vector<ll> a(m);\r\n\t    for( auto& x:a)cin>>x;\r\n\t    sort(a.begin(),a.end(),greater<ll>());\r\n\t    vector<ll> pre(m+1,0);\r\n\t    for(int i = 0;i<m;i++){\r\n\t        pre[i+1] = pre[i]+a[i];\r\n\t    }\r\n\t    \r\n\t    auto calc = [&](int A, int B) -> ll{\r\n\t        int C = n-A-B;\r\n\t        int e1 = A;\r\n\t        int e2 = A+2*B;\r\n\t        int e3 = e2 + 3*C;\r\n\t        return 6*pre[e1] + 4*(pre[e2] - pre[e1]) + 3*(pre[e3]-pre[e2]);\r\n\t    };\r\n\t    \r\n\t    ll best = 0;\r\n\t    for( int A = 0;A<=n;A++){\r\n\t        int lo = 0, hi = n-A;\r\n\t        while(lo<hi){\r\n\t            int mid = lo + (hi-lo)/2;\r\n\t            if(calc(A,mid+1)> calc(A,mid)) lo = mid+1;\r\n\t            else hi = mid;\r\n\t        }\r\n\t        best = max(best,calc(A,lo));\r\n\t    }\r\n\t    cout<<best<<\"\\n\";\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n",
